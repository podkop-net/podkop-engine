+		}
+		to, err = readIPSetAddr(reader)
+		if err != nil {
+			return nil, err
+		}
+		if !builder.AddRange(netipx.IPRangeFrom(from, to)) {
+			return nil, os.ErrInvalid
+		}
+	}
