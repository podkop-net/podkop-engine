From f53702490efc95383c433322d538592eb00b67dd Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 19 Oct 2026 22:59:58 +0300
Subject: [PATCH 139/159] domainset: the build of sorted keys refuses what
 stops sing's build

The legacy way of rule sets of version 1, and a list with a name that is
not valid UTF-8, go to the build of sorted keys. It did what sing does with
an empty suffix, or with a name and a suffix that make the same key (a name
that begins with "\n" or "\r"): it stopped the process. It refuses them now,
as the trie does; NewSet makes the keys first before it hands such a list to
sing.
---
 common/domainset/domainset.go      |  7 +++-
 common/domainset/domainset_test.go | 56 +++++++++++++++++++++---------
 common/domainset/legacy.go         | 23 +++++++++---
 3 files changed, 64 insertions(+), 22 deletions(-)

diff --git a/common/domainset/domainset.go b/common/domainset/domainset.go
index 7cf17e0a5..949959ffd 100644
--- a/common/domainset/domainset.go
+++ b/common/domainset/domainset.go
@@ -46,6 +46,11 @@ type Matcher interface {
 // around them.
 func NewSet(domains []string, domainSuffix []string) (Matcher, error) {
 	if !validNames(domains, domainSuffix) {
+		// the keys are made first for what stops sing's build
+		_, err := keys(domains, domainSuffix, false)
+		if err != nil {
+			return nil, err
+		}
 		return domain.NewMatcher(domains, domainSuffix, false), nil
 	}
 	collector, err := collect(domains, domainSuffix)
@@ -87,7 +92,7 @@ func Describe(domains []string, domainCount int, domainSuffix []string, domainSu
 // writes it, the form a rule set in the binary format carries.
 func Encode(domains []string, domainSuffix []string, generateLegacy bool) ([]byte, error) {
 	if generateLegacy || !validNames(domains, domainSuffix) {
-		return encodeSorted(domains, domainSuffix, generateLegacy), nil
+		return encodeSorted(domains, domainSuffix, generateLegacy)
 	}
 	collector, err := collect(domains, domainSuffix)
 	if err != nil {
diff --git a/common/domainset/domainset_test.go b/common/domainset/domainset_test.go
index 45ded88bc..f0aa2a66a 100644
--- a/common/domainset/domainset_test.go
+++ b/common/domainset/domainset_test.go
@@ -88,7 +88,8 @@ func TestSameAsSing(t *testing.T) {
 
 // Names sing takes that a list of a rule set hardly has: empty, in capitals, with the
 // labels of the trie inside them, of one byte, a name that is a suffix of another in
-// every way; and names that are not valid UTF-8, which go the way sing builds them.
+// every way; and names that are not valid UTF-8, which go the way sing builds them. The
+// random lists go every way: with a name that is not valid UTF-8 or not, legacy or not.
 func TestSameAsSingOddNames(t *testing.T) {
 	for _, lists := range [][2][]string{
 		{{""}, nil},
@@ -121,23 +122,35 @@ func TestSameAsSingOddNames(t *testing.T) {
 		if len(lists[0])+len(lists[1]) == 0 {
 			continue
 		}
-		var want []byte
-		func() {
-			defer func() {
-				if recover() != nil {
-					want = nil
+		// a name that is not valid UTF-8 takes the list to the build of sorted keys, as
+		// the legacy way does (two bytes before the bad one: sing's reverse of a name puts
+		// U+FFFD, three bytes, where that byte goes and needs room for it)
+		odd := append(append([]string(nil), lists[0]...), "ab\xffcd")
+		for _, domains := range [][]string{lists[0], odd} {
+			for _, legacy := range []bool{false, true} {
+				var want []byte
+				func() {
+					defer func() {
+						if recover() != nil {
+							want = nil
+						}
+					}()
+					want = singBytes(t, domains, lists[1], legacy)
+				}()
+				encoded, err := Encode(domains, lists[1], legacy)
+				if want == nil {
+					// sing stops the process: an empty suffix, a key made twice
+					require.Error(t, err, "%q %q legacy %v", domains, lists[1], legacy)
+				} else {
+					require.NoError(t, err, "%q %q legacy %v", domains, lists[1], legacy)
+					require.Equal(t, want, encoded, "%q %q legacy %v", domains, lists[1], legacy)
 				}
-			}()
-			want = singBytes(t, lists[0], lists[1], false)
-		}()
-		encoded, err := Encode(lists[0], lists[1], false)
-		if want == nil {
-			// sing stops the process: an empty suffix, a name and a suffix of one key
-			require.Error(t, err, "%q", lists)
-			continue
+				if !legacy {
+					_, err = NewSet(domains, lists[1])
+					require.Equal(t, want == nil, err != nil, "%q %q", domains, lists[1])
+				}
+			}
 		}
-		require.NoError(t, err, "%q", lists)
-		require.Equal(t, want, encoded, "%q", lists)
 	}
 }
 
@@ -147,6 +160,17 @@ func TestRefused(t *testing.T) {
 	require.ErrorIs(t, err, ErrEmptySuffix)
 	_, err = NewSet([]string{"\na"}, []string{"a"})
 	require.ErrorIs(t, err, errSameKey)
+	// the build of sorted keys: the legacy way, a name that is not valid UTF-8
+	_, err = Encode(nil, []string{"a", ""}, true)
+	require.ErrorIs(t, err, ErrEmptySuffix)
+	_, err = Encode([]string{"\r.a"}, []string{"a"}, true)
+	require.ErrorIs(t, err, errSameKey)
+	_, err = Encode([]string{"\na", "ab\xffcd"}, []string{"a"}, false)
+	require.ErrorIs(t, err, errSameKey)
+	_, err = NewSet([]string{"\na", "ab\xffcd"}, []string{"a"})
+	require.ErrorIs(t, err, errSameKey)
+	_, err = NewSet([]string{"ab\xffcd"}, []string{"a", ""})
+	require.ErrorIs(t, err, ErrEmptySuffix)
 }
 
 // What a list of 100000 names of no pattern costs to build: here and in sing.
diff --git a/common/domainset/legacy.go b/common/domainset/legacy.go
index 40448f46e..2b1c9f520 100644
--- a/common/domainset/legacy.go
+++ b/common/domainset/legacy.go
@@ -20,17 +20,25 @@ const (
 // map and sorted: for the legacy way of rule sets of version 1 (a suffix is two keys,
 // one of them for a name that is not in the list) and for names that are not valid UTF-8.
 // Only the walk of the trie is the lean one of Collector.build, one level at a time.
-func encodeSorted(domains []string, domainSuffix []string, generateLegacy bool) []byte {
-	return buildSorted(keys(domains, domainSuffix, generateLegacy))
+func encodeSorted(domains []string, domainSuffix []string, generateLegacy bool) ([]byte, error) {
+	list, err := keys(domains, domainSuffix, generateLegacy)
+	if err != nil {
+		return nil, err
+	}
+	return buildSorted(list), nil
 }
 
 // keys are the keys of the trie, as domain.NewMatcher makes them: a name reversed, with a
 // label for how it matches, each once, in order. A name of domains that is a suffix too is
-// the suffix only, as there.
-func keys(domains []string, domainSuffix []string, generateLegacy bool) []string {
+// the suffix only, as there. What stops the process there is an error: an empty suffix,
+// and a key made twice (a name that begins with "\n" or "\r" and a suffix).
+func keys(domains []string, domainSuffix []string, generateLegacy bool) ([]string, error) {
 	seen := make(map[string]bool, len(domainSuffix)+len(domains))
 	list := make([]string, 0, len(domains)+len(domainSuffix))
 	for _, name := range domainSuffix {
+		if name == "" {
+			return nil, ErrEmptySuffix
+		}
 		if seen[name] {
 			continue
 		}
@@ -59,7 +67,12 @@ func keys(domains []string, domainSuffix []string, generateLegacy bool) []string
 	// the map is no longer needed: a big list should not keep it while the trie is built
 	seen = nil
 	slices.Sort(list)
-	return list
+	for index := 1; index < len(list); index++ {
+		if list[index] == list[index-1] {
+			return nil, errSameKey
+		}
+	}
+	return list, nil
 }
 
 // reverse is reverseDomain of sing: the runes in the other order.
