+// contextReader ends with the error of ctx once it is done: a rule set of the binary
+// format closed while it is read stops at the next read.
+type contextReader struct {
+	ctx    context.Context
+	reader io.Reader
+}
+
+func (r contextReader) Read(p []byte) (int, error) {
+	if err := r.ctx.Err(); err != nil {
+		return 0, err
+	}
+	return r.reader.Read(p)
+}
+
 func (s *RemoteRuleSet) loopUpdate() {
 	// Never downloaded (initial fetch failed): retry with backoff instead of
 	// waiting a whole update_interval.
diff --git a/route/rule/rule_set_remote_stop_test.go b/route/rule/rule_set_remote_stop_test.go
new file mode 100644
index 000000000..36f22cd04
--- /dev/null
+++ b/route/rule/rule_set_remote_stop_test.go
@@ -0,0 +1,45 @@
+package rule
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"strings"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/stretchr/testify/require"
+)
+
+// A rule set closed while it reads a downloaded list stops reading it: the content it had
+// stays, and the error is the one of its context.
+func TestRemoteRuleSetClosedStopsReading(t *testing.T) {
+	var source strings.Builder
+	source.WriteString(`{"version":3,"rules":[{"domain_suffix":[`)
+	for index := range 50000 {
+		if index > 0 {
+			source.WriteByte(',')
+		}
+		fmt.Fprintf(&source, `"host%d.example.com"`, index)
+	}
+	source.WriteString(`]}]}`)
+	ctx, cancel := context.WithCancel(context.Background())
+	ruleSet := &RemoteRuleSet{ctx: ctx, options: option.RuleSet{Tag: "big", Format: C.RuleSetFormatSource}}
+	cancel()
+	require.ErrorIs(t, ruleSet.loadBytes([]byte(source.String())), context.Canceled)
+	require.Nil(t, ruleSet.rules)
+}
+
+func TestContextReader(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	reader := contextReader{ctx, bytes.NewReader([]byte("abcdef"))}
+	buffer := make([]byte, 3)
+	count, err := reader.Read(buffer)
+	require.NoError(t, err)
+	require.Equal(t, 3, count)
+	cancel()
+	_, err = reader.Read(buffer)
+	require.ErrorIs(t, err, context.Canceled)
+}
