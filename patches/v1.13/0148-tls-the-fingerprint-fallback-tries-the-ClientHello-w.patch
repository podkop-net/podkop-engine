+// choiceCache is the part of a cache file that keeps the choice of the fallback.
+type choiceCache struct {
+	adapter.CacheFile
+	access  sync.Mutex
+	choices map[string]choiceEntry
+}
+
+type choiceEntry struct {
+	choice string
