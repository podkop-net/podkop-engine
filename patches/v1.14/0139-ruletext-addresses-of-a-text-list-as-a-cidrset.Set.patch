From ae1c07f7bf81633670ad9fee2c78051865d83648 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 19 Oct 2026 00:22:47 +0300
Subject: [PATCH 139/174] ruletext: addresses of a text list as a cidrset.Set

A canonical IPv4 address or prefix of a text list is read from its line
(cidrset.Parse4), any other by parsePrefix as before; no string a line,
no map of repeats, no second reading by NewIPCIDRItem. The rule carries
the set (IPRanges). Room for domains and for addresses is made at the
first item of each, so that a list of one kind does not hold room for
the other.
---
 common/ruletext/ruletext.go      | 52 +++++++++++++++++++++-----------
 common/ruletext/ruletext_test.go |  9 ++++--
 2 files changed, 42 insertions(+), 19 deletions(-)

diff --git a/common/ruletext/ruletext.go b/common/ruletext/ruletext.go
index 56479b6c3..d99b6a2b4 100644
--- a/common/ruletext/ruletext.go
+++ b/common/ruletext/ruletext.go
@@ -10,11 +10,11 @@ import (
 	"net/netip"
 	"strings"
 
+	"github.com/sagernet/sing-box/common/cidrset"
 	"github.com/sagernet/sing-box/common/domainset"
 	C "github.com/sagernet/sing-box/constant"
 	"github.com/sagernet/sing-box/option"
 	E "github.com/sagernet/sing/common/exceptions"
-	"github.com/sagernet/sing/common/json/badoption"
 )
 
 // Skipped is what a list had that is neither a domain nor an IP address or CIDR.
@@ -48,18 +48,18 @@ func ReadAddresses(content []byte) (option.PlainRuleSetCompat, Skipped, error) {
 
 func read(content []byte, build bool) (option.PlainRuleSetCompat, Skipped, error) {
 	var (
-		prefixes []string
-		skipped  Skipped
-		domains  int
+		skipped Skipped
+		domains int
 		// the first names, for the description of the rule
 		first []string
+		// the addresses, how many items there are, the first of them
+		addresses    cidrset.Builder
+		addressCount int
+		addressFirst []string
+		items        int
+		lines        = bytes.Count(content, []byte{'\n'}) + 1
 	)
 	names := domainset.NewCollector(content)
-	if build {
-		// a name a line at most: room made once
-		names.Grow(bytes.Count(content, []byte{'\n'}) + 1)
-	}
-	seenPrefixes := make(map[string]bool)
 	for offset := 0; offset < len(content); {
 		lineStart := offset
 		lineEnd := bytes.IndexByte(content[offset:], '\n')
@@ -81,12 +81,25 @@ func read(content []byte, build bool) (option.PlainRuleSetCompat, Skipped, error
 		if len(item) == 0 {
 			continue
 		}
+		items++
 		if mayBeAddress(item) {
-			if prefix, isPrefix := parsePrefix(string(item)); isPrefix {
-				text := prefix.String()
-				if !seenPrefixes[text] {
-					seenPrefixes[text] = true
-					prefixes = append(prefixes, text)
+			if addressCount == 0 {
+				// an item a line at most from here: room made once
+				addresses.Grow(lines - items + 1)
+			}
+			if from, to, ok := cidrset.Parse4(item); ok {
+				addresses.Add4(from, to)
+				addressCount++
+				if len(addressFirst) < 3 {
+					prefix, _ := parsePrefix(string(item))
+					addressFirst = append(addressFirst, prefix.String())
+				}
+				continue
+			}
+			if prefix, isPrefix := parsePrefix(string(item)); isPrefix && addresses.AddPrefix(prefix) {
+				addressCount++
+				if len(addressFirst) < 3 {
+					addressFirst = append(addressFirst, prefix.String())
 				}
 				continue
 			}
@@ -94,6 +107,10 @@ func read(content []byte, build bool) (option.PlainRuleSetCompat, Skipped, error
 		if from, to, isDomain := parseASCIIDomain(item); isDomain {
 			domains++
 			if build {
+				if domains == 1 {
+					// a name a line at most from here: room made once
+					names.Grow(lines - items + 1)
+				}
 				// the item is a part of the content: where it is, from what is left after it
 				start := cap(content) - cap(item[from:])
 				if len(first) < 3 {
@@ -137,7 +154,7 @@ func read(content []byte, build bool) (option.PlainRuleSetCompat, Skipped, error
 		}
 		skipped.Count++
 	}
-	if domains == 0 && len(prefixes) == 0 {
+	if domains == 0 && addressCount == 0 {
 		if skipped.Count > 0 {
 			return option.PlainRuleSetCompat{}, skipped, E.New("no domain and no IP CIDR in the list, the first line: ", skipped.First)
 		}
@@ -151,8 +168,9 @@ func read(content []byte, build bool) (option.PlainRuleSetCompat, Skipped, error
 		}
 		rules = append(rules, option.HeadlessRule{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultHeadlessRule{DomainSet: set}})
 	}
-	if len(prefixes) > 0 {
-		rules = append(rules, option.HeadlessRule{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultHeadlessRule{IPCIDR: badoption.Listable[string](prefixes)}})
+	if addressCount > 0 {
+		set := addresses.Set(cidrset.Describe(false, addressFirst, addressCount))
+		rules = append(rules, option.HeadlessRule{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultHeadlessRule{IPRanges: set}})
 	}
 	return option.PlainRuleSetCompat{Version: C.RuleSetVersionCurrent, Options: option.PlainRuleSet{Rules: rules}}, skipped, nil
 }
diff --git a/common/ruletext/ruletext_test.go b/common/ruletext/ruletext_test.go
index c887f9d57..bad820595 100644
--- a/common/ruletext/ruletext_test.go
+++ b/common/ruletext/ruletext_test.go
@@ -2,6 +2,7 @@ package ruletext
 
 import (
 	"bytes"
+	"net/netip"
 	"strings"
 	"testing"
 
@@ -18,7 +19,9 @@ func TestRead(t *testing.T) {
 	require.Len(t, ruleSet.Options.Rules, 2)
 	require.Equal(t, written(t, domain.NewMatcher(nil, []string{"example.com", "sub.example.org", "x.example", "ru", "last.example"}, false)),
 		written(t, ruleSet.Options.Rules[0].DefaultOptions.DomainSet))
-	require.Equal(t, []string{"10.0.0.0/8", "192.0.2.1/32", "2001:db8::/32"}, []string(ruleSet.Options.Rules[1].DefaultOptions.IPCIDR))
+	require.Equal(t, []netip.Prefix{netip.MustParsePrefix("10.0.0.0/8"), netip.MustParsePrefix("192.0.2.1/32"), netip.MustParsePrefix("2001:db8::/32")},
+		ruleSet.Options.Rules[1].DefaultOptions.IPRanges.Prefixes())
+	require.Equal(t, "ip_cidr=[10.0.0.0/8 192.0.2.1/32 2001:db8::/32]", ruleSet.Options.Rules[1].DefaultOptions.IPRanges.String())
 	require.Equal(t, Skipped{Count: 2, First: "not a domain"}, skipped)
 
 	// the last line without a line end is read; a list of names alone has one rule
@@ -64,7 +67,9 @@ func TestReadNames(t *testing.T) {
 	require.NoError(t, err)
 	require.Equal(t, 5, skipped.Count)
 	require.Equal(t, written(t, domain.NewMatcher(nil, expected, false)), written(t, ruleSet.Options.Rules[0].DefaultOptions.DomainSet))
-	require.Equal(t, []string{"10.0.0.1/32", "10.0.0.0/8", "2001:db8::/32"}, []string(ruleSet.Options.Rules[1].DefaultOptions.IPCIDR))
+	// 10.0.0.1 is in 10.0.0.0/8: the set holds the network
+	require.Equal(t, []netip.Prefix{netip.MustParsePrefix("10.0.0.0/8"), netip.MustParsePrefix("2001:db8::/32")},
+		ruleSet.Options.Rules[1].DefaultOptions.IPRanges.Prefixes())
 	// without the matcher: the same addresses, the same lines left out
 	addresses, skippedToo, err := ReadAddresses([]byte(strings.Join(lines, "\n")))
 	require.NoError(t, err)
