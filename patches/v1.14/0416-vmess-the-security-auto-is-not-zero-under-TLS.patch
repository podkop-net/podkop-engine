From 96f5cf19b133d04d6250715e2c44497a21952620 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Thu, 12 Nov 2026 21:41:21 +0300
Subject: [PATCH 51/63] vmess: the security auto is not zero under TLS

The security auto of VMess is not zero under TLS.

Made of these commits of the earlier series (branch archive/r25-1.14-commits):
  ef2b5231a vmess: the security auto is not zero under TLS

Pdk-Feature: vmess
Pdk-Zone: protocols
Pdk-Layer: 04
---
 protocol/vmess/outbound.go | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/protocol/vmess/outbound.go b/protocol/vmess/outbound.go
index 2d8676762..9b7d9c0e2 100644
--- a/protocol/vmess/outbound.go
+++ b/protocol/vmess/outbound.go
@@ -100,9 +100,9 @@ func NewOutbound(ctx context.Context, router adapter.Router, logger log.ContextL
 	if security == "" {
 		security = "auto"
 	}
-	if security == "auto" && outbound.tlsConfig != nil {
-		security = "zero"
-	}
+	// "auto" is AES-128-GCM or ChaCha20-Poly1305, by the hardware, under TLS too. It was
+	// made "zero" there; Xray-core has dropped "zero" and "none", and its server refuses a
+	// request that names one of them ("unknown security type").
 	client, err := vmess.NewClient(options.UUID, security, options.AlterId, clientOptions...)
 	if err != nil {
 		return nil, err
-- 
2.53.0

