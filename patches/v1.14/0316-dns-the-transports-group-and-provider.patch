+	time.Sleep(groupTestTiming.staleAfter)
+	groupTestExpect(t, group, "10.0.0.1")
+	waitFallbackTest(t, "a copy a while later", func() bool { return other.asked() == 2 })
+	time.Sleep(groupTestTiming.staleAfter)
+	groupTestExpect(t, group, "10.0.0.1")
