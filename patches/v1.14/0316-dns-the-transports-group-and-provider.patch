+// A change of state caused by a query of sing-box itself, whose lines are lowered to the
+// debug level, is still written at the warn level.
+func TestGroupStateLinesOfOwnQueries(t *testing.T) {
+	t.Parallel()
+	output := new(lockedBuffer)
+	factory := log.NewDefaultFactory(context.Background(), log.Formatter{BaseTime: time.Now(), DisableColors: true}, output, "", nil, false)
+	factory.SetLevel(log.LevelWarn)
+	require.NoError(t, factory.Start())
+	first, second := newGroupTestMember("first", fallbackTestFails), newGroupTestMember("second", groupTestAnswer(2, 0))
+	group, err := newGroupTransport(context.Background(), factory.NewLogger("dns/group[dns-server]"), "dns-server", option.GroupDNSServerOptions{Servers: []string{"first", "second"}}, false)
+	require.NoError(t, err)
+	group.timing = groupTestTiming
+	require.NoError(t, group.resolveMembers(&fakeDNSTransportManager{transports: map[string]adapter.DNSTransport{"first": first, "second": second}}))
+	t.Cleanup(func() { group.close() })
+	own := func() {
+		ctx, cancel := context.WithTimeout(log.ContextWithOverrideLevel(context.Background(), log.LevelDebug), 5*time.Second)
+		defer cancel()
+		response, err := group.Exchange(ctx, freshTestQuery())
+		require.Equal(t, "10.0.0.2", groupTestWho(response, err))
+	}
+	own()
+	own()
+	require.True(t, output.has("server first failed 2 times in a row"), output.String())
+	require.False(t, output.has("asking the next one") || output.has("failed: "), "a single query stays at the debug level:\n%s", output)
+	first.serve(groupTestAnswer(1, 0))
+	time.Sleep(groupTestTiming.probeFirst + 50*time.Millisecond)
+	own()
+	waitFallbackTest(t, "first answers its probe", func() bool { return output.has("server first answers again") })
+}
+
+// An answer of the net to a query planned before a member answered again leaves the net
+// unused: no line of the net taking over just after the member came back.
+func TestGroupSafetyNetLateAnswer(t *testing.T) {
+	t.Parallel()
+	first := newGroupTestMember("first", fallbackTestFails)
+	group, output := newGroupTest(t, groupTestProviders(testResolver(t, mDNS.RcodeSuccess)), C.DNSGroupStrategyOrder, true, first)
+	plan, err := group.plan(context.Background(), freshTestQuery())
+	require.NoError(t, err)
+	require.NotNil(t, plan.net)
+	group.answered(context.Background(), group.members[0], plan.epoch, time.Millisecond)
+	group.netAnswered(context.Background(), plan, errGroupSetAside)
+	require.False(t, output.has("answering from provider DNS"), output.String())
+	require.False(t, group.GroupState().SafetyNetAnswer.IsZero(), "the time of the answer is kept")
+	plan, err = group.plan(context.Background(), freshTestQuery())
+	require.NoError(t, err)
+	group.netAnswered(context.Background(), plan, errGroupSetAside)
+	require.True(t, output.has("answering from provider DNS"), output.String())
+}
+
+// With the safety net, a group whose members are all set aside answers from the provider at
+// once and probes the members; when the provider fails too, the members are asked in order.
+func TestGroupSafetyNetFirst(t *testing.T) {
+	t.Parallel()
+	t.Run("provider answers", func(t *testing.T) {
+		t.Parallel()
+		first, second := newGroupTestMember("first", fallbackTestFails), newGroupTestMember("second", fallbackTestFails)
+		group, _ := newGroupTest(t, groupTestProviders(testResolver(t, mDNS.RcodeSuccess)), C.DNSGroupStrategyOrder, true, first, second)
+		groupTestExpect(t, group, "1.2.3.4")
+		groupTestExpect(t, group, "1.2.3.4")
+		require.True(t, group.testMember("first").SetAside && group.testMember("second").SetAside)
+		groupTestExpect(t, group, "1.2.3.4")
+		require.Equal(t, []int{2, 2}, []int{first.asked(), second.asked()}, "members set aside asked before the provider")
+		second.serve(groupTestAnswer(2, 0))
+		time.Sleep(groupTestTiming.probeFirst + 50*time.Millisecond)
+		groupTestExpect(t, group, "1.2.3.4")
+		waitFallbackTest(t, "second answers its probe", func() bool { return !group.testMember("second").SetAside })
+		waitFallbackTest(t, "first is probed", func() bool { return first.asked() == 3 })
+		groupTestExpect(t, group, "10.0.0.2")
+	})
+	t.Run("provider fails", func(t *testing.T) {
+		t.Parallel()
+		first, second := newGroupTestMember("first", fallbackTestFails), newGroupTestMember("second", fallbackTestFails)
+		group, _ := newGroupTest(t, groupTestProviders(testResolver(t, mDNS.RcodeRefused)), C.DNSGroupStrategyOrder, true, first, second)
+		group.timing.probeFirst = time.Minute // no probe in this test
+		groupTestExpect(t, group, "error")
+		groupTestExpect(t, group, "error")
+		require.True(t, group.testMember("first").SetAside && group.testMember("second").SetAside)
+		second.serve(groupTestAnswer(2, 0))
+		groupTestExpect(t, group, "10.0.0.2")
+		require.Equal(t, []int{3, 3}, []int{first.asked(), second.asked()})
+		require.False(t, group.testMember("second").SetAside)
+	})
+}
+
+// A member has no per-server fallback: neither through the group nor asked alone; the group
+// itself has none either.
+func TestGroupMembersWithoutFallback(t *testing.T) {
+	t.Parallel()
+	member, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+	member.transportTag = "member"
+	member.serve(fallbackTestFails)
+	require.NotNil(t, fallbackFor(member))
+	group, output := newGroupTest(t, nil, C.DNSGroupStrategyOrder, false, member)
+	require.Nil(t, fallbackFor(member), "a member keeps its fallback")
+	require.True(t, state.grouped.Load())
+	require.True(t, output.has("no provider DNS fallback for server member: member of group dns-server"), output.String())
+	groupTestExpect(t, group, "error")
+	client := &Client{ctx: context.Background()}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if got, err := fallbackTestAnswer(client.exchangeTransport(ctx, member, freshTestQuery())); got != "" || err != errFallbackTestServer {
+		t.Errorf("the member asked alone answered by %q (%v), want its own error", got, err)
+	}
+	require.Nil(t, fallbackFor(group))
+	if got := state.testState(); got.failures != 0 || got.down {
+		t.Errorf("the fallback state of the member moved: %+v", got)
+	}
+}
+
+// A network reset clears failures, the set-aside state and measurements; what was on its
+// way before counts nothing.
+func TestGroupReset(t *testing.T) {
+	t.Parallel()
+	first, second := newGroupTestMember("first", fallbackTestFails), newGroupTestMember("second", groupTestAnswer(2, 0))
+	group, output := newGroupTest(t, nil, C.DNSGroupStrategyOrder, false, first, second)
+	groupTestExpect(t, group, "10.0.0.2")
+	groupTestExpect(t, group, "10.0.0.2")
+	require.True(t, group.testMember("first").SetAside)
+	require.NotZero(t, group.testMember("second").SmoothedTime)
+	group.Reset()
+	state := group.GroupState()
+	require.False(t, state.Members[0].SetAside)
+	require.Zero(t, state.Members[1].SmoothedTime)
+	require.Equal(t, uint64(2), state.Members[0].Failures, "the counts since the start are kept")
+	require.True(t, output.has("network reset: servers set aside are asked again: first"), output.String())
+
+	// a query on its way across a reset
+	called, release := make(chan struct{}), make(chan struct{})
+	first.serve(func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+		close(called)
+		<-release
+		return nil, errFallbackTestServer
+	})
+	done := make(chan string)
+	go func() {
+		got, _ := groupTestQuery(group)
+		done <- got
+	}()
+	<-called
+	group.Reset()
+	close(release)
+	require.Equal(t, "10.0.0.2", <-done)
+	state = group.GroupState()
+	require.Equal(t, uint64(2), state.Members[0].Failures, "a failure from before the reset counted")
+	require.Equal(t, uint64(2), state.Members[1].Answers, "an answer from before the reset counted")
+	require.Zero(t, state.Members[1].SmoothedTime)
+}
+
+// The close of the group ends the background copies and waits for them; none starts after.
+func TestGroupCloseEndsCopies(t *testing.T) {
+	t.Parallel()
+	fast, hanging := newGroupTestMember("fast", groupTestAnswer(1, 0)), newGroupTestMember("hanging", groupTestSilent)
+	group, _ := newGroupTest(t, nil, C.DNSGroupStrategyFastest, false, fast, hanging)
+	group.timing.attemptMax = 10 * time.Second // the copy would wait that long
+	groupTestExpect(t, group, "10.0.0.1")
+	waitFallbackTest(t, "the copy to hanging", func() bool { return hanging.asked() == 1 })
+	startAt := time.Now()
+	require.NoError(t, group.close())
+	if elapsed := time.Since(startAt); elapsed > time.Second {
+		t.Fatalf("close took %v", elapsed)
+	}
+	group.timing.staleAfter = 0
+	groupTestExpect(t, group, "10.0.0.1")
+	time.Sleep(50 * time.Millisecond)
+	require.Equal(t, 1, hanging.asked(), "a copy sent after the close")
+	require.Zero(t, group.testMember("hanging").Failures, "the close counted as a failure")
+}
+
+// ExchangeAsync calls back once, from another goroutine.
+func TestGroupExchangeAsync(t *testing.T) {
+	t.Parallel()
+	first := newGroupTestMember("first", groupTestAnswer(1, 20*time.Millisecond))
+	group, _ := newGroupTest(t, nil, C.DNSGroupStrategyOrder, false, first)
+	results := make(chan string, 2)
+	startAt := time.Now()
+	group.ExchangeAsync(context.Background(), freshTestQuery(), func(response *mDNS.Msg, err error) {
+		results <- groupTestWho(response, err)
+	})
+	if time.Since(startAt) > 10*time.Millisecond {
+		t.Error("ExchangeAsync kept the caller")
+	}
+	require.Equal(t, "10.0.0.1", <-results)
+	select {
+	case <-results:
+		t.Fatal("called back twice")
+	case <-time.After(50 * time.Millisecond):
+	}
+}
+
+// Many queries at once, with network resets and readers of the state, members answering,
+// failing, refusing and hanging at random (go test -race).
+func TestGroupRace(t *testing.T) {
+	t.Parallel()
+	for _, strategy := range []string{C.DNSGroupStrategyOrder, C.DNSGroupStrategyFastest} {
+		t.Run(strategy, func(t *testing.T) {
+			t.Parallel()
+			random := func(n byte) groupTestHandler {
+				return func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+					switch rand.IntN(10) {
+					case 0:
+						return nil, errFallbackTestServer
+					case 1:
+						return groupTestRcode(mDNS.RcodeServerFailure)(ctx, message)
+					case 2:
+						return groupTestSilent(ctx, message)
+					default:
+						return groupTestAnswer(n, time.Duration(rand.IntN(5))*time.Millisecond)(ctx, message)
+					}
+				}
+			}
+			var members []adapter.DNSTransport
+			for n, tag := range []string{"a", "b", "c"} {
+				members = append(members, newGroupTestMember(tag, random(byte(n+1))))
+			}
+			group, _ := newGroupTest(t, groupTestProviders(testResolver(t, mDNS.RcodeSuccess)), strategy, true, members...)
+			group.timing.attemptMax = 30 * time.Millisecond
+			group.timing.attemptMin = 10 * time.Millisecond
+			group.timing.probeFirst = 5 * time.Millisecond
+			group.timing.probeMax = 20 * time.Millisecond
+			group.timing.staleAfter = 5 * time.Millisecond
+			stop := make(chan struct{})
+			var others sync.WaitGroup
+			others.Add(1)
+			go func() {
+				defer others.Done()
+				for {
+					select {
+					case <-stop:
+						return
+					case <-time.After(3 * time.Millisecond):
+					}
+					if rand.IntN(4) == 0 {
+						group.Reset()
+					}
+					group.GroupState()
+				}
+			}()
+			var queries sync.WaitGroup
+			var answered atomic.Int32
+			for i := 0; i < 32; i++ {
+				queries.Add(1)
+				go func() {
+					defer queries.Done()
+					for j := 0; j < 30; j++ {
+						ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+						if j%7 == 0 {
+							time.AfterFunc(time.Duration(rand.IntN(20))*time.Millisecond, cancel)
+						}
+						response, err := group.Exchange(ctx, freshTestQuery())
+						cancel()
+						if err == nil && response != nil {
+							answered.Add(1)
+						}
+					}
+				}()
+			}
+			queries.Wait()
+			close(stop)
+			others.Wait()
+			startAt := time.Now()
+			require.NoError(t, group.close())
+			require.Less(t, time.Since(startAt), time.Second, "close waited for the background copies")
+			require.Greater(t, answered.Load(), int32(0))
+		})
+	}
+}
+
+// A member that gives no answer in its time has the rest asked together: the answer comes one
+// timeout after the query, not one per dead member, and the members it cut count nothing.
+func TestGroupTogetherAfterTimeout(t *testing.T) {
+	t.Parallel()
+	first, second, third := newGroupTestMember("first", groupTestSilent), newGroupTestMember("second", groupTestSilent), newGroupTestMember("third", groupTestSilent)
+	fourth := newGroupTestMember("fourth", groupTestAnswer(4, 0))
+	group, output := newGroupTest(t, nil, C.DNSGroupStrategyOrder, false, first, second, third, fourth)
+	elapsed := groupTestExpect(t, group, "10.0.0.4")
+	if elapsed < groupTestTiming.attemptMax || elapsed > 2*groupTestTiming.attemptMax {
+		t.Errorf("answered after %v, want one timeout of %v", elapsed, groupTestTiming.attemptMax)
+	}
+	// the members cut by the answer may be called after it, with their context done already
+	require.Eventually(t, func() bool {
+		return first.asked() == 1 && second.asked() == 1 && third.asked() == 1 && fourth.asked() == 1
+	}, time.Second, 5*time.Millisecond, "each member asked once")
+	require.Equal(t, uint64(1), group.testMember("first").Failures)
+	require.Zero(t, group.testMember("second").Failures, "cut by the answer of the fourth")
+	require.Zero(t, group.testMember("third").Failures, "cut by the answer of the fourth")
+	require.True(t, output.has("server first gave no answer in 300ms, asking the other 3 together"), output.String())
+
+	// a first member that answers: nobody else is asked
+	first.serve(groupTestAnswer(1, 0))
+	groupTestExpect(t, group, "10.0.0.1")
+	require.Equal(t, []int{1, 1, 1}, []int{second.asked(), third.asked(), fourth.asked()})
+}
+
+// Every member dead, the safety net behind them: the first times out, the rest together, then the
+// provider; each member had its whole time and counts one failure.
+func TestGroupTogetherThenSafetyNet(t *testing.T) {
+	t.Parallel()
+	members := make([]adapter.DNSTransport, 4)
+	for index := range members {
+		members[index] = newGroupTestMember("m"+strconv.Itoa(index+1), groupTestSilent)
+	}
+	group, _ := newGroupTest(t, groupTestProviders(testResolver(t, mDNS.RcodeSuccess)), C.DNSGroupStrategyOrder, true, members...)
+	elapsed := groupTestExpect(t, group, "1.2.3.4")
+	if elapsed > 3*groupTestTiming.attemptMax {
+		t.Errorf("the provider answered after %v; one after another the members alone take %v", elapsed, 4*groupTestTiming.attemptMax)
+	}
+	for index := range members {
+		tag := "m" + strconv.Itoa(index+1)
+		require.Equal(t, uint64(1), group.testMember(tag).Failures, tag)
+	}
+}
diff --git a/dns/transport_provider.go b/dns/transport_provider.go
new file mode 100644
index 000000000..e5bf0b554
--- /dev/null
+++ b/dns/transport_provider.go
@@ -0,0 +1,106 @@
+package dns
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+
+	mDNS "github.com/miekg/dns"
+)
+
+// The DNS server of the type provider (podkop-engine) asks the DNS servers of the internet
+// provider: those netifd knows, the same list and the same way as the provider DNS fallback
+// (client_fallback_provider.go). They are the servers of the output device of sing-box, or
+// of every uplink when sing-box binds no socket, each asked through its uplink from a fresh
+// socket: the one that answered last alone, all at once when it does not answer, a REFUSED
+// skipped. It works whether the fallback is enabled or not, and has no fallback of its own:
+// it is the provider. With no server known it fails at once, so that a group moves on to
+// its next member, and the list is read again 30 s later (DHCP may hand the servers out
+// after sing-box started). A network reset forgets the list.
+
+func RegisterProviderTransport(registry *TransportRegistry) {
+	RegisterTransport[option.ProviderDNSServerOptions](registry, C.DNSTypeProvider, NewProviderTransport)
+}
+
+var _ adapter.DNSProviderTransport = (*ProviderTransport)(nil)
+
+type ProviderTransport struct {
+	TransportAdapter
+	ctx    context.Context
+	logger logger.ContextLogger
+	asker  *fallbackServer
+}
+
+func NewProviderTransport(ctx context.Context, logger log.ContextLogger, tag string, options option.ProviderDNSServerOptions) (adapter.DNSTransport, error) {
+	asker, err := newProviderAsker(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return &ProviderTransport{
+		TransportAdapter: NewTransportAdapter(C.DNSTypeProvider, tag, nil),
+		ctx:              ctx,
+		logger:           logger,
+		asker:            asker,
+	}, nil
+}
+
+// newProviderAsker is the part of a fallback server that asks the provider's servers of the
+// box of ctx, for a server that is not itself a remote one (the provider DNS server, the
+// safety net of a group): a plain socket of the box, as the fallback of a server qualifies
+// with one only, bound to the device of an uplink for a server of an uplink (dialerFor).
+func newProviderAsker(ctx context.Context) (*fallbackServer, error) {
+	var options option.RemoteDNSServerOptions
+	dialer, err := NewRemoteDialer(ctx, options)
+	if err != nil {
+		return nil, err
+	}
+	return &fallbackServer{options: options, eligible: true, dialer: dialer, ctx: ctx, providers: providersFrom(ctx)}, nil
+}
+
+func (t *ProviderTransport) Start(stage adapter.StartStage, scope *adapter.Scope) error {
+	return nil
+}
+
+// Reset forgets the list: the uplinks and their servers may have changed. The DNS router
+// does it for the list of the box on a network reset anyway.
+func (t *ProviderTransport) Reset() {
+	t.asker.providers.forget()
+}
+
+func (t *ProviderTransport) Exchange(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+	servers := t.asker.providers.listWait(ctx, t.ctx, t.logger)
+	if len(servers) == 0 {
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		t.asker.providers.noneAnswered() // read the list again in providerRetryAfter
+		return nil, errNoProviders
+	}
+	return t.asker.askProviders(ctx, servers, message)
+}
+
+// ExchangeAsync must not keep the caller: the first query reads the list (an exec of ubus).
+func (t *ProviderTransport) ExchangeAsync(ctx context.Context, message *mDNS.Msg, callback func(response *mDNS.Msg, err error)) {
+	go func() {
+		callback(t.Exchange(ctx, message))
+	}()
+}
+
+func (t *ProviderTransport) ProviderServers() []adapter.DNSProviderServer {
+	t.asker.providers.list(t.ctx, t.logger)
+	return t.asker.providers.snapshot()
+}
+
+// ProviderServers returns the provider's servers of the box of ctx as the provider DNS
+// server, the fallback and the safety net of a group ask them now, for diagnostics of a
+// program that runs the box in its process; ctx carries the services of the box. When the
+// list is due to be read, it reads it first, which runs ubus.
+func ProviderServers(ctx context.Context) []adapter.DNSProviderServer {
+	providers := providersFrom(ctx)
+	providers.list(ctx, nil)
+	return providers.snapshot()
+}
diff --git a/dns/transport_provider_test.go b/dns/transport_provider_test.go
new file mode 100644
index 000000000..20ad17bcb
--- /dev/null
+++ b/dns/transport_provider_test.go
@@ -0,0 +1,215 @@
+package dns
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+
+	mDNS "github.com/miekg/dns"
+	"github.com/stretchr/testify/require"
+)
+
+func providerTestDump(t *testing.T) []netifdInterface {
+	t.Helper()
+	var dump struct {
+		Interface []netifdInterface `json:"interface"`
+	}
+	require.NoError(t, json.Unmarshal([]byte(testUbusDump), &dump))
+	return dump.Interface
+}
+
+// providerTestBox is the context of a box with the provider set given and a network manager
+// (nil: sing-box binds no socket).
+func providerTestBox(providers *providerSet, network adapter.NetworkManager) context.Context {
+	ctx := service.ContextWithDefaultRegistry(context.Background())
+	if network != nil {
+		service.MustRegister[adapter.NetworkManager](ctx, network)
+	}
+	service.MustRegister[*providerSet](ctx, providers)
+	return ctx
+}
+
+func newProviderTest(t *testing.T, ctx context.Context) *ProviderTransport {
+	t.Helper()
+	logger, _ := groupTestLogger(t)
+	transport, err := NewProviderTransport(ctx, logger, "isp", option.ProviderDNSServerOptions{})
+	require.NoError(t, err)
+	return transport.(*ProviderTransport)
+}
+
+func providerTestServers(servers []adapter.DNSProviderServer) string {
+	var names []string
+	for _, server := range servers {
+		name := server.Address.String()
+		if server.Device != "" {
+			name += " on " + server.Device
+		}
+		names = append(names, name)
+	}
+	return strings.Join(names, ", ")
+}
+
+// The servers it asks, from netifd: those of every uplink, each bound to its device, or
+// those of the device sing-box binds its sockets to.
+func TestProviderTransportServers(t *testing.T) {
+	t.Parallel()
+	dump := providerTestDump(t)
+	read := func(ctx context.Context) ([]netifdInterface, error) { return dump, nil }
+
+	ctx := providerTestBox(&providerSet{read: read}, nil)
+	transport := newProviderTest(t, ctx)
+	require.Equal(t, C.DNSTypeProvider, transport.Type())
+	require.Nil(t, fallbackFor(transport), "the provider has a fallback of its own")
+	want := "10.99.0.53:53 on wan0, 10.99.0.54:53 on wan0, 100.64.5.1:53 on wwan0, [fe80::1%wan0]:53 on wan0, [2a00::53]:53 on wan0"
+	require.Equal(t, want, providerTestServers(transport.ProviderServers()))
+	require.Equal(t, want, providerTestServers(ProviderServers(ctx)))
+
+	// boundNetwork has no more of a network manager than the device: no dialer is made of it
+	bound := providerTestBox(&providerSet{read: read}, boundNetwork{device: "wwan0"})
+	require.Equal(t, "100.64.5.1:53", providerTestServers(ProviderServers(bound)))
+}
+
+// It asks the provider's servers as the fallback does: all at once, REFUSED skipped, the one
+// that answered alone next time; the answer is as the server gave it.
+func TestProviderTransportExchange(t *testing.T) {
+	t.Parallel()
+	silent, refused, good := testResolver(t, -1), testResolver(t, mDNS.RcodeRefused), testResolver(t, mDNS.RcodeSuccess)
+	providers := &providerSet{servers: []M.Socksaddr{silent, refused, good}, readAt: time.Now()}
+	transport := newProviderTest(t, providerTestBox(providers, nil))
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	response, err := transport.Exchange(ctx, freshTestQuery())
+	require.NoError(t, err)
+	require.Equal(t, "1.2.3.4", groupTestWho(response, err))
+	require.Equal(t, uint32(300), response.Answer[0].Header().Ttl, "the TTL of a provider server is its own")
+	best, loaded := providers.pick(providers.servers)
+	require.True(t, loaded)
+	require.Equal(t, good, best)
+
+	none := newProviderTest(t, providerTestBox(&providerSet{servers: []M.Socksaddr{silent, refused}, readAt: time.Now()}, nil))
+	ctx, cancel = context.WithTimeout(context.Background(), 500*time.Millisecond)
+	defer cancel()
+	_, err = none.Exchange(ctx, freshTestQuery())
+	require.Error(t, err)
+}
+
+// With no server known it fails at once (a group moves on), and reads the list again
+// providerRetryAfter later, not at every query; a network reset makes it read the list at
+// the next query.
+func TestProviderTransportNoServers(t *testing.T) {
+	t.Parallel()
+	var reads atomic.Int32
+	providers := &providerSet{read: func(ctx context.Context) ([]netifdInterface, error) {
+		reads.Add(1)
+		return nil, nil // no uplink has DNS servers yet
+	}}
+	transport := newProviderTest(t, providerTestBox(providers, nil))
+	exchange := func() error {
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		defer cancel()
+		startAt := time.Now()
+		_, err := transport.Exchange(ctx, freshTestQuery())
+		if time.Since(startAt) > 500*time.Millisecond {
+			t.Errorf("failed after %v", time.Since(startAt))
+		}
+		return err
+	}
+	require.ErrorIs(t, exchange(), errNoProviders)
+	require.ErrorIs(t, exchange(), errNoProviders)
+	require.Equal(t, int32(1), reads.Load(), "the list was read at every query")
+	providers.access.Lock()
+	providers.readAt = time.Now().Add(-providerRetryAfter)
+	providers.access.Unlock()
+	require.ErrorIs(t, exchange(), errNoProviders)
+	require.Equal(t, int32(2), reads.Load(), "the list was not read again")
+	transport.Reset()
+	require.ErrorIs(t, exchange(), errNoProviders)
+	require.Equal(t, int32(3), reads.Load(), "the list was not read again after a network reset")
+}
+
+// A query that finds no server while another one reads the list waits for that read.
+func TestProviderListWait(t *testing.T) {
+	t.Parallel()
+	dump := providerTestDump(t)
+	reading, release := make(chan struct{}), make(chan struct{})
+	providers := &providerSet{read: func(ctx context.Context) ([]netifdInterface, error) {
+		close(reading)
+		<-release
+		return dump, nil
+	}}
+	go providers.list(context.Background(), nil)
+	<-reading
+	got := make(chan []M.Socksaddr)
+	go func() {
+		got <- providers.listWait(context.Background(), context.Background(), nil)
+	}()
+	select {
+	case servers := <-got:
+		t.Fatalf("returned %v while the list was read", servers)
+	case <-time.After(50 * time.Millisecond):
+	}
+	close(release)
+	require.Equal(t, "10.99.0.53, 10.99.0.54, 100.64.5.1, fe80::1%wan0, 2a00::53", joinServers(<-got))
+
+	// the caller gives up while it waits
+	stuck := &providerSet{read: func(ctx context.Context) ([]netifdInterface, error) {
+		<-ctx.Done() // never: the read has its own context
+		return nil, E.New("unreachable")
+	}}
+	stuck.access.Lock()
+	stuck.reading, stuck.readDone = true, make(chan struct{})
+	stuck.access.Unlock()
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	require.Nil(t, stuck.listWait(ctx, context.Background(), nil))
+}
+
+// A server of an uplink is asked through the dialer bound to the device of that uplink.
+func TestProviderTransportThroughUplink(t *testing.T) {
+	t.Parallel()
+	ofUplink, ofSystem := testResolver(t, mDNS.RcodeSuccess), testResolver(t, -1)
+	own, bound := &recordingDialer{Dialer: N.SystemDialer}, &recordingDialer{Dialer: N.SystemDialer}
+	providers := &providerSet{
+		servers: []M.Socksaddr{ofUplink, ofSystem},
+		devices: map[M.Socksaddr]string{ofUplink: "wan9"},
+		readAt:  time.Now(),
+	}
+	transport := newProviderTest(t, providerTestBox(providers, nil))
+	transport.asker.dialer = own
+	transport.asker.bound = map[string]N.Dialer{"wan9": bound}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	response, err := transport.Exchange(ctx, freshTestQuery())
+	require.Equal(t, "1.2.3.4", groupTestWho(response, err))
+	require.Equal(t, []string{ofUplink.String()}, bound.told())
+	require.Equal(t, []string{ofSystem.String()}, own.told())
+}
+
+// A provider server as the last member of a group: it answers when the others fail, with
+// its own TTL, and there is no safety net besides it.
+func TestProviderTransportInGroup(t *testing.T) {
+	t.Parallel()
+	ctx := providerTestBox(&providerSet{servers: []M.Socksaddr{testResolver(t, mDNS.RcodeSuccess)}, readAt: time.Now()}, nil)
+	provider := newProviderTest(t, ctx)
+	dead := newGroupTestMember("dead", fallbackTestFails)
+	group, _ := newGroupTest(t, ctx, C.DNSGroupStrategyOrder, true, dead, provider)
+	require.False(t, group.GroupState().SafetyNet)
+	queryCtx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	response, err := group.Exchange(queryCtx, freshTestQuery())
+	require.Equal(t, "1.2.3.4", groupTestWho(response, err))
+	require.Equal(t, uint32(300), response.Answer[0].Header().Ttl)
+	require.Equal(t, C.DNSTypeProvider, group.testMember("isp").Type)
+	require.Equal(t, uint64(1), group.testMember("isp").Answers)
+}
