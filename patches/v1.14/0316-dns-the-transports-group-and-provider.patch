+		"fake":   member("fake", C.DNSTypeFakeIP),
+		"hosts":  member("hosts", C.DNSTypeHosts),
+		"isp":    member("isp", C.DNSTypeProvider),
+		"local":  member("local", C.DNSTypeLocal),
+		"tunnel": member("tunnel", C.DNSTypeHTTPS),
+	}
+	for _, test := range []struct {
+		servers []string
