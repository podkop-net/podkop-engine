diff --git a/route/rule/match_line.go b/route/rule/match_line.go
new file mode 100644
index 000000000..b47212e31
--- /dev/null
+++ b/route/rule/match_line.go
@@ -0,0 +1,22 @@
+package rule
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	F "github.com/sagernet/sing/common/format"
+)
+
+// MatchLine is the debug line of a matched rule, built only when a logger formats it: the
+// description of a rule is a long string, and the connection and query paths must not pay
+// for it at a level that drops the line.
+type MatchLine struct {
+	Prefix string
+	Index  int
+	Rule   adapter.Rule
+}
+
+func (l MatchLine) String() string {
+	if ruleDescription := l.Rule.String(); ruleDescription != "" {
+		return F.ToString(l.Prefix, "[", l.Index, "] ", ruleDescription, " => ", l.Rule.Action())
+	}
+	return F.ToString(l.Prefix, "[", l.Index, "] => ", l.Rule.Action())
+}
diff --git a/route/rule/match_line_test.go b/route/rule/match_line_test.go
new file mode 100644
index 000000000..5f743bff1
--- /dev/null
+++ b/route/rule/match_line_test.go
@@ -0,0 +1,38 @@
+package rule
+
+import (
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	F "github.com/sagernet/sing/common/format"
+)
+
+type matchLineRule struct {
+	adapter.Rule
+	description string
+	described   *int
+}
+
+func (r matchLineRule) String() string {
+	*r.described++
+	return r.description
+}
+
+func (r matchLineRule) Action() adapter.RuleAction {
+	return &RuleActionReject{Method: "default"}
+}
+
+func TestMatchLine(t *testing.T) {
+	t.Parallel()
+	var described int
+	line := MatchLine{"match", 3, matchLineRule{description: "domain_suffix=example.org", described: &described}}
+	if described != 0 {
+		t.Fatalf("the rule was described before the line was formatted")
+	}
+	if got, want := F.ToString(line), "match[3] domain_suffix=example.org => reject"; got != want {
+		t.Fatalf("line %q, want %q", got, want)
+	}
+	if got, want := F.ToString(MatchLine{"pre-match", 0, matchLineRule{described: &described}}), "pre-match[0] => reject"; got != want {
+		t.Fatalf("line %q, want %q", got, want)
+	}
+}
