-		if prefix, isPrefix := parsePrefix(item); isPrefix {
-			text := prefix.String()
-			if !seenPrefixes[text] {
-				seenPrefixes[text] = true
-				prefixes = append(prefixes, text)
+		if mayBeAddress(item) {
+			if prefix, isPrefix := parsePrefix(string(item)); isPrefix {
