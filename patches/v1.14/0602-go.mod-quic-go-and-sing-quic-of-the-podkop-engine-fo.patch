From bef4229d2001d99ca482882ea881959a3a8d06b3 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sat, 28 Nov 2026 17:26:12 +0300
Subject: [PATCH 66/71] go.mod: quic-go and sing-quic of the podkop-engine
 forks, the statistics of a QUIC connection

The loss of a member over QUIC is counted by the packets of its QUIC connection.
podkop-net/quic-go v0.61.0-sing-box-mod.12-pdk.2 is pdk.1 and the count of the peer's 1-RTT
packets that came and of the packet numbers that did not (ConnectionStats).
podkop-net/sing-quic v0.7.2-pdk.1 is upstream 7e0a5869a5f4, the version sing-box 1.14.4 takes,
and the statistics of the current QUIC connection of the hysteria2 and tuic clients
(Client.ConnectionStats).

Pdk-Feature: quic-stats
Pdk-Zone: build
Pdk-Layer: 06

# Conflicts:
#	go.mod
#	go.sum
---
 go.mod | 5 ++++-
 go.sum | 7 ++-----
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/go.mod b/go.mod
index ea3b2e7c3..52f3e91a0 100644
--- a/go.mod
+++ b/go.mod
@@ -202,5 +202,8 @@ require (
 replace github.com/sagernet/sing-vmess => github.com/FiyeroT/sing-vmess v0.2.9-pdk.3
 
 // Chrome's QUIC ClientHello in the order of the CPU: ChaCha20 first without AES hardware, as Chrome
-// does
+// does; the count of the peer's packets of a connection (ConnectionStats)
 replace github.com/sagernet/quic-go => github.com/podkop-net/quic-go v0.61.0-sing-box-mod.15-pdk.1
+
+// the statistics of the current QUIC connection of a hysteria2 or tuic client
+replace github.com/sagernet/sing-quic => github.com/podkop-net/sing-quic v0.7.2-pdk.2
