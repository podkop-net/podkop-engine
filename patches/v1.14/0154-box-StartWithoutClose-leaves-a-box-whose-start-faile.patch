From ae09bd696dff3abca3c7dc47abf6caa2e2338057 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Sat, 24 Oct 2026 09:41:46 +0300
Subject: [PATCH 154/155] box: StartWithoutClose leaves a box whose start
 failed to its caller

Start closes a box whose start failed at once, so a component whose Close
does not return holds Start with it. StartWithoutClose returns the error
and leaves the box as it is: the caller closes it with a bound of its own
(the Go backend of podkop ends its process when the close does not come).
---
 box.go | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/box.go b/box.go
index fb97c52fd..9599243ca 100644
--- a/box.go
+++ b/box.go
@@ -503,9 +503,19 @@ func (s *Box) PreStart() error {
 }
 
 func (s *Box) Start() error {
-	err := s.start()
+	err := s.StartWithoutClose()
 	if err != nil {
 		s.Close()
+	}
+	return err
+}
+
+// StartWithoutClose is Start that leaves a box whose start failed as it is: the caller
+// closes it, and may bound how long that takes (podkop-engine). Start closes it at once,
+// and a component whose Close does not return holds Start with it.
+func (s *Box) StartWithoutClose() error {
+	err := s.start()
+	if err != nil {
 		return err
 	}
 	s.logger.Info("sing-box started (", F.Seconds(time.Since(s.createdAt).Seconds()), "s)")
-- 
