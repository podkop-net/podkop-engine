From dccf771ca03c3fe5dd3ae490b32a601862d61b6d Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 19 Oct 2026 21:12:53 +0300
Subject: [PATCH 144/148] dns/https: compare the starts of queries by the
 monotonic clock

The latest start among the answered queries was kept as unix nanoseconds,
by the wall clock, and only grew: after the clock was set back, every new
query started "before" it, and a timeout no longer reset a stuck
connection until the wall clock caught up. It is kept as nanoseconds since
the transport was made now, which time.Sub reads from the monotonic clock.
---
 dns/transport/https.go | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/dns/transport/https.go b/dns/transport/https.go
index 840a05ae1..2425c2004 100644
--- a/dns/transport/https.go
+++ b/dns/transport/https.go
@@ -55,7 +55,10 @@ type HTTPSTransport struct {
 	transportAccess  sync.Mutex
 	transport        *HTTPSTransportWrapper
 	transportResetAt time.Time
-	answeredStartAt  atomic.Int64 // unix nanoseconds: the latest start among the answered exchanges
+	// answeredStartAt is the latest start among the answered exchanges, in nanoseconds since
+	// createdAt: time.Sub reads the monotonic clock, which a clock set back does not move
+	answeredStartAt atomic.Int64
+	createdAt       time.Time
 }
 
 func NewHTTPS(ctx context.Context, logger log.ContextLogger, tag string, options option.RemoteHTTPSDNSServerOptions) (adapter.DNSTransport, error) {
@@ -138,6 +141,7 @@ func NewHTTPSRaw(
 	}
 	transport := &HTTPSTransport{
 		TransportAdapter: adapter,
+		createdAt:        time.Now(),
 		logger:           logger,
 		dialer:           dialer,
 		destination:      destination,
@@ -212,7 +216,7 @@ func (t *HTTPSTransport) Exchange(ctx context.Context, message *mDNS.Msg) (*mDNS
 			// A query that began after this one was answered: the connection is alive
 			// and the timeout is about this query alone (a slow upstream for one name).
 			// A reset would close the connection with every query in flight on it.
-			if t.answeredStartAt.Load() > startAt.UnixNano() {
+			if t.answeredStartAt.Load() > t.sinceCreated(startAt) {
 				return nil, err
 			}
 			t.transportAccess.Lock()
@@ -224,7 +228,7 @@ func (t *HTTPSTransport) Exchange(ctx context.Context, message *mDNS.Msg) (*mDNS
 		}
 		return nil, err
 	}
-	for started := startAt.UnixNano(); ; {
+	for started := t.sinceCreated(startAt); ; {
 		latest := t.answeredStartAt.Load()
 		if started <= latest || t.answeredStartAt.CompareAndSwap(latest, started) {
 			break
@@ -233,6 +237,12 @@ func (t *HTTPSTransport) Exchange(ctx context.Context, message *mDNS.Msg) (*mDNS
 	return response, nil
 }
 
+// sinceCreated is a time of this transport as nanoseconds since it was made, by the
+// monotonic clock.
+func (t *HTTPSTransport) sinceCreated(at time.Time) int64 {
+	return int64(at.Sub(t.createdAt))
+}
+
 func (t *HTTPSTransport) ExchangeAsync(ctx context.Context, message *mDNS.Msg, callback func(response *mDNS.Msg, err error)) {
 	go func() {
 		callback(t.Exchange(ctx, message))
-- 
