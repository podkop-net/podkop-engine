 dns/client_ipv6.go      |  47 +++++++++
 dns/client_ipv6_test.go | 206 ++++++++++++++++++++++++++++++++++++++++
 dns/router.go           |  11 ++-
 option/dns.go           |   4 +
 5 files changed, 292 insertions(+), 2 deletions(-)
 create mode 100644 dns/client_ipv6.go
 create mode 100644 dns/client_ipv6_test.go

