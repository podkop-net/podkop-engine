+func TestUnusedRecordsAreRemoved(t *testing.T) {
+	t.Parallel()
+	for _, storage := range []*fakeStorage{nil, newFakeStorage()} {
+		store := newTestStore(t, storage, "198.18.0.0/15", "")
+		queried := mustCreate(t, store, "queried.test")
