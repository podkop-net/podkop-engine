+func mustCreate(t *testing.T, store *TableStore, domain string) netip.Addr {
+	t.Helper()
+	address, err := store.Create(domain, false)
+	require.NoError(t, err)
+	return address
+}
+
+func address(text string) netip.Addr {
+	return netip.MustParseAddr(text)
+}
