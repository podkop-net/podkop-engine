From 317bc0304e4de7944099e6ecdb3ae8ed10360659 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Fri, 30 Oct 2026 20:56:05 +0300
Subject: [PATCH 179/182] clashapi: the fallbacks of a URL test are told apart

"all" of a URL test lists its outbounds, then its fallbacks, and a delay test
of the group answers only the outbounds that answered. A client could not tell
a server that did not answer from a fallback that was not tested. The proxies
of the API now carry "fallbacks", the end of "all".
---
 experimental/clashapi/proxies.go   | 4 ++++
 protocol/group/urltest.go          | 5 +++++
 protocol/group/urltest_r20_test.go | 4 ++++
 3 files changed, 13 insertions(+)

diff --git a/experimental/clashapi/proxies.go b/experimental/clashapi/proxies.go
index fd8a6e23d..b953ba77b 100644
--- a/experimental/clashapi/proxies.go
+++ b/experimental/clashapi/proxies.go
@@ -83,6 +83,10 @@ func proxyInfo(server *Server, detour adapter.Outbound) *badjson.JSONObject {
 		}
 		info.Put("now", now)
 		info.Put("all", group.All())
+		// the end of "all" that a delay test of the group leaves out (podkop-engine)
+		if withFallbacks, isURLTest := detour.(interface{ Fallbacks() []string }); isURLTest && len(withFallbacks.Fallbacks()) > 0 {
+			info.Put("fallbacks", withFallbacks.Fallbacks())
+		}
 	}
 	return &info
 }
diff --git a/protocol/group/urltest.go b/protocol/group/urltest.go
index d8bffcf4a..f032458f2 100644
--- a/protocol/group/urltest.go
+++ b/protocol/group/urltest.go
@@ -154,6 +154,11 @@ func (s *URLTest) All() []string {
 	return s.all
 }
 
+// Fallbacks lists the fallbacks, the end of All (podkop-engine): what is tested is the rest.
+func (s *URLTest) Fallbacks() []string {
+	return s.fallbackTags
+}
+
 func (s *URLTest) Selected(network string) adapter.Outbound {
 	var outbound adapter.Outbound
 	if network == N.NetworkUDP {
diff --git a/protocol/group/urltest_r20_test.go b/protocol/group/urltest_r20_test.go
index 61d2f53ac..4750d3f0d 100644
--- a/protocol/group/urltest_r20_test.go
+++ b/protocol/group/urltest_r20_test.go
@@ -30,6 +30,10 @@ func TestURLTestOfFallbacksOnly(t *testing.T) {
 	require.NoError(t, err)
 	_, err = NewURLTest(ctx, nil, log.NewNOPFactory().NewLogger("urltest"), "t", option.URLTestOutboundOptions{})
 	require.ErrorContains(t, err, "missing tags")
+	both, err := NewURLTest(ctx, nil, log.NewNOPFactory().NewLogger("urltest"), "t", option.URLTestOutboundOptions{Outbounds: []string{"a"}, Fallbacks: []string{"f1"}})
+	require.NoError(t, err)
+	require.Equal(t, []string{"a", "f1"}, both.(*URLTest).All())
+	require.Equal(t, []string{"f1"}, both.(*URLTest).Fallbacks())
 
 	f1, f2 := newTestMember(C.TypeSOCKS, "f1", dialRefused), newTestMember(C.TypeSOCKS, "f2", dialRefused)
 	_, group := newTestFallbackGroup(t, "", "", nil, members(f1, f2), map[string]uint16{"f2": 100})
