From 64e6aa66b221508e3d4103fc06dc2277bd9b4369 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Fri, 6 Nov 2026 08:59:44 +0300
Subject: [PATCH 187/193] urltest: the balance is logged as text; the tests of
 the modes log for real

The logger panics on a list of strings (format.ToString), which a test
logger of no output never formats: the stand engine panicked at the first
balance. The tests of the modes now log through a real logger at debug.
---
 protocol/group/urltest_balance.go   |  3 ++-
 protocol/group/urltest_loss_test.go | 13 +++++++++++++
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/protocol/group/urltest_balance.go b/protocol/group/urltest_balance.go
index e79c5ed49..a8e159e44 100644
--- a/protocol/group/urltest_balance.go
+++ b/protocol/group/urltest_balance.go
@@ -4,6 +4,7 @@ import (
 	"context"
 	"hash/fnv"
 	"slices"
+	"strings"
 	"sync"
 	"time"
 
@@ -87,7 +88,7 @@ func (g *URLTestGroup) updateBalance() {
 		for i, member := range tcp {
 			tags[i] = member.Tag()
 		}
-		g.logger.Info("balance over ", len(tags), " outbounds: ", tags)
+		g.logger.Info("balance over ", len(tags), " outbounds: ", strings.Join(tags, ", "))
 	}
 }
 
diff --git a/protocol/group/urltest_loss_test.go b/protocol/group/urltest_loss_test.go
index 5fff7c273..e5c01d746 100644
--- a/protocol/group/urltest_loss_test.go
+++ b/protocol/group/urltest_loss_test.go
@@ -3,6 +3,7 @@ package group
 import (
 	"context"
 	"fmt"
+	"io"
 	"net"
 	"net/http"
 	"net/http/httptest"
@@ -14,6 +15,7 @@ import (
 	"github.com/sagernet/sing-box/common/probesock"
 	"github.com/sagernet/sing-box/common/urltest"
 	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
 	M "github.com/sagernet/sing/common/metadata"
 	N "github.com/sagernet/sing/common/network"
 
@@ -59,8 +61,19 @@ func storeLoss(group *URLTestGroup, tag string, segments, lost int, rtt time.Dur
 	group.history.StoreLossSample(tag, urltest.LossSample{At: time.Now(), Received: urltest.LossProbeLarge, Segments: segments, Lost: lost, RTT: rtt})
 }
 
+// formattingLogger is a real logger at the debug level: it panics on argument types it does
+// not format, which the logger of no output never does.
+func formattingLogger(t *testing.T) log.ContextLogger {
+	factory := log.NewDefaultFactory(context.Background(), log.Formatter{BaseTime: time.Now(), DisableColors: true}, io.Discard, "", nil, false)
+	factory.SetLevel(log.LevelDebug)
+	require.NoError(t, factory.Start())
+	t.Cleanup(func() { factory.Close() })
+	return factory.NewLogger("outbound/urltest[test]")
+}
+
 func newModeGroup(t *testing.T, mode string, outbounds []adapter.Outbound, delays map[string]uint16, prepare func(group *URLTestGroup)) (*URLTest, *URLTestGroup) {
 	urlTest, group := newTestFallbackGroup(t, "", "", outbounds, nil, nil)
+	group.logger = formattingLogger(t)
 	var err error
 	group.mode, group.loss, err = groupMode(mode, "http://127.0.0.1:1/loss", 0, 0, 0, 0)
 	require.NoError(t, err)
