+// wouldLoopToInbound reports whether dialing selectedOutbound would send the connection
+// back to the listen address of the inbound it arrived on. A direct inbound without an
+// override hands out its own address as the destination, expecting a rule to hijack it;
+// when nothing does, the connection falls to the direct outbound, which dials that address,
+// and the packet returns to the same inbound as a new session, round after round. Only the
+// direct outbound dials the raw destination, and only a return to the SAME inbound is a
+// loop: a connection chained to a different local inbound (a urltest member pointed at a
+// mixed inbound) goes through a proxy outbound to another inbound and is left alone.
+//
+// selectedOutbound is the outbound the connection is dialed through: the last of the chain
+// the router resolved, a group's selected member.
+func (r *Router) wouldLoopToInbound(metadata *adapter.InboundContext, selectedOutbound adapter.Outbound) bool {
+	if metadata.Inbound == "" {
+		return false
+	}
+	if selectedOutbound.Type() != C.TypeDirect {
+		return false
+	}
+	inbound, loaded := r.inbound.Get(metadata.Inbound)
+	if !loaded {
+		return false
+	}
+	listenInbound, isListen := inbound.(adapter.InboundListenAddress)
+	if !isListen {
+		return false
+	}
+	listen := listenInbound.ListenAddress()
+	if !listen.Addr.IsValid() || metadata.Destination.Port != listen.Port {
+		return false
+	}
+	if listen.Addr.IsUnspecified() {
+		// a listener on every address is reached at any of them: a connection accepted on
+		// it carries the one it came in on as its original destination
+		return metadata.Destination.Addr == listen.Addr || (metadata.OriginDestination.Addr.IsValid() && metadata.Destination.Addr == metadata.OriginDestination.Addr)
+	}
+	return metadata.Destination.Addr == listen.Addr
+}
+
 func (r *Router) matchRule(
 	ctx context.Context, metadata *adapter.InboundContext,
 	inputConn net.Conn, inputPacketConn N.PacketConn,
diff --git a/route/route_loop_log.go b/route/route_loop_log.go
new file mode 100644
index 000000000..9a78a78fb
--- /dev/null
+++ b/route/route_loop_log.go
@@ -0,0 +1,71 @@
+package route
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/log"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// inboundLoopError refuses a connection the direct outbound would dial back to the inbound
+// it came in on, see wouldLoopToInbound.
+type inboundLoopError struct {
+	inbound string
+	error
+}
+
+func (e *inboundLoopError) Unwrap() error {
+	return e.error
+}
+
+// Such refusals are logged here, by inbound. What reaches the listen address of an inbound
+// without being hijacked usually keeps coming, and every datagram is a session of its own:
+// the first refusal is logged at once, and while they go on, one line every
+// loopRefusalLogInterval counts the refusals in between and shows the last one.
+var loopRefusalLogInterval = 10 * time.Second
+
+type loopRefusalLog struct {
+	access  sync.Mutex
+	windows map[string]*loopRefusalWindow
+}
+
+type loopRefusalWindow struct {
+	count int
+	last  error
+}
+
+func (l *loopRefusalLog) refused(ctx context.Context, logger log.ContextLogger, refusal *inboundLoopError) {
+	inbound := refusal.inbound
+	l.access.Lock()
+	if l.windows == nil {
+		l.windows = make(map[string]*loopRefusalWindow)
+	}
+	window, open := l.windows[inbound]
+	if open {
+		window.count++
+		window.last = refusal
+		l.access.Unlock()
+		return
+	}
+	l.windows[inbound] = &loopRefusalWindow{}
+	l.access.Unlock()
+	logger.ErrorContext(ctx, refusal)
+	time.AfterFunc(loopRefusalLogInterval, func() { l.flush(logger, inbound) })
+}
+
+func (l *loopRefusalLog) flush(logger log.ContextLogger, inbound string) {
+	l.access.Lock()
+	window := l.windows[inbound]
+	if window.count == 0 {
+		delete(l.windows, inbound)
+		l.access.Unlock()
+		return
+	}
+	count, last := window.count, window.last
+	window.count = 0
+	l.access.Unlock()
+	logger.Error(E.Cause(last, "inbound ", inbound, ": ", count, " more refused in ", loopRefusalLogInterval, ", the last"))
+	time.AfterFunc(loopRefusalLogInterval, func() { l.flush(logger, inbound) })
+}
diff --git a/route/route_loop_test.go b/route/route_loop_test.go
new file mode 100644
index 000000000..55f450bea
--- /dev/null
+++ b/route/route_loop_test.go
@@ -0,0 +1,146 @@
+package route
+
+import (
+	"io"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+type fakeOutbound struct {
+	adapter.Outbound
+	typ string
+}
+
+func (o fakeOutbound) Type() string { return o.typ }
+func (o fakeOutbound) Tag() string  { return o.typ }
+func (o fakeOutbound) Network() []string {
+	return []string{N.NetworkTCP, N.NetworkUDP}
+}
+
+type fakeListenInbound struct {
+	adapter.Inbound
+	addr M.Socksaddr
+}
+
+func (i fakeListenInbound) ListenAddress() M.Socksaddr { return i.addr }
+
+type fakeGroup struct {
+	fakeOutbound
+	member adapter.Outbound
+}
+
+func (g fakeGroup) All() []string                              { return nil }
+func (g fakeGroup) Selected(string) adapter.Outbound           { return g.member }
+func (g fakeGroup) AttachConnection(io.Closer) (detach func()) { return func() {} }
+
+type fakeOutboundManager struct {
+	adapter.OutboundManager
+	outbounds map[string]adapter.Outbound
+}
+
+func (m fakeOutboundManager) Outbound(tag string) (adapter.Outbound, bool) {
+	out, ok := m.outbounds[tag]
+	return out, ok
+}
+
+type fakeInboundManager struct {
+	adapter.InboundManager
+	inbounds map[string]adapter.Inbound
+}
+
+func (m fakeInboundManager) Get(tag string) (adapter.Inbound, bool) {
+	in, ok := m.inbounds[tag]
+	return in, ok
+}
+
+// The loop guard must fire exactly on a connection a direct outbound would dial back to the
+// same inbound it arrived on, and never on legitimate chaining to another local inbound.
+func TestWouldLoopToInbound(t *testing.T) {
+	t.Parallel()
+	dnsIn := M.ParseSocksaddr("127.0.0.42:53")
+	tproxyIn := M.ParseSocksaddr("127.0.0.1:1602")
+	mixedIn := M.ParseSocksaddr("127.0.0.1:17001")
+	r := &Router{inbound: fakeInboundManager{inbounds: map[string]adapter.Inbound{
+		"dns-in":    fakeListenInbound{addr: dnsIn},
+		"tproxy-in": fakeListenInbound{addr: tproxyIn},
+		"mixed-in":  fakeListenInbound{addr: mixedIn},
+	}}}
+	direct := fakeOutbound{typ: C.TypeDirect}
+	socks := fakeOutbound{typ: C.TypeSOCKS}
+	mk := func(inbound string, dest M.Socksaddr) *adapter.InboundContext {
+		return &adapter.InboundContext{Inbound: inbound, Destination: dest}
+	}
+
+	// the loop: a datagram on dns-in that was not hijacked is dialled by the direct outbound
+	// back to dns-in's own address
+	require.True(t, r.wouldLoopToInbound(mk("dns-in", dnsIn), direct))
+
+	// legitimate chaining: a connection on tproxy-in routed through a urltest/selector to a
+	// socks outbound that points at a local mixed inbound. The outbound is socks, not direct.
+	require.False(t, r.wouldLoopToInbound(mk("tproxy-in", mixedIn), socks))
+
+	// even a direct outbound to a DIFFERENT inbound's address is left alone
+	require.False(t, r.wouldLoopToInbound(mk("tproxy-in", dnsIn), direct))
+
+	// a direct outbound to the same inbound but a different port is not the loop
+	require.False(t, r.wouldLoopToInbound(mk("dns-in", M.ParseSocksaddr("127.0.0.42:80")), direct))
+
+	// a socks outbound to the same inbound address is allowed: only the direct outbound dials
+	// the raw destination that forms the loop
+	require.False(t, r.wouldLoopToInbound(mk("dns-in", dnsIn), socks))
+
+	// an unknown inbound tag (no listener) is not treated as a loop
+	require.False(t, r.wouldLoopToInbound(mk("gone", dnsIn), direct))
+}
+
+// A group dials through its selected member, which the router resolves before the check
+// (the last outbound of the chain): a selector or urltest whose current member is the direct
+// outbound forms the same loop; one whose member is a proxy does not.
+func TestWouldLoopToInboundThroughGroup(t *testing.T) {
+	t.Parallel()
+	dnsIn := M.ParseSocksaddr("127.0.0.42:53")
+	direct := fakeOutbound{typ: C.TypeDirect}
+	socks := fakeOutbound{typ: C.TypeSOCKS}
+	r := &Router{
+		inbound:  fakeInboundManager{inbounds: map[string]adapter.Inbound{"dns-in": fakeListenInbound{addr: dnsIn}}},
+		outbound: fakeOutboundManager{outbounds: map[string]adapter.Outbound{"direct": direct, "socks": socks}},
+	}
+	metadata := &adapter.InboundContext{Inbound: "dns-in", Destination: dnsIn}
+	last := func(outbound adapter.Outbound) adapter.Outbound {
+		chain, err := resolveOutbound(outbound, N.NetworkTCP)
+		require.NoError(t, err)
+		return chain[len(chain)-1]
+	}
+	require.True(t, r.wouldLoopToInbound(metadata, last(fakeGroup{fakeOutbound{typ: C.TypeURLTest}, direct})))
+	require.True(t, r.wouldLoopToInbound(metadata, last(fakeGroup{fakeOutbound{typ: C.TypeSelector}, fakeGroup{fakeOutbound{typ: C.TypeSelector}, direct}})), "a group inside a group")
+	require.False(t, r.wouldLoopToInbound(metadata, last(fakeGroup{fakeOutbound{typ: C.TypeURLTest}, socks})))
+	_, err := resolveOutbound(fakeGroup{fakeOutbound{typ: C.TypeURLTest}, nil}, N.NetworkTCP)
+	require.Error(t, err, "a group without a member is refused before the check")
+}
+
+// A listener on every address (0.0.0.0, ::) is reached at whichever address the connection
+// came in on: that address, with the listen port, is the loop; another port, or another
+// host's address, is not.
+func TestWouldLoopToInboundWildcard(t *testing.T) {
+	t.Parallel()
+	direct := fakeOutbound{typ: C.TypeDirect}
+	r := &Router{inbound: fakeInboundManager{inbounds: map[string]adapter.Inbound{
+		"any4": fakeListenInbound{addr: M.ParseSocksaddr("0.0.0.0:53")},
+		"any6": fakeListenInbound{addr: M.ParseSocksaddr("[::]:53")},
+	}}}
+	accepted := M.ParseSocksaddr("192.168.1.1:53")
+	// TCP: the destination is the original one, the address the connection was accepted on
+	require.True(t, r.wouldLoopToInbound(&adapter.InboundContext{Inbound: "any4", Destination: accepted, OriginDestination: accepted}, direct))
+	require.True(t, r.wouldLoopToInbound(&adapter.InboundContext{Inbound: "any6", Destination: accepted, OriginDestination: accepted}, direct))
+	// UDP: the destination is the bind address itself
+	require.True(t, r.wouldLoopToInbound(&adapter.InboundContext{Inbound: "any4", Destination: M.ParseSocksaddr("0.0.0.0:53")}, direct))
+	// an override to another host, or to another port, is no loop
+	require.False(t, r.wouldLoopToInbound(&adapter.InboundContext{Inbound: "any4", Destination: M.ParseSocksaddr("8.8.8.8:53"), OriginDestination: accepted}, direct))
+	require.False(t, r.wouldLoopToInbound(&adapter.InboundContext{Inbound: "any4", Destination: M.ParseSocksaddr("192.168.1.1:5353"), OriginDestination: accepted}, direct))
+}
