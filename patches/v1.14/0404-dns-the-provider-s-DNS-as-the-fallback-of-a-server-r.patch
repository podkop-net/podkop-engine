+package dns
+
+import (
+	"context"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	mDNS "github.com/miekg/dns"
+)
+
+// fallbackTestTransport is a DNS server with the fallback state whose exchanges are
+// answered by a function of the test.
+type fallbackTestTransport struct {
+	TransportAdapter
+	access  sync.Mutex
+	handler func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error)
+	calls   int
+}
+
+func (t *fallbackTestTransport) Start(adapter.StartStage, *adapter.Scope) error { return nil }
+func (t *fallbackTestTransport) Reset()                                         {}
+
+func (t *fallbackTestTransport) Exchange(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+	t.access.Lock()
+	t.calls++
+	handler := t.handler
+	t.access.Unlock()
+	return handler(ctx, message)
+}
+
+func (t *fallbackTestTransport) ExchangeAsync(ctx context.Context, message *mDNS.Msg, callback func(response *mDNS.Msg, err error)) {
+	go func() {
+		callback(t.Exchange(ctx, message))
+	}()
+}
+
+func (t *fallbackTestTransport) serve(handler func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error)) {
+	t.access.Lock()
+	t.handler = handler
+	t.access.Unlock()
+}
+
+func (t *fallbackTestTransport) asked() int {
+	t.access.Lock()
+	defer t.access.Unlock()
+	return t.calls
+}
+
+var errFallbackTestServer = E.New("connection reset")
+
+// The server of the tests answers 5.6.7.8, the provider (testResolver) 1.2.3.4.
+func fallbackTestAnswers(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+	response := new(mDNS.Msg)
+	response.SetReply(message)
+	response.Answer = []mDNS.RR{&mDNS.A{Hdr: mDNS.RR_Header{Name: message.Question[0].Name, Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 300}, A: net.IPv4(5, 6, 7, 8)}}
+	return response, nil
+}
+
+func fallbackTestFails(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+	return nil, errFallbackTestServer
+}
+
+func fallbackTestServfail(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+	response := new(mDNS.Msg)
+	response.SetRcode(message, mDNS.RcodeServerFailure)
+	return response, nil
+}
+
+// newFallbackTest returns a server that qualifies for the fallback, with the decision
+// taken and the provider's servers known, so that ubus is never asked: a read of the
+// list fails and is counted.
+func newFallbackTest(providers ...M.Socksaddr) (*fallbackTestTransport, *fallbackServer, *atomic.Int32) {
+	reads := new(atomic.Int32)
+	state := &fallbackServer{
+		options:  option.RemoteDNSServerOptions{DNSServerAddressOptions: option.DNSServerAddressOptions{Server: "77.88.8.8"}},
+		eligible: true,
+		dialer:   N.SystemDialer,
+		providers: &providerSet{
+			read: func(ctx context.Context) ([]netifdInterface, error) {
+				reads.Add(1)
+				return nil, E.New("no ubus in tests")
+			},
+			servers: providers,
+			readAt:  time.Now(),
+		},
+	}
+	state.decideOnce.Do(func() { state.decided.Store(true) })
+	transport := &fallbackTestTransport{
+		TransportAdapter: TransportAdapter{transportType: "test", transportTag: "dns-server", fallback: state},
+		handler:          fallbackTestAnswers,
+	}
+	return transport, state, reads
+}
+
+func fallbackTestExchange(transport *fallbackTestTransport, state *fallbackServer) (string, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	return fallbackTestAnswer(exchangeWithFallback(ctx, context.Background(), nil, transport, state, freshTestQuery()))
+}
+
+// fallbackTestAnswer names who answered: "server" or "provider" with the TTL, else the
+// rcode.
+func fallbackTestAnswer(response *mDNS.Msg, err error) (string, error) {
+	if err != nil {
+		return "", err
+	}
+	if response.Rcode != mDNS.RcodeSuccess || len(response.Answer) != 1 {
+		return mDNS.RcodeToString[response.Rcode], nil
+	}
+	record := response.Answer[0].(*mDNS.A)
+	switch {
+	case record.A.Equal(net.IPv4(5, 6, 7, 8)) && record.Hdr.Ttl == 300:
+		return "server", nil
+	case record.A.Equal(net.IPv4(1, 2, 3, 4)) && record.Hdr.Ttl == fallbackMaxTTL:
+		return "provider", nil
+	}
+	return record.String(), nil
+}
+
+type fallbackTestState struct {
+	failures      int
+	providerFails int
+	down          bool
+	unusable      bool
+	probeIn       time.Duration
+	probeEvery    time.Duration
+}
+
+func (s *fallbackServer) testState() fallbackTestState {
+	s.access.Lock()
+	defer s.access.Unlock()
+	now := time.Now()
+	return fallbackTestState{s.failures, s.providerFails, s.down, now.Before(s.unusableUntil), s.probeAt.Sub(now), s.probeEvery}
+}
+
+func waitFallbackTest(t *testing.T, what string, condition func() bool) {
+	t.Helper()
+	for deadline := time.Now().Add(5 * time.Second); !condition(); time.Sleep(5 * time.Millisecond) {
+		if time.Now().After(deadline) {
+			t.Fatalf("timeout waiting until %s", what)
+		}
+	}
+}
+
+// The decisions of exchangeWithFallback: who answers a query and what it does to the
+// state of the server.
+func TestExchangeWithFallback(t *testing.T) {
+	t.Parallel()
+	expect := func(t *testing.T, transport *fallbackTestTransport, state *fallbackServer, want string, wantErr error) {
+		t.Helper()
+		got, err := fallbackTestExchange(transport, state)
+		if got != want || err != wantErr {
+			t.Fatalf("answered by %q (%v), want %q (%v)", got, err, want, wantErr)
+		}
+	}
+	for _, test := range []struct {
+		name string
+		run  func(t *testing.T)
+	}{
+		{"a server that answers is asked alone", func(t *testing.T) {
+			transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+			expect(t, transport, state, "server", nil)
+			transport.serve(func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+				return nil, RcodeNameError
+			})
+			expect(t, transport, state, "", RcodeNameError)
+			if got := state.testState(); got.failures != 0 || got.down {
+				t.Errorf("state %+v after answers of the server", got)
+			}
+		}},
+		{"two failures in a row set the server aside", func(t *testing.T) {
+			transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+			transport.serve(fallbackTestFails)
+			expect(t, transport, state, "provider", nil)
+			if got := state.testState(); got.failures != 1 || got.down {
+				t.Fatalf("state %+v after one failure", got)
+			}
+			expect(t, transport, state, "provider", nil)
+			got := state.testState()
+			if !got.down || got.probeEvery != fallbackProbeFirst || got.probeIn < fallbackProbeFirst-5*time.Second {
+				t.Fatalf("state %+v after two failures, want down and a probe in %v", got, fallbackProbeFirst)
+			}
+			// set aside: the provider answers and the server is not asked before the probe
+			expect(t, transport, state, "provider", nil)
+			if asked := transport.asked(); asked != 2 {
+				t.Errorf("server asked %d times, want 2", asked)
+			}
+		}},
+		{"an answer between failures clears the count", func(t *testing.T) {
+			transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+			for _, between := range []func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error){
+				fallbackTestAnswers,
+				func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) { return nil, RcodeNameError },
+			} {
+				transport.serve(fallbackTestFails)
+				expect(t, transport, state, "provider", nil)
+				transport.serve(between)
+				fallbackTestExchange(transport, state)
+				if got := state.testState(); got.failures != 0 {
+					t.Fatalf("state %+v after an answer of the server", got)
+				}
+			}
+			transport.serve(fallbackTestFails)
+			expect(t, transport, state, "provider", nil)
+			if got := state.testState(); got.failures != 1 || got.down {
+				t.Errorf("state %+v, want one failure", got)
+			}
+		}},
+		{"a query given up by its caller counts nothing", func(t *testing.T) {
+			transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+			for i := 0; i < 3; i++ {
+				ctx, cancel := context.WithCancel(context.Background())
+				transport.serve(func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+					cancel()
+					<-ctx.Done()
+					return nil, ctx.Err()
+				})
+				response, err := exchangeWithFallback(ctx, context.Background(), nil, transport, state, freshTestQuery())
+				if response != nil || err != context.Canceled {
+					t.Fatalf("got %v, %v, want the error of the caller's context", response, err)
+				}
+			}
+			if got := state.testState(); got.failures != 0 || got.providerFails != 0 || got.down {
+				t.Errorf("state %+v after queries their callers gave up", got)
+			}
+		}},
+		{"a probe that is answered brings the server back", func(t *testing.T) {
+			transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+			transport.serve(fallbackTestFails)
+			expect(t, transport, state, "provider", nil)
+			expect(t, transport, state, "provider", nil)
+			due := func() {
+				state.access.Lock()
+				state.probeAt = time.Now().Add(-time.Second)
+				state.access.Unlock()
+			}
+			// the server still fails: the probe is sent, the next one comes later
+			due()
+			expect(t, transport, state, "provider", nil)
+			waitFallbackTest(t, "the server is probed", func() bool { return transport.asked() == 3 })
+			got := state.testState()
+			if !got.down || got.probeEvery != 2*fallbackProbeFirst || got.probeIn < fallbackProbeFirst-5*time.Second {
+				t.Fatalf("state %+v after a failed probe, want down and the next probe in %v", got, fallbackProbeFirst)
+			}
+			expect(t, transport, state, "provider", nil)
+			if asked := transport.asked(); asked != 3 {
+				t.Fatalf("server asked %d times, want 3: no probe is due", asked)
+			}
+			// a SERVFAIL is not the answer that brings it back
+			transport.serve(fallbackTestServfail)
+			due()
+			expect(t, transport, state, "provider", nil)
+			waitFallbackTest(t, "the server is probed again", func() bool { return transport.asked() == 4 })
+			transport.serve(fallbackTestAnswers)
+			due()
+			expect(t, transport, state, "provider", nil) // the query that carried the probe
+			waitFallbackTest(t, "the server is back", func() bool { return !state.isDown() })
+			expect(t, transport, state, "server", nil)
+			if got := state.testState(); got.failures != 0 {
+				t.Errorf("state %+v after the server came back", got)
+			}
+		}},
+		{"a SERVFAIL of the server is replaced by the provider's answer", func(t *testing.T) {
+			transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+			for i := 0; i < 3; i++ {
+				transport.serve(fallbackTestServfail)
+				expect(t, transport, state, "provider", nil)
+				transport.serve(func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+					return nil, RcodeServerFailure
+				})
+				expect(t, transport, state, "provider", nil)
+			}
+			if got := state.testState(); got.failures != 0 || got.down {
+				t.Errorf("state %+v: a SERVFAIL counted against the server", got)
+			}
+		}},
+		{"a SERVFAIL of the server stays when the provider has no better answer", func(t *testing.T) {
+			for _, provider := range []int{mDNS.RcodeServerFailure, mDNS.RcodeRefused} {
+				transport, state, _ := newFallbackTest(testResolver(t, provider))
+				transport.serve(fallbackTestServfail)
+				expect(t, transport, state, "SERVFAIL", nil)
+				transport.serve(func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+					return nil, RcodeServerFailure
+				})
+				expect(t, transport, state, "", RcodeServerFailure)
+				if got := state.testState(); got.failures != 0 || got.down || got.unusable {
+					t.Errorf("provider answers %s: state %+v", mDNS.RcodeToString[provider], got)
+				}
+			}
+		}},
+		{"the provider failing twice in a row switches the fallback off", func(t *testing.T) {
+			transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeRefused))
+			transport.serve(fallbackTestFails)
+			expect(t, transport, state, "", errFallbackTestServer)
+			if got := state.testState(); got.providerFails != 1 || got.unusable {
+				t.Fatalf("state %+v after one failure of the provider", got)
+			}
+			expect(t, transport, state, "", errFallbackTestServer)
+			if got := state.testState(); !got.unusable || got.failures != 0 || got.down {
+				t.Fatalf("state %+v after two failures of the provider, want no fallback for a while", got)
+			}
+			if state.usable(context.Background(), nil) {
+				t.Error("fallback still usable")
+			}
+			// without the fallback the server is asked alone
+			expect(t, transport, state, "", errFallbackTestServer)
+			transport.serve(fallbackTestAnswers)
+			expect(t, transport, state, "server", nil)
+		}},
+		{"an answer of the provider clears its failure count", func(t *testing.T) {
+			refused, good := testResolver(t, mDNS.RcodeRefused), testResolver(t, mDNS.RcodeSuccess)
+			transport, state, _ := newFallbackTest(refused)
+			transport.serve(fallbackTestFails)
+			setProviders := func(server M.Socksaddr) {
+				state.providers.access.Lock()
+				state.providers.servers = []M.Socksaddr{server}
+				state.providers.access.Unlock()
+			}
+			for i := 0; i < 2; i++ {
+				setProviders(refused)
+				expect(t, transport, state, "", errFallbackTestServer)
+				setProviders(good)
+				expect(t, transport, state, "provider", nil)
+				if got := state.testState(); got.providerFails != 0 || got.unusable {
+					t.Fatalf("state %+v after an answer of the provider", got)
+				}
+				state.success() // not the subject here
+			}
+		}},
+		{"a server set aside is asked when the provider fails too", func(t *testing.T) {
+			transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeRefused))
+			state.access.Lock()
+			state.down, state.probeEvery, state.probeAt = true, fallbackProbeFirst, time.Now().Add(fallbackProbeFirst)
+			state.access.Unlock()
+			expect(t, transport, state, "server", nil)
+			if got := state.testState(); !got.down || got.providerFails != 1 {
+				t.Fatalf("state %+v after one failure of the provider", got)
+			}
+			expect(t, transport, state, "server", nil)
+			if got := state.testState(); got.down || !got.unusable {
+				t.Fatalf("state %+v after two failures of the provider, want the server back and no fallback for a while", got)
+			}
+		}},
+		{"no provider known", func(t *testing.T) {
+			transport, state, reads := newFallbackTest()
+			transport.serve(fallbackTestFails)
+			for i := 0; i < 3; i++ {
+				expect(t, transport, state, "", errFallbackTestServer)
+			}
+			if got := state.testState(); got.failures != 0 || got.providerFails != 0 || got.down || got.unusable {
+				t.Errorf("state %+v without provider servers", got)
+			}
+			if reads.Load() != 0 {
+				t.Errorf("the list was read %d times", reads.Load())
+			}
+		}},
+		{"a server that does not qualify is asked alone", func(t *testing.T) {
+			transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+			state.eligible = false
+			transport.serve(fallbackTestFails)
+			for i := 0; i < 3; i++ {
+				expect(t, transport, state, "", errFallbackTestServer)
+			}
+			transport.serve(fallbackTestServfail)
+			expect(t, transport, state, "SERVFAIL", nil)
+			if got := state.testState(); got.failures != 0 || got.down {
+				t.Errorf("state %+v of a server without the fallback", got)
+			}
+		}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			test.run(t)
+		})
+	}
+}
+
+// A server that stays silent is given up after fallbackPrimaryTimeout, well before the
+// deadline of the query, and the provider answers. The real timeout, once.
+func TestFallbackPrimaryTimeout(t *testing.T) {
+	t.Parallel()
+	transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+	transport.serve(func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+		<-ctx.Done()
+		return nil, ctx.Err()
+	})
+	startAt := time.Now()
+	got, err := fallbackTestExchange(transport, state) // the query has 10 s
+	elapsed := time.Since(startAt)
+	if got != "provider" || err != nil {
+		t.Fatalf("answered by %q (%v), want the provider", got, err)
+	}
+	if elapsed < fallbackPrimaryTimeout-500*time.Millisecond || elapsed > fallbackPrimaryTimeout+3*time.Second {
+		t.Errorf("answered after %v, want about %v", elapsed, fallbackPrimaryTimeout)
+	}
+	if got := state.testState(); got.failures != 1 || got.down {
+		t.Errorf("state %+v, want one failure", got)
+	}
+}
+
+// Client.exchangeTransport and exchangeTransportAsync, the path of queries hijacked from
+// clients: every query gets one answer, through the fallback when the server has one.
+func TestExchangeTransportFallback(t *testing.T) {
+	t.Parallel()
+	client := &Client{ctx: context.Background()}
+	exchangeAsync := func(t *testing.T, transport adapter.DNSTransport) (string, error) {
+		t.Helper()
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		type result struct {
+			response *mDNS.Msg
+			err      error
+		}
+		results := make(chan result, 4)
+		client.exchangeTransportAsync(ctx, transport, freshTestQuery(), func(response *mDNS.Msg, err error) {
+			results <- result{response, err}
+		})
+		var first result
+		select {
+		case first = <-results:
+		case <-ctx.Done():
+			t.Fatal("the callback was not called")
+		}
+		select {
+		case <-results:
+			t.Fatal("the callback was called twice")
+		case <-time.After(200 * time.Millisecond):
+		}
+		return fallbackTestAnswer(first.response, first.err)
+	}
+	exchange := func(t *testing.T, transport adapter.DNSTransport) (string, error) {
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		return fallbackTestAnswer(client.exchangeTransport(ctx, transport, freshTestQuery()))
+	}
+	for _, test := range []struct {
+		name     string
+		exchange func(t *testing.T, transport adapter.DNSTransport) (string, error)
+	}{
+		{"exchangeTransport", exchange},
+		{"exchangeTransportAsync", exchangeAsync},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			// with the fallback
+			transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+			if got, err := test.exchange(t, transport); got != "server" || err != nil {
+				t.Errorf("answered by %q (%v), want the server", got, err)
+			}
+			transport.serve(fallbackTestFails)
+			if got, err := test.exchange(t, transport); got != "provider" || err != nil {
+				t.Errorf("answered by %q (%v), want the provider", got, err)
+			}
+			if got := state.testState(); got.failures != 1 {
+				t.Errorf("state %+v, want one failure", got)
+			}
+			// a server that does not qualify
+			transport, state, _ = newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+			state.eligible = false
+			if got, err := test.exchange(t, transport); got != "server" || err != nil {
+				t.Errorf("answered by %q (%v), want the server", got, err)
+			}
+			transport.serve(fallbackTestFails)
+			if got, err := test.exchange(t, transport); got != "" || err != errFallbackTestServer {
+				t.Errorf("answered by %q (%v), want the error of the server", got, err)
+			}
+			// a server without the fallback state (the fallback is not enabled)
+			transport, _, _ = newFallbackTest()
+			transport.fallback = nil
+			if got, err := test.exchange(t, transport); got != "server" || err != nil {
+				t.Errorf("answered by %q (%v), want the server", got, err)
+			}
+			if asked := transport.asked(); asked != 1 {
+				t.Errorf("server asked %d times, want 1", asked)
+			}
+		})
+	}
+}
+
+// One event that fails many queries at once, as a closed connection they shared does, is
+// one failure of the server; a query that starts after it and fails is the second.
+func TestFallbackCountsBatchOnce(t *testing.T) {
+	t.Parallel()
+	const batch = 20
+	transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+	var waiting sync.WaitGroup
+	waiting.Add(batch)
+	reset := make(chan struct{})
+	transport.serve(func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+		waiting.Done()
+		<-reset
+		return nil, errFallbackTestServer
+	})
+	answers := make(chan string, batch)
+	for i := 0; i < batch; i++ {
+		go func() {
+			got, _ := fallbackTestExchange(transport, state)
+			answers <- got
+		}()
+	}
+	waiting.Wait()
+	close(reset)
+	for i := 0; i < batch; i++ {
+		if got := <-answers; got != "provider" {
+			t.Errorf("answered by %q, want the provider", got)
+		}
+	}
+	if got := state.testState(); got.failures != 1 || got.down {
+		t.Fatalf("state %+v after %d queries failed at once, want one failure", got, batch)
+	}
+	transport.serve(fallbackTestFails)
+	if got, err := fallbackTestExchange(transport, state); got != "provider" || err != nil {
+		t.Fatalf("answered by %q (%v), want the provider", got, err)
+	}
+	if got := state.testState(); !got.down {
+		t.Errorf("state %+v after a later failure, want the server set aside", got)
+	}
+}
+
+// A failure counts against the server only when the provider resolved the name: a name
+// that the provider cannot resolve either says nothing about the server.
+func TestFallbackCountsResolvedOnly(t *testing.T) {
+	t.Parallel()
+	for _, test := range []struct {
+		provider int
+		answer   string
+		down     bool
+	}{
+		{mDNS.RcodeSuccess, "provider", true},
+		{mDNS.RcodeNameError, "NXDOMAIN", true},
+		{mDNS.RcodeServerFailure, "SERVFAIL", false},
+		{mDNS.RcodeNotImplemented, "NOTIMP", false},
+	} {
+		transport, state, _ := newFallbackTest(testResolver(t, test.provider))
+		transport.serve(fallbackTestFails)
+		for i := 0; i < 3; i++ {
+			if got, err := fallbackTestExchange(transport, state); got != test.answer || err != nil {
+				t.Fatalf("provider answers %s: got %q (%v)", test.answer, got, err)
+			}
+		}
+		if got := state.testState(); got.down != test.down || (!test.down && got.failures != 0) {
+			t.Errorf("provider answers %s: state %+v, want down %v", test.answer, got, test.down)
+		}
+	}
+}
+
+// A network reset forgives what the fallback learned on the old network.
+func TestFallbackNetworkReset(t *testing.T) {
+	t.Parallel()
+	newRouter := func(transport adapter.DNSTransport) *Router {
+		return &Router{transport: &TransportManager{transports: []adapter.DNSTransport{transport}}}
+	}
+	t.Run("the provider is usable again", func(t *testing.T) {
+		t.Parallel()
+		transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+		for i := 0; i < fallbackProviderAfter+1; i++ {
+			state.providerFailed(context.Background(), nil, "dns-server", E.New("timeout"))
+		}
+		if got := state.testState(); !got.unusable || got.providerFails != 1 {
+			t.Fatalf("state %+v before the reset", got)
+		}
+		newRouter(transport).ResetNetwork()
+		if got := state.testState(); got.unusable || got.providerFails != 0 {
+			t.Errorf("state %+v after the reset, want the provider usable", got)
+		}
+		transport.serve(fallbackTestFails)
+		if got, err := fallbackTestExchange(transport, state); got != "provider" || err != nil {
+			t.Errorf("answered by %q (%v), want the provider", got, err)
+		}
+	})
+	t.Run("a server set aside is probed at once", func(t *testing.T) {
+		t.Parallel()
+		transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+		state.access.Lock()
+		state.down, state.probeEvery, state.probeAt = true, fallbackProbeMax, time.Now().Add(fallbackProbeMax)
+		state.access.Unlock()
+		newRouter(transport).ResetNetwork()
+		if got := state.testState(); !got.down || got.probeIn > 0 || got.probeEvery != fallbackProbeFirst {
+			t.Fatalf("state %+v after the reset, want down and a probe due, the next in %v", got, fallbackProbeFirst)
+		}
+		if got, err := fallbackTestExchange(transport, state); got != "provider" || err != nil {
+			t.Errorf("answered by %q (%v), want the provider", got, err)
+		}
+		waitFallbackTest(t, "the server is back", func() bool { return !state.isDown() })
+	})
+	t.Run("failures around the reset do not add up", func(t *testing.T) {
+		t.Parallel()
+		transport, state, _ := newFallbackTest(testResolver(t, mDNS.RcodeSuccess))
+		router := newRouter(transport)
+		transport.serve(fallbackTestFails)
+		if got, err := fallbackTestExchange(transport, state); got != "provider" || err != nil {
+			t.Fatalf("answered by %q (%v), want the provider", got, err)
+		}
+		// a query on its way when the network is reset fails with the connections
+		transport.serve(func(ctx context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+			router.ResetNetwork()
+			return nil, errFallbackTestServer
+		})
+		if got, err := fallbackTestExchange(transport, state); got != "provider" || err != nil {
+			t.Fatalf("answered by %q (%v), want the provider", got, err)
+		}
+		if got := state.testState(); got.failures != 0 || got.down {
+			t.Errorf("state %+v, want no failure counted on the new network yet", got)
+		}
+	})
+}
+
+// When none of the provider's servers answers, the list is read again, since it may have
+// changed without a network reset, but not at every such query: not sooner than
+// providerRetryAfter after the last read. A network reset reads it at the next use.
+func TestProviderListRereadAfterMiss(t *testing.T) {
+	t.Parallel()
+	_, state, reads := newFallbackTest(testResolver(t, mDNS.RcodeRefused))
+	for i := 0; i < 3; i++ {
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		_, err := state.exchangeProvider(ctx, context.Background(), nil, freshTestQuery())
+		cancel()
+		if err == nil || err == errNoProviders {
+			t.Fatalf("query %d: got %v, want the refusal of the provider", i, err)
+		}
+	}
+	if reads.Load() != 0 {
+		t.Fatalf("the list was read %d times right after it was read", reads.Load())
+	}
+	state.providers.access.Lock()
+	state.providers.readAt = time.Now().Add(-providerRetryAfter - time.Second)
+	state.providers.access.Unlock()
+	state.providers.list(context.Background(), nil)
+	state.providers.list(context.Background(), nil)
+	if reads.Load() != 1 {
+		t.Fatalf("the list was read %d times %v after the last read, want 1", reads.Load(), providerRetryAfter)
+	}
+	state.providers.forget()
+	state.providers.list(context.Background(), nil)
+	if reads.Load() != 2 {
+		t.Errorf("the list was read %d times, want 2: a reset reads it at the next use", reads.Load())
+	}
+}
+
+// The first query to a server decides whether the fallback applies and reads the
+// provider's servers. A hijacked query does not wait for that on the goroutine of its
+// caller, which reads the next queries of the client.
+func TestExchangeTransportAsyncFirstQuery(t *testing.T) {
+	t.Parallel()
+	read := make(chan struct{})
+	state := &fallbackServer{
+		options: option.RemoteDNSServerOptions{DNSServerAddressOptions: option.DNSServerAddressOptions{Server: "77.88.8.8"}},
+		providers: &providerSet{read: func(ctx context.Context) ([]netifdInterface, error) {
+			<-read
+			return nil, E.New("no ubus in tests")
+		}},
+	}
+	transport := &fallbackTestTransport{
+		TransportAdapter: TransportAdapter{transportType: "test", transportTag: "dns-server", fallback: state},
+		handler:          fallbackTestAnswers,
+	}
+	client := &Client{ctx: context.Background()}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	results := make(chan error, 4)
+	returned := make(chan struct{})
+	go func() {
+		client.exchangeTransportAsync(ctx, transport, freshTestQuery(), func(response *mDNS.Msg, err error) {
+			results <- err
+		})
+		close(returned)
+	}()
+	select {
+	case <-returned:
+	case <-time.After(2 * time.Second):
+		t.Error("exchangeTransportAsync waits for the read of the provider's servers")
+	}
+	close(read)
+	<-returned
+	for i := 0; i < 2; i++ {
+		select {
+		case err := <-results:
+			if err != nil {
+				t.Errorf("query %d: %v", i, err)
+			}
+		case <-ctx.Done():
+			t.Fatalf("query %d: the callback was not called", i)
+		}
+		if !state.eligible {
+			t.Fatal("the server does not qualify: its first query read no provider list")
+		}
+		if i == 0 { // the decision is taken now
+			client.exchangeTransportAsync(ctx, transport, freshTestQuery(), func(response *mDNS.Msg, err error) {
+				results <- err
+			})
+		}
+	}
+	select {
+	case <-results:
+		t.Error("a callback was called twice")
+	case <-time.After(200 * time.Millisecond):
+	}
+}
+
+// The first hijacked query to a server that turns out not to qualify is decided on the
+// goroutine as well and is then answered by the server alone, once; the provider's
+// servers are not read for it.
+func TestExchangeTransportAsyncFirstQueryNoFallback(t *testing.T) {
+	t.Parallel()
+	reads := new(atomic.Int32)
+	state := &fallbackServer{
+		options: option.RemoteDNSServerOptions{DNSServerAddressOptions: option.DNSServerAddressOptions{Server: "192.168.1.1"}},
+		providers: &providerSet{read: func(ctx context.Context) ([]netifdInterface, error) {
+			reads.Add(1)
+			return nil, E.New("no ubus in tests")
+		}},
+	}
+	transport := &fallbackTestTransport{
+		TransportAdapter: TransportAdapter{transportType: "test", transportTag: "dns-server", fallback: state},
+		handler:          fallbackTestAnswers,
+	}
+	client := &Client{ctx: context.Background()}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	type result struct {
+		response *mDNS.Msg
+		err      error
+	}
+	results := make(chan result, 4)
+	// the first query takes the decision, the second finds it taken, the third fails
+	for i, want := range []string{"server", "server", ""} {
+		var wantErr error
+		if want == "" {
+			transport.serve(fallbackTestFails)
+			wantErr = errFallbackTestServer
+		}
+		client.exchangeTransportAsync(ctx, transport, freshTestQuery(), func(response *mDNS.Msg, err error) {
+			results <- result{response, err}
+		})
+		select {
+		case answer := <-results:
+			if got, err := fallbackTestAnswer(answer.response, answer.err); got != want || err != wantErr {
+				t.Errorf("query %d: answered by %q (%v), want %q (%v)", i, got, err, want, wantErr)
+			}
+		case <-ctx.Done():
+			t.Fatalf("query %d: the callback was not called", i)
+		}
+		if !state.decided.Load() || state.eligible {
+			t.Fatalf("query %d: decided %v, want a server that does not qualify", i, state.decided.Load())
+		}
+	}
+	select {
+	case <-results:
+		t.Error("a callback was called twice")
+	case <-time.After(200 * time.Millisecond):
+	}
+	if asked := transport.asked(); asked != 3 {
+		t.Errorf("server asked %d times, want 3", asked)
+	}
+	if reads.Load() != 0 {
+		t.Errorf("the provider's servers were read %d times for a server without the fallback", reads.Load())
+	}
+}
diff --git a/dns/client_fallback_provider.go b/dns/client_fallback_provider.go
new file mode 100644
index 000000000..303fb7b12
--- /dev/null
+++ b/dns/client_fallback_provider.go
@@ -0,0 +1,552 @@
+package dns
+
+import (
+	"context"
+	"encoding/json"
+	"maps"
+	"net"
+	"net/netip"
+	"os/exec"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/service"
+
+	mDNS "github.com/miekg/dns"
+)
+
+// The provider's servers for the fallback (podkop-engine), also asked by the DNS server of
+// the type provider and by the safety net of a group (transport_provider.go,
+// transport_group.go).
+//
+// They are the DNS servers of the OpenWrt interfaces, taken from netifd over ubus:
+//
+//   - When sing-box binds its sockets to a device (auto_detect_interface or
+//     default_interface), the servers of the interfaces on that device: all its traffic
+//     leaves there. For DHCP or PPPoE these are the servers of wan and wan6 (or wan_6).
+//   - Else the servers of every uplink: each interface that is up and has a default route,
+//     tunnels left out (wireguard, openvpn and the like), so a backup modem or a second WAN
+//     too. A query to a server of an uplink is bound to the device of that uplink: a
+//     provider answers its own customers, and when mwan3 (or anything else) sends the
+//     traffic of the router another way, the server of each uplink is still reached through
+//     it. An uplink whose provider is down does not answer; another one does.
+//
+// A LAN with DNS set by hand, an interface without a default route and a tunnel are left
+// out. The list belongs to a box (the DNS router makes it): a box that replaces another one
+// in the same process, with other settings, reads it again. It is read at the first
+// fallback, and again when sing-box resets the network after its default interface changed
+// (the DNS router calls forget): another uplink, the WAN down and up, a new PPPoE session.
+// It is also read again after none of its servers answered and 30 s after ubus could not be
+// asked, in both cases not sooner than 30 s after the last read: each read runs ubus.
+//
+// The servers are chosen by their answers, as dnsmasq does: the first fallback query goes
+// to all of them at once, the first to answer gets the next queries alone, and all of them
+// are asked again every 20 s or 50 queries, and as soon as it misses one: an uplink that
+// comes back takes over again when it answers first.
+
+const (
+	providerRetryAfter  = 30 * time.Second // between reads after ubus could not be asked or no server answered
+	providerMax         = 4                // servers of one device
+	providerMaxAll      = 8                // servers asked at once
+	providerRoundEvery  = 20 * time.Second
+	providerRoundAfter  = 50 // queries
+	providerBestTimeout = 1500 * time.Millisecond
+	providerUbusTimeout = 3 * time.Second
+)
+
+var (
+	errNoProviders = E.New("no provider DNS on the output device")
+
+	// provider queries have their own sockets: a burst of queries waiting for a silent
+	// server must not keep them from the provider. The bound is of the process, not of a box.
+	fallbackSocketSlots = make(chan struct{}, 256)
+
+	// the set of a context without a DNS router (providersFrom)
+	defaultProviders = newProviderSet()
+
+	// the protocols of netifd that make tunnels, not uplinks of a provider
+	tunnelProtocols = []string{"wireguard", "amneziawg", "openvpn", "openconnect", "vpnc", "gre", "gretap", "grev6", "grev6tap", "vti", "vtiv6", "xfrm", "ipip"}
+)
+
+func newProviderSet() *providerSet {
+	return &providerSet{read: readUbusInterfaces}
+}
+
+// providersFrom is the provider set of the box of ctx, which its DNS router registers.
+func providersFrom(ctx context.Context) *providerSet {
+	if ctx != nil {
+		if set := service.FromContext[*providerSet](ctx); set != nil {
+			return set
+		}
+	}
+	return defaultProviders
+}
+
+type providerSet struct {
+	read func(ctx context.Context) ([]netifdInterface, error)
+
+	access   sync.Mutex
+	reading  bool          // one read at a time, outside the lock
+	readDone chan struct{} // closed when the read in progress ends (listWait)
+	servers  []M.Socksaddr
+	// devices are the devices of the uplinks the queries to the servers are bound to; a
+	// server without one is asked through the dialer of the server (sing-box binds them)
+	devices map[M.Socksaddr]string
+	device  string // the output device the list is for, "" for every uplink
+	readAt  time.Time
+	readErr bool        // ubus could not be asked
+	stale   bool        // no server answered: the list may have changed
+	best    M.Socksaddr // the server that answered last, invalid when none
+	uses    int         // queries sent to best alone since all were asked
+	roundAt time.Time   // when all were asked
+}
+
+// netifdInterface is what the fallback needs of `ubus call network.interface dump`.
+type netifdInterface struct {
+	Name      string   `json:"interface"`
+	Up        bool     `json:"up"`
+	Proto     string   `json:"proto"`
+	L3Device  string   `json:"l3_device"`
+	DNSServer []string `json:"dns-server"`
+	Route     []struct {
+		Target string `json:"target"`
+		Mask   int    `json:"mask"`
+		Metric int    `json:"metric"`
+	} `json:"route"`
+}
+
+func readUbusInterfaces(ctx context.Context) ([]netifdInterface, error) {
+	ctx, cancel := context.WithTimeout(ctx, providerUbusTimeout)
+	defer cancel()
+	output, err := exec.CommandContext(ctx, "ubus", "call", "network.interface", "dump").Output()
+	if err != nil {
+		return nil, E.Cause(err, "ubus call network.interface dump")
+	}
+	var dump struct {
+		Interface []netifdInterface `json:"interface"`
+	}
+	err = json.Unmarshal(output, &dump)
+	if err != nil {
+		return nil, E.Cause(err, "parse ubus network.interface dump")
+	}
+	return dump.Interface, nil
+}
+
+// known reports whether there are provider servers; it is on the path of every query, so
+// a due read runs in the background.
+func (p *providerSet) known(ctx context.Context, logger logger.ContextLogger) bool {
+	p.access.Lock()
+	count := len(p.servers)
+	start := p.beginRead()
+	p.access.Unlock()
+	if start {
+		go p.refresh(logger, outputDevice(ctx))
+	}
+	return count > 0
+}
+
+func (p *providerSet) rereadDue() bool {
+	return p.readAt.IsZero() || ((p.readErr || p.stale) && time.Since(p.readAt) >= providerRetryAfter)
+}
+
+// beginRead reserves the read when it is due and no other one runs; under the lock.
+func (p *providerSet) beginRead() bool {
+	if !p.rereadDue() || p.reading {
+		return false
+	}
+	p.reading = true
+	p.readDone = make(chan struct{})
+	return true
+}
+
+// list returns the provider's servers, reading them again when it is due. While another
+// query reads them, the servers read before are returned.
+func (p *providerSet) list(ctx context.Context, logger logger.ContextLogger) []M.Socksaddr {
+	p.access.Lock()
+	servers := p.servers
+	start := p.beginRead()
+	p.access.Unlock()
+	if !start {
+		return servers
+	}
+	return p.refresh(logger, outputDevice(ctx))
+}
+
+// listWait is list for the provider DNS server, which has nothing else to ask: when no
+// server is known yet and another query is reading the list (the first queries after the
+// start or a network reset), it waits for that read instead of failing. ctx is the one of
+// the query, baseCtx carries the services of the box.
+func (p *providerSet) listWait(ctx context.Context, baseCtx context.Context, logger logger.ContextLogger) []M.Socksaddr {
+	servers := p.list(baseCtx, logger)
+	if len(servers) > 0 {
+		return servers
+	}
+	p.access.Lock()
+	if !p.reading {
+		servers = p.servers // the read may have ended since
+		p.access.Unlock()
+		return servers
+	}
+	done := p.readDone
+	p.access.Unlock()
+	select {
+	case <-done:
+	case <-ctx.Done():
+		return nil
+	}
+	p.access.Lock()
+	defer p.access.Unlock()
+	return p.servers
+}
+
+// snapshot is the list as it is now, each server with the device a query to it is bound to.
+func (p *providerSet) snapshot() []adapter.DNSProviderServer {
+	p.access.Lock()
+	defer p.access.Unlock()
+	servers := make([]adapter.DNSProviderServer, 0, len(p.servers))
+	for _, server := range p.servers {
+		servers = append(servers, adapter.DNSProviderServer{Address: server.AddrPort(), Device: p.devices[server]})
+	}
+	return servers
+}
+
+func (p *providerSet) refresh(logger logger.ContextLogger, device string) []M.Socksaddr {
+	var (
+		servers []M.Socksaddr
+		devices map[M.Socksaddr]string
+		names   []string
+	)
+	interfaces, err := p.read(context.Background())
+	if err == nil {
+		servers, devices, names = providersOn(interfaces, device)
+	}
+	p.access.Lock()
+	defer p.access.Unlock()
+	p.reading = false
+	if p.readDone != nil {
+		close(p.readDone)
+		p.readDone = nil
+	}
+	changed := p.readAt.IsZero() || device != p.device || !slices.Equal(servers, p.servers) || !maps.Equal(devices, p.devices)
+	p.servers, p.devices, p.device, p.readAt, p.readErr, p.stale = servers, devices, device, time.Now(), err != nil, false
+	if changed {
+		p.best = M.Socksaddr{}
+		if logger != nil {
+			switch {
+			case err != nil:
+				logger.Warn("no provider DNS: ", err)
+			case len(servers) == 0 && device != "":
+				logger.Warn("no provider DNS on ", device)
+			case len(servers) == 0:
+				logger.Warn("no provider DNS: no uplink has DNS servers")
+			case device != "":
+				logger.Warn("provider DNS on ", device, " (", strings.Join(names, ", "), "): ", joinServers(servers))
+			default:
+				logger.Warn("provider DNS, each through its uplink: ", strings.Join(names, "; "))
+			}
+		}
+	}
+	return servers
+}
+
+// deviceOf is the device a query to a server is bound to, "" for none.
+func (p *providerSet) deviceOf(server M.Socksaddr) string {
+	p.access.Lock()
+	defer p.access.Unlock()
+	return p.devices[server]
+}
+
+// forget makes the next use read the servers again.
+func (p *providerSet) forget() {
+	p.access.Lock()
+	p.readAt = time.Time{}
+	p.best = M.Socksaddr{}
+	p.access.Unlock()
+}
+
+// noneAnswered makes a later use read the servers again: they may have changed without a
+// network reset, as when DHCP hands out other ones. Unlike forget it keeps the time of
+// the last read, so that servers that keep refusing do not run ubus at every query.
+func (p *providerSet) noneAnswered() {
+	p.access.Lock()
+	p.stale = true
+	p.best = M.Socksaddr{}
+	p.access.Unlock()
+}
+
+func (p *providerSet) names() string {
+	p.access.Lock()
+	defer p.access.Unlock()
+	return joinServers(p.servers)
+}
+
+// pick returns the server to ask alone: the one that answered last, while its turn lasts.
+func (p *providerSet) pick(servers []M.Socksaddr) (M.Socksaddr, bool) {
+	p.access.Lock()
+	defer p.access.Unlock()
+	if !p.best.IsValid() || p.uses >= providerRoundAfter || time.Since(p.roundAt) >= providerRoundEvery || !slices.Contains(servers, p.best) {
+		return M.Socksaddr{}, false
+	}
+	p.uses++
+	return p.best, true
+}
+
+func (p *providerSet) chose(server M.Socksaddr) {
+	p.access.Lock()
+	p.best, p.uses, p.roundAt = server, 0, time.Now()
+	p.access.Unlock()
+}
+
+func (p *providerSet) missed(server M.Socksaddr) {
+	p.access.Lock()
+	if p.best == server {
+		p.best = M.Socksaddr{}
+	}
+	p.access.Unlock()
+}
+
+// providersOn returns the DNS servers of the interfaces that are up on device; when device
+// is "" (sing-box binds no socket), those of every uplink, each with the device of its
+// uplink to bind the queries to, the uplinks in the order of their default routes. The
+// names tell the interfaces the servers come from.
+func providersOn(interfaces []netifdInterface, device string) (servers []M.Socksaddr, devices map[M.Socksaddr]string, names []string) {
+	own := ownAddresses()
+	seen := make(map[netip.Addr]bool)
+	// the servers of each device: at most providerMax
+	counts := make(map[string]int)
+	add := func(networkInterface netifdInterface, bind bool) []string {
+		var added []string
+		for _, server := range networkInterface.DNSServer {
+			address, err := netip.ParseAddr(server)
+			if err != nil || address.IsLoopback() || address.IsUnspecified() || own[address.Unmap()] {
+				continue
+			}
+			if address.IsLinkLocalUnicast() && address.Zone() == "" {
+				address = address.WithZone(networkInterface.L3Device)
+			}
+			if seen[address] || counts[networkInterface.L3Device] >= providerMax || len(servers) >= providerMaxAll {
+				continue
+			}
+			seen[address] = true
+			counts[networkInterface.L3Device]++
+			socksaddr := M.SocksaddrFrom(address, 53)
+			servers = append(servers, socksaddr)
+			if bind {
+				if devices == nil {
+					devices = make(map[M.Socksaddr]string)
+				}
+				devices[socksaddr] = networkInterface.L3Device
+			}
+			added = append(added, address.String())
+		}
+		return added
+	}
+	if device != "" {
+		for _, networkInterface := range interfaces {
+			if networkInterface.Up && networkInterface.L3Device == device && len(networkInterface.DNSServer) > 0 {
+				names = append(names, networkInterface.Name)
+				add(networkInterface, false)
+			}
+		}
+		return servers, nil, names
+	}
+	for _, networkInterface := range uplinks(interfaces) {
+		if added := add(networkInterface, true); len(added) > 0 {
+			names = append(names, networkInterface.Name+" on "+networkInterface.L3Device+": "+strings.Join(added, ", "))
+		}
+	}
+	return servers, devices, names
+}
+
+// uplinks are the interfaces that are up, have a device and a default route, and are no
+// tunnel, in the order of the metric of their default route (IPv4 first).
+func uplinks(interfaces []netifdInterface) []netifdInterface {
+	type uplink struct {
+		networkInterface netifdInterface
+		metric           int
+	}
+	var found []uplink
+	for _, networkInterface := range interfaces {
+		if !networkInterface.Up || networkInterface.L3Device == "" || slices.Contains(tunnelProtocols, networkInterface.Proto) {
+			continue
+		}
+		best, isUplink := 0, false
+		for _, route := range networkInterface.Route {
+			if route.Mask != 0 || (route.Target != "0.0.0.0" && route.Target != "::") {
+				continue
+			}
+			metric := route.Metric
+			if route.Target == "::" {
+				metric += 1 << 20
+			}
+			if !isUplink || metric < best {
+				best, isUplink = metric, true
+			}
+		}
+		if isUplink {
+			found = append(found, uplink{networkInterface, best})
+		}
+	}
+	slices.SortStableFunc(found, func(left uplink, right uplink) int { return left.metric - right.metric })
+	result := make([]netifdInterface, len(found))
+	for index, item := range found {
+		result[index] = item.networkInterface
+	}
+	return result
+}
+
+// outputDevice is the device sing-box binds its sockets to (auto_detect_interface or
+// default_interface), "" when it does not bind them.
+func outputDevice(ctx context.Context) string {
+	if ctx == nil {
+		return ""
+	}
+	manager := service.FromContext[adapter.NetworkManager](ctx)
+	if manager == nil {
+		return ""
+	}
+	if bind := manager.DefaultOptions().BindInterface; bind != "" {
+		return bind
+	}
+	if manager.AutoDetectInterface() {
+		if networkInterface := manager.DefaultNetworkInterface(); networkInterface != nil {
+			return networkInterface.Name
+		}
+	}
+	return ""
+}
+
+func ownAddresses() map[netip.Addr]bool {
+	own := make(map[netip.Addr]bool)
+	addresses, err := net.InterfaceAddrs()
+	if err != nil {
+		return own
+	}
+	for _, interfaceAddress := range addresses {
+		prefix, err := netip.ParsePrefix(interfaceAddress.String())
+		if err == nil {
+			own[prefix.Addr().Unmap()] = true
+		}
+	}
+	return own
+}
+
+// exchangeProvider asks the provider's servers for the fallback of a server, through the
+// server's own dialer; their answer lives fallbackMaxTTL at most.
+func (s *fallbackServer) exchangeProvider(ctx context.Context, baseCtx context.Context, logger logger.ContextLogger, message *mDNS.Msg) (*mDNS.Msg, error) {
+	servers := s.providersFor(s.providers.list(baseCtx, logger))
+	if len(servers) == 0 {
+		return nil, errNoProviders
+	}
+	ctx, cancel := context.WithTimeout(ctx, fallbackTimeout)
+	defer cancel()
+	response, err := s.askProviders(ctx, servers, message)
+	if err != nil {
+		return nil, err
+	}
+	return s.providerAnswered(response), nil
+}
+
+// askProviders asks the provider's servers from fresh sockets: the one that answered last
+// alone, else (or when it does not answer in providerBestTimeout) all of them at once; a
+// REFUSED is no answer. The answer is returned as the server gave it.
+func (s *fallbackServer) askProviders(ctx context.Context, servers []M.Socksaddr, message *mDNS.Msg) (*mDNS.Msg, error) {
+	if best, loaded := s.providers.pick(servers); loaded {
+		bestCtx, bestCancel := context.WithTimeout(ctx, providerBestTimeout)
+		response, err := exchangeFresh(bestCtx, fallbackSocketSlots, s.dialerFor(s.providers.deviceOf(best)), best, message)
+		bestCancel()
+		if err == nil && response.Rcode != mDNS.RcodeRefused {
+			return response, nil
+		}
+		s.providers.missed(best)
+		if ctx.Err() != nil {
+			if err == nil {
+				err = E.New("refused")
+			}
+			return nil, E.Cause(err, "provider DNS ", best)
+		}
+	}
+	response, err := s.exchangeAll(ctx, servers, message)
+	if err != nil && ctx.Err() == nil {
+		s.providers.noneAnswered()
+	}
+	return response, err
+}
+
+// exchangeAll asks all the servers at once: the first answer wins, the other sockets are
+// closed with the context.
+func (s *fallbackServer) exchangeAll(ctx context.Context, servers []M.Socksaddr, message *mDNS.Msg) (*mDNS.Msg, error) {
+	ctx, cancel := context.WithCancel(ctx)
+	// the losers end with the context (it closes their sockets); wait for them, so that
+	// nothing of this exchange runs on after it returned
+	var exchanges sync.WaitGroup
+	defer func() {
+		cancel()
+		exchanges.Wait()
+	}()
+	type result struct {
+		server   M.Socksaddr
+		response *mDNS.Msg
+		err      error
+	}
+	results := make(chan result, len(servers))
+	for _, server := range servers {
+		exchanges.Add(1)
+		go func(server M.Socksaddr) {
+			defer exchanges.Done()
+			response, err := exchangeFresh(ctx, fallbackSocketSlots, s.dialerFor(s.providers.deviceOf(server)), server, message)
+			results <- result{server, response, err}
+		}(server)
+	}
+	err := E.New("provider DNS refused")
+	for range servers {
+		answer := <-results
+		if answer.err != nil {
+			err = answer.err
+			continue
+		}
+		if answer.response.Rcode == mDNS.RcodeRefused {
+			continue
+		}
+		s.providers.chose(answer.server)
+		return answer.response, nil
+	}
+	return nil, err
+}
+
+func (s *fallbackServer) providerAnswered(response *mDNS.Msg) *mDNS.Msg {
+	s.access.Lock()
+	s.providerFails = 0
+	s.access.Unlock()
+	capTTL(response, fallbackMaxTTL)
+	return response
+}
+
+// providersFor leaves the server itself out.
+func (s *fallbackServer) providersFor(servers []M.Socksaddr) []M.Socksaddr {
+	self := s.options.DNSServerAddressOptions.Build()
+	if !self.IsIP() {
+		return servers
+	}
+	var others []M.Socksaddr
+	for _, server := range servers {
+		if server.Addr.Unmap() != self.Addr.Unmap() {
+			others = append(others, server)
+		}
+	}
+	return others
+}
+
+func joinServers(servers []M.Socksaddr) string {
+	names := make([]string, 0, len(servers))
+	for _, server := range servers {
+		names = append(names, server.Addr.String())
+	}
+	return strings.Join(names, ", ")
+}
