diff --git a/common/dialer/default_finalmask_test.go b/common/dialer/default_finalmask_test.go
new file mode 100644
index 000000000..683552146
--- /dev/null
+++ b/common/dialer/default_finalmask_test.go
@@ -0,0 +1,71 @@
+package dialer
+
+import (
+	"context"
+	"crypto/rand"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+)
+
+// The finalmask of the dialer options reaches the TCP connections of the default dialer: a
+// ClientHello written to one arrives cut into records of the lengths asked for.
+func TestDefaultDialerFinalMask(t *testing.T) {
+	t.Parallel()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+	received := make(chan []byte, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			received <- nil
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+		content, _ := io.ReadAll(conn)
+		received <- content
+	}()
+	length := option.V2RayXHTTPRange{From: 11, To: 24}
+	dialer, err := NewDefault(context.Background(), option.DialerOptions{FinalMask: &option.FinalMaskOptions{
+		TCP: []option.FinalMaskTCPOptions{{Type: "fragment", Packets: "tlshello", Length: &length}},
+	}})
+	require.NoError(t, err)
+	conn, err := dialer.DialContext(context.Background(), "tcp", M.ParseSocksaddr(listener.Addr().String()))
+	require.NoError(t, err)
+	payload := make([]byte, 600)
+	_, _ = rand.Read(payload)
+	payload[0] = 1
+	message := append([]byte{22, 3, 1, byte(len(payload) >> 8), byte(len(payload))}, payload...)
+	_, err = conn.Write(message)
+	require.NoError(t, err)
+	require.NoError(t, conn.Close())
+	stream := <-received
+	var joined []byte
+	count := 0
+	for len(stream) >= 5 {
+		size := int(stream[3])<<8 | int(stream[4])
+		require.LessOrEqual(t, size, 24)
+		joined = append(joined, stream[5:5+size]...)
+		stream = stream[5+size:]
+		count++
+	}
+	require.Empty(t, stream)
+	require.Equal(t, payload, joined)
+	require.Greater(t, count, 600/24)
+}
+
+// Without a finalmask the bytes go as they are written.
+func TestDefaultDialerWithoutFinalMask(t *testing.T) {
+	t.Parallel()
+	dialer, err := NewDefault(context.Background(), option.DialerOptions{})
+	require.NoError(t, err)
+	require.Nil(t, dialer.finalMask)
+}
diff --git a/common/finalmask/conn.go b/common/finalmask/conn.go
new file mode 100644
index 000000000..83691caec
--- /dev/null
+++ b/common/finalmask/conn.go
@@ -0,0 +1,199 @@
+package finalmask
+
+import (
+	"net"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// fragmentConn cuts the writes of a connection as Xray's fragment mask does
+// (fragment/conn.go of Xray-core). Reading is not touched. A pause between pieces ends when
+// the connection is closed or its write deadline passes.
+type fragmentConn struct {
+	net.Conn
+	mask *fragment
+	// writes begun, and writes done: the mask steps aside only after the last one it cuts
+	count     atomic.Int64
+	done      atomic.Int64
+	deadline  atomic.Int64
+	closeOnce sync.Once
+	closed    chan struct{}
+}
+
+func newFragmentConn(conn net.Conn, mask *fragment) *fragmentConn {
+	return &fragmentConn{Conn: conn, mask: mask, closed: make(chan struct{})}
+}
+
+func (c *fragmentConn) Close() error {
+	c.closeOnce.Do(func() { close(c.closed) })
+	return c.Conn.Close()
+}
+
+func (c *fragmentConn) setDeadline(t time.Time) {
+	if t.IsZero() {
+		c.deadline.Store(0)
+	} else {
+		c.deadline.Store(t.UnixNano())
+	}
+}
+
+func (c *fragmentConn) SetDeadline(t time.Time) error {
+	c.setDeadline(t)
+	return c.Conn.SetDeadline(t)
+}
+
+func (c *fragmentConn) SetWriteDeadline(t time.Time) error {
+	c.setDeadline(t)
+	return c.Conn.SetWriteDeadline(t)
+}
+
+func (c *fragmentConn) pause(delay span) error {
+	if delay.to <= 0 {
+		return nil
+	}
+	wait := time.Duration(delay.draw()) * time.Millisecond
+	expired := false
+	if deadline := c.deadline.Load(); deadline != 0 {
+		left := time.Until(time.Unix(0, deadline))
+		if left <= 0 {
+			return os.ErrDeadlineExceeded
+		}
+		if left < wait {
+			wait, expired = left, true
+		}
+	}
+	timer := time.NewTimer(wait)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+		if expired {
+			return os.ErrDeadlineExceeded
+		}
+		return nil
+	case <-c.closed:
+		return net.ErrClosed
+	}
+}
+
+// pieceEnd is where a piece that starts at from ends: its drawn length, bounded by the bytes
+// left (a length near the largest int does not wrap on 32 bits), and the rest for the last
+// piece max_split allows.
+func (c *fragmentConn) pieceEnd(from, size int, piece, maxSplit int64) int {
+	length := c.mask.lengthOf(piece).draw()
+	if length > int64(size-from) || maxSplit > 0 && piece+1 >= maxSplit {
+		return size
+	}
+	return from + int(length)
+}
+
+func (c *fragmentConn) Write(p []byte) (int, error) {
+	count := c.count.Add(1)
+	defer c.done.Add(1)
+	mask := c.mask
+	if mask.packetsFrom == 0 && mask.packetsTo == 1 {
+		return c.writeHello(p, count)
+	}
+	if mask.packetsFrom != 0 && (count < mask.packetsFrom || count > mask.packetsTo) {
+		return c.Conn.Write(p)
+	}
+	maxSplit := mask.maxSplit.draw()
+	var piece int64
+	for from := 0; ; {
+		to := c.pieceEnd(from, len(p), piece, maxSplit)
+		n, err := c.Conn.Write(p[from:to])
+		from += n
+		if err != nil {
+			return from, err
+		}
+		// as in Xray, the pause follows every piece, the last one too
+		err = c.pause(mask.delayOf(piece))
+		if err != nil {
+			return from, err
+		}
+		piece++
+		if from >= len(p) {
+			return from, nil
+		}
+	}
+}
+
+// writeHello cuts the first write, when it is a whole TLS record of a ClientHello, into
+// records ("tlshello"). Anything else goes as it is: Xray takes any first record of the
+// handshake, which a client's first write that only looks like one (the random salt of
+// Shadowsocks, one time in 256) would lose its bytes to; a record of no byte is no hello.
+func (c *fragmentConn) writeHello(p []byte, count int64) (int, error) {
+	if count != 1 || len(p) <= 5 || p[0] != 22 || p[1] != 3 || p[5] != 1 {
+		return c.Conn.Write(p)
+	}
+	recordLength := 5 + (int(p[3])<<8 | int(p[4]))
+	if len(p) < recordLength || recordLength == 5 {
+		return c.Conn.Write(p)
+	}
+	mask := c.mask
+	data := p[5:recordLength]
+	merged := mask.merged()
+	var out []byte
+	if merged {
+		// each piece of n bytes gets a header of 5
+		out = make([]byte, 0, len(data)+5*(len(data)/max(int(mask.lengths[0].from), 1)+2))
+	}
+	maxSplit := mask.maxSplit.draw()
+	var piece int64
+	for from := 0; from < len(data); piece++ {
+		to := c.pieceEnd(from, len(data), piece, maxSplit)
+		length := to - from
+		record := append(append([]byte(nil), p[0], p[1], p[2], byte(length>>8), byte(length)), data[from:to]...)
+		from = to
+		if merged {
+			out = append(out, record...)
+			continue
+		}
+		_, err := c.Conn.Write(record)
+		if err != nil {
+			return 0, err
+		}
+		err = c.pause(mask.delayOf(piece))
+		if err != nil {
+			return 0, err
+		}
+	}
+	if len(out) > 0 {
+		_, err := c.Conn.Write(out)
+		if err != nil {
+			return 0, err
+		}
+	}
+	if len(p) > recordLength {
+		n, err := c.Conn.Write(p[recordLength:])
+		if err != nil {
+			return recordLength + n, err
+		}
+	}
+	return len(p), nil
+}
+
+// ReaderReplaceable: reads are not touched.
+func (c *fragmentConn) ReaderReplaceable() bool {
+	return true
+}
+
+// WriterReplaceable: the writes past the ones the mask cuts may go to the connection under
+// it directly, once the last of those is done. Cutting every write ("" packets), it never
+// steps aside.
+func (c *fragmentConn) WriterReplaceable() bool {
+	done := c.done.Load()
+	switch {
+	case c.mask.packetsFrom == 0 && c.mask.packetsTo == 1:
+		return done >= 1
+	case c.mask.packetsFrom == 0:
+		return false
+	default:
+		return done >= c.mask.packetsTo
+	}
+}
+
+func (c *fragmentConn) Upstream() any {
+	return c.Conn
+}
diff --git a/common/finalmask/finalmask.go b/common/finalmask/finalmask.go
new file mode 100644
index 000000000..e235a951d
--- /dev/null
+++ b/common/finalmask/finalmask.go
@@ -0,0 +1,149 @@
+// Package finalmask puts Xray's finalmask masks on the TCP connections of an outbound: what
+// goes over the wire is reshaped, what it carries is not. Only "fragment" is here, the one
+// mask a server does not see (transport/internet/finalmask/fragment of Xray-core, 26.x): it
+// cuts the ClientHello into small TLS records, or the first writes of a connection into
+// small pieces, so that a DPI box that reads the handshake in one piece does not find it.
+package finalmask
+
+import (
+	"math/rand/v2"
+	"net"
+	"strings"
+
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// Masks are the masks of one outbound, in the order of its options.
+type Masks struct {
+	fragments []*fragment
+}
+
+// New reads the masks; nil when there are none.
+func New(options *option.FinalMaskOptions) (*Masks, error) {
+	if options == nil || len(options.TCP) == 0 {
+		return nil, nil
+	}
+	masks := &Masks{}
+	for index, mask := range options.TCP {
+		switch strings.ToLower(mask.Type) {
+		case "fragment":
+			built, err := newFragment(mask)
+			if err != nil {
+				return nil, E.Cause(err, "finalmask.tcp[", index, "]")
+			}
+			masks.fragments = append(masks.fragments, built)
+		default:
+			return nil, E.New("finalmask.tcp[", index, "]: the mask ", mask.Type, " is not supported (only fragment)")
+		}
+	}
+	return masks, nil
+}
+
+// Client puts the masks on a TCP connection the outbound opened: the first mask of the list
+// is the one nearest to the socket, as in Xray.
+func (m *Masks) Client(conn net.Conn) net.Conn {
+	if m == nil {
+		return conn
+	}
+	for _, mask := range m.fragments {
+		conn = newFragmentConn(conn, mask)
+	}
+	return conn
+}
+
+// a range of whole numbers, drawn as Xray's crypto.RandBetween draws it: from included, to
+// left out, and from alone when they are 1 apart or less ("11-24" gives 11 to 23)
+type span struct{ from, to int64 }
+
+func (s span) draw() int64 {
+	from, to := s.from, s.to
+	if from > to {
+		from, to = to, from
+	}
+	if to-from <= 1 {
+		return from
+	}
+	return from + rand.Int64N(to-from)
+}
+
+func spanOf(value *option.V2RayXHTTPRange) span {
+	if value == nil {
+		return span{}
+	}
+	return span{int64(value.From), int64(value.To)}
+}
+
+// fragment is a fragment mask as Xray builds it (infra/conf FragmentMask.Build).
+type fragment struct {
+	// the writes cut, counted from 1: 0-1 is the ClientHello ("tlshello"), 0-0 every write
+	packetsFrom, packetsTo int64
+	lengths, delays        []span
+	maxSplit               span
+}
+
+func newFragment(options option.FinalMaskTCPOptions) (*fragment, error) {
+	f := &fragment{}
+	switch packets := strings.ToLower(strings.TrimSpace(options.Packets)); packets {
+	case "tlshello":
+		f.packetsFrom, f.packetsTo = 0, 1
+	case "":
+	default:
+		var bounds option.V2RayXHTTPRange
+		err := bounds.UnmarshalJSON([]byte(`"` + packets + `"`))
+		if err != nil {
+			return nil, E.Cause(err, "packets")
+		}
+		if bounds.From <= 0 {
+			return nil, E.New("packets: the first write is 1")
+		}
+		f.packetsFrom, f.packetsTo = int64(bounds.From), int64(bounds.To)
+	}
+	if len(options.Lengths) > 0 {
+		for index := range options.Lengths {
+			f.lengths = append(f.lengths, spanOf(&options.Lengths[index]))
+		}
+	} else {
+		f.lengths = append(f.lengths, spanOf(options.Length))
+	}
+	for _, length := range f.lengths {
+		if length.from < 0 {
+			return nil, E.New("length: a negative length")
+		}
+	}
+	// a piece of no byte is no piece: Xray refuses a last range that may draw 0
+	if f.lengths[len(f.lengths)-1].from <= 0 {
+		return nil, E.New("length: the last range must start above 0")
+	}
+	if len(options.Delays) > 0 {
+		for index := range options.Delays {
+			f.delays = append(f.delays, spanOf(&options.Delays[index]))
+		}
+	} else {
+		f.delays = append(f.delays, spanOf(options.Delay))
+	}
+	for _, delay := range f.delays {
+		if delay.from < 0 {
+			return nil, E.New("delay: a negative delay")
+		}
+	}
+	f.maxSplit = spanOf(options.MaxSplit)
+	if f.maxSplit.from < 0 {
+		return nil, E.New("max_split: a negative number")
+	}
+	return f, nil
+}
+
+func (f *fragment) lengthOf(piece int64) span {
+	return f.lengths[min(piece, int64(len(f.lengths)-1))]
+}
+
+func (f *fragment) delayOf(piece int64) span {
+	return f.delays[min(piece, int64(len(f.delays)-1))]
+}
+
+// merged: with one delay of 0 the records of a ClientHello go out in one write (Xray's
+// mergeTlsHelloSegments)
+func (f *fragment) merged() bool {
+	return len(f.delays) == 1 && f.delays[0].to == 0
+}
diff --git a/common/finalmask/finalmask_test.go b/common/finalmask/finalmask_test.go
new file mode 100644
index 000000000..099235cd9
--- /dev/null
+++ b/common/finalmask/finalmask_test.go
@@ -0,0 +1,292 @@
+package finalmask
+
+import (
+	"bytes"
+	"crypto/rand"
+	"net"
+	"os"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json"
+
+	"github.com/stretchr/testify/require"
+)
+
+// writesConn keeps each write of the mask apart.
+type writesConn struct {
+	net.Conn
+	access sync.Mutex
+	writes [][]byte
+}
+
+func (c *writesConn) Write(p []byte) (int, error) {
+	c.access.Lock()
+	defer c.access.Unlock()
+	c.writes = append(c.writes, append([]byte(nil), p...))
+	return len(p), nil
+}
+
+func (c *writesConn) Close() error { return nil }
+
+func (c *writesConn) SetDeadline(time.Time) error      { return nil }
+func (c *writesConn) SetWriteDeadline(time.Time) error { return nil }
+
+func hello(size int) []byte {
+	payload := make([]byte, size)
+	_, _ = rand.Read(payload)
+	payload[0] = 1 // ClientHello
+	return append([]byte{22, 3, 1, byte(size >> 8), byte(size)}, payload...)
+}
+
+// records reads TLS records back: their payload joined and their sizes.
+func records(t *testing.T, stream []byte) ([]byte, []int) {
+	t.Helper()
+	var payload []byte
+	var sizes []int
+	for len(stream) > 0 {
+		require.GreaterOrEqual(t, len(stream), 5)
+		require.Equal(t, []byte{22, 3, 1}, stream[:3])
+		size := int(stream[3])<<8 | int(stream[4])
+		require.GreaterOrEqual(t, len(stream), 5+size)
+		payload = append(payload, stream[5:5+size]...)
+		sizes = append(sizes, size)
+		stream = stream[5+size:]
+	}
+	return payload, sizes
+}
+
+func masked(t *testing.T, content string) (*fragmentConn, *writesConn) {
+	t.Helper()
+	var options option.FinalMaskOptions
+	require.NoError(t, json.Unmarshal([]byte(content), &options))
+	masks, err := New(&options)
+	require.NoError(t, err)
+	under := &writesConn{}
+	conn := masks.Client(under).(*fragmentConn)
+	return conn, under
+}
+
+func TestHelloInRecordsOneWrite(t *testing.T) {
+	t.Parallel()
+	for range 20 {
+		conn, under := masked(t, `{"tcp":[{"type":"fragment","packets":"tlshello","length":"11-24","delay":0}]}`)
+		message := hello(1521)
+		n, err := conn.Write(message)
+		require.NoError(t, err)
+		require.Equal(t, len(message), n)
+		require.Len(t, under.writes, 1, "a single delay of 0: one write")
+		payload, sizes := records(t, under.writes[0])
+		require.Equal(t, message[5:], payload)
+		for _, size := range sizes[:len(sizes)-1] {
+			require.True(t, size >= 11 && size <= 23, "a record of %d bytes", size)
+		}
+		require.True(t, sizes[len(sizes)-1] >= 1 && sizes[len(sizes)-1] <= 23)
+		require.Greater(t, len(sizes), 1521/24)
+	}
+}
+
+func TestHelloRecordsEachAWriteWithDelay(t *testing.T) {
+	t.Parallel()
+	conn, under := masked(t, `{"tcp":[{"type":"fragment","packets":"tlshello","length":"200","delay":"1-2"}]}`)
+	message := hello(1000)
+	_, err := conn.Write(message)
+	require.NoError(t, err)
+	require.Len(t, under.writes, 5)
+	payload, sizes := records(t, bytes.Join(under.writes, nil))
+	require.Equal(t, message[5:], payload)
+	require.Equal(t, []int{200, 200, 200, 200, 200}, sizes)
+}
+
+func TestHelloLengthsAndMaxSplit(t *testing.T) {
+	t.Parallel()
+	conn, under := masked(t, `{"tcp":[{"type":"fragment","packets":"tlshello","lengths":["1","5",{"from":100,"to":100}],"max_split":"4"}]}`)
+	message := hello(600)
+	_, err := conn.Write(message)
+	require.NoError(t, err)
+	payload, sizes := records(t, under.writes[0])
+	require.Equal(t, message[5:], payload)
+	require.Equal(t, []int{1, 5, 100, 494}, sizes, "the last of max_split pieces takes the rest")
+}
+
+func TestHelloOnlyTheFirstWrite(t *testing.T) {
+	t.Parallel()
+	conn, under := masked(t, `{"tcp":[{"type":"fragment","packets":"tlshello","length":"11-24"}]}`)
+	plain := []byte("GET / HTTP/1.1\r\n\r\n")
+	_, err := conn.Write(plain)
+	require.NoError(t, err)
+	require.True(t, conn.WriterReplaceable())
+	message := hello(300)
+	_, err = conn.Write(message)
+	require.NoError(t, err)
+	require.Equal(t, [][]byte{plain, message}, under.writes, "not a hello first: nothing is cut, and later writes are not looked at")
+}
+
+func TestHelloWithMoreAfterTheRecord(t *testing.T) {
+	t.Parallel()
+	conn, under := masked(t, `{"tcp":[{"type":"fragment","packets":"tlshello","length":"50"}]}`)
+	message := hello(120)
+	extra := []byte{23, 3, 3, 0, 1, 9}
+	n, err := conn.Write(append(append([]byte(nil), message...), extra...))
+	require.NoError(t, err)
+	require.Equal(t, len(message)+len(extra), n)
+	require.Len(t, under.writes, 2)
+	payload, sizes := records(t, under.writes[0])
+	require.Equal(t, message[5:], payload)
+	require.Equal(t, []int{50, 50, 20}, sizes)
+	require.Equal(t, extra, under.writes[1])
+}
+
+func TestPacketsRange(t *testing.T) {
+	t.Parallel()
+	conn, under := masked(t, `{"tcp":[{"type":"fragment","packets":"2-3","length":"3"}]}`)
+	for _, text := range []string{"first", "second", "third!", "fourth"} {
+		_, err := conn.Write([]byte(text))
+		require.NoError(t, err)
+	}
+	require.Equal(t, []string{"first", "sec", "ond", "thi", "rd!", "fourth"}, texts(under.writes))
+	require.True(t, conn.WriterReplaceable())
+}
+
+func TestPacketsEvery(t *testing.T) {
+	t.Parallel()
+	conn, under := masked(t, `{"tcp":[{"type":"fragment","length":"4"}]}`)
+	for _, text := range []string{"abcdefgh", "ijkl"} {
+		_, err := conn.Write([]byte(text))
+		require.NoError(t, err)
+	}
+	require.Equal(t, []string{"abcd", "efgh", "ijkl"}, texts(under.writes))
+	require.False(t, conn.WriterReplaceable(), "every write is cut: the mask never steps aside")
+}
+
+func TestCloseEndsThePause(t *testing.T) {
+	t.Parallel()
+	conn, _ := masked(t, `{"tcp":[{"type":"fragment","packets":"1-1","length":"1","delay":"60000"}]}`)
+	done := make(chan error, 1)
+	go func() {
+		_, err := conn.Write([]byte("abc"))
+		done <- err
+	}()
+	time.Sleep(50 * time.Millisecond)
+	require.NoError(t, conn.Close())
+	select {
+	case err := <-done:
+		require.ErrorIs(t, err, net.ErrClosed)
+	case <-time.After(5 * time.Second):
+		t.Fatal("the pause did not end with the connection")
+	}
+}
+
+func TestOptionErrors(t *testing.T) {
+	t.Parallel()
+	for name, content := range map[string]string{
+		"another mask":        `{"tcp":[{"type":"header-custom"}]}`,
+		"no length":           `{"tcp":[{"type":"fragment","packets":"tlshello"}]}`,
+		"a last length of 0":  `{"tcp":[{"type":"fragment","lengths":["5","0-3"]}]}`,
+		"packets from 0":      `{"tcp":[{"type":"fragment","packets":"0-2","length":"5"}]}`,
+		"packets not a range": `{"tcp":[{"type":"fragment","packets":"hello","length":"5"}]}`,
+	} {
+		var options option.FinalMaskOptions
+		err := json.Unmarshal([]byte(content), &options)
+		if err == nil {
+			_, err = New(&options)
+		}
+		require.Error(t, err, name)
+	}
+	masks, err := New(nil)
+	require.NoError(t, err)
+	require.Nil(t, masks)
+}
+
+func texts(writes [][]byte) []string {
+	var result []string
+	for _, write := range writes {
+		result = append(result, string(write))
+	}
+	return result
+}
+
+func TestNotReplaceableBeforeTheFirstWrite(t *testing.T) {
+	t.Parallel()
+	for _, content := range []string{
+		`{"tcp":[{"type":"fragment","packets":"tlshello","length":"11-24"}]}`,
+		`{"tcp":[{"type":"fragment","packets":"1-2","length":"3"}]}`,
+		`{"tcp":[{"type":"fragment","length":"3"}]}`,
+	} {
+		conn, _ := masked(t, content)
+		require.False(t, conn.WriterReplaceable(), "a copy loop must not reach the socket before the mask has cut: %s", content)
+		require.True(t, conn.ReaderReplaceable())
+	}
+}
+
+func TestHelloNotCut(t *testing.T) {
+	t.Parallel()
+	for name, first := range map[string][]byte{
+		// a record of no byte, and a record after it: Xray would lose the header
+		"an empty record": {22, 3, 1, 0, 0, 22, 3, 1, 0, 1, 1},
+		// a handshake record that is not a ClientHello (type 2): not a client's first write
+		"not a ClientHello": append([]byte{22, 3, 3, 0, 40, 2}, make([]byte, 39)...),
+		// what only looks like a record: the salt of Shadowsocks starting with 0x16
+		"not TLS": append([]byte{22, 9, 9, 0, 20, 1}, make([]byte, 30)...),
+	} {
+		conn, under := masked(t, `{"tcp":[{"type":"fragment","packets":"tlshello","length":"2"}]}`)
+		n, err := conn.Write(first)
+		require.NoError(t, err)
+		require.Equal(t, len(first), n)
+		require.Equal(t, [][]byte{first}, under.writes, name)
+	}
+}
+
+func TestRangesAsXrayDrawsThem(t *testing.T) {
+	t.Parallel()
+	// crypto.RandBetween of Xray: "11-12" is always 11, "11-14" never 14
+	for range 20 {
+		conn, under := masked(t, `{"tcp":[{"type":"fragment","packets":"tlshello","length":"11-12","delay":0}]}`)
+		_, err := conn.Write(hello(110))
+		require.NoError(t, err)
+		_, sizes := records(t, under.writes[0])
+		require.Equal(t, []int{11, 11, 11, 11, 11, 11, 11, 11, 11, 11}, sizes)
+	}
+	seen := map[int]bool{}
+	for range 50 {
+		conn, under := masked(t, `{"tcp":[{"type":"fragment","packets":"tlshello","length":"11-14","delay":0}]}`)
+		_, err := conn.Write(hello(600))
+		require.NoError(t, err)
+		_, sizes := records(t, under.writes[0])
+		for _, size := range sizes[:len(sizes)-1] {
+			seen[size] = true
+		}
+	}
+	require.Equal(t, map[int]bool{11: true, 12: true, 13: true}, seen)
+}
+
+func TestHugeLength(t *testing.T) {
+	t.Parallel()
+	conn, under := masked(t, `{"tcp":[{"type":"fragment","packets":"1-1","lengths":["5","2147483647"]}]}`)
+	_, err := conn.Write(bytes.Repeat([]byte{7}, 40))
+	require.NoError(t, err)
+	require.Equal(t, []int{5, 35}, sizesOf(under.writes))
+}
+
+func TestDeadlineEndsThePause(t *testing.T) {
+	t.Parallel()
+	conn, under := masked(t, `{"tcp":[{"type":"fragment","packets":"1-1","length":"1","delay":"60000"}]}`)
+	require.NoError(t, conn.SetWriteDeadline(time.Now().Add(100*time.Millisecond)))
+	started := time.Now()
+	n, err := conn.Write([]byte("abc"))
+	require.ErrorIs(t, err, os.ErrDeadlineExceeded)
+	require.Equal(t, 1, n, "the piece before the pause is written")
+	require.Less(t, time.Since(started), 5*time.Second)
+	require.Equal(t, []string{"a"}, texts(under.writes))
+	require.NoError(t, conn.SetWriteDeadline(time.Time{}))
+}
+
+func sizesOf(writes [][]byte) []int {
+	var sizes []int
+	for _, write := range writes {
+		sizes = append(sizes, len(write))
+	}
+	return sizes
+}
