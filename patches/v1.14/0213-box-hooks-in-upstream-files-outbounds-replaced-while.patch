From 7d5475f6075b1ec1745b3a930b15cde787a6db16 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Thu, 12 Nov 2026 21:41:20 +0300
Subject: [PATCH 16/59] box, hooks in upstream files: outbounds replaced while
 the box runs

The lines of upstream files that "box: outbounds replaced while the box runs" needs; the feature
itself is its patch of layer 03, in files of its own.

Pdk-Feature: hot-swap
Pdk-Zone: core
Pdk-Layer: 02
---
 box.go                  | 1 +
 common/dialer/detour.go | 5 ++++-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/box.go b/box.go
index b409d3ab8..3ebc8eb7b 100644
--- a/box.go
+++ b/box.go
@@ -59,6 +59,7 @@ type Box struct {
 	internalService     []adapter.LifecycleService
 	ntpService          *ntp.Service
 	scope               *adapter.Scope
+	hot                 hotOutbounds // outbounds changed while the box runs (podkop-engine)
 }
 
 type Options struct {
diff --git a/common/dialer/detour.go b/common/dialer/detour.go
index b2fc3efa0..7873fd1d6 100644
--- a/common/dialer/detour.go
+++ b/common/dialer/detour.go
@@ -51,7 +51,10 @@ func InitializeDetour(dialer N.Dialer) error {
 
 func (d *DetourDialer) Dialer() (N.Dialer, error) {
 	d.initOnce.Do(d.init)
-	return d.dialer, d.initErr
+	if d.initErr != nil {
+		return nil, d.initErr
+	}
+	return d.current(), nil
 }
 
 func (d *DetourDialer) init() {
-- 
2.53.0

