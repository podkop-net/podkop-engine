+//go:build linux
+
+package probesock
+
+import (
+	"encoding/binary"
+	"net"
+	"net/netip"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+	"unsafe"
+
+	"github.com/sagernet/sing/common/control"
+	E "github.com/sagernet/sing/common/exceptions"
+
+	"golang.org/x/net/bpf"
+	"golang.org/x/sys/unix"
+)
+
+// clampWindow holds the window a connection offers to window bytes: its receive buffer and the
+// clamp of its window. Set once the connection is established and before data moves, it leaves
+// the window scale the connect chose by the system maximum: a buffer set before the connect has
+// the kernel choose the scale by it (tcp_connect_init clamps the window to a buffer the user
+// set), and the window could never grow past 64 KB again. The buffer is set too, not the clamp
+// alone: the kernel's tuning of a buffer the user did not set moves the clamp along with it.
+// The connection keeps the buffer it is given (restoreWindow).
+func clampWindow(conn *net.TCPConn, window int) error {
+	return holdWindow(conn, window, window)
+}
+
+// holdWindow sets the receive buffer of a connection to buffer bytes (the kernel doubles what it
+// is given, as the bookkeeping counts) and the clamp of its window to window bytes.
+func holdWindow(conn *net.TCPConn, buffer int, window int) error {
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return err
+	}
+	return control.Raw(raw, func(fd uintptr) error {
+		if err := setBuffer(int(fd), buffer); err != nil {
+			return err
+		}
+		return unix.SetsockoptInt(int(fd), unix.IPPROTO_TCP, unix.TCP_WINDOW_CLAMP, window)
+	})
+}
+
+// setBuffer sets the receive buffer of a socket to size bytes, doubled by the kernel:
+// SO_RCVBUFFORCE passes over net.core.rmem_max, small on routers, for a process with
+// CAP_NET_ADMIN.
+func setBuffer(fd int, size int) error {
+	if unix.SetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_RCVBUFFORCE, size) == nil {
+		return nil
+	}
+	return unix.SetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_RCVBUF, size)
+}
+
+var (
+	bufferMaxOnce sync.Once
+	bufferMax     int
+)
+
+// systemBufferMax is the largest receive buffer the system grows a TCP connection to (the
+// last of net.ipv4.tcp_rmem), 4 MB when it cannot be read: the clamp of a window no tuning
+// reaches.
+func systemBufferMax() int {
+	bufferMaxOnce.Do(func() {
+		bufferMax = 4 << 20
+		content, err := os.ReadFile("/proc/sys/net/ipv4/tcp_rmem")
+		if err != nil {
+			return
+		}
+		fields := strings.Fields(string(content))
+		if len(fields) == 3 {
+			if value, err := strconv.Atoi(fields[2]); err == nil && value > 0 {
+				bufferMax = value
+			}
+		}
+	})
+	return bufferMax
+}
+
+// restoreWindow lets the window of a probe connection grow as far as the system lets a TCP
+// connection's once the probe is done: a multiplexed transport (gRPC, HTTP/2, xhttp, mux) keeps
+// the connection a probe dialed in its pool and carries other connections over it. The buffer
+// stays set (no tuning), at the most the tuning would reach: memory is taken only by data that
+// waits to be read.
+func restoreWindow(conn *net.TCPConn) {
+	// half given, as the kernel doubles it: the buffer the tuning would grow it to at most
+	_ = holdWindow(conn, systemBufferMax()/2, systemBufferMax())
+}
+
+type connInfo struct {
+	mss    int
+	minRTT time.Duration
+}
+
+func tcpInfo(conn *net.TCPConn) (connInfo, error) {
+	var info connInfo
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return info, err
+	}
+	var tcp *unix.TCPInfo
+	err = control.Raw(raw, func(fd uintptr) error {
+		var err error
+		tcp, err = unix.GetsockoptTCPInfo(int(fd), unix.IPPROTO_TCP, unix.TCP_INFO)
+		return err
+	})
+	if err != nil {
+		return info, err
+	}
+	info.mss = int(tcp.Rcv_mss)
+	info.minRTT = time.Duration(tcp.Min_rtt) * time.Microsecond
+	return info, nil
+}
+
+// snapLength is how much of a packet the capture keeps: the IP header (IPv6 without
+// extension headers) and the TCP header with its options.
+const snapLength = 128
+
+// capture takes the packets of one TCP connection from a packet socket of every interface,
+// headers only, and counts the incoming sequence.
+type capture struct {
+	fd      int
+	local   netip.AddrPort
+	remote  netip.AddrPort
+	stopped atomic.Bool
+	// stoppedAt is the time of the stop by the clock the kernel stamps the packets with, in
+	// nanoseconds: set before stopped
+	stoppedAt atomic.Int64
+	done      chan struct{}
+
+	access  sync.Mutex
+	counter counter
+	inIndex int // the interface the incoming packets are taken from: the first one seen
+}
+
+func startCapture(conn *net.TCPConn) (*capture, error) {
+	local, err := netip.ParseAddrPort(conn.LocalAddr().String())
+	if err != nil {
+		return nil, err
+	}
+	remote, err := netip.ParseAddrPort(conn.RemoteAddr().String())
+	if err != nil {
+		return nil, err
+	}
+	local = netip.AddrPortFrom(local.Addr().Unmap(), local.Port())
+	remote = netip.AddrPortFrom(remote.Addr().Unmap(), remote.Port())
+	// protocol 0: nothing comes before the filter is on and the socket is bound
+	fd, err := unix.Socket(unix.AF_PACKET, unix.SOCK_DGRAM|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		return nil, E.Cause(err, "open a packet socket")
+	}
+	c := &capture{fd: fd, local: local, remote: remote, done: make(chan struct{})}
+	err = c.setup()
+	if err != nil {
+		unix.Close(fd)
+		return nil, err
+	}
+	go c.run()
+	return c, nil
+}
+
+func htons(value uint16) uint16 {
+	return value<<8 | value>>8
+}
+
+func (c *capture) setup() error {
+	filter, err := incomingFilter(c.local, c.remote)
+	if err != nil {
+		return err
+	}
+	err = unix.SetsockoptSockFprog(c.fd, unix.SOL_SOCKET, unix.SO_ATTACH_FILTER, &unix.SockFprog{Len: uint16(len(filter)), Filter: &filter[0]})
+	if err != nil {
+		return E.Cause(err, "attach the filter")
+	}
+	// what the router sends is not wanted: the kernel does not clone it for this socket
+	// (Linux 4.20 and later; on older ones it is passed over as it is read)
+	_ = unix.SetsockoptInt(c.fd, unix.SOL_PACKET, unix.PACKET_IGNORE_OUTGOING, 1)
+	// a probe is a few hundred packets a second: a megabyte of buffer holds seconds of them
+	_ = setBuffer(c.fd, 1<<20)
+	err = unix.SetsockoptInt(c.fd, unix.SOL_SOCKET, unix.SO_TIMESTAMPNS, 1)
+	if err != nil {
+		return E.Cause(err, "timestamps")
+	}
+	err = unix.SetsockoptTimeval(c.fd, unix.SOL_SOCKET, unix.SO_RCVTIMEO, &unix.Timeval{Usec: 100_000})
+	if err != nil {
+		return err
+	}
+	err = unix.Bind(c.fd, &unix.SockaddrLinklayer{Protocol: htons(unix.ETH_P_ALL)})
+	if err != nil {
+		return E.Cause(err, "bind the packet socket")
+	}
+	return nil
+}
+
+// incomingFilter passes the TCP packets the remote end sends to the local port of the
+// connection, IPv4 not fragmented or IPv6 without extension headers, cut to snapLength.
+// The remote address is matched, the local one is not: a source NAT on the way out (mwan3,
+// a VPN that masquerades) rewrites it before the capture sees the packets come back. A
+// packet of another connection to the same server port that shares the local port (the
+// kernel lets connections to different destinations share one) stays out.
+func incomingFilter(local netip.AddrPort, remote netip.AddrPort) ([]unix.SockFilter, error) {
+	ports := uint32(remote.Port())<<16 | uint32(local.Port())
+	var program []bpf.Instruction
+	var drops []int // the jumps to the drop at the end, their skips set once it is placed
+	require := func(value uint32) {
+		drops = append(drops, len(program))
+		program = append(program, bpf.JumpIf{Cond: bpf.JumpEqual, Val: value})
+	}
+	program = append(program, bpf.LoadAbsolute{Off: 0, Size: 1}, bpf.ALUOpConstant{Op: bpf.ALUOpAnd, Val: 0xf0})
+	address := remote.Addr()
+	if address.Is4() {
+		require(0x40)
+		program = append(program, bpf.LoadAbsolute{Off: 9, Size: 1})
+		require(unix.IPPROTO_TCP)
+		// a fragment carries no TCP header where one is looked for
+		program = append(program, bpf.LoadAbsolute{Off: 6, Size: 2}, bpf.ALUOpConstant{Op: bpf.ALUOpAnd, Val: 0x1fff})
+		require(0)
+		bytes := address.As4()
+		program = append(program, bpf.LoadAbsolute{Off: 12, Size: 4})
+		require(binary.BigEndian.Uint32(bytes[:]))
+		program = append(program, bpf.LoadMemShift{Off: 0}, bpf.LoadIndirect{Off: 0, Size: 4})
+		require(ports)
+	} else {
+		require(0x60)
+		program = append(program, bpf.LoadAbsolute{Off: 6, Size: 1})
+		require(unix.IPPROTO_TCP)
+		bytes := address.As16()
+		for word := 0; word < 4; word++ {
+			program = append(program, bpf.LoadAbsolute{Off: uint32(8 + 4*word), Size: 4})
+			require(binary.BigEndian.Uint32(bytes[4*word:]))
+		}
+		program = append(program, bpf.LoadAbsolute{Off: 40, Size: 4})
+		require(ports)
+	}
+	program = append(program, bpf.RetConstant{Val: snapLength})
+	drop := len(program)
+	program = append(program, bpf.RetConstant{Val: 0})
+	for _, index := range drops {
+		jump := program[index].(bpf.JumpIf)
+		skip := drop - index - 1
+		if skip > 255 {
+			return nil, E.New("the filter is too long")
+		}
+		jump.SkipFalse = uint8(skip)
+		program[index] = jump
+	}
+	raw, err := bpf.Assemble(program)
+	if err != nil {
+		return nil, E.Cause(err, "assemble the filter")
+	}
+	filter := make([]unix.SockFilter, len(raw))
+	for i, instruction := range raw {
+		filter[i] = unix.SockFilter{Code: instruction.Op, Jt: instruction.Jt, Jf: instruction.Jf, K: instruction.K}
+	}
+	return filter, nil
+}
+
+// drainLimit bounds the reading of what the socket still holds once the capture is stopped. Its
+// buffer (a megabyte, doubled by the kernel) holds some thousands of packets: on an x86 host the
+// capture read 480 thousand a second under a flood, and a stop under that flood took 12 ms
+// (TestCaptureStopUnderFlood). A far end that goes on sending, to a connection closed or not,
+// must not keep the capture, and the probe that waits for it, for good.
+const drainLimit = time.Second
+
+func (c *capture) run() {
+	defer close(c.done)
+	buffer := make([]byte, snapLength)
+	oob := make([]byte, unix.CmsgSpace(int(unsafe.Sizeof(unix.Timespec{}))))
+	var drainUntil time.Time
+	for {
+		flags := 0
+		if c.stopped.Load() {
+			// what came before the stop is read without waiting, then the capture ends: when the
+			// socket is empty, at the first packet that came after the stop, or at drainLimit
+			flags = unix.MSG_DONTWAIT
+			now := time.Now()
+			if drainUntil.IsZero() {
+				drainUntil = now.Add(drainLimit)
+			} else if now.After(drainUntil) {
+				return
+			}
+		}
+		n, oobn, _, from, err := unix.Recvmsg(c.fd, buffer, oob, flags)
+		if err != nil {
+			if err == unix.EAGAIN || err == unix.EINTR {
+				if c.stopped.Load() && flags != 0 {
+					return
+				}
+				continue
+			}
+			return
+		}
+		at, hasTime := packetTime(oob[:oobn])
+		if flags != 0 && hasTime && at.UnixNano() > c.stoppedAt.Load() {
+			return
+		}
+		link, isLink := from.(*unix.SockaddrLinklayer)
+		if !isLink || link.Pkttype == unix.PACKET_OUTGOING {
+			continue
+		}
+		if !hasTime {
+			at = time.Now()
+		}
+		if !c.take(buffer[:n], link.Ifindex, at) {
+			// no stream of a probe (the counter is broken): nothing more is read, and the kernel
+			// drops what the socket has no room for
+			return
+		}
+	}
+}
+
+// packetTime reads the kernel's receive time of a packet: a struct timespec of the platform
+// (32-bit fields on the 32-bit routers).
+func packetTime(oob []byte) (time.Time, bool) {
+	messages, err := unix.ParseSocketControlMessage(oob)
+	if err != nil {
+		return time.Time{}, false
+	}
+	for _, message := range messages {
+		if message.Header.Level == unix.SOL_SOCKET && message.Header.Type == unix.SCM_TIMESTAMPNS && len(message.Data) >= int(unsafe.Sizeof(unix.Timespec{})) {
+			spec := *(*unix.Timespec)(unsafe.Pointer(&message.Data[0]))
+			return time.Unix(int64(spec.Sec), int64(spec.Nsec)), true
+		}
+	}
+	return time.Time{}, false
+}
+
+// take counts an incoming packet of the connection: the addresses are checked here, and
+// only the first interface that brought one is believed (a packet may be seen on a device
+// and on the device under it). It returns false when the counter is broken: the capture has
+// nothing more to read.
+func (c *capture) take(packet []byte, index int, at time.Time) bool {
+	if len(packet) < 20 {
+		return true
+	}
+	var (
+		source  netip.Addr
+		tcp     []byte
+		payload int
+	)
+	switch packet[0] >> 4 {
+	case 4:
+		headerLength := int(packet[0]&0x0f) * 4
+		if len(packet) < headerLength+20 {
+			return true
+		}
+		source = netip.AddrFrom4([4]byte(packet[12:16]))
+		tcp = packet[headerLength:]
+		payload = int(binary.BigEndian.Uint16(packet[2:4])) - headerLength - int(tcp[12]>>4)*4
+	case 6:
+		if len(packet) < 60 {
+			return true
+		}
+		source = netip.AddrFrom16([16]byte(packet[8:24]))
+		tcp = packet[40:]
+		payload = int(binary.BigEndian.Uint16(packet[4:6])) - int(tcp[12]>>4)*4
+	default:
+		return true
+	}
+	// the local address is not matched: a source NAT on the way rewrites it (incomingFilter)
+	if source != c.remote.Addr() ||
+		binary.BigEndian.Uint16(tcp[0:2]) != c.remote.Port() || binary.BigEndian.Uint16(tcp[2:4]) != c.local.Port() {
+		return true
+	}
+	c.access.Lock()
+	defer c.access.Unlock()
+	if c.inIndex == 0 {
+		c.inIndex = index
+	} else if index != c.inIndex {
+		return true
+	}
+	c.counter.add(at, binary.BigEndian.Uint32(tcp[4:8]), payload)
+	return !c.counter.Broken
+}
+
+// stop ends the capture once the packets that came before it are read (run: within drainLimit,
+// whatever the far end sends meanwhile), and returns what it counted and how many packets the
+// socket dropped.
+func (c *capture) stop() (*counter, int) {
+	c.stoppedAt.CompareAndSwap(0, time.Now().UnixNano())
+	if c.stopped.Swap(true) {
+		return &counter{}, 0
+	}
+	<-c.done
+	dropped := 0
+	if stats, err := unix.GetsockoptTpacketStats(c.fd, unix.SOL_PACKET, unix.PACKET_STATISTICS); err == nil {
+		dropped = int(stats.Drops)
+	}
+	unix.Close(c.fd)
+	c.access.Lock()
+	defer c.access.Unlock()
+	return &c.counter, dropped
+}
diff --git a/common/probesock/capture_linux_test.go b/common/probesock/capture_linux_test.go
new file mode 100644
index 000000000..b9f32135d
--- /dev/null
+++ b/common/probesock/capture_linux_test.go
@@ -0,0 +1,298 @@
+//go:build linux
+
+package probesock
+
+import (
+	"context"
+	"encoding/binary"
+	"io"
+	"net"
+	"net/netip"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/common/control"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+func serve(t *testing.T, size int) string {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	t.Cleanup(func() { listener.Close() })
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			go func() {
+				defer conn.Close()
+				// the client speaks first, as through a proxy: nothing comes before the
+				// capture is on
+				request := make([]byte, 1)
+				if _, err := io.ReadFull(conn, request); err != nil {
+					return
+				}
+				conn.Write(make([]byte, size))
+			}()
+		}
+	}()
+	return listener.Addr().String()
+}
+
+func skipWithoutCapture(t *testing.T, err error) {
+	if err != nil && strings.Contains(err.Error(), "operation not permitted") {
+		t.Skip("no CAP_NET_RAW: ", err)
+	}
+}
+
+// The probe connection of a context: a small receive buffer, and every byte of it counted
+// once over the loopback (seen there both as sent and as received), nothing lost.
+func TestCaptureLoopback(t *testing.T) {
+	const size = 1 << 20
+	address := serve(t, size)
+	ctx, socket := With(context.Background(), Window)
+	conn, err := socket.Dial(ctx, net.Dialer{}, "tcp", address)
+	require.NoError(t, err)
+	defer conn.Close()
+	raw, err := conn.(*net.TCPConn).SyscallConn()
+	require.NoError(t, err)
+	clamp := func() int {
+		var value int
+		require.NoError(t, control.Raw(raw, func(fd uintptr) error {
+			var err error
+			value, err = unix.GetsockoptInt(int(fd), unix.IPPROTO_TCP, unix.TCP_WINDOW_CLAMP)
+			return err
+		}))
+		return value
+	}
+	// the window of the probe is clamped once the connection is established
+	require.Equal(t, Window, clamp())
+	_, err = conn.Write([]byte{1})
+	require.NoError(t, err)
+	received, err := io.Copy(io.Discard, conn)
+	require.NoError(t, err)
+	require.Equal(t, int64(size), received)
+	result, err := socket.Finish()
+	skipWithoutCapture(t, err)
+	require.NoError(t, err)
+	require.Zero(t, result.Dropped)
+	require.Equal(t, int64(size), result.Bytes)
+	// the probe done, the connection may carry other traffic: its window may grow again, its
+	// buffer no larger than the kernel's tuning would make it
+	require.Equal(t, systemBufferMax(), clamp())
+	require.NoError(t, control.Raw(raw, func(fd uintptr) error {
+		buffer, err := unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_RCVBUF)
+		if err == nil && buffer > systemBufferMax() {
+			t.Errorf("the buffer is %d, the tuning stops at %d", buffer, systemBufferMax())
+		}
+		return err
+	}))
+	require.Zero(t, result.Lost)
+	require.Zero(t, result.DupBytes)
+	require.Positive(t, result.Segments)
+	require.Positive(t, result.RTT)
+}
+
+// Only the first dial under the context is the probe connection.
+func TestSecondDialOrdinary(t *testing.T) {
+	address := serve(t, 64<<10)
+	ctx, socket := With(context.Background(), Window)
+	first, err := socket.Dial(ctx, net.Dialer{}, "tcp", address)
+	require.NoError(t, err)
+	defer first.Close()
+	second, err := socket.Dial(ctx, net.Dialer{}, "tcp", address)
+	require.NoError(t, err)
+	defer second.Close()
+	_, err = first.Write([]byte{1})
+	require.NoError(t, err)
+	_, err = second.Write([]byte{1})
+	require.NoError(t, err)
+	_, err = io.Copy(io.Discard, second)
+	require.NoError(t, err)
+	_, err = io.Copy(io.Discard, first)
+	require.NoError(t, err)
+	result, err := socket.Finish()
+	skipWithoutCapture(t, err)
+	require.NoError(t, err)
+	require.Equal(t, int64(64<<10), result.Bytes)
+	require.Nil(t, From(Without(ctx)))
+}
+
+// Without a dial there is nothing to count.
+func TestFinishWithoutDial(t *testing.T) {
+	_, socket := With(context.Background(), Window)
+	_, err := socket.Finish()
+	require.Error(t, err)
+	socket.Close()
+}
+
+// A dial under the context of a probe that is over is an ordinary connection: no capture is
+// started that nobody would stop.
+func TestSealedAfterClose(t *testing.T) {
+	address := serve(t, 64<<10)
+	ctx, socket := With(context.Background(), Window)
+	socket.Close()
+	conn, err := socket.Dial(ctx, net.Dialer{}, "tcp", address)
+	require.NoError(t, err)
+	defer conn.Close()
+	socket.access.Lock()
+	require.Nil(t, socket.capture)
+	require.Nil(t, socket.conn)
+	socket.access.Unlock()
+	_, err = socket.Finish()
+	require.ErrorIs(t, err, ErrNoOwnConnection)
+}
+
+// flood sends TCP segments with the addresses of a connection, as its far end would, from raw
+// sockets (workers at once), until the returned function is called: each of a byte of data, with
+// the sequence number sequence gives for its count. Their checksums are wrong: the kernel's TCP
+// drops them, the capture, which sees every packet before that, takes them.
+func flood(t *testing.T, local net.Addr, remote net.Addr, workers int, sequence func(count uint32) uint32) (stop func() int64) {
+	t.Helper()
+	localPort, remotePort := netip.MustParseAddrPort(local.String()), netip.MustParseAddrPort(remote.String())
+	var (
+		sent    atomic.Int64
+		count   atomic.Uint32
+		stopped atomic.Bool
+		group   sync.WaitGroup
+	)
+	for worker := 0; worker < workers; worker++ {
+		fd, err := unix.Socket(unix.AF_INET, unix.SOCK_RAW|unix.SOCK_CLOEXEC, unix.IPPROTO_RAW)
+		if err != nil {
+			t.Skip("no raw socket: ", err)
+		}
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			defer unix.Close(fd)
+			packet := make([]byte, 41)
+			packet[0], packet[8], packet[9] = 0x45, 64, unix.IPPROTO_TCP
+			binary.BigEndian.PutUint16(packet[2:], uint16(len(packet)))
+			source, destination := remotePort.Addr().As4(), localPort.Addr().As4()
+			copy(packet[12:], source[:])
+			copy(packet[16:], destination[:])
+			binary.BigEndian.PutUint16(packet[20:], remotePort.Port())
+			binary.BigEndian.PutUint16(packet[22:], localPort.Port())
+			packet[32], packet[33] = 5<<4, 0x10
+			to := &unix.SockaddrInet4{Addr: destination}
+			for !stopped.Load() {
+				binary.BigEndian.PutUint32(packet[24:], sequence(count.Add(1)))
+				if unix.Sendto(fd, packet, 0, to) == nil {
+					sent.Add(1)
+				}
+			}
+		}()
+	}
+	return func() int64 {
+		stopped.Store(true)
+		group.Wait()
+		return sent.Load()
+	}
+}
+
+// probed opens a probe connection, downloads size bytes over it and returns the socket with the
+// capture still on, and the sequence number of the first byte the capture counted.
+func probed(t *testing.T, size int) (*Socket, net.Conn, uint32) {
+	t.Helper()
+	address := serve(t, size)
+	ctx, socket := With(context.Background(), Window)
+	conn, err := socket.Dial(ctx, net.Dialer{}, "tcp", address)
+	require.NoError(t, err)
+	t.Cleanup(func() { conn.Close() })
+	socket.access.Lock()
+	capture, captureErr := socket.capture, socket.err
+	socket.access.Unlock()
+	skipWithoutCapture(t, captureErr)
+	require.NoError(t, captureErr)
+	_, err = conn.Write([]byte{1})
+	require.NoError(t, err)
+	received, err := io.Copy(io.Discard, conn)
+	require.NoError(t, err)
+	require.Equal(t, int64(size), received)
+	var base uint32
+	require.Eventually(t, func() bool {
+		capture.access.Lock()
+		defer capture.access.Unlock()
+		base = capture.counter.base
+		return capture.counter.highest >= int64(size)
+	}, 5*time.Second, time.Millisecond)
+	return socket, conn, base
+}
+
+// finishWithin ends the probe and fails the test when that takes longer than limit.
+func finishWithin(t *testing.T, socket *Socket, limit time.Duration) (Result, time.Duration) {
+	t.Helper()
+	type finished struct {
+		result Result
+		err    error
+	}
+	done := make(chan finished, 1)
+	start := time.Now()
+	go func() {
+		result, err := socket.Finish()
+		done <- finished{result, err}
+	}()
+	select {
+	case end := <-done:
+		require.NoError(t, end.err)
+		return end.result, time.Since(start)
+	case <-time.After(limit):
+		t.Fatalf("the probe did not end within %v: the capture goes on reading", limit)
+		return Result{}, 0
+	}
+}
+
+// A far end that never stops sending (packets of data the connection has already, as fast as
+// four senders make them) does not keep the probe: the capture ends at the first packet that
+// came after the stop.
+func TestCaptureStopUnderFlood(t *testing.T) {
+	socket, _, base := probed(t, 64<<10)
+	stop := flood(t, socket.conn.LocalAddr(), socket.conn.RemoteAddr(), 4, func(uint32) uint32 { return base })
+	time.Sleep(time.Second)
+	socket.access.Lock()
+	capture := socket.capture
+	socket.access.Unlock()
+	capture.access.Lock()
+	before := capture.counter.Packets
+	capture.access.Unlock()
+	time.Sleep(time.Second)
+	capture.access.Lock()
+	rate := capture.counter.Packets - before
+	capture.access.Unlock()
+	result, took := finishWithin(t, socket, drainLimit+2*time.Second)
+	sent := stop()
+	t.Logf("the flood: %d packets sent, the capture read %d a second, dropped %d; the stop took %v", sent, rate, result.Dropped, took)
+	require.False(t, result.Broken)
+	require.Less(t, took, drainLimit+500*time.Millisecond)
+	require.Equal(t, int64(64<<10), result.Bytes)
+}
+
+// A far end that sends holes without end (every packet three bytes past the one before) is told
+// as no stream of a probe: the capture stops reading at maxHoles holes, keeps none of them, and
+// the probe ends at once.
+func TestCaptureHolesWithoutEnd(t *testing.T) {
+	socket, _, base := probed(t, 64<<10)
+	stop := flood(t, socket.conn.LocalAddr(), socket.conn.RemoteAddr(), 1, func(count uint32) uint32 { return base + 1<<20 + 3*count })
+	socket.access.Lock()
+	capture := socket.capture
+	socket.access.Unlock()
+	select {
+	case <-capture.done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("the capture goes on reading holes without end")
+	}
+	capture.access.Lock()
+	require.True(t, capture.counter.Broken)
+	require.Nil(t, capture.counter.holes)
+	capture.access.Unlock()
+	result, took := finishWithin(t, socket, 2*time.Second)
+	sent := stop()
+	t.Logf("the flood: %d packets sent; the stop took %v", sent, took)
+	require.True(t, result.Broken)
+}
