diff --git a/common/probesock/count.go b/common/probesock/count.go
new file mode 100644
index 000000000..f29264e0b
--- /dev/null
+++ b/common/probesock/count.go
@@ -0,0 +1,154 @@
+// Package probesock counts what a probe connection lost on its way to this host
+// (podkop-engine).
+//
+// A loss probe downloads through a server over a TCP connection of its own, opened with a
+// small receive buffer: the window the host offers stays at a few segments, so the server
+// never sends a burst that a shallow queue on the way (the subscriber's line, mostly) would
+// drop. Loss the probe made itself would show on every server alike. While the probe runs,
+// the headers of the packets of its connection are captured, and the incoming sequence is
+// followed: a hole a later packet fills is reordering when it is filled sooner than a
+// quarter of the RTT, and a loss when filled later, by the retransmission of the lost
+// segment. The kernel's own counters cannot tell the two apart: its count of out-of-order
+// packets grows with the window, not with the loss, and calls a server that reorders lossy.
+package probesock
+
+import (
+	"time"
+)
+
+// Counts are what the capture saw of the incoming data of the probe connection.
+type Counts struct {
+	Packets      int   // incoming packets with data
+	Bytes        int64 // the sequence space they covered, once
+	Holes        int   // gaps in the sequence that opened
+	LostBytes    int64 // bytes of holes filled late: retransmitted
+	LostFills    int   // packets that filled a hole late
+	ReorderBytes int64 // bytes of holes filled soon: reordered
+	DupBytes     int64 // bytes that came twice
+	Unfilled     int64 // bytes of holes still open at the end
+}
+
+// minReorderWindow is the least time a hole may take to fill and still be reordering: a
+// quarter of the RTT, but not less than this, so that the scheduling of the capture on a
+// nearby server does not turn reordering into loss.
+const minReorderWindow = 3 * time.Millisecond
+
+// reorderWindow is that time for a connection whose connect took rtt.
+func reorderWindow(rtt time.Duration) time.Duration {
+	return max(rtt/4, minReorderWindow)
+}
+
+type hole struct {
+	start, end int64
+	at         time.Time
+}
+
+// fill is a piece of a hole a packet filled: how long the hole had been open, and its bytes.
+// The pieces are told apart (reordering or loss) only at the end, by the least RTT of the
+// connection: the time of its connect, which a busy host or server stretches, would call
+// retransmissions reordering.
+type fill struct {
+	packet int
+	age    time.Duration
+	bytes  int64
+}
+
+// counter follows the incoming sequence of one connection, packet by packet.
+type counter struct {
+	started bool
+	base    uint32
+	highest int64
+	holes   []hole
+	fills   []fill
+	Counts
+}
+
+// maxAhead bounds how far past the highest byte a packet may start: a sequence number
+// further away is not of this stream (an older packet, wrapped around).
+const maxAhead = 1 << 30
+
+// add takes an incoming packet with payload bytes of data starting at seq, captured at at.
+func (c *counter) add(at time.Time, seq uint32, payload int) {
+	if payload <= 0 {
+		return
+	}
+	if !c.started {
+		c.base, c.started = seq, true
+	}
+	start := int64(seq - c.base)
+	if start > c.highest+maxAhead {
+		return
+	}
+	end := start + int64(payload)
+	c.Packets++
+	if start > c.highest {
+		c.holes = append(c.holes, hole{c.highest, start, at})
+		c.Holes++
+		c.highest = end
+		return
+	}
+	limit := min(end, c.highest)
+	covered := int64(0)
+	// a new list: a packet inside a hole splits it in two, and a list filtered in place would
+	// write the second piece over the next hole before it is read
+	kept := make([]hole, 0, len(c.holes)+1)
+	for _, h := range c.holes {
+		from, to := max(start, h.start), min(limit, h.end)
+		if from >= to {
+			kept = append(kept, h)
+			continue
+		}
+		covered += to - from
+		c.fills = append(c.fills, fill{packet: c.Packets, age: at.Sub(h.at), bytes: to - from})
+		if h.start < from {
+			kept = append(kept, hole{h.start, from, h.at})
+		}
+		if to < h.end {
+			kept = append(kept, hole{to, h.end, h.at})
+		}
+	}
+	c.holes = kept
+	c.DupBytes += (limit - start) - covered
+	if end > c.highest {
+		c.highest = end
+	}
+}
+
+// finish returns the counts of the connection so far, the holes filled within window
+// counted as reordering, the others as loss.
+func (c *counter) finish(window time.Duration) Counts {
+	counts := c.Counts
+	counts.Bytes = c.highest
+	for _, h := range c.holes {
+		counts.Unfilled += h.end - h.start
+	}
+	lastLate := -1
+	for _, piece := range c.fills {
+		if piece.age < window {
+			counts.ReorderBytes += piece.bytes
+			continue
+		}
+		counts.LostBytes += piece.bytes
+		if piece.packet != lastLate {
+			counts.LostFills++
+			lastLate = piece.packet
+		}
+	}
+	return counts
+}
+
+// segments turns the counts into segments of size mss: how many the data took, and how many
+// of them were lost (a lost segment is at least one late fill).
+func (c Counts) segments(mss int) (segments int, lost int) {
+	if mss <= 0 {
+		mss = defaultMSS
+	}
+	segments = int((c.Bytes + int64(mss) - 1) / int64(mss))
+	lost = int((c.LostBytes + int64(mss)/2) / int64(mss))
+	lost = max(lost, c.LostFills)
+	return
+}
+
+// defaultMSS is the segment size when the connection does not tell its own: Ethernet, IPv4,
+// TCP timestamps.
+const defaultMSS = 1448
diff --git a/common/probesock/count_test.go b/common/probesock/count_test.go
new file mode 100644
index 000000000..321d6b793
--- /dev/null
+++ b/common/probesock/count_test.go
@@ -0,0 +1,140 @@
+package probesock
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func at(milliseconds int) time.Time {
+	return time.Unix(1000, 0).Add(time.Duration(milliseconds) * time.Millisecond)
+}
+
+func newCounter() *counter {
+	return &counter{}
+}
+
+const testWindow = 10 * time.Millisecond
+
+func TestCounterInOrder(t *testing.T) {
+	c := newCounter()
+	for i := 0; i < 10; i++ {
+		c.add(at(i), uint32(5000+i*1000), 1000)
+	}
+	counts := c.finish(testWindow)
+	require.Equal(t, int64(10000), counts.Bytes)
+	require.Zero(t, counts.Holes)
+	require.Zero(t, counts.LostBytes)
+	require.Equal(t, 10, counts.Packets)
+}
+
+// A hole filled later than the window is a loss: the retransmission of the segment.
+func TestCounterLoss(t *testing.T) {
+	c := newCounter()
+	c.add(at(0), 0, 1000)
+	c.add(at(1), 1000, 1000)
+	c.add(at(2), 3000, 1000)
+	c.add(at(3), 4000, 1000)
+	c.add(at(100), 2000, 1000)
+	counts := c.finish(testWindow)
+	require.Equal(t, 1, counts.Holes)
+	require.Equal(t, int64(1000), counts.LostBytes)
+	require.Equal(t, 1, counts.LostFills)
+	require.Zero(t, counts.ReorderBytes)
+	require.Zero(t, counts.Unfilled)
+	require.Equal(t, int64(5000), counts.Bytes)
+}
+
+// A hole filled within the window is reordering, not a loss.
+func TestCounterReorder(t *testing.T) {
+	c := newCounter()
+	c.add(at(0), 0, 1000)
+	c.add(at(1), 2000, 1000)
+	c.add(at(2), 1000, 1000)
+	counts := c.finish(testWindow)
+	require.Equal(t, int64(1000), counts.ReorderBytes)
+	require.Zero(t, counts.LostBytes)
+	require.Zero(t, counts.LostFills)
+}
+
+func TestCounterDuplicateAndUnfilled(t *testing.T) {
+	c := newCounter()
+	c.add(at(0), 0, 1000)
+	c.add(at(1), 0, 1000)
+	c.add(at(2), 2000, 1000)
+	counts := c.finish(testWindow)
+	require.Equal(t, int64(1000), counts.DupBytes)
+	require.Equal(t, int64(1000), counts.Unfilled)
+}
+
+// A hole of two segments filled late by two retransmissions is two lost segments.
+func TestCounterPartialFills(t *testing.T) {
+	c := newCounter()
+	c.add(at(0), 0, 1000)
+	c.add(at(1), 3000, 1000)
+	c.add(at(50), 1000, 1000)
+	c.add(at(60), 2000, 1000)
+	counts := c.finish(testWindow)
+	require.Equal(t, int64(2000), counts.LostBytes)
+	require.Equal(t, 2, counts.LostFills)
+	segments, lost := counts.segments(1000)
+	require.Equal(t, 4, segments)
+	require.Equal(t, 2, lost)
+}
+
+// The sequence number wraps around; a number far behind the stream is not taken.
+func TestCounterWrap(t *testing.T) {
+	c := newCounter()
+	c.add(at(0), 0xffffff00, 0x100)
+	c.add(at(1), 0, 1000)
+	c.add(at(2), 0x7fff0000, 1000)
+	counts := c.finish(testWindow)
+	require.Equal(t, int64(0x100+1000), counts.Bytes)
+	require.Zero(t, counts.Holes)
+}
+
+func TestSegments(t *testing.T) {
+	segments, lost := Counts{Bytes: 14480, LostBytes: 1448}.segments(1448)
+	require.Equal(t, 10, segments)
+	require.Equal(t, 1, lost)
+	segments, lost = Counts{Bytes: 14480, LostBytes: 100, LostFills: 2}.segments(0)
+	require.Equal(t, 10, segments)
+	require.Equal(t, 2, lost)
+}
+
+func TestReorderWindow(t *testing.T) {
+	require.Equal(t, minReorderWindow, reorderWindow(time.Millisecond))
+	require.Equal(t, 25*time.Millisecond, reorderWindow(100*time.Millisecond))
+}
+
+// The pieces are told apart by the window given at the end: a longer RTT makes a fill
+// reordering that a shorter one calls a loss.
+func TestCounterWindowAtTheEnd(t *testing.T) {
+	c := newCounter()
+	c.add(at(0), 0, 1000)
+	c.add(at(1), 2000, 1000)
+	c.add(at(30), 1000, 1000)
+	require.Equal(t, int64(1000), c.finish(20*time.Millisecond).LostBytes)
+	require.Equal(t, int64(1000), c.finish(40*time.Millisecond).ReorderBytes)
+	require.Zero(t, c.finish(40*time.Millisecond).LostBytes)
+}
+
+// A packet in the middle of a hole splits it; the holes after it stay as they were.
+func TestCounterSplitKeepsLaterHoles(t *testing.T) {
+	c := newCounter()
+	c.add(at(0), 0, 1000)
+	c.add(at(1), 4000, 1000)
+	c.add(at(2), 6000, 1000)
+	// holes [1000,4000) and [5000,6000); a retransmission lands in the middle of the first
+	c.add(at(50), 2000, 1000)
+	c.add(at(60), 1000, 1000)
+	c.add(at(70), 3000, 1000)
+	c.add(at(80), 5000, 1000)
+	counts := c.finish(testWindow)
+	require.Equal(t, int64(4000), counts.LostBytes)
+	require.Equal(t, 4, counts.LostFills)
+	require.Zero(t, counts.DupBytes)
+	require.Zero(t, counts.Unfilled)
+	require.Equal(t, int64(7000), counts.Bytes)
+}
diff --git a/common/probesock/probesock.go b/common/probesock/probesock.go
new file mode 100644
index 000000000..e3be2ac78
--- /dev/null
+++ b/common/probesock/probesock.go
@@ -0,0 +1,189 @@
+package probesock
+
+import (
+	"context"
+	"net"
+	"sync"
+	"time"
+
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// Window is the most a probe connection offers its server, about a dozen segments. On the
+// stand a 1 MB download with a window of 16-24 KB lost nothing on a 25-packet queue and on a
+// 10 Mbit/s line, where a download with the ordinary window lost 6-13 %, and still showed a
+// random loss of 1 % as 0.8-1.25 %.
+const Window = 20 << 10
+
+type contextKey struct{}
+
+// Socket is the probe connection of a context: the first TCP connection a dialer opens
+// under it (see Dial). One probe, one socket: a context is made for each probe.
+type Socket struct {
+	window int
+
+	access   sync.Mutex
+	taken    bool
+	conn     *net.TCPConn
+	connect  time.Duration
+	capture  *capture
+	err      error
+	restored bool
+	// sealed: the probe is over (Finish or Close). A transport may still dial under its context
+	// afterwards (in the background, with the cancellation taken off): that is an ordinary
+	// connection, with no capture nobody would stop
+	sealed bool
+}
+
+// ErrNoOwnConnection tells that the probe went over no TCP connection of its own: a
+// multiplexed transport took a connection it had, or the transport is not TCP. Probing the
+// member again would not count either.
+var ErrNoOwnConnection = E.New("no connection of its own")
+
+// restore lets the window of the probe connection grow again once the probe has run: a
+// multiplexed transport (gRPC, HTTP/2, xhttp, mux) keeps the connection a probe dialed in its
+// pool and carries other connections over it, which a window of 20 KB would hold to a crawl
+// (on the stand, a gRPC server 25 ms away: 7 Mbit/s). Called under access.
+func (s *Socket) restore() {
+	if s.conn == nil || s.restored {
+		return
+	}
+	s.restored = true
+	restoreWindow(s.conn)
+}
+
+// With returns a context under which the first TCP dial is a probe connection with a
+// receive buffer of window bytes.
+func With(ctx context.Context, window int) (context.Context, *Socket) {
+	socket := &Socket{window: window}
+	return context.WithValue(ctx, contextKey{}, socket), socket
+}
+
+// From returns the probe socket of the context, nil when it has none.
+func From(ctx context.Context) *Socket {
+	socket, _ := ctx.Value(contextKey{}).(*Socket)
+	return socket
+}
+
+// Without returns a context whose dials are no probe connection: for the dials a probe
+// causes on the side, as the queries that resolve the server's name.
+func Without(ctx context.Context) context.Context {
+	if From(ctx) == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, contextKey{}, (*Socket)(nil))
+}
+
+// take reports whether this dial is the probe connection: the first one under the context.
+func (s *Socket) take() bool {
+	if s == nil {
+		return false
+	}
+	s.access.Lock()
+	defer s.access.Unlock()
+	if s.taken || s.sealed {
+		return false
+	}
+	s.taken = true
+	return true
+}
+
+// Dial dials address with dialer. The first dial under the context that connects is the
+// probe connection: once it is established its window is clamped to the window of the probe
+// (the kernel's first window is ten segments, below it) and its packets are captured, before
+// any data moves (the client speaks first through a proxy). Every later dial is an ordinary
+// one.
+func (s *Socket) Dial(ctx context.Context, dialer net.Dialer, network string, address string) (net.Conn, error) {
+	if !s.take() {
+		return dialer.DialContext(ctx, network, address)
+	}
+	start := time.Now()
+	conn, err := dialer.DialContext(ctx, network, address)
+	if err != nil {
+		// the next address of the server, dialed after this one, is the probe connection
+		s.access.Lock()
+		s.taken = false
+		s.access.Unlock()
+		return nil, err
+	}
+	connect := time.Since(start)
+	s.access.Lock()
+	defer s.access.Unlock()
+	if s.sealed {
+		// the probe ended while this dialed: an ordinary connection
+		return conn, nil
+	}
+	s.connect = connect
+	tcpConn, isTCP := conn.(*net.TCPConn)
+	if !isTCP {
+		s.err = E.Cause(ErrNoOwnConnection, "not a TCP connection")
+		return conn, nil
+	}
+	s.conn = tcpConn
+	if s.err = clampWindow(tcpConn, s.window); s.err != nil {
+		// a probe whose window is not held could make its own loss: not counted
+		return conn, nil
+	}
+	s.capture, s.err = startCapture(tcpConn)
+	return conn, nil
+}
+
+// Result is what a probe connection showed.
+type Result struct {
+	Counts
+	Segments int           // segments of data that came
+	Lost     int           // of them lost on the way
+	RTT      time.Duration // the least RTT of the connection, or its connect time
+	MSS      int
+	Dropped  int // packets the capture could not keep: the counts are short
+}
+
+// Finish ends the capture and returns the counts, before the connection is closed (its
+// TCP information is read). An error tells that the probe had no connection of its own to
+// count: the dial went over a connection opened before (a multiplexed transport), over UDP,
+// or the capture could not run.
+func (s *Socket) Finish() (Result, error) {
+	s.access.Lock()
+	defer s.access.Unlock()
+	s.sealed = true
+	var result Result
+	if !s.taken || s.conn == nil {
+		if s.err != nil {
+			return result, s.err
+		}
+		return result, ErrNoOwnConnection
+	}
+	if s.capture == nil {
+		s.restore()
+		return result, E.Cause(s.err, "capture")
+	}
+	result.RTT = s.connect
+	if info, err := tcpInfo(s.conn); err == nil {
+		result.MSS = info.mss
+		if info.minRTT > 0 {
+			result.RTT = info.minRTT
+		}
+	}
+	counter, dropped := s.capture.stop()
+	s.capture = nil
+	s.restore()
+	result.Counts = counter.finish(reorderWindow(result.RTT))
+	result.Dropped = dropped
+	result.Segments, result.Lost = result.Counts.segments(result.MSS)
+	return result, nil
+}
+
+// Close ends a capture that Finish did not end: the probe failed on the way.
+func (s *Socket) Close() {
+	if s == nil {
+		return
+	}
+	s.access.Lock()
+	defer s.access.Unlock()
+	s.sealed = true
+	if s.capture != nil {
+		s.capture.stop()
+		s.capture = nil
+	}
+	s.restore()
+}
diff --git a/common/probesock/window_linux_test.go b/common/probesock/window_linux_test.go
new file mode 100644
index 000000000..f92ab4e5a
--- /dev/null
+++ b/common/probesock/window_linux_test.go
@@ -0,0 +1,57 @@
+//go:build linux
+
+package probesock
+
+import (
+	"context"
+	"io"
+	"net"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// The window of a probe connection that a multiplexed transport keeps for other traffic grows
+// again once the probe is done; left as the probe had it, it holds the traffic to some 16 KB a
+// round trip. Needs a delay on the loopback (PROBESOCK_NETEM=1 after
+// "tc qdisc add dev lo root netem delay 12ms"); skipped otherwise.
+func TestWindowGrowsAfterProbe(t *testing.T) {
+	if os.Getenv("PROBESOCK_NETEM") == "" {
+		t.Skip("needs a delay on lo: tc qdisc add dev lo root netem delay 12ms, PROBESOCK_NETEM=1")
+	}
+	const after = 16 << 20
+	address := serve(t, LossProbeSizeForTest+after)
+	rate := func(restore bool) float64 {
+		ctx, socket := With(context.Background(), Window)
+		conn, err := socket.Dial(ctx, net.Dialer{}, "tcp", address)
+		require.NoError(t, err)
+		defer conn.Close()
+		_, err = conn.Write([]byte{1})
+		require.NoError(t, err)
+		_, err = io.CopyN(io.Discard, conn, LossProbeSizeForTest)
+		require.NoError(t, err)
+		if restore {
+			_, err = socket.Finish()
+			require.NoError(t, err)
+		} else {
+			// the probe as it was before: the capture ends, the window stays
+			socket.access.Lock()
+			socket.capture.stop()
+			socket.capture = nil
+			socket.restored = true
+			socket.access.Unlock()
+		}
+		start := time.Now()
+		received, err := io.CopyN(io.Discard, conn, after)
+		require.NoError(t, err)
+		return float64(received) * 8 / time.Since(start).Seconds() / 1e6
+	}
+	kept, restored := rate(false), rate(true)
+	t.Logf("after the probe: %.1f Mbit/s with the window of the probe, %.1f Mbit/s with it restored", kept, restored)
+	require.Greater(t, restored, 4*kept)
+}
+
+// LossProbeSizeForTest is what the probe reads before the traffic goes on.
+const LossProbeSizeForTest = 256 << 10
