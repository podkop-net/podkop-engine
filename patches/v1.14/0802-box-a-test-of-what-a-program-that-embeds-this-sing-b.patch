+		{"type": "socks", "tag": "B", "server": "127.0.0.1", "server_port": ` + fmt.Sprint(s.mixedPort) + `, "username": "loop", "password": "p"},
+		{"type": "socks", "tag": "dead", "server": "127.0.0.1", "server_port": 1},
+		{"type": "vless", "tag": "stranger", "server": "127.0.0.1", "server_port": ` + fmt.Sprint(s.stranger.Port) + `, ` + embedderUUID + `,
+			"tls": {"enabled": true, "server_name": "www.example.com", "utls": {"enabled": true, "fingerprint": "edge"}, ` + embedderReality + `}},
+		{"type": "urltest", "tag": "reserve-out", "outbounds": ["dead", "B"], "urls": ["` + s.web.URL + `/204"], "interval": "1m", "tolerance": 50,
+			"download_url": "", "mode": "loss", "loss_url": "` + s.web.URL + `/loss"},
+		{"type": "urltest", "tag": "main-urltest-out", "outbounds": ["A"], "urls": ["` + s.web.URL + `/204"], "interval": "1m", "tolerance": 50,
+			"download_url": "` + s.web.URL + `/download", "fallbacks": ["reserve-out", "direct-out", "block"]},
+		{"type": "selector", "tag": "main-out", "outbounds": ["main-urltest-out", "A", "dead", "B"], "default": "main-urltest-out"}`
+}
+
+func (s *embedderStand) serverA(user string) string {
+	return `{"type": "socks", "tag": "A", "server": "127.0.0.1", "server_port": ` + fmt.Sprint(s.mixedPort) + `, "username": "` + user + `", "password": "p"}`
+}
