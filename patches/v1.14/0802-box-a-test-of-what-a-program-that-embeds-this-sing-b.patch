+// What a program that embeds this sing-box relies on beyond upstream's API, the way
+// podkop-experimental uses it (its package engine; the list is podkop-engine's docs/EMBEDDING.md):
+// the Go API of the fork, the options only the fork reads, the keys and the texts it goes by. A
+// change of the series that breaks such a program fails here, not when the program moves to it. A
+// change that is meant is made here as well, and is a line of the release notes ("embedding:").
+
+// embedderContext is the context such a program builds its boxes in: the registries with a service
+// of its own, and what the boxes of the process share.
+func embedderContext(t *testing.T, history *urltest.HistoryStorage, memory *httpclient.DownloadMemory) context.Context {
+	registry := include.ServiceRegistry()
+	boxService.Register[embedderServiceOptions](registry, "embedder-service", newEmbedderService)
+	ctx := service.ContextWith[deprecated.Manager](context.Background(), deprecated.NewStderrManager(log.StdLogger()))
+	ctx = box.Context(ctx, include.InboundRegistry(), include.OutboundRegistry(), include.EndpointRegistry(),
+		include.DNSTransportRegistry(), registry, include.CertificateProviderRegistry())
+	ctx = service.ExtendContext(ctx)
+	ctx = service.ContextWithPtr(service.ContextWithPtr(ctx, history), memory)
+	ctx = service.ContextWithPtr(ctx, &R.RemoteStart{Empty: true})
+	ctx, cancel := context.WithCancel(ctx)
+	t.Cleanup(cancel)
+	return ctx
+}
+
+type embedderServiceOptions struct {
+	Table string `json:"table,omitempty"`
+}
+
+type embedderService struct {
+	boxService.Adapter
+}
+
+func newEmbedderService(ctx context.Context, logger log.ContextLogger, tag string, options embedderServiceOptions) (adapter.Service, error) {
+	if options.Table == "" {
+		return nil, E.New("missing table")
+	}
+	return &embedderService{boxService.NewAdapter("embedder-service", tag)}, nil
+}
+
+func (s *embedderService) Start(stage adapter.StartStage, scope *adapter.Scope) error { return nil }
+
+// embedderLog is the log writer of such a program: the lines of its level, without colours.
+type embedderLog struct {
+	access sync.Mutex
+	lines  []string
+}
+
+var (
+	_ log.PlatformWriterLevel  = (*embedderLog)(nil)
+	_ log.PlatformWriterColors = (*embedderLog)(nil)
+)
+
+func (l *embedderLog) Level() log.Level    { return log.LevelInfo }
+func (l *embedderLog) DisableColors() bool { return true }
+
+func (l *embedderLog) WriteMessage(level log.Level, message string) {
+	l.access.Lock()
+	defer l.access.Unlock()
+	l.lines = append(l.lines, log.FormatLevel(level)+" "+message)
+}
+
+func (l *embedderLog) find(part string) string {
+	l.access.Lock()
+	defer l.access.Unlock()
+	for _, line := range l.lines {
+		if strings.Contains(line, part) {
+			return line
+		}
+	}
+	return ""
+}
+
+// embedderHook is told of the connections the router routes.
+type embedderHook struct {
+	access sync.Mutex
+	routed []adapter.InboundContext
+}
+
+func (h *embedderHook) RoutedConnection(ctx context.Context, conn net.Conn, metadata adapter.InboundContext, matchedRule adapter.Rule, matchOutbound adapter.Outbound) net.Conn {
+	h.access.Lock()
+	defer h.access.Unlock()
+	h.routed = append(h.routed, metadata)
+	return conn
+}
+
+func (h *embedderHook) RoutedPacketConnection(ctx context.Context, conn N.PacketConn, metadata adapter.InboundContext, matchedRule adapter.Rule, matchOutbound adapter.Outbound) N.PacketConn {
+	return conn
+}
+
+func (h *embedderHook) RoutedFlow(ctx context.Context, metadata adapter.InboundContext, matchedRule adapter.Rule, matchOutbound adapter.Outbound) tun.FlowTracker {
+	return nil
+}
+
+func (h *embedderHook) inbounds() []string {
+	h.access.Lock()
+	defer h.access.Unlock()
+	var tags []string
+	for _, metadata := range h.routed {
+		tags = append(tags, metadata.Inbound)
+	}
+	return tags
+}
