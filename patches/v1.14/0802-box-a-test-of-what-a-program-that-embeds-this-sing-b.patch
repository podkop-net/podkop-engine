+	s.stranger = plainServer(t)
+	s.web = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/204":
+			w.WriteHeader(http.StatusNoContent)
+		case "/list":
+			s.lists.Add(1)
+			select {
+			case <-s.listGate:
+			case <-r.Context().Done():
+				return
+			}
+			w.Write([]byte(s.list.Load().(string)))
+		default:
+			w.Write(make([]byte, urltest.LossProbeLarge))
+		}
+	}))
+	t.Cleanup(s.web.Close)
+	s.ctx = embedderContext(t, s.history, s.memory)
