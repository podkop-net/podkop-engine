+// must finds an outbound of the box and what it can do.
+func must[T any](t *testing.T, s *embedderStand, tag string) T {
+	outbound, found := s.box.Outbound().Outbound(tag)
+	require.True(t, found)
+	can, is := outbound.(T)
+	require.True(t, is)
+	return can
+}
