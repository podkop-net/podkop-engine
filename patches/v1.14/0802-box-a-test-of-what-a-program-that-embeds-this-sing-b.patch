+// embedderStand is a box such a program runs, and what it reaches.
+type embedderStand struct {
+	ctx       context.Context
+	box       *box.Box
+	log       embedderLog
+	hook      embedderHook
+	history   *urltest.HistoryStorage
+	memory    *httpclient.DownloadMemory
+	web       *httptest.Server
+	list      atomic.Value  // the content of the remote list
+	listGate  chan struct{} // closed: the list is served
+	lists     atomic.Int32  // the requests for it
+	mixedPort uint16
+	dnsPort   uint16
+	apiPort   uint16
+	// the server of the outbound stranger
+	stranger M.Socksaddr
+}
+
+// embedderPorts are free ports of the loopback, held until release: a port that is let go at once is
+// the one a server of the test may get next.
+func embedderPorts(t *testing.T, count int) (ports []uint16, release func()) {
+	var listeners []net.Listener
+	release = func() {
+		for _, listener := range listeners {
+			listener.Close()
+		}
+	}
+	t.Cleanup(release)
+	for range count {
+		listener, err := net.Listen("tcp", "127.0.0.1:0")
+		require.NoError(t, err)
+		listeners = append(listeners, listener)
+		ports = append(ports, uint16(listener.Addr().(*net.TCPAddr).Port))
+	}
+	return
+}
+
+// plainServer is a server of TLS whose certificate nobody trusts: to a REALITY client, one that is
+// not the server it should be.
+func plainServer(t *testing.T) M.Socksaddr {
+	server := httptest.NewTLSServer(http.NotFoundHandler())
+	t.Cleanup(server.Close)
+	return M.SocksaddrFromNet(server.Listener.Addr())
+}
+
+func (s *embedderStand) outbounds(serverA string) string {
