+// The readers such a program shares with the box: rule-set files and share links.
+func TestEmbedderReaders(t *testing.T) {
+	text, skipped, err := ruletext.ReadAddresses([]byte("example.com\n192.0.2.0/24\n2001:db8::/32\nnot a name\n"))
+	require.NoError(t, err)
+	require.Equal(t, 1, skipped.Count)
+	require.Equal(t, "not a name", skipped.First)
+	source := []byte(`{"version": 3, "rules": [{"domain_suffix": ["example.com"], "ip_cidr": ["192.0.2.0/24", "2001:db8::/32"], "source_ip_cidr": ["10.0.0.0/8"]}]}`)
+	named, err := domainset.ReadSource(source)
+	require.NoError(t, err)
+	addresses, err := domainset.ReadSourceAddresses(source)
+	require.NoError(t, err)
+	var binary bytes.Buffer
+	plain, err := json.UnmarshalExtended[option.PlainRuleSetCompat](source)
+	require.NoError(t, err)
+	require.NoError(t, srs.Write(&binary, plain.Options, plain.Version))
+	read, err := srs.ReadSets(bytes.NewReader(binary.Bytes()))
+	require.NoError(t, err)
+	for name, compat := range map[string]option.PlainRuleSetCompat{"text": text, "source": named, "addresses": addresses, "binary": read} {
+		ruleSet, err := compat.Upgrade()
+		require.NoError(t, err, name)
+		var four []uint64
+		var all int
+		for _, rule := range ruleSet.Rules {
+			require.NotEqual(t, C.RuleTypeLogical, rule.Type, name)
+			if ranges := rule.DefaultOptions.IPRanges; ranges != nil {
+				four = append(four, ranges.Ranges4()...)
+				all += len(ranges.Ranges())
+				require.Equal(t, len(ranges.Ranges()), ranges.Len(), name)
+			}
+			switch name {
+			case "source":
+				require.NotNil(t, rule.DefaultOptions.DomainSet)
+				require.NotNil(t, rule.DefaultOptions.SourceIPRanges)
+			case "binary":
+				require.NotNil(t, rule.DefaultOptions.DomainMatcher)
+				require.NotNil(t, rule.DefaultOptions.SourceIPRanges)
+			}
+		}
+		require.Equal(t, []uint64{0xc0000200<<32 | 0xc00002ff}, four, name)
+		require.Equal(t, 2, all, name)
+	}
+	require.Equal(t, "text", C.RuleSetFormatText)
+	require.Equal(t, "xhttp", C.V2RayTransportTypeXHTTP)
+
+	outbound, warnings, err := sharelink.Decode("vless://9c17d9be-4eaa-4336-89ce-1ecdd76b7ac4@203.0.113.61:443?security=tls&sni=www.example.com&type=ws&path=%2Fsecret#name")
+	require.NoError(t, err)
+	require.Empty(t, warnings)
+	require.Equal(t, C.TypeVLESS, outbound.Type)
+	require.Contains(t, outbound.Secrets(), "9c17d9be-4eaa-4336-89ce-1ecdd76b7ac4")
+	_ = []string(outbound.Unplain())
+	require.NotContains(t, sharelink.PlainMessage("the user 9c17d9be-4eaa-4336-89ce-1ecdd76b7ac4 is unknown", outbound.Secrets()), "9c17d9be")
+	require.Equal(t, "a b", sharelink.OneLine("a\nb"))
+	_, _, err = sharelink.Decode("nothing")
+	require.Error(t, err)
+}
