+			"final": "dns-server", "strategy": "ipv4_only", "ipv6_if_no_ipv4": true
+		},
+		"http_clients": [{"tag": "lists", "outbounds": ["direct-out", "main-out"]}],
+		"inbounds": [
+			{"type": "direct", "tag": "dns-in", "listen": "127.0.0.1", "listen_port": ` + fmt.Sprint(s.dnsPort) + `},
+			{"type": "mixed", "tag": "mixed-in", "listen": "127.0.0.1", "listen_port": ` + fmt.Sprint(s.mixedPort) + `,
+				"users": [{"username": "main", "password": "p"}, {"username": "loop", "password": "p"}, {"username": "loop2", "password": "p"}]}
+		],
+		"outbounds": [` + s.outbounds(s.serverA("loop")) + `],
+		"route": {
+			"rules": [
+				{"action": "sniff", "inbound": ["dns-in"]},
+				{"action": "hijack-dns", "protocol": "dns"},
+				{"action": "route", "auth_user": ["loop", "loop2"], "outbound": "direct-out"},
+				{"action": "route", "auth_user": "main", "outbound": "main-out"}
+			],
+			"rule_set": [{"type": "remote", "tag": "list", "format": "text", "url": "` + s.web.URL + `/list", "update_interval": "1d"}],
+			"final": "direct-out", "default_http_client": "lists"
+		},
+		"services": [{"type": "embedder-service", "tag": "own", "table": "t"}],
+		"experimental": {
+			"cache_file": {"enabled": true, "path": "` + filepath.Join(t.TempDir(), "cache.db") + `", "store_fakeip": true},
+			"clash_api": {"external_controller": "127.0.0.1:` + fmt.Sprint(s.apiPort) + `", "secret": "s"},
+			"utls_fallback": {"enabled": true}
+		}
+	}`
+	options, err := json.UnmarshalExtendedContext[option.Options](s.ctx, []byte(content))
+	require.NoError(t, err)
+	s.box, err = box.New(box.Options{Context: s.ctx, Options: options, PlatformLogWriter: &s.log})
+	require.NoError(t, err)
+	t.Cleanup(func() { s.box.Close() })
+	service.FromContext[adapter.Router](s.ctx).AppendTracker(&s.hook)
+	release()
+	return s
+}
