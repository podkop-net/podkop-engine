+func (s *embedderStand) get(t *testing.T, user string) (int, error) {
+	proxy := &url.URL{Scheme: "http", User: url.UserPassword(user, "p"), Host: fmt.Sprint("127.0.0.1:", s.mixedPort)}
+	client := &http.Client{Timeout: 10 * time.Second, Transport: &http.Transport{Proxy: http.ProxyURL(proxy), DisableKeepAlives: true}}
+	response, err := client.Get(s.web.URL + "/204")
+	if err != nil {
+		return 0, err
+	}
+	response.Body.Close()
+	return response.StatusCode, nil
+}
