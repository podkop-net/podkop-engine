+// A start that fails is the caller's to close: StartWithoutClose leaves the box as it is.
+func TestEmbedderFailedStart(t *testing.T) {
+	taken, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer taken.Close()
+	ctx := embedderContext(t, urltest.NewHistoryStorage(), httpclient.NewDownloadMemory())
+	options, err := json.UnmarshalExtendedContext[option.Options](ctx, []byte(fmt.Sprint(`{"inbounds": [{"type": "mixed", "listen": "127.0.0.1", "listen_port": `, taken.Addr().(*net.TCPAddr).Port, `}]}`)))
+	require.NoError(t, err)
+	instance, err := box.New(box.Options{Context: ctx, Options: options, PlatformLogWriter: new(embedderLog)})
+	require.NoError(t, err)
+	require.Error(t, instance.StartWithoutClose())
+	require.NoError(t, instance.Close())
+}
