+// HTTPDownloaders is an HTTPClientManager whose clients may download through several outbounds
+// (option.HTTPClientOptions.Outbounds).
+type HTTPDownloaders interface {
+	// ResolveDownloader is the downloader of the client the options name, or of the default
+	// client for nil; nil when that client has no outbounds.
+	ResolveDownloader(options *option.HTTPClientOptions) (HTTPDownloader, error)
+}
+
+// HTTPDownloader downloads files through the outbounds of a client: in the order of what it
+// knows of each for the host of the file, the next one started beside those under way when they
+// stall, the first accepted result taken.
+type HTTPDownloader interface {
+	// Download tries the ways for the host as their order says until accept takes a result of
+	// try. accept is called for one result at a time; an error of it fails that way. It returns
+	// the way of the accepted result.
+	Download(ctx context.Context, host string, try HTTPDownloadTry, accept func(way string, result any) error) (string, error)
+	// Ways is the order of the ways for the host, for a caller that downloads by itself, and
+	// whether the first two start together (the first failed for the host last time).
+	Ways(host string) ([]string, bool)
+	// Record takes the result of such a download through a way: err nil when it brought the
+	// file, of size bytes in took.
+	Record(host string, way string, err error, took time.Duration, bytes int64)
+}
+
+// HTTPDownloadTry downloads through one way of a downloader with its client. progress is called
+// when the headers came (0) and with the size of each part of the body that comes.
+type HTTPDownloadTry func(ctx context.Context, way string, client *http.Client, progress func(bytes int)) (any, error)
+
 // HTTPFallback is a fallback client: its tag and its shared transport.
 type HTTPFallback struct {
 	Tag       string
diff --git a/common/httpclient/downloader.go b/common/httpclient/downloader.go
new file mode 100644
index 000000000..6cf50e7b5
--- /dev/null
+++ b/common/httpclient/downloader.go
@@ -0,0 +1,538 @@
+package httpclient
+
+import (
+	"cmp"
+	"context"
+	"net/http"
+	"slices"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+)
+
+var (
+	_ adapter.HTTPDownloaders = (*Manager)(nil)
+	_ adapter.HTTPDownloader  = (*Downloader)(nil)
+)
+
+// DownloadPlan is when a download starts its next way beside those under way: when none of them
+// showed progress for Wait (no answer yet) or Body (a pause in a body), or the youngest is Total
+// old and none has a body coming; at most Most ways at once.
+type DownloadPlan struct {
+	Wait  time.Duration
+	Body  time.Duration
+	Total time.Duration
+	Most  int
+}
+
+// downloadPlan is the plan of every downloader. PROVISIONAL: the plan of the subscription download
+// of podkop-exp (subscription.DefaultPlan: 5 s is what a way had there before the plan, 3 s in a
+// body and 10 s a choice; 3 at once, as bursts of TLS hellos to one name are what the DPI of some
+// ISPs penalises), until the ways of real routers are measured.
+var downloadPlan = DownloadPlan{Wait: 5 * time.Second, Body: 3 * time.Second, Total: 10 * time.Second, Most: 3}
+
+// downloadWatch is how often a download looks at its ways under way.
+const downloadWatch = 100 * time.Millisecond
+
+// checkOutbounds tells a client whose outbounds come with a detour or fallbacks: which of them
+// a caller takes would depend on the caller.
+func checkOutbounds(define option.HTTPClient) error {
+	if len(define.Outbounds) == 0 {
+		return nil
+	}
+	if define.Detour != "" {
+		return E.New("http_client[", define.Tag, "]: outbounds and detour together")
+	}
+	if len(define.Fallback) > 0 {
+		return E.New("http_client[", define.Tag, "]: outbounds and fallback together")
+	}
+	return nil
+}
+
+// clientOptions are the options of the transport of a client: one with outbounds goes through
+// the first of them for a caller that does not know the downloader.
+func clientOptions(define option.HTTPClient) option.HTTPClientOptions {
+	options := define.Options()
+	if len(options.Outbounds) > 0 && options.Detour == "" {
+		options.Detour = options.Outbounds[0]
+		// a way may be a direct outbound with no options of its own: the way of no proxy
+		options.DisableEmptyDirectCheck = true
+	}
+	options.Outbounds = nil
+	return options
+}
+
+// ResolveDownloader is the downloader of the client the options name, or of the default client
+// for nil; nil when that client has no outbounds. A client has one downloader, whoever asks.
+func (m *Manager) ResolveDownloader(options *option.HTTPClientOptions) (adapter.HTTPDownloader, error) {
+	var tag string
+	switch {
+	case options == nil:
+		tag = m.defaultTag
+	case options.Tag != "":
+		tag = options.Tag
+	case len(options.Outbounds) > 0:
+		return nil, E.New("an http client with outbounds is one of http_clients, named by its tag")
+	}
+	if tag == "" {
+		return nil, nil
+	}
+	m.access.Lock()
+	defer m.access.Unlock()
+	if downloader, loaded := m.downloaders[tag]; loaded {
+		return downloader, nil
+	}
+	define, loaded := m.defines[tag]
+	if !loaded {
+		return nil, E.New("http_client not found: ", tag)
+	}
+	if len(define.Outbounds) == 0 {
+		return nil, nil
+	}
+	err := checkOutbounds(define)
+	if err != nil {
+		return nil, err
+	}
+	var ways []string
+	transports := make(map[string]adapter.HTTPTransport)
+	for _, outbound := range define.Outbounds {
+		if _, loaded := transports[outbound]; loaded {
+			continue
+		}
+		wayOptions := define.Options()
+		wayOptions.Detour = outbound
+		wayOptions.Outbounds = nil
+		wayOptions.DisableEmptyDirectCheck = true
+		transport, err := NewTransport(m.ctx, m.logger, tag, wayOptions)
+		if err != nil {
+			return nil, E.Cause(err, "http_client[", tag, "] through ", outbound)
+		}
+		m.managedTransports = append(m.managedTransports, transport)
+		ways = append(ways, outbound)
+		transports[outbound] = transport
+	}
+	downloader := NewDownloader(m.logger, ways, transports, m.memory, service.PtrFromContext[urltest.HistoryStorage](m.ctx))
+	downloader.Outbounds = service.FromContext[adapter.OutboundManager](m.ctx)
+	if m.downloaders == nil {
+		m.downloaders = make(map[string]*Downloader)
+	}
+	m.downloaders[tag] = downloader
+	return downloader, nil
+}
+
+// Downloader downloads through the outbounds of a client (adapter.HTTPDownloader).
+type Downloader struct {
+	logger     logger.ContextLogger
+	ways       []string
+	transports map[string]adapter.HTTPTransport
+	memory     *DownloadMemory
+	history    *urltest.HistoryStorage
+	// Plan is the plan of its downloads, downloadPlan when made
+	Plan DownloadPlan
+	// Outbounds, when set, tell a way that is a group: its delay is that of the outbound it
+	// uses now
+	Outbounds adapter.OutboundManager
+}
+
+// NewDownloader makes a downloader of the ways (outbound tags, the first one the default first
+// try), each with its transport; history may be nil.
+func NewDownloader(logger logger.ContextLogger, ways []string, transports map[string]adapter.HTTPTransport, memory *DownloadMemory, history *urltest.HistoryStorage) *Downloader {
+	if memory == nil {
+		memory = NewDownloadMemory()
+	}
+	return &Downloader{logger: logger, ways: ways, transports: transports, memory: memory, history: history, Plan: downloadPlan}
+}
+
+// delayHops bounds the groups of groups delay follows.
+const delayHops = 4
+
+func (d *Downloader) delay(way string) (uint16, bool) {
+	for range delayHops {
+		if d.Outbounds == nil {
+			break
+		}
+		outbound, loaded := d.Outbounds.Outbound(way)
+		if !loaded {
+			break
+		}
+		group, isGroup := outbound.(adapter.OutboundGroup)
+		if !isGroup {
+			break
+		}
+		selected := group.Selected(N.NetworkTCP)
+		if selected == nil {
+			break
+		}
+		way = selected.Tag()
+	}
+	history := d.history.LoadURLTestHistory(way)
+	if history == nil {
+		return 0, false
+	}
+	return history.Delay, true
+}
+
+func (d *Downloader) Ways(host string) ([]string, bool) {
+	ways := make([]string, 0, len(d.ways))
+	for _, way := range d.ways {
+		if d.allowed(way) {
+			ways = append(ways, way)
+		}
+	}
+	return d.memory.order(host, ways, d.delay)
+}
+
+// allowed tells a way that goes through no outbound the program excluded (SetExcluded), its
+// groups followed to the outbound they use now: a group is passed by only while it uses an
+// excluded one.
+func (d *Downloader) allowed(way string) bool {
+	for range delayHops + 1 {
+		if d.memory.isExcluded(way) {
+			return false
+		}
+		if d.Outbounds == nil {
+			return true
+		}
+		outbound, loaded := d.Outbounds.Outbound(way)
+		if !loaded {
+			return true
+		}
+		group, isGroup := outbound.(adapter.OutboundGroup)
+		if !isGroup {
+			return true
+		}
+		selected := group.Selected(N.NetworkTCP)
+		if selected == nil {
+			return true
+		}
+		way = selected.Tag()
+	}
+	return true
+}
+
+func (d *Downloader) Record(host string, way string, err error, took time.Duration, bytes int64) {
+	if err != nil {
+		d.memory.failed(host, way)
+		return
+	}
+	d.memory.brought(host, way, took, bytes)
+}
+
+// attempt is a way of a download under way or done.
+type attempt struct {
+	way     string
+	started time.Time
+	cancel  context.CancelFunc
+
+	access   sync.Mutex
+	last     time.Time
+	body     bool
+	bytes    int64
+	finished bool
+	took     time.Duration
+	result   any
+	err      error
+}
+
+func (a *attempt) progress(bytes int) {
+	a.access.Lock()
+	defer a.access.Unlock()
+	a.body = true
+	a.bytes += int64(bytes)
+	a.last = time.Now()
+}
+
+func (a *attempt) finish(result any, err error) {
+	a.access.Lock()
+	defer a.access.Unlock()
+	a.finished = true
+	a.took = time.Since(a.started)
+	a.result, a.err = result, err
+}
+
+func (d *Downloader) Download(ctx context.Context, host string, try adapter.HTTPDownloadTry, accept func(way string, result any) error) (string, error) {
+	order, together := d.Ways(host)
+	if len(order) == 0 {
+		return "", E.New("no way to download through")
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	// buffered for every way: a way that ends after the download returned does not block
+	done := make(chan *attempt, len(order))
+	var attempts []*attempt
+	next, running := 0, 0
+	start := func() {
+		way := order[next]
+		next++
+		attemptContext, attemptCancel := context.WithCancel(ctx)
+		now := time.Now()
+		item := &attempt{way: way, started: now, last: now, cancel: attemptCancel}
+		attempts = append(attempts, item)
+		running++
+		client := &http.Client{Transport: d.transports[way]}
+		d.logger.DebugContext(ctx, "download from ", host, " through ", way)
+		go func() {
+			result, err := try(attemptContext, way, client, item.progress)
+			item.finish(result, err)
+			done <- item
+		}()
+	}
+	start()
+	if together && next < len(order) {
+		start()
+	}
+	watch := time.NewTicker(downloadWatch)
+	defer watch.Stop()
+	var errs []error
+	for {
+		select {
+		case item := <-done:
+			running--
+			item.cancel()
+			err := item.err
+			if err == nil {
+				err = accept(item.way, item.result)
+				if err == nil {
+					d.memory.brought(host, item.way, item.took, item.bytes)
+					return item.way, nil
+				}
+			}
+			if ctx.Err() == nil {
+				// a way cut by the caller's deadline is not known to be bad
+				d.memory.failed(host, item.way)
+			}
+			errs = append(errs, E.Cause(err, item.way))
+			if next < len(order) || running > 0 {
+				d.logger.InfoContext(ctx, "download from ", host, " through ", item.way, " failed: ", err)
+			}
+			if next < len(order) {
+				if running < d.Plan.Most {
+					start()
+				}
+			} else if running == 0 {
+				return "", E.Errors(errs...)
+			}
+		case <-watch.C:
+			if next < len(order) && running < d.Plan.Most && d.due(attempts) {
+				start()
+			}
+		case <-ctx.Done():
+			return "", E.Errors(append(errs, ctx.Err())...)
+		}
+	}
+}
+
+// due tells whether the ways under way have earned the start of the next one (DownloadPlan).
+func (d *Downloader) due(attempts []*attempt) bool {
+	now := time.Now()
+	idle, youngest := time.Duration(-1), time.Duration(-1)
+	body := false
+	for _, item := range attempts {
+		item.access.Lock()
+		finished, last, started, inBody := item.finished, item.last, item.started, item.body
+		item.access.Unlock()
+		if finished {
+			continue
+		}
+		if inBody && now.Sub(last) < d.Plan.Body {
+			// a body is coming: a second one would hold another copy of a file of up to
+			// tens of MB on a router
+			return false
+		}
+		body = body || inBody
+		if idle < 0 || now.Sub(last) < idle {
+			idle = now.Sub(last)
+		}
+		if youngest < 0 || now.Sub(started) < youngest {
+			youngest = now.Sub(started)
+		}
+	}
+	if idle < 0 {
+		return true
+	}
+	wait := d.Plan.Wait
+	if body {
+		wait = d.Plan.Body
+	}
+	return idle >= wait || youngest >= d.Plan.Total
+}
+
+// DownloadMemory is what the downloads found of the ways: per host, the way that brought its last
+// file and the ways that failed for it since they last brought one; per way, its last download
+// that brought a file. A host process that keeps one in the context of its boxes
+// (service.ContextWithPtr) keeps it across them.
+type DownloadMemory struct {
+	access sync.Mutex
+	hosts  map[string]*hostRecord
+	ways   map[string]*wayRecord
+	// excluded are the outbounds no download goes through (SetExcluded)
+	excluded map[string]bool
+}
+
+type hostRecord struct {
+	brought string
+	failed  map[string]time.Time
+	used    time.Time
+}
+
+type wayRecord struct {
+	brought time.Time
+	// bytes a second of that download
+	rate float64
+}
+
+// memoryHosts bounds the hosts a memory keeps, the least recently used forgotten first: a box
+// downloads from a few hosts; a bound only against a caller that asks for many.
+const memoryHosts = 256
+
+func NewDownloadMemory() *DownloadMemory {
+	return &DownloadMemory{hosts: make(map[string]*hostRecord), ways: make(map[string]*wayRecord)}
+}
+
+func (m *DownloadMemory) host(name string) *hostRecord {
+	record := m.hosts[name]
+	if record == nil {
+		if len(m.hosts) >= memoryHosts {
+			var oldest string
+			for key, item := range m.hosts {
+				if oldest == "" || item.used.Before(m.hosts[oldest].used) {
+					oldest = key
+				}
+			}
+			delete(m.hosts, oldest)
+		}
+		record = &hostRecord{failed: make(map[string]time.Time)}
+		m.hosts[name] = record
+	}
+	record.used = time.Now()
+	return record
+}
+
+func (m *DownloadMemory) brought(host string, way string, took time.Duration, bytes int64) {
+	m.access.Lock()
+	defer m.access.Unlock()
+	record := m.host(host)
+	record.brought = way
+	delete(record.failed, way)
+	rate := float64(bytes)
+	if took > 0 {
+		rate = float64(bytes) / took.Seconds()
+	}
+	m.ways[way] = &wayRecord{brought: time.Now(), rate: rate}
+}
+
+func (m *DownloadMemory) failed(host string, way string) {
+	m.access.Lock()
+	defer m.access.Unlock()
+	record := m.host(host)
+	if record.brought == way {
+		record.brought = ""
+	}
+	record.failed[way] = time.Now()
+}
+
+// SetExcluded sets the outbounds no download goes through, by tag, in place of those set before:
+// the choice of the program that runs the boxes (a server of little traffic, one kept as the last
+// reserve of a rule, a tunnel to a closed network). They are not in the configuration, whose
+// http_clients would change with every new list of servers.
+func (m *DownloadMemory) SetExcluded(tags []string) {
+	excluded := make(map[string]bool, len(tags))
+	for _, tag := range tags {
+		excluded[tag] = true
+	}
+	m.access.Lock()
+	defer m.access.Unlock()
+	m.excluded = excluded
+}
+
+func (m *DownloadMemory) isExcluded(tag string) bool {
+	m.access.Lock()
+	defer m.access.Unlock()
+	return m.excluded[tag]
+}
+
+// Forget forgets what the downloads found of a way: its tag names another outbound now. A nil
+// memory has nothing to forget.
+func (m *DownloadMemory) Forget(way string) {
+	if m == nil {
+		return
+	}
+	m.access.Lock()
+	defer m.access.Unlock()
+	delete(m.ways, way)
+	for _, record := range m.hosts {
+		if record.brought == way {
+			record.brought = ""
+		}
+		delete(record.failed, way)
+	}
+}
+
+// order is the ways of a download from host in the order they are tried: the way that brought
+// its last file; the first way of the list; the ways that brought a file of another host, the
+// fastest first; those the URL tests passed, the lowest delay first (a group by the outbound it
+// uses now); those not known, in the order of the list; those that failed for the host, the oldest failure first. No way is left
+// out. together tells that the first failed for the host last time: the second starts with it.
+func (m *DownloadMemory) order(host string, ways []string, delay func(string) (uint16, bool)) ([]string, bool) {
+	if len(ways) == 0 {
+		return nil, false
+	}
+	m.access.Lock()
+	defer m.access.Unlock()
+	record := m.hosts[host]
+	if record != nil {
+		record.used = time.Now()
+	}
+	order := make([]string, 0, len(ways))
+	if record != nil && record.brought != "" && slices.Contains(ways, record.brought) {
+		order = append(order, record.brought)
+	}
+	if !slices.Contains(order, ways[0]) {
+		order = append(order, ways[0])
+	}
+	type ranked struct {
+		way   string
+		class int
+		key   float64
+	}
+	var rest []ranked
+	for _, way := range ways[1:] {
+		if slices.Contains(order, way) || slices.ContainsFunc(rest, func(item ranked) bool { return item.way == way }) {
+			continue
+		}
+		item := ranked{way: way, class: 3}
+		var failedAt time.Time
+		if record != nil {
+			failedAt = record.failed[way]
+		}
+		switch {
+		case !failedAt.IsZero():
+			item.class, item.key = 4, float64(failedAt.UnixNano())
+		case m.ways[way] != nil:
+			item.class, item.key = 1, -m.ways[way].rate
+		default:
+			if value, tested := delay(way); tested {
+				item.class, item.key = 2, float64(value)
+			}
+		}
+		rest = append(rest, item)
+	}
+	slices.SortStableFunc(rest, func(left ranked, right ranked) int {
+		if left.class != right.class {
+			return left.class - right.class
+		}
+		return cmp.Compare(left.key, right.key)
+	})
+	for _, item := range rest {
+		order = append(order, item.way)
+	}
+	together := record != nil && len(order) > 1 && !record.failed[order[0]].IsZero()
+	return order, together
+}
diff --git a/common/httpclient/downloader_test.go b/common/httpclient/downloader_test.go
new file mode 100644
index 000000000..8f3cbb3ea
--- /dev/null
+++ b/common/httpclient/downloader_test.go
@@ -0,0 +1,263 @@
+package httpclient
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing-box/log"
+
+	"github.com/stretchr/testify/require"
+)
+
+// testPlan is a plan of the same shape as downloadPlan, a hundred times shorter.
+var testPlan = DownloadPlan{Wait: 50 * time.Millisecond, Body: 30 * time.Millisecond, Total: 100 * time.Millisecond, Most: 3}
+
+func testDownloader(ways ...string) *Downloader {
+	downloader := NewDownloader(log.NewNOPFactory().Logger(), ways, map[string]adapter.HTTPTransport{}, nil, nil)
+	downloader.Plan = testPlan
+	return downloader
+}
+
+func accepting(string, any) error { return nil }
+
+// The order: the way that brought the host's last file; the first of the list; the ways that
+// brought another host's file, the fastest first; those the URL tests passed, the lowest delay
+// first; the unknown ones in list order; those that failed for the host, the oldest failure first.
+func TestDownloadMemoryOrder(t *testing.T) {
+	memory := NewDownloadMemory()
+	history := urltest.NewHistoryStorage()
+	history.StoreURLTestHistory("tested-slow", &adapter.URLTestHistory{Time: time.Now(), Delay: 300})
+	history.StoreURLTestHistory("tested-fast", &adapter.URLTestHistory{Time: time.Now(), Delay: 40})
+	history.StoreURLTestHistory("failed-old", &adapter.URLTestHistory{Time: time.Now(), Delay: 10})
+	downloader := NewDownloader(log.NewNOPFactory().Logger(), []string{
+		"direct", "unknown-1", "failed-new", "tested-slow", "other-slow", "brought", "failed-old",
+		"tested-fast", "other-fast", "unknown-2",
+	}, nil, memory, history)
+	memory.failed("lists.example", "failed-old")
+	time.Sleep(time.Millisecond)
+	memory.failed("lists.example", "failed-new")
+	memory.brought("other.example", "other-slow", time.Second, 1000)
+	memory.brought("other.example", "other-fast", time.Second, 9000)
+	memory.brought("lists.example", "brought", time.Second, 1)
+	ways, together := downloader.Ways("lists.example")
+	require.Equal(t, []string{
+		"brought", "direct", "other-fast", "other-slow", "tested-fast", "tested-slow",
+		"unknown-1", "unknown-2", "failed-old", "failed-new",
+	}, ways)
+	require.False(t, together)
+}
+
+// The first way of the list stays first when it failed for the host, but the next starts with it;
+// a way that brings the host's file again is no longer a failed one.
+func TestDownloadMemoryTogether(t *testing.T) {
+	downloader := testDownloader("direct", "a", "b")
+	downloader.Record("lists.example", "direct", errors.New("reset"), 0, 0)
+	ways, together := downloader.Ways("lists.example")
+	require.Equal(t, []string{"direct", "a", "b"}, ways)
+	require.True(t, together)
+	downloader.Record("lists.example", "direct", nil, time.Second, 1)
+	_, together = downloader.Ways("lists.example")
+	require.False(t, together)
+	_, together = downloader.Ways("other.example")
+	require.False(t, together)
+}
+
+// A way that does not answer has the next one started beside it after Wait; the first result
+// accepted wins, the way under way is cancelled, and the host's next download starts with the
+// way that brought it.
+func TestDownloaderStartsNextWhenSilent(t *testing.T) {
+	downloader := testDownloader("silent", "works")
+	var silentCanceled atomic.Bool
+	started := time.Now()
+	way, err := downloader.Download(context.Background(), "lists.example", func(ctx context.Context, way string, _ *http.Client, progress func(int)) (any, error) {
+		if way == "silent" {
+			<-ctx.Done()
+			silentCanceled.Store(true)
+			return nil, ctx.Err()
+		}
+		progress(0)
+		progress(100)
+		return "list", nil
+	}, accepting)
+	require.NoError(t, err)
+	require.Equal(t, "works", way)
+	require.GreaterOrEqual(t, time.Since(started), testPlan.Wait)
+	require.Eventually(t, silentCanceled.Load, time.Second, 5*time.Millisecond)
+	ways, _ := downloader.Ways("lists.example")
+	require.Equal(t, []string{"works", "silent"}, ways)
+}
+
+// While a body comes no other way starts, however long it takes: a second copy of a big list
+// would be held at once.
+func TestDownloaderBodyHoldsTheNext(t *testing.T) {
+	downloader := testDownloader("slow-body", "other")
+	var otherStarted atomic.Bool
+	way, err := downloader.Download(context.Background(), "lists.example", func(ctx context.Context, way string, _ *http.Client, progress func(int)) (any, error) {
+		if way == "other" {
+			otherStarted.Store(true)
+			return "list", nil
+		}
+		progress(0)
+		for range 25 {
+			// steady parts, closer than Body, for 3 Totals
+			time.Sleep(testPlan.Body / 3)
+			progress(10)
+		}
+		return "list", nil
+	}, accepting)
+	require.NoError(t, err)
+	require.Equal(t, "slow-body", way)
+	require.False(t, otherStarted.Load())
+}
+
+// A result accept refuses (a page of an ISP with status 200) fails its way and the next one is
+// started at once. The refused way is the first of the list: it stays right after the way that
+// brought the file.
+func TestDownloaderAcceptRefuses(t *testing.T) {
+	downloader := testDownloader("page", "works", "spare")
+	started := time.Now()
+	way, err := downloader.Download(context.Background(), "lists.example", func(ctx context.Context, way string, _ *http.Client, progress func(int)) (any, error) {
+		progress(0)
+		return way, nil
+	}, func(way string, result any) error {
+		if result == "page" {
+			return errors.New("not a list")
+		}
+		return nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, "works", way)
+	require.Less(t, time.Since(started), testPlan.Wait)
+	ways, together := downloader.Ways("lists.example")
+	require.Equal(t, []string{"works", "page", "spare"}, ways)
+	require.False(t, together)
+}
+
+// At most Most ways at once, however many are silent.
+func TestDownloaderMostAtOnce(t *testing.T) {
+	downloader := testDownloader("a", "b", "c", "d", "e")
+	var access sync.Mutex
+	running, most := 0, 0
+	ctx, cancel := context.WithTimeout(context.Background(), 8*testPlan.Wait)
+	defer cancel()
+	_, err := downloader.Download(ctx, "lists.example", func(ctx context.Context, way string, _ *http.Client, progress func(int)) (any, error) {
+		access.Lock()
+		running++
+		most = max(most, running)
+		access.Unlock()
+		<-ctx.Done()
+		access.Lock()
+		running--
+		access.Unlock()
+		return nil, ctx.Err()
+	}, accepting)
+	require.Error(t, err)
+	// a way started just before the deadline may still be counting itself in
+	time.Sleep(testPlan.Wait)
+	access.Lock()
+	defer access.Unlock()
+	require.Equal(t, testPlan.Most, most)
+}
+
+// When every way fails the error names each, and ways cut by the caller's deadline are not
+// remembered as failed.
+func TestDownloaderAllFail(t *testing.T) {
+	downloader := testDownloader("a", "b")
+	_, err := downloader.Download(context.Background(), "lists.example", func(ctx context.Context, way string, _ *http.Client, progress func(int)) (any, error) {
+		return nil, errors.New(way + " refused")
+	}, accepting)
+	require.Error(t, err)
+	for _, text := range []string{"a: a refused", "b: b refused"} {
+		require.Contains(t, err.Error(), text)
+	}
+	cut := testDownloader("silent")
+	ctx, cancel := context.WithTimeout(context.Background(), testPlan.Wait)
+	defer cancel()
+	_, err = cut.Download(ctx, "lists.example", func(ctx context.Context, way string, _ *http.Client, progress func(int)) (any, error) {
+		<-ctx.Done()
+		return nil, ctx.Err()
+	}, accepting)
+	require.Error(t, err)
+	_, together := cut.Ways("lists.example")
+	require.False(t, together)
+}
+
+// The memory keeps memoryHosts hosts, the least recently used forgotten first.
+func TestDownloadMemoryBound(t *testing.T) {
+	memory := NewDownloadMemory()
+	for index := range memoryHosts + 10 {
+		memory.failed("host-"+strconv.Itoa(index), "direct")
+	}
+	require.LessOrEqual(t, len(memory.hosts), memoryHosts)
+}
+
+// A way forgotten (its tag names another outbound now) is not known for any host any more.
+func TestDownloadMemoryForget(t *testing.T) {
+	downloader := testDownloader("direct", "a", "b")
+	downloader.Record("lists.example", "b", nil, time.Second, 10)
+	downloader.Record("lists.example", "direct", errors.New("reset"), 0, 0)
+	downloader.Record("other.example", "a", errors.New("reset"), 0, 0)
+	downloader.memory.Forget("b")
+	downloader.memory.Forget("a")
+	ways, together := downloader.Ways("lists.example")
+	require.Equal(t, []string{"direct", "a", "b"}, ways)
+	require.True(t, together)
+	ways, _ = downloader.Ways("other.example")
+	require.Equal(t, []string{"direct", "a", "b"}, ways)
+}
+
+// testOutbounds are outbounds by tag: a group selects what its entry names.
+type testOutbounds struct {
+	adapter.OutboundManager
+	selects map[string]string
+}
+
+type testOutbound struct {
+	adapter.OutboundGroup
+	tag      string
+	selected adapter.Outbound
+}
+
+func (o *testOutbound) Tag() string { return o.tag }
+
+func (o *testOutbound) Selected(string) adapter.Outbound { return o.selected }
+
+type testLeaf struct {
+	adapter.Outbound
+	tag string
+}
+
+func (o *testLeaf) Tag() string { return o.tag }
+
+func (m *testOutbounds) Outbound(tag string) (adapter.Outbound, bool) {
+	if selected, isGroup := m.selects[tag]; isGroup {
+		next, _ := m.Outbound(selected)
+		return &testOutbound{tag: tag, selected: next}, true
+	}
+	return &testLeaf{tag: tag}, true
+}
+
+// The outbounds the program excludes are no ways, nor is a group while it uses one of them (a
+// rule fallen back to its last reserve); excluding nothing again gives them back.
+func TestDownloaderExcluded(t *testing.T) {
+	downloader := testDownloader("direct", "rule-a", "rule-b", "helper")
+	outbounds := &testOutbounds{selects: map[string]string{"rule-a": "rule-a-test", "rule-a-test": "reserve", "rule-b": "nl"}}
+	downloader.Outbounds = outbounds
+	downloader.memory.SetExcluded([]string{"reserve", "helper"})
+	ways, _ := downloader.Ways("lists.example")
+	require.Equal(t, []string{"direct", "rule-b"}, ways)
+	outbounds.selects["rule-a-test"] = "fi"
+	ways, _ = downloader.Ways("lists.example")
+	require.Equal(t, []string{"direct", "rule-a", "rule-b"}, ways)
+	downloader.memory.SetExcluded(nil)
+	ways, _ = downloader.Ways("lists.example")
+	require.Equal(t, []string{"direct", "rule-a", "rule-b", "helper"}, ways)
+}
