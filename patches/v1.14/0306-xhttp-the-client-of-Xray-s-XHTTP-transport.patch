+package v2rayxhttp
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json/badoption"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+func xrange(from, to int32) *option.V2RayXHTTPRange {
+	return &option.V2RayXHTTPRange{From: from, To: to}
+}
+
+// What Xray refuses, and what it panics on at a dial, fails here when the
+// client is built, which `sing-box check` does.
+func TestXHTTPConfigErrors(t *testing.T) {
+	cases := map[string]func(*option.V2RayXHTTPOptions){
+		"unknown mode": func(o *option.V2RayXHTTPOptions) { o.Mode = "stream-down" },
+		"download in stream-one": func(o *option.V2RayXHTTPOptions) {
+			o.Mode, o.Download = modeStreamOne, &option.V2RayXHTTPDownloadOptions{}
+		},
+		"download without server":    func(o *option.V2RayXHTTPOptions) { o.Download = &option.V2RayXHTTPDownloadOptions{} },
+		"host in headers":            func(o *option.V2RayXHTTPOptions) { o.Headers = badoption.HTTPHeader{"Host": {"a"}} },
+		"padding disabled":           func(o *option.V2RayXHTTPOptions) { o.XPaddingBytes = xrange(0, 100) },
+		"padding negative":           func(o *option.V2RayXHTTPOptions) { o.XPaddingBytes = xrange(-1, -1) },
+		"padding huge":               func(o *option.V2RayXHTTPOptions) { o.XPaddingBytes = xrange(100, 1<<30) },
+		"padding placement":          func(o *option.V2RayXHTTPOptions) { o.XPaddingPlacement = "body" },
+		"padding method":             func(o *option.V2RayXHTTPOptions) { o.XPaddingMethod = "random" },
+		"GET upload with auto mode":  func(o *option.V2RayXHTTPOptions) { o.UplinkHTTPMethod = "get" },
+		"data in headers, stream-up": func(o *option.V2RayXHTTPOptions) { o.Mode, o.UplinkDataPlacement = modeStreamUp, placementHeader },
+		"data in cookies, auto":      func(o *option.V2RayXHTTPOptions) { o.UplinkDataPlacement = placementCookie },
+		"data placement":             func(o *option.V2RayXHTTPOptions) { o.UplinkDataPlacement = "query" },
+		"session placement":          func(o *option.V2RayXHTTPOptions) { o.SessionPlacement = "body" },
+		"seq placement":              func(o *option.V2RayXHTTPOptions) { o.SeqPlacement = "queryInHeader" },
+		"session table too small":    func(o *option.V2RayXHTTPOptions) { o.SessionIDTable, o.SessionIDLength = "number", xrange(4, 8) },
+		"session length zero":        func(o *option.V2RayXHTTPOptions) { o.SessionIDTable, o.SessionIDLength = "hex", xrange(0, 32) },
+		"session length huge":        func(o *option.V2RayXHTTPOptions) { o.SessionIDTable, o.SessionIDLength = "hex", xrange(16, 1<<30) },
+		"session table not ASCII": func(o *option.V2RayXHTTPOptions) {
+			o.SessionIDTable, o.SessionIDLength = "абвгдежзиклмнопр", xrange(16, 16)
+		},
+		"post size negative":  func(o *option.V2RayXHTTPOptions) { o.ScMaxEachPostBytes = xrange(-1, -1) },
+		"post size from zero": func(o *option.V2RayXHTTPOptions) { o.ScMaxEachPostBytes = xrange(0, 1000) },
+		"connections and concurrency": func(o *option.V2RayXHTTPOptions) {
+			o.Xmux = &option.V2RayXHTTPXmuxOptions{MaxConnections: xrange(2, 2), MaxConcurrency: xrange(4, 4)}
+		},
+		"header name":    func(o *option.V2RayXHTTPOptions) { o.Headers = badoption.HTTPHeader{"X Foo": {"a"}} },
+		"header value":   func(o *option.V2RayXHTTPOptions) { o.Headers = badoption.HTTPHeader{"X-Foo": {"a\nb"}} },
+		"upgrade header": func(o *option.V2RayXHTTPOptions) { o.Headers = badoption.HTTPHeader{"Upgrade": {"websocket"}} },
+		"session key":    func(o *option.V2RayXHTTPOptions) { o.SessionPlacement, o.SessionKey = placementHeader, "X Session" },
+		"cookie key":     func(o *option.V2RayXHTTPOptions) { o.SessionPlacement, o.SessionKey = placementCookie, "a=b; c" },
+		"padding header": func(o *option.V2RayXHTTPOptions) { o.XPaddingHeader = "X:Pad" },
+		"session table with a slash": func(o *option.V2RayXHTTPOptions) {
+			o.SessionIDTable, o.SessionIDLength = "ABCDEFGHIJKLMNOP+/", xrange(16, 16)
+		},
+		"download padding": func(o *option.V2RayXHTTPOptions) {
+			o.Download = &option.V2RayXHTTPDownloadOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: 1}}
+			o.Download.XPaddingBytes = xrange(0, 10)
+		},
+		"download without port": func(o *option.V2RayXHTTPOptions) {
+			o.Download = &option.V2RayXHTTPDownloadOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1"}}
+		},
+		"method with a space":   func(o *option.V2RayXHTTPOptions) { o.Mode, o.UplinkHTTPMethod = modePacketUp, "P OST" },
+		"method with a newline": func(o *option.V2RayXHTTPOptions) { o.UplinkHTTPMethod = "POST\r\nX: y" },
+		"method not ASCII":      func(o *option.V2RayXHTTPOptions) { o.UplinkHTTPMethod = "ПОСТ" },
+		"download method": func(o *option.V2RayXHTTPOptions) {
+			o.Download = &option.V2RayXHTTPDownloadOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: 1}}
+			o.Download.UplinkHTTPMethod = "P OST"
+		},
+	}
+	for name, configure := range cases {
+		options := option.V2RayXHTTPOptions{}
+		configure(&options)
+		_, err := NewClient(context.Background(), N.SystemDialer, M.ParseSocksaddr("127.0.0.1:443"), options, nil)
+		require.Error(t, err, name)
+		// the check without a client refuses the same options, in the same words
+		require.EqualError(t, CheckOptions(options), err.Error(), name)
+	}
+}
+
+func TestXHTTPConfigDefaults(t *testing.T) {
+	cases := map[string]func(*option.V2RayXHTTPOptions){
+		"empty":                     func(o *option.V2RayXHTTPOptions) {},
+		"zero post size is default": func(o *option.V2RayXHTTPOptions) { o.ScMaxEachPostBytes = xrange(0, 0) },
+		"negative interval":         func(o *option.V2RayXHTTPOptions) { o.ScMinPostsIntervalMs = xrange(-1, -1) },
+		"GET upload in packet-up":   func(o *option.V2RayXHTTPOptions) { o.Mode, o.UplinkHTTPMethod = modePacketUp, "GET" },
+		"method in lower case":      func(o *option.V2RayXHTTPOptions) { o.UplinkHTTPMethod = "put" },
+		"download": func(o *option.V2RayXHTTPOptions) {
+			o.Download = &option.V2RayXHTTPDownloadOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: 8443}}
+		},
+		"server-side settings": func(o *option.V2RayXHTTPOptions) {
+			o.NoSSEHeader, o.ScMaxBufferedPosts, o.ScStreamUpServerSecs, o.ServerMaxHeaderBytes = true, 30, xrange(20, 80), 8192
+		},
+	}
+	for name, configure := range cases {
+		options := option.V2RayXHTTPOptions{}
+		configure(&options)
+		transport, err := NewClient(context.Background(), N.SystemDialer, M.ParseSocksaddr("127.0.0.1:443"), options, nil)
+		require.NoError(t, err, name)
+		transport.Close()
+		require.NoError(t, CheckOptions(options), name)
+	}
+	config, err := newRequestConfig(option.V2RayXHTTPBaseOptions{}, modeAuto)
+	require.NoError(t, err)
+	require.Equal(t, valueRange{100, 1000}, config.paddingBytes)
+	require.Equal(t, valueRange{1000000, 1000000}, config.maxEachPostBytes)
+	require.Equal(t, valueRange{30, 30}, config.minPostsIntervalMs)
+	require.Equal(t, xmuxConfig{maxConnections: valueRange{3, 3}, hMaxRequestTimes: valueRange{600, 900}, hMaxReusableSecs: valueRange{1800, 3000}}, config.xmux)
+	require.Equal(t, "/", config.normalizedPath())
+	for _, placement := range []string{placementHeader, placementCookie} {
+		config, err = newRequestConfig(option.V2RayXHTTPBaseOptions{UplinkDataPlacement: placement}, modePacketUp)
+		require.NoError(t, err)
+		require.Equal(t, valueRange{4096, 4096}, config.maxEachPostBytes, placement)
+		config, err = newRequestConfig(option.V2RayXHTTPBaseOptions{UplinkDataPlacement: placement, ScMaxEachPostBytes: xrange(2048, 2048)}, modePacketUp)
+		require.NoError(t, err)
+		require.Equal(t, valueRange{2048, 2048}, config.maxEachPostBytes, placement)
+	}
+	// Setting any XMUX field drops all its defaults, as with Xray.
+	config, err = newRequestConfig(option.V2RayXHTTPBaseOptions{Xmux: &option.V2RayXHTTPXmuxOptions{HKeepAlivePeriod: 30}}, modeAuto)
+	require.NoError(t, err)
+	require.Equal(t, xmuxConfig{hKeepAlivePeriod: 30}, config.xmux)
+}
+
+func TestXHTTPPaths(t *testing.T) {
+	for _, c := range []struct {
+		path, placement, expected string
+	}{
+		{"", placementPath, "/"},
+		{"xhttp", placementPath, "/xhttp/"},
+		{"/xhttp", placementPath, "/xhttp/"},
+		{"/xhttp/", placementPath, "/xhttp/"},
+		{"/xhttp", placementQuery, "/xhttp"},
+		{"/xhttp?ed=2048", placementHeader, "/xhttp"},
+	} {
+		options := option.V2RayXHTTPBaseOptions{Path: c.path, SessionPlacement: c.placement, SeqPlacement: c.placement}
+		config, err := newRequestConfig(options, modeAuto)
+		require.NoError(t, err)
+		require.Equal(t, c.expected, config.normalizedPath(), c.path+" "+c.placement)
+	}
+}
diff --git a/transport/v2rayxhttp/conn.go b/transport/v2rayxhttp/conn.go
new file mode 100644
index 000000000..bd3e68bab
--- /dev/null
+++ b/transport/v2rayxhttp/conn.go
@@ -0,0 +1,540 @@
+package v2rayxhttp
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptrace"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/common/readwait"
+	"github.com/sagernet/sing/common/baderror"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// session is the net.Conn of one XHTTP session: a download (the body of a GET,
+// or of the stream-one request) and an upload (a streamed request body, or
+// packet-up requests).
+//
+// Every request of the session runs on the session's own context, not on the
+// context of the dial: a dial context is done once the dial returns, and the
+// session must outlive it. Cancelling the session context aborts every request
+// in flight; Close does it once what was written has been sent.
+type session struct {
+	ctx      context.Context
+	cancel   context.CancelFunc
+	closed   atomic.Bool
+	tearOnce sync.Once
+	// unanswered: data was written and no download data has been read since.
+	unanswered atomic.Bool
+
+	failure atomic.Pointer[failureBox]
+
+	clientAccess sync.Mutex
+	clients      []*poolClient
+	counted      []*poolClient
+
+	downloadOnce  sync.Once
+	downloadReady chan struct{}
+	download      io.ReadCloser
+	downloadErr   error
+
+	// The read waiter waits for download data on a small probe instead of the
+	// copy buffer: what the probe read is delivered first. Both are used by
+	// the one reader of the session only.
+	probe      []byte
+	pending    []byte
+	pendingErr error
+	flowing    bool
+
+	// streamBody is the body of the request that streams the upload: closing it
+	// with an error is what releases a Write blocked on a failed request.
+	streamBody   *io.PipeReader
+	streamUpload *io.PipeWriter
+	packetUpload *uploader
+	// uploadWritten is closed when the upload stream is over: the request
+	// written to its end (stream-one), answered to its end (stream-up), or
+	// failed.
+	uploadWritten chan struct{}
+	writtenOnce   sync.Once
+
+	connected  chan struct{}
+	localAddr  net.Addr
+	remoteAddr net.Addr
+}
+
+type failureBox struct {
+	err error
+}
+
+// dialDepthKey counts, in the context of a session's requests, the sessions
+// that context has passed through: a download detour that leads back to its
+// own outbound would otherwise dial itself without end.
+type dialDepthKey struct{}
+
+const maxDialDepth = 4
+
+func dialDepth(ctx context.Context) int {
+	depth, _ := ctx.Value(dialDepthKey{}).(int)
+	return depth
+}
+
+func newSession(depth int) *session {
+	ctx, cancel := context.WithCancel(context.WithValue(context.Background(), dialDepthKey{}, depth+1))
+	return &session{
+		ctx:           ctx,
+		cancel:        cancel,
+		downloadReady: make(chan struct{}),
+		connected:     make(chan struct{}),
+		uploadWritten: make(chan struct{}),
+	}
+}
+
+// closeLinger bounds how long a closed session stays to send what was written
+// to it before the Close; closeGrace is how long it stays after that when the
+// server has not answered the data, for the server to forward it.
+const (
+	closeLinger = 5 * time.Second
+	closeGrace  = time.Second
+)
+
+// withUploadTrace reports the end of the request that streams the upload.
+func (s *session) withUploadTrace(ctx context.Context) context.Context {
+	return httptrace.WithClientTrace(ctx, &httptrace.ClientTrace{
+		WroteRequest: func(httptrace.WroteRequestInfo) {
+			s.writtenOnce.Do(func() { close(s.uploadWritten) })
+		},
+	})
+}
+
+// hold makes the session keep a client (counted as running by get) until it
+// closes.
+func (s *session) hold(client *poolClient) {
+	s.clientAccess.Lock()
+	defer s.clientAccess.Unlock()
+	if s.closed.Load() {
+		client.release()
+		return
+	}
+	s.clients = append(s.clients, client)
+}
+
+// count makes the session end, when it closes, the session count get(true)
+// started on a client.
+func (s *session) count(client *poolClient) {
+	s.clientAccess.Lock()
+	defer s.clientAccess.Unlock()
+	if s.closed.Load() {
+		client.endSession()
+		return
+	}
+	s.counted = append(s.counted, client)
+}
+
+// withConnectTrace reports the first connection a request of the session got:
+// the dial returns then, before any response, since the server may hold the
+// response of a download until the first upload arrives.
+func (s *session) withConnectTrace(ctx context.Context) context.Context {
+	var once sync.Once
+	return httptrace.WithClientTrace(ctx, &httptrace.ClientTrace{
+		GotConn: func(info httptrace.GotConnInfo) {
+			once.Do(func() {
+				s.localAddr = info.Conn.LocalAddr()
+				s.remoteAddr = info.Conn.RemoteAddr()
+				close(s.connected)
+			})
+		},
+	})
+}
+
+// waitConnected waits for the download (or the stream-one request) to get its
+// connection, for the session to fail, or for the dial to be given up.
+func (s *session) waitConnected(ctx context.Context) error {
+	select {
+	case <-s.connected:
+		return nil
+	case <-s.downloadReady:
+		select {
+		case <-s.connected:
+			return nil
+		default:
+		}
+		return s.downloadErr
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+// startDownload sends the request whose response body is the download.
+func (s *session) startDownload(client *poolClient, request *http.Request) {
+	request = request.WithContext(s.withConnectTrace(request.Context()))
+	go func() {
+		response, err := client.roundTrip(request)
+		if err != nil {
+			s.fail(E.Cause(err, "xhttp: download"))
+			return
+		}
+		if response.StatusCode != http.StatusOK {
+			// Not read to its end first: the body of an error may never end,
+			// and a read of the session would wait for it.
+			response.Body.Close()
+			s.fail(E.New("xhttp: download: unexpected status ", response.Status))
+			return
+		}
+		if !s.setDownload(response.Body, nil) {
+			response.Body.Close()
+		}
+	}()
+}
+
+// startStreamUpload sends the request whose body streams the upload
+// (stream-up). Its response carries only the server's keep-alive padding.
+//
+// Unlike Xray's client, which does not look at the answer to this request, a
+// failure, an error status or an answer cut short ends the session: without its
+// upload it could only wait. An answer that ends is the server ending the
+// upload, as Xray does when the connection is over: the HTTP client closes the
+// request body then, and a later write finds it closed (ioError).
+func (s *session) startStreamUpload(client *poolClient, request *http.Request) {
+	go func() {
+		// the server ends its answer once it has read the upload to its end
+		defer s.writtenOnce.Do(func() { close(s.uploadWritten) })
+		response, err := client.roundTrip(request)
+		if err != nil {
+			s.fail(E.Cause(err, "xhttp: upload"))
+			return
+		}
+		if response.StatusCode != http.StatusOK {
+			response.Body.Close()
+			s.fail(E.New("xhttp: upload: unexpected status ", response.Status))
+			return
+		}
+		err = discardBody(response.Body)
+		if err != nil && !s.closed.Load() {
+			s.fail(E.Cause(err, "xhttp: upload"))
+		}
+	}()
+}
+
+// discardBody reads a body to its end and closes it; the error is the one of the
+// read, nil for a body that ended.
+func discardBody(body io.ReadCloser) error {
+	_, err := io.Copy(io.Discard, body)
+	body.Close()
+	return err
+}
+
+// setDownload sets the download body, or the error that stands for it, once;
+// it reports whether this call did.
+func (s *session) setDownload(body io.ReadCloser, err error) bool {
+	var set bool
+	s.downloadOnce.Do(func() {
+		s.download = body
+		s.downloadErr = err
+		close(s.downloadReady)
+		set = true
+	})
+	return set
+}
+
+// fail ends the session on the first failure of any of its requests: the other
+// half is aborted, and both halves report this failure from then on.
+func (s *session) fail(err error) {
+	failure := &failureBox{hideHTTPError(err)}
+	if !s.failure.CompareAndSwap(nil, failure) {
+		failure = s.failure.Load()
+	}
+	s.setDownload(nil, failure.err)
+	if s.streamBody != nil {
+		s.streamBody.CloseWithError(failure.err)
+	}
+	if s.packetUpload != nil {
+		s.packetUpload.interrupt(failure.err)
+	}
+	s.cancel()
+}
+
+// ioError turns an error of the HTTP machinery into the error the session
+// reports: net.ErrClosed once closed here, the failure that ended the session,
+// and otherwise an error that does not carry the HTTP/2 error types.
+//
+// io.ErrClosedPipe is a write after the HTTP client closed the body of the
+// request that carries the upload (stream-up, stream-one): the client does that
+// when the request is over, the server having ended its answer. That is the end
+// of the connection, as a closed socket is, not an error to report: a request
+// that failed fails the session first, and its failure is reported instead. The
+// HTTP client closes that body when a request fails too (a lost connection, a
+// reset stream): a write that comes before the failure is known reads as closed
+// as well, and the connection ends with no error reported unless the download
+// reports the cause first.
+func (s *session) ioError(err error) error {
+	if err == nil {
+		return nil
+	}
+	if s.closed.Load() {
+		return net.ErrClosed
+	}
+	if err == io.EOF {
+		return err
+	}
+	if failure := s.failure.Load(); failure != nil {
+		return failure.err
+	}
+	if err == io.ErrClosedPipe {
+		return net.ErrClosed
+	}
+	return hideHTTPError(err)
+}
+
+func (s *session) Read(b []byte) (int, error) {
+	<-s.downloadReady
+	if s.download == nil {
+		return 0, s.ioError(s.downloadErr)
+	}
+	if len(s.pending) > 0 {
+		n := copy(b, s.pending)
+		s.pending = s.pending[n:]
+		return n, nil
+	}
+	if s.pendingErr != nil {
+		err := s.pendingErr
+		s.pendingErr = nil
+		return 0, s.ioError(err)
+	}
+	n, err := s.download.Read(b)
+	if n > 0 && s.unanswered.Load() {
+		s.unanswered.Store(false)
+	}
+	s.flowing = n == len(b)
+	if err != nil {
+		err = s.ioError(err)
+	}
+	return n, err
+}
+
+// probeSize is what an idle session holds while it waits for the server.
+const probeSize = 512
+
+// CreateReadWaiter lets the copy loop of sing wait for download data without
+// its buffer: an idle session otherwise held a 32 KiB buffer for as long as
+// the server stayed silent. The response body of HTTP/2 and 3 can't be peeked,
+// so the waiter reads a small probe and hands it over before anything else;
+// while data keeps filling whole buffers it reads straight away.
+func (s *session) CreateReadWaiter() (N.ReadWaiter, bool) {
+	return readwait.NewPeekWaiter(s, s.waitData), true
+}
+
+func (s *session) waitData() error {
+	<-s.downloadReady
+	if s.download == nil || len(s.pending) > 0 || s.pendingErr != nil || s.flowing {
+		return nil
+	}
+	if s.probe == nil {
+		s.probe = make([]byte, probeSize)
+	}
+	n, err := s.download.Read(s.probe)
+	if n > 0 && s.unanswered.Load() {
+		s.unanswered.Store(false)
+	}
+	s.pending = s.probe[:n]
+	s.pendingErr = err
+	s.flowing = n == len(s.probe)
+	return nil
+}
+
+func (s *session) Write(b []byte) (int, error) {
+	if len(b) == 0 {
+		return 0, nil
+	}
+	if s.closed.Load() {
+		return 0, net.ErrClosed
+	}
+	var (
+		n   int
+		err error
+	)
+	if !s.unanswered.Load() {
+		s.unanswered.Store(true)
+	}
+	if s.packetUpload != nil {
+		n, err = s.packetUpload.write(b)
+	} else {
+		n, err = s.streamUpload.Write(b)
+	}
+	if err != nil {
+		err = s.ioError(err)
+	}
+	return n, err
+}
+
+// Close ends the session for its user at once, and the session itself once
+// the data written before has left: sing-box closes a connection as soon as
+// its source is done, and a request, a message or the last part of an upload
+// written just before that must still reach the server, as it does with Xray,
+// whose packet-up uploader and request bodies run to their end after a close.
+func (s *session) Close() error {
+	if s.closed.Swap(true) {
+		return nil
+	}
+	// What the server has not answered since it was written may still be on
+	// its way to the destination: the server takes the end of the download
+	// for the end of the session. Such a session stays a moment after its
+	// upload is sent, as an outbound of Xray does after the end of an upload
+	// (a second, by Xray's default policy). A session whose last write was
+	// answered, the usual end of an exchange, has nothing to wait for.
+	unanswered := s.unanswered.Load()
+	var sent <-chan struct{}
+	switch {
+	case s.failure.Load() != nil:
+	case s.packetUpload != nil:
+		if !s.packetUpload.idle() {
+			sent = s.packetUpload.finish()
+		} else if unanswered {
+			sent = closedChannel
+		}
+	case s.streamUpload != nil:
+		// the end of the request body: the HTTP client writes what it holds
+		s.streamUpload.Close()
+		sent = s.uploadWritten
+	}
+	if sent == nil {
+		s.teardown()
+		return nil
+	}
+	if !unanswered {
+		select {
+		case <-sent:
+			s.teardown()
+			return nil
+		default:
+		}
+	}
+	go func() {
+		defer s.teardown()
+		timer := time.NewTimer(closeLinger)
+		defer timer.Stop()
+		select {
+		case <-sent:
+		case <-s.ctx.Done():
+			return
+		case <-timer.C:
+			return
+		}
+		if unanswered {
+			timer.Reset(closeGrace)
+			select {
+			case <-timer.C:
+			case <-s.ctx.Done():
+			}
+		}
+	}()
+	return nil
+}
+
+var closedChannel = func() chan struct{} {
+	channel := make(chan struct{})
+	close(channel)
+	return channel
+}()
+
+// abandon ends a session nothing was written to, at once: a dial given up.
+func (s *session) abandon() {
+	s.closed.Store(true)
+	s.teardown()
+}
+
+// teardown aborts the requests of the session and lets go of its connections.
+func (s *session) teardown() {
+	s.tearOnce.Do(s.doTeardown)
+}
+
+func (s *session) closeDownload() {
+	if !s.setDownload(nil, net.ErrClosed) && s.download != nil {
+		s.download.Close()
+	}
+}
+
+func (s *session) doTeardown() {
+	s.cancel()
+	s.closeDownload()
+	if s.streamBody != nil {
+		s.streamBody.CloseWithError(net.ErrClosed)
+	}
+	if s.packetUpload != nil {
+		s.packetUpload.interrupt(net.ErrClosed)
+	}
+	s.clientAccess.Lock()
+	clients, counted := s.clients, s.counted
+	s.clients, s.counted = nil, nil
+	s.clientAccess.Unlock()
+	for _, client := range counted {
+		client.endSession()
+	}
+	for _, client := range clients {
+		client.release()
+	}
+}
+
+func (s *session) LocalAddr() net.Addr {
+	if s.localAddr == nil {
+		return M.Socksaddr{}
+	}
+	return s.localAddr
+}
+
+func (s *session) RemoteAddr() net.Addr {
+	if s.remoteAddr == nil {
+		return M.Socksaddr{}
+	}
+	return s.remoteAddr
+}
+
+// Deadlines are left to the caller's wrapper, as with the other HTTP based
+// transports (NeedAdditionalReadDeadline).
+func (s *session) SetDeadline(t time.Time) error {
+	return os.ErrInvalid
+}
+
+func (s *session) SetReadDeadline(t time.Time) error {
+	return os.ErrInvalid
+}
+
+func (s *session) SetWriteDeadline(t time.Time) error {
+	return os.ErrInvalid
+}
+
+func (s *session) NeedAdditionalReadDeadline() bool {
+	return true
+}
+
+// transportError carries the text of an HTTP error without its type. An
+// http2.StreamError read from a connection that an HTTP/2 client in turn reads
+// (DoH, a rule-set download or a chained outbound over this transport) sticks
+// in crypto/tls and makes that client's read loop spin on it forever.
+type transportError struct {
+	message string
+}
+
+func (e *transportError) Error() string {
+	return e.message
+}
+
+func hideHTTPError(err error) error {
+	if err == nil {
+		return nil
+	}
+	err = baderror.WrapH2(err)
+	if err == io.EOF || err == net.ErrClosed {
+		return err
+	}
+	if _, isHidden := err.(*transportError); isHidden {
+		return err
+	}
+	return &transportError{err.Error()}
+}
diff --git a/transport/v2rayxhttp/frame_size.go b/transport/v2rayxhttp/frame_size.go
new file mode 100644
index 000000000..3ae5ec68b
--- /dev/null
+++ b/transport/v2rayxhttp/frame_size.go
@@ -0,0 +1,73 @@
+package v2rayxhttp
+
+import (
+	"encoding/binary"
+	"io"
+	"net"
+)
+
+// maxWriteFrameSize is the largest HTTP/2 DATA frame sent to the server, the
+// protocol's initial value and what Chrome sends.
+const maxWriteFrameSize = 16 * 1024
+
+// frameSizeCapConn lowers the SETTINGS_MAX_FRAME_SIZE of the server's first
+// SETTINGS frame to maxWriteFrameSize before the HTTP/2 client reads it.
+//
+// The client of golang.org/x/net/http2 writes a request body through a
+// buffer as large as the server's maximum frame size, up to 512 KiB, held
+// until the body ends. A streamed upload (stream-up, stream-one) ends with its
+// session, and Xray's server announces 1 MiB: every such session held 512 KiB
+// (lab: 300 idle stream-one sessions, 567 KB each). Smaller frames cost a few
+// more of them on a bulk upload.
+//
+// The server's connection preface starts with a SETTINGS frame; a later
+// SETTINGS frame raising the size again is left alone.
+type frameSizeCapConn struct {
+	net.Conn
+	done    bool
+	pending []byte
+}
+
+// maxSettingsFrame bounds the first frame read whole: a SETTINGS frame has
+// six bytes per setting, and there are few.
+const maxSettingsFrame = 1024
+
+func (c *frameSizeCapConn) Read(b []byte) (int, error) {
+	if len(c.pending) > 0 {
+		n := copy(b, c.pending)
+		c.pending = c.pending[n:]
+		return n, nil
+	}
+	if c.done {
+		return c.Conn.Read(b)
+	}
+	c.done = true
+	frame := make([]byte, 9, 9+64)
+	_, err := io.ReadFull(c.Conn, frame)
+	if err != nil {
+		return 0, err
+	}
+	length := int(frame[0])<<16 | int(frame[1])<<8 | int(frame[2])
+	const frameTypeSettings, flagAck = 0x4, 0x1
+	if frame[3] == frameTypeSettings && frame[4]&flagAck == 0 && length <= maxSettingsFrame && length%6 == 0 {
+		payload := make([]byte, length)
+		_, err = io.ReadFull(c.Conn, payload)
+		if err != nil {
+			return 0, err
+		}
+		const settingMaxFrameSize = 0x5
+		for i := 0; i+6 <= len(payload); i += 6 {
+			if binary.BigEndian.Uint16(payload[i:]) == settingMaxFrameSize && binary.BigEndian.Uint32(payload[i+2:]) > maxWriteFrameSize {
+				binary.BigEndian.PutUint32(payload[i+2:], maxWriteFrameSize)
+			}
+		}
+		frame = append(frame, payload...)
+	}
+	n := copy(b, frame)
+	c.pending = frame[n:]
+	return n, nil
+}
+
+func (c *frameSizeCapConn) Upstream() any {
+	return c.Conn
+}
diff --git a/transport/v2rayxhttp/frame_size_test.go b/transport/v2rayxhttp/frame_size_test.go
new file mode 100644
index 000000000..9e55e700a
--- /dev/null
+++ b/transport/v2rayxhttp/frame_size_test.go
@@ -0,0 +1,116 @@
+package v2rayxhttp
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"io"
+	"net"
+	"runtime"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/stretchr/testify/require"
+)
+
+func settingsFrame(flags byte, settings ...uint32) []byte {
+	payload := make([]byte, 0, len(settings)*3)
+	for i := 0; i+1 < len(settings); i += 2 {
+		payload = binary.BigEndian.AppendUint16(payload, uint16(settings[i]))
+		payload = binary.BigEndian.AppendUint32(payload, settings[i+1])
+	}
+	frame := []byte{byte(len(payload) >> 16), byte(len(payload) >> 8), byte(len(payload)), 0x4, flags, 0, 0, 0, 0}
+	return append(frame, payload...)
+}
+
+// oneByteConn delivers what it holds a byte per read.
+type oneByteConn struct {
+	net.Conn
+	data *bytes.Reader
+}
+
+func (c *oneByteConn) Read(b []byte) (int, error) {
+	return c.data.Read(b[:min(len(b), 1)])
+}
+
+func TestFrameSizeCap(t *testing.T) {
+	const initialWindow, maxFrameSize = 0x4, 0x5
+	data := []byte("after the frame")
+	cases := map[string]struct {
+		input, expected []byte
+	}{
+		"lowered": {
+			append(settingsFrame(0, initialWindow, 1<<20, maxFrameSize, 1<<20), data...),
+			append(settingsFrame(0, initialWindow, 1<<20, maxFrameSize, 16384), data...),
+		},
+		"already small": {
+			append(settingsFrame(0, maxFrameSize, 16384), data...),
+			append(settingsFrame(0, maxFrameSize, 16384), data...),
+		},
+		"not settings": {
+			append([]byte{0, 0, 2, 0x1, 0x4, 0, 0, 0, 1, 1, 2}, settingsFrame(0, maxFrameSize, 1<<20)...),
+			append([]byte{0, 0, 2, 0x1, 0x4, 0, 0, 0, 1, 1, 2}, settingsFrame(0, maxFrameSize, 1<<20)...),
+		},
+		"acknowledgement": {
+			settingsFrame(0x1), settingsFrame(0x1),
+		},
+	}
+	for name, c := range cases {
+		for _, split := range []bool{false, true} {
+			var conn net.Conn = &oneByteConn{data: bytes.NewReader(c.input)}
+			if !split {
+				reader := bytes.NewReader(c.input)
+				conn = &readerConn{reader}
+			}
+			output, err := io.ReadAll(&frameSizeCapConn{Conn: conn})
+			require.NoError(t, err, name)
+			require.Equal(t, c.expected, output, name)
+		}
+	}
+}
+
+type readerConn struct {
+	*bytes.Reader
+}
+
+func (c *readerConn) Close() error                     { return nil }
+func (c *readerConn) Write(b []byte) (int, error)      { return len(b), nil }
+func (c *readerConn) LocalAddr() net.Addr              { return nil }
+func (c *readerConn) RemoteAddr() net.Addr             { return nil }
+func (c *readerConn) SetDeadline(time.Time) error      { return nil }
+func (c *readerConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *readerConn) SetWriteDeadline(time.Time) error { return nil }
+
+// The Go server of the test, like Xray's, announces 1 MiB frames: without the
+// cap every idle stream-one session held a 512 KiB request body buffer.
+func TestXHTTPStreamedUploadMemory(t *testing.T) {
+	client, _ := newTestPair(t, option.V2RayXHTTPOptions{Mode: modeStreamOne}, "h2", nil)
+	warmup, err := client.DialContext(context.Background())
+	require.NoError(t, err)
+	echo(t, warmup, 1024)
+	warmup.Close()
+	heap := func() uint64 {
+		runtime.GC()
+		runtime.GC()
+		var stats runtime.MemStats
+		runtime.ReadMemStats(&stats)
+		return stats.HeapAlloc
+	}
+	before := heap()
+	const sessions = 50
+	var conns []net.Conn
+	for i := 0; i < sessions; i++ {
+		conn, err := client.DialContext(context.Background())
+		require.NoError(t, err)
+		echo(t, conn, 1024)
+		conns = append(conns, conn)
+	}
+	perSession := (int64(heap()) - int64(before)) / sessions
+	for _, conn := range conns {
+		conn.Close()
+	}
+	t.Logf("heap per idle stream-one session (client and test server): %d B", perSession)
+	require.Less(t, perSession, int64(128*1024))
+}
diff --git a/transport/v2rayxhttp/http3.go b/transport/v2rayxhttp/http3.go
new file mode 100644
index 000000000..abbe3759c
--- /dev/null
+++ b/transport/v2rayxhttp/http3.go
@@ -0,0 +1,288 @@
+//go:build with_quic
+
+package v2rayxhttp
+
+import (
+	"context"
+	stdTLS "crypto/tls"
+	"io"
+	"net"
+	"net/http"
+	"runtime"
+	"sync"
+	"time"
+
+	"github.com/sagernet/quic-go"
+	"github.com/sagernet/quic-go/http3"
+	"github.com/sagernet/sing-box/common/tls"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	congestion_meta2 "github.com/sagernet/sing-quic/congestion_meta2"
+	"github.com/sagernet/sing/common/bufio"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// quicKeepAlivePeriod is the QUIC keep-alive of an idle HTTP/3 connection
+// (Xray's net.QuicgoH3KeepAlivePeriod).
+const quicKeepAlivePeriod = 10 * time.Second
+
+// maxLaneRequests is how many requests at a time one QUIC connection is given.
+// A server allows so many open streams to a connection, 100 with quic-go's
+// defaults (Xray) and with the common servers and CDNs, and the HTTP/3 client
+// waits for a free one where the HTTP/2 client opens another connection: the
+// sessions past the limit hung until others ended (lab: 250 sessions held, 300
+// not). The margin is for the streams the server has not counted closed yet.
+const maxLaneRequests = 90
+
+// laneIdleTimeout closes a QUIC connection added for a burst once it has had
+// no request for this long.
+const laneIdleTimeout = 30 * time.Second
+
+// http3Connection carries the requests of its sessions as streams of a QUIC
+// connection, and of more connections (lanes) while one is full.
+type http3Connection struct {
+	newTransport func(lane *http3Lane) *http3.Transport
+
+	access sync.Mutex
+	lanes  []*http3Lane
+	closed bool
+}
+
+// http3Lane is one QUIC connection of an http3Connection.
+type http3Lane struct {
+	owner     *http3Connection
+	transport *http3.Transport
+	// requests on their way, and the timer that closes the lane when there
+	// are none; both under the lock of the owner.
+	requests  int
+	idleTimer *time.Timer
+	// conns are the QUIC connections dialed: http3.Transport forgets one whose
+	// request failed without closing it, and its keep-alive then holds it,
+	// its socket and its goroutines open.
+	conns  map[*quic.Conn]struct{}
+	closed bool
+	// ctx is done when the lane closes: a dial does not outlive it.
+	ctx    context.Context
+	cancel context.CancelFunc
+}
+
+func (l *http3Lane) track(conn *quic.Conn) bool {
+	c := l.owner
+	c.access.Lock()
+	defer c.access.Unlock()
+	if l.closed {
+		return false
+	}
+	if l.conns == nil {
+		l.conns = make(map[*quic.Conn]struct{})
+	}
+	l.conns[conn] = struct{}{}
+	context.AfterFunc(conn.Context(), func() {
+		c.access.Lock()
+		delete(l.conns, conn)
+		c.access.Unlock()
+	})
+	return true
+}
+
+// close closes the lane; the caller has taken it out of the list and marked
+// it closed under the lock.
+func (l *http3Lane) close(conns map[*quic.Conn]struct{}) {
+	l.cancel()
+	l.transport.Close()
+	for conn := range conns {
+		conn.CloseWithError(0, "")
+	}
+}
+
+// acquire counts a request on a lane with room for it, the first one, so that
+// the later ones empty and close; a new lane when all are full.
+func (c *http3Connection) acquire() (*http3Lane, error) {
+	c.access.Lock()
+	defer c.access.Unlock()
+	if c.closed {
+		return nil, net.ErrClosed
+	}
+	var lane *http3Lane
+	for _, candidate := range c.lanes {
+		if candidate.requests < maxLaneRequests {
+			lane = candidate
+			break
+		}
+	}
+	if lane == nil {
+		lane = &http3Lane{owner: c}
+		lane.ctx, lane.cancel = context.WithCancel(context.Background())
+		lane.transport = c.newTransport(lane)
+		c.lanes = append(c.lanes, lane)
+	}
+	lane.requests++
+	if lane.idleTimer != nil {
+		lane.idleTimer.Stop()
+		lane.idleTimer = nil
+	}
+	return lane, nil
+}
+
+func (c *http3Connection) release(lane *http3Lane) {
+	c.access.Lock()
+	defer c.access.Unlock()
+	lane.requests--
+	// the first lane stays: the pool retires the whole connection when idle
+	if lane.requests > 0 || lane.closed || len(c.lanes) == 0 || c.lanes[0] == lane {
+		return
+	}
+	lane.idleTimer = time.AfterFunc(laneIdleTimeout, func() {
+		c.access.Lock()
+		if lane.requests > 0 || lane.closed {
+			c.access.Unlock()
+			return
+		}
+		lane.closed = true
+		for i, other := range c.lanes {
+			if other == lane {
+				c.lanes = append(c.lanes[:i], c.lanes[i+1:]...)
+				break
+			}
+		}
+		conns := lane.conns
+		lane.conns = nil
+		c.access.Unlock()
+		lane.close(conns)
+	})
+}
+
+// laneBody ends the count of its request when the response body is closed.
+type laneBody struct {
+	io.ReadCloser
+	release func()
+}
+
+func (b *laneBody) Close() error {
+	err := b.ReadCloser.Close()
+	b.release()
+	return err
+}
+
+func newHTTP3Connections(dialer N.Dialer, serverAddr M.Socksaddr, tlsConfig tls.Config, keepAlivePeriod time.Duration) (func() pooledConnection, error) {
+	stdConfig, err := tls.STDConfigForQUIC(tlsConfig)
+	if err != nil {
+		return nil, E.Cause(err, "xhttp: HTTP/3 TLS")
+	}
+	stdConfig = stdConfig.Clone()
+	stdConfig.NextProtos = []string{http3.NextProtoH3}
+	// The QUIC handshake looks like Chrome's, as with Xray. quic-go's Chrome
+	// profile refuses VerifyConnection, which checks the server name with
+	// disable_sni, and the Certificates field, which carries a client
+	// certificate here.
+	chromeParrot := true
+	if stdConfig.VerifyConnection != nil {
+		chromeParrot = false
+		log.StdLogger().Warn("xhttp: disable_sni turns the Chrome profile of HTTP/3 off")
+	}
+	if len(stdConfig.Certificates) > 0 {
+		certificate := stdConfig.Certificates[0]
+		stdConfig.Certificates = nil
+		stdConfig.GetClientCertificate = func(*stdTLS.CertificateRequestInfo) (*stdTLS.Certificate, error) {
+			return &certificate, nil
+		}
+	}
+	switch {
+	case keepAlivePeriod == 0:
+		keepAlivePeriod = quicKeepAlivePeriod
+	case keepAlivePeriod < 0:
+		keepAlivePeriod = 0
+	}
+	quicConfig := &quic.Config{
+		MaxIdleTimeout:          connectionIdleTimeout,
+		KeepAlivePeriod:         keepAlivePeriod,
+		MaxIncomingStreams:      -1,
+		DisablePathMTUDiscovery: !(runtime.GOOS == "linux" || runtime.GOOS == "windows" || runtime.GOOS == "darwin"),
+		ChromeParrot:            chromeParrot,
+	}
+	return func() pooledConnection {
+		connection := &http3Connection{}
+		connection.newTransport = func(lane *http3Lane) *http3.Transport {
+			return &http3.Transport{
+				TLSClientConfig: stdConfig,
+				QUICConfig:      quicConfig,
+				Dial: func(ctx context.Context, addr string, tlsConfig *tls.STDConfig, quicConfig *quic.Config) (*quic.Conn, error) {
+					// The connection is shared: the session whose request started
+					// the dial must not take it down, by closing, for the sessions
+					// waiting for it.
+					// It ends with its lane: closing the HTTP/3 client waits for
+					// a dial in progress.
+					ctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), C.TCPTimeout)
+					defer cancel()
+					defer context.AfterFunc(lane.ctx, cancel)()
+					// http3.Transport fills an empty server name from the request's
+					// host, which would undo disable_sni.
+					tlsConfig = tlsConfig.Clone()
+					tlsConfig.ServerName = stdConfig.ServerName
+					conn, err := dialer.DialContext(ctx, N.NetworkUDP, serverAddr)
+					if err != nil {
+						return nil, err
+					}
+					quicConn, err := quic.DialEarly(ctx, bufio.NewUnbindPacketConn(conn), conn.RemoteAddr(), tlsConfig, quicConfig)
+					if err != nil {
+						conn.Close()
+						return nil, err
+					}
+					// quic-go does not own a packet conn passed to DialEarly: it
+					// only stops reading it when the connection ends.
+					context.AfterFunc(quicConn.Context(), func() {
+						conn.Close()
+					})
+					// BBR with the standard profile, as Xray's HTTP/3 uses.
+					quicConn.SetCongestionControl(congestion_meta2.NewBbrSenderWithProfile(quicConn.InitialPacketSize(), congestion_meta2.ProfileStandard))
+					if !lane.track(quicConn) {
+						quicConn.CloseWithError(0, "")
+						return nil, net.ErrClosed
+					}
+					return quicConn, nil
+				},
+			}
+		}
+		return connection
+	}, nil
+}
+
+func (c *http3Connection) roundTrip(request *http.Request) (*http.Response, error) {
+	lane, err := c.acquire()
+	if err != nil {
+		return nil, err
+	}
+	var once sync.Once
+	release := func() { once.Do(func() { c.release(lane) }) }
+	response, err := lane.transport.RoundTrip(request)
+	if err != nil {
+		release()
+		return nil, err
+	}
+	response.Body = &laneBody{response.Body, release}
+	// a request given up by its context frees its stream as well
+	context.AfterFunc(request.Context(), release)
+	return response, nil
+}
+
+func (c *http3Connection) close() {
+	c.access.Lock()
+	lanes := c.lanes
+	c.lanes = nil
+	c.closed = true
+	conns := make([]map[*quic.Conn]struct{}, len(lanes))
+	for i, lane := range lanes {
+		lane.closed = true
+		if lane.idleTimer != nil {
+			lane.idleTimer.Stop()
+		}
+		conns[i] = lane.conns
+		lane.conns = nil
+	}
+	c.access.Unlock()
+	for i, lane := range lanes {
+		lane.close(conns[i])
+	}
+}
diff --git a/transport/v2rayxhttp/http3_stub.go b/transport/v2rayxhttp/http3_stub.go
new file mode 100644
index 000000000..f265ddfb9
--- /dev/null
+++ b/transport/v2rayxhttp/http3_stub.go
@@ -0,0 +1,16 @@
+//go:build !with_quic
+
+package v2rayxhttp
+
+import (
+	"time"
+
+	"github.com/sagernet/sing-box/common/tls"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+func newHTTP3Connections(dialer N.Dialer, serverAddr M.Socksaddr, tlsConfig tls.Config, keepAlivePeriod time.Duration) (func() pooledConnection, error) {
+	return nil, E.New("xhttp: HTTP/3 (tls.alpn [\"h3\"]) needs a build with QUIC")
+}
diff --git a/transport/v2rayxhttp/http3_test.go b/transport/v2rayxhttp/http3_test.go
new file mode 100644
index 000000000..a0d2e401a
--- /dev/null
+++ b/transport/v2rayxhttp/http3_test.go
@@ -0,0 +1,161 @@
+//go:build with_quic
+
+package v2rayxhttp
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/sagernet/quic-go/http3"
+	"github.com/sagernet/sing-box/common/tls"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json/badoption"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+// tls.alpn ["h3"] selects HTTP/3, every mode over QUIC streams.
+func TestXHTTPHTTP3(t *testing.T) {
+	testHTTP3(t, false)
+}
+
+// A request the server resets must not leave its QUIC connection behind:
+// http3.Transport forgets such a connection without closing it.
+func TestXHTTPHTTP3ResetLeavesNothing(t *testing.T) {
+	testHTTP3(t, true)
+}
+
+func testHTTP3(t *testing.T, abortUploads bool) {
+	modes := []string{modePacketUp, modeStreamUp, modeStreamOne}
+	if abortUploads {
+		modes = []string{modePacketUp, modeStreamUp}
+	}
+	for _, mode := range modes {
+		t.Run(mode, func(t *testing.T) {
+			options := option.V2RayXHTTPOptions{Mode: mode}
+			options.Path = "/h3"
+			serverConfig, err := newRequestConfig(options.V2RayXHTTPBaseOptions, mode)
+			require.NoError(t, err)
+			handler := &testServer{t: t, config: serverConfig, sessions: make(map[string]*testSession), requests: make(map[string]int), abortUploads: abortUploads}
+			// httptest only provides the certificate here.
+			certificateServer := httptest.NewUnstartedServer(nil)
+			certificateServer.StartTLS()
+			serverTLS := certificateServer.TLS.Clone()
+			certificateServer.Close()
+			serverTLS.NextProtos = []string{http3.NextProtoH3}
+			packetConn, err := net.ListenPacket("udp", "127.0.0.1:0")
+			require.NoError(t, err)
+			server := &http3.Server{Handler: http.HandlerFunc(handler.serveHTTP), TLSConfig: serverTLS}
+			go server.Serve(packetConn)
+			t.Cleanup(func() {
+				server.Close()
+				packetConn.Close()
+			})
+			tlsConfig, err := tls.NewClient(context.Background(), log.StdLogger(), "example.com", option.OutboundTLSOptions{
+				Enabled: true, Insecure: true, ServerName: "example.com", ALPN: badoption.Listable[string]{"h3"},
+			})
+			require.NoError(t, err)
+			transport, err := NewClient(context.Background(), N.SystemDialer, M.SocksaddrFromNet(packetConn.LocalAddr()), options, tlsConfig)
+			require.NoError(t, err)
+			baseline := settledGoroutines()
+			for i := 0; i < 3; i++ {
+				conn, err := transport.DialContext(context.Background())
+				if abortUploads && err != nil {
+					// the pool backs off after the resets
+					continue
+				}
+				require.NoError(t, err)
+				if abortUploads {
+					conn.Write([]byte("x"))
+					conn.Read(make([]byte, 1))
+				} else {
+					echo(t, conn, 128*1024)
+				}
+				conn.Close()
+			}
+			transport.Close()
+			waitGoroutines(t, baseline)
+			require.Zero(t, handler.requestCount("bad-padding"))
+		})
+	}
+}
+
+// More sessions than one QUIC connection has streams for: the server allows
+// 100 at a time by quic-go's default, and the sessions past them must get a
+// connection of their own instead of waiting for a stream.
+func TestXHTTPHTTP3StreamLimit(t *testing.T) {
+	options := option.V2RayXHTTPOptions{Mode: modeStreamOne}
+	options.Path = "/h3"
+	// one pooled connection, so that the lanes are what carries the excess
+	options.Xmux = &option.V2RayXHTTPXmuxOptions{MaxConnections: &option.V2RayXHTTPRange{From: 1, To: 1}}
+	serverConfig, err := newRequestConfig(options.V2RayXHTTPBaseOptions, modeStreamOne)
+	require.NoError(t, err)
+	handler := &testServer{t: t, config: serverConfig, sessions: make(map[string]*testSession), requests: make(map[string]int)}
+	certificateServer := httptest.NewUnstartedServer(nil)
+	certificateServer.StartTLS()
+	serverTLS := certificateServer.TLS.Clone()
+	certificateServer.Close()
+	serverTLS.NextProtos = []string{http3.NextProtoH3}
+	packetConn, err := net.ListenPacket("udp", "127.0.0.1:0")
+	require.NoError(t, err)
+	server := &http3.Server{Handler: http.HandlerFunc(handler.serveHTTP), TLSConfig: serverTLS}
+	go server.Serve(packetConn)
+	t.Cleanup(func() {
+		server.Close()
+		packetConn.Close()
+	})
+	tlsConfig, err := tls.NewClient(context.Background(), log.StdLogger(), "example.com", option.OutboundTLSOptions{
+		Enabled: true, Insecure: true, ServerName: "example.com", ALPN: badoption.Listable[string]{"h3"},
+	})
+	require.NoError(t, err)
+	transport, err := NewClient(context.Background(), N.SystemDialer, M.SocksaddrFromNet(packetConn.LocalAddr()), options, tlsConfig)
+	require.NoError(t, err)
+	baseline := settledGoroutines()
+	const sessions = 250
+	conns := make([]net.Conn, 0, sessions)
+	for i := 0; i < sessions; i++ {
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		conn, err := transport.DialContext(ctx)
+		cancel()
+		require.NoError(t, err, "session %d", i)
+		conns = append(conns, conn)
+	}
+	// every one of them carries data while all are open
+	for i, conn := range conns {
+		conn.SetDeadline(time.Now().Add(10 * time.Second))
+		message := []byte{byte(i), byte(i >> 8), 7}
+		_, err = conn.Write(message)
+		require.NoError(t, err, "session %d", i)
+		reply := make([]byte, len(message))
+		done := make(chan error, 1)
+		go func() {
+			_, err := io.ReadFull(conn, reply)
+			done <- err
+		}()
+		select {
+		case err = <-done:
+			require.NoError(t, err, "session %d", i)
+			require.Equal(t, message, reply)
+		case <-time.After(10 * time.Second):
+			t.Fatalf("session %d got no stream", i)
+		}
+	}
+	connection := transport.(*Client).upPool.clients[0].connection.(*http3Connection)
+	connection.access.Lock()
+	lanes := len(connection.lanes)
+	connection.access.Unlock()
+	require.Equal(t, 3, lanes, "250 sessions, 90 to a QUIC connection")
+	for _, conn := range conns {
+		conn.Close()
+	}
+	transport.Close()
+	waitGoroutines(t, baseline)
+}
diff --git a/transport/v2rayxhttp/many_test.go b/transport/v2rayxhttp/many_test.go
new file mode 100644
index 000000000..2ef7c6a7a
--- /dev/null
+++ b/transport/v2rayxhttp/many_test.go
@@ -0,0 +1,82 @@
+package v2rayxhttp
+
+import (
+	"context"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Many sessions held at once, each carrying a little data: the load of a busy
+// network, where the HTTP/2 client spreads the streams over more connections.
+func TestXHTTPManySessions(t *testing.T) {
+	for _, mode := range []string{modePacketUp, modeStreamUp, modeStreamOne} {
+		t.Run(mode, func(t *testing.T) {
+			options := option.V2RayXHTTPOptions{Mode: mode}
+			// connections rotate many times while the sessions are open
+			options.Xmux = &option.V2RayXHTTPXmuxOptions{
+				MaxConnections:   &option.V2RayXHTTPRange{From: 3, To: 3},
+				HMaxRequestTimes: &option.V2RayXHTTPRange{From: 40, To: 40},
+			}
+			client, _ := newTestPair(t, options, "h2", nil)
+			const sessions = 300
+			var (
+				group  sync.WaitGroup
+				access sync.Mutex
+				failed []string
+				conns  []net.Conn
+			)
+			limit := make(chan struct{}, 20)
+			for i := 0; i < sessions; i++ {
+				group.Add(1)
+				limit <- struct{}{}
+				go func(i int) {
+					defer group.Done()
+					defer func() { <-limit }()
+					conn, err := client.DialContext(context.Background())
+					if err != nil {
+						access.Lock()
+						failed = append(failed, "dial: "+err.Error())
+						access.Unlock()
+						return
+					}
+					access.Lock()
+					conns = append(conns, conn)
+					access.Unlock()
+					// two writes, as a proxied request makes: the header of the
+					// protocol above, then the payload
+					conn.Write([]byte{byte(i)})
+					conn.Write([]byte{byte(i >> 8), 7})
+					reply := make([]byte, 3)
+					conn.SetReadDeadline(time.Now().Add(10 * time.Second))
+					done := make(chan error, 1)
+					go func() {
+						_, err := io.ReadFull(conn, reply)
+						done <- err
+					}()
+					select {
+					case err = <-done:
+					case <-time.After(10 * time.Second):
+						err = context.DeadlineExceeded
+					}
+					if err != nil {
+						access.Lock()
+						failed = append(failed, "echo: "+err.Error())
+						access.Unlock()
+					}
+				}(i)
+			}
+			group.Wait()
+			for _, conn := range conns {
+				conn.Close()
+			}
+			require.Empty(t, failed, "%d of %d sessions failed", len(failed), sessions)
+		})
+	}
+}
diff --git a/transport/v2rayxhttp/pool.go b/transport/v2rayxhttp/pool.go
new file mode 100644
index 000000000..430c8d078
--- /dev/null
+++ b/transport/v2rayxhttp/pool.go
@@ -0,0 +1,583 @@
+package v2rayxhttp
+
+import (
+	"context"
+	"errors"
+	"math"
+	"math/rand/v2"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/common/tls"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"golang.org/x/net/http2"
+)
+
+const (
+	// connectionIdleTimeout closes a pooled connection no request has used for
+	// this long (Xray's net.ConnIdleTimeout).
+	connectionIdleTimeout = 300 * time.Second
+	// chromeH2KeepAlivePeriod is the HTTP/2 ping interval of an idle connection
+	// (Xray's net.ChromeH2KeepAlivePeriod).
+	chromeH2KeepAlivePeriod = 45 * time.Second
+
+	// A pooled connection that fails before it has lived youngConnection is
+	// counted against the server: after the second such failure in a row new
+	// connections wait, longer each time, up to maxBackoff. A server or CDN that
+	// resets every stream would otherwise be redialled as fast as the clients
+	// reconnect, a TLS handshake each time.
+	youngConnection = 5 * time.Second
+	failureMemory   = 30 * time.Second
+	firstBackoff    = 250 * time.Millisecond
+	maxBackoff      = 5 * time.Second
+)
+
+// pooledConnection is one HTTP connection of the pool (for HTTP/1.1 a few, see
+// http1Connection): every request of a session that took it goes through it.
+type pooledConnection interface {
+	roundTrip(request *http.Request) (*http.Response, error)
+	// close tears the connection down, requests in flight included.
+	close()
+}
+
+type pool struct {
+	// ctx is the context the transport was created with: once it is done the
+	// pool opens no connections (see Client.Close).
+	ctx           context.Context
+	newConnection func() pooledConnection
+	// watched: the connections notice a server that went silent by themselves
+	// (HTTP/2 pings, the idle timeout and keep-alive of QUIC) and fail the
+	// requests on them.
+	watched     bool
+	config      xmuxConfig
+	idleTimeout time.Duration
+	concurrency int32
+	connections int32
+
+	access  sync.Mutex
+	clients []*poolClient
+	// retired holds the clients taken out of the pool that sessions still use,
+	// for close to reach them.
+	retired map[*poolClient]struct{}
+	// generation counts the resets (close). A client of an earlier generation
+	// was closed by one: it belongs to the network as it was before.
+	generation uint64
+	failures   int
+	lastFail   time.Time
+	retryAt    time.Time
+	lastErr    error
+}
+
+func newPool(ctx context.Context, config xmuxConfig, newConnection func() pooledConnection) *pool {
+	return &pool{
+		ctx:           ctx,
+		newConnection: newConnection,
+		config:        config,
+		idleTimeout:   poolIdleTimeout,
+		concurrency:   config.maxConcurrency.rand(),
+		connections:   config.maxConnections.rand(),
+	}
+}
+
+// poolClient is a pooled connection with its XMUX budget. running counts the
+// sessions and upload requests using it: a client taken out of the pool is
+// closed once the last of them is done.
+type poolClient struct {
+	pool       *pool
+	connection pooledConnection
+	createdAt  time.Time
+	// generation is that of the pool when the client was made.
+	generation uint64
+	running    atomic.Int32
+	// sessions counts the sessions on the client, what max_concurrency limits
+	// (Xray counts a session once, whatever requests it has in flight).
+	sessions     atomic.Int32
+	leftUsage    int32 // under pool.access; -1 is no limit
+	leftRequests atomic.Int32
+	unreusableAt time.Time
+	broken       atomic.Bool
+	removed      atomic.Bool
+	// closed is set once the connection is shut down: a request a session
+	// sends afterwards is refused here, before the HTTP client dials for it.
+	closed    atomic.Bool
+	closeOnce sync.Once
+	// idleGeneration changes whenever the client is taken, so that a check
+	// scheduled when it went idle knows whether it stayed idle.
+	idleGeneration atomic.Uint64
+	timerAccess    sync.Mutex
+	idleTimer      *time.Timer
+}
+
+// poolIdleTimeout retires a pooled connection no session has used for this
+// long. HTTP/3 needs it: the QUIC keep-alive keeps an idle connection open
+// for good (Xray keeps it until XMUX retires it, 30 to 50 minutes on).
+var poolIdleTimeout = connectionIdleTimeout
+
+// get returns a client for a new session (session is true: it then counts
+// against max_concurrency until endSession) or for the next upload request of
+// one, and counts it as running; release gives it back.
+func (p *pool) get(session bool) (*poolClient, error) {
+	client, removed, err := p.take(session)
+	// Closed outside the lock: closing a TLS connection may wait on its peer.
+	for _, old := range removed {
+		old.closeIfIdle()
+	}
+	return client, err
+}
+
+func (p *pool) take(session bool) (*poolClient, []*poolClient, error) {
+	p.access.Lock()
+	defer p.access.Unlock()
+	if p.ctx.Err() != nil {
+		return nil, nil, net.ErrClosed
+	}
+	now := time.Now()
+	var removed []*poolClient
+	for i := 0; i < len(p.clients); {
+		client := p.clients[i]
+		if client.broken.Load() || client.leftUsage == 0 || client.leftRequests.Load() <= 0 ||
+			(!client.unreusableAt.IsZero() && now.After(client.unreusableAt)) {
+			p.retireLocked(client)
+			removed = append(removed, client)
+			p.clients = append(p.clients[:i], p.clients[i+1:]...)
+		} else {
+			i++
+		}
+	}
+	// pick takes one of the pooled clients that has room for a session.
+	pick := func() *poolClient {
+		candidates := p.clients
+		if p.concurrency > 0 {
+			candidates = make([]*poolClient, 0, len(p.clients))
+			for _, candidate := range p.clients {
+				if candidate.sessions.Load() < p.concurrency {
+					candidates = append(candidates, candidate)
+				}
+			}
+		}
+		if len(candidates) == 0 {
+			return nil
+		}
+		picked := candidates[rand.IntN(len(candidates))]
+		if picked.leftUsage > 0 {
+			picked.leftUsage--
+		}
+		return picked
+	}
+	var client *poolClient
+	wantMore := len(p.clients) == 0 || (p.connections > 0 && len(p.clients) < int(p.connections))
+	if !wantMore {
+		client = pick()
+	}
+	if client == nil {
+		if now.Before(p.retryAt) {
+			// No new connection for now. The backoff is about connecting: a
+			// connection that works goes on serving, also when the pool would
+			// rather have opened one more.
+			client = pick()
+			if client == nil {
+				return nil, removed, E.Cause(p.lastErr, "xhttp: server failed ", p.failures, " connections in a row, next try in ", p.retryAt.Sub(now).Round(time.Millisecond))
+			}
+		} else {
+			client = p.newClient(now)
+		}
+	}
+	client.acquire()
+	if session {
+		client.sessions.Add(1)
+	}
+	return client, removed, nil
+}
+
+// retireLocked marks a client as out of the pool; the caller removes it from
+// clients and calls closeIfIdle after unlocking.
+func (p *pool) retireLocked(client *poolClient) {
+	client.removed.Store(true)
+	if p.retired == nil {
+		p.retired = make(map[*poolClient]struct{})
+	}
+	p.retired[client] = struct{}{}
+}
+
+// acquire counts one more user of the client; release ends it.
+func (c *poolClient) acquire() {
+	c.running.Add(1)
+	c.idleGeneration.Add(1)
+	c.timerAccess.Lock()
+	if c.idleTimer != nil {
+		c.idleTimer.Stop()
+		c.idleTimer = nil
+	}
+	c.timerAccess.Unlock()
+}
+
+// endSession ends the count get(true) started.
+func (c *poolClient) endSession() {
+	c.sessions.Add(-1)
+}
+
+func (p *pool) newClient(now time.Time) *poolClient {
+	client := &poolClient{
+		pool:       p,
+		connection: p.newConnection(),
+		createdAt:  now,
+		generation: p.generation,
+		leftUsage:  -1,
+	}
+	if usage := p.config.cMaxReuseTimes.rand(); usage > 0 {
+		client.leftUsage = usage - 1
+	}
+	client.leftRequests.Store(math.MaxInt32)
+	if requests := p.config.hMaxRequestTimes.rand(); requests > 0 {
+		client.leftRequests.Store(requests)
+	}
+	if seconds := p.config.hMaxReusableSecs.rand(); seconds > 0 {
+		client.unreusableAt = now.Add(time.Duration(seconds) * time.Second)
+	}
+	p.clients = append(p.clients, client)
+	return client
+}
+
+// usable tells whether a session holding the client may still send requests
+// through it (packet-up moves its uploads to another client when not).
+func (c *poolClient) usable() bool {
+	return !c.broken.Load() && c.leftRequests.Load() > 0 &&
+		(c.unreusableAt.IsZero() || time.Now().Before(c.unreusableAt))
+}
+
+func (c *poolClient) roundTrip(request *http.Request) (*http.Response, error) {
+	if c.closed.Load() {
+		// The HTTP clients would open a connection for the request, to have
+		// it closed at once: a handshake the server sees, for nothing.
+		return nil, net.ErrClosed
+	}
+	c.leftRequests.Add(-1)
+	response, err := c.connection.roundTrip(request)
+	if err != nil {
+		c.fail(request.Context(), err)
+	}
+	return response, err
+}
+
+// headersTooLarge tells the error of a request the HTTP/2 client did not send:
+// its headers are larger than the server said it takes. (The error value is
+// not exported by golang.org/x/net/http2.)
+func headersTooLarge(err error) bool {
+	return err != nil && strings.Contains(err.Error(), "request header list larger than peer's advertised limit")
+}
+
+// fail takes the client out of service after a failed request, as Xray does
+// after a failed download or packet. A request we cancelled ourselves (a
+// session closed, a dial given up) says nothing about the server, and neither
+// does one that was never sent for the size of its headers: the connection is
+// as good as it was, and other sessions go on using it.
+func (c *poolClient) fail(ctx context.Context, err error) {
+	if errors.Is(ctx.Err(), context.Canceled) || errors.Is(err, context.Canceled) || errors.Is(err, net.ErrClosed) || headersTooLarge(err) {
+		return
+	}
+	if c.broken.Swap(true) {
+		return
+	}
+	if gracefulGoAway(err) {
+		// The server retires the connection in good order, as a proxy does
+		// after so many requests: a new one is due, with nothing to hold
+		// against the server.
+		return
+	}
+	c.pool.noteFailure(c, err)
+}
+
+// gracefulGoAway tells the error of a request that met the GOAWAY of a server
+// closing a connection without an error.
+func gracefulGoAway(err error) bool {
+	var goAway http2.GoAwayError
+	if errors.As(err, &goAway) {
+		return goAway.ErrCode == http2.ErrCodeNo
+	}
+	return err != nil && strings.Contains(err.Error(), "graceful shutdown GOAWAY")
+}
+
+func (p *pool) noteFailure(client *poolClient, err error) {
+	p.access.Lock()
+	defer p.access.Unlock()
+	if client.generation != p.generation {
+		// A connection a reset closed fails every request it had in flight.
+		// That is the doing of the reset, not of the server, and must not
+		// hold back the connections opened since.
+		return
+	}
+	now := time.Now()
+	if now.Sub(client.createdAt) >= youngConnection || now.Sub(p.lastFail) >= failureMemory {
+		p.failures = 0
+	}
+	if now.Sub(client.createdAt) < youngConnection {
+		p.failures++
+	}
+	p.lastFail = now
+	p.lastErr = hideHTTPError(err)
+	if p.failures >= 2 {
+		backoff := firstBackoff << min(p.failures-2, 5)
+		p.retryAt = now.Add(min(backoff, maxBackoff))
+	}
+}
+
+func (c *poolClient) release() {
+	if c.running.Add(-1) > 0 {
+		return
+	}
+	generation := c.idleGeneration.Load()
+	c.timerAccess.Lock()
+	// Looked at under the lock of the timer: whoever takes the client out of
+	// the pool marks it first and stops the timer after, so that no timer is
+	// started behind its back.
+	if c.removed.Load() {
+		c.timerAccess.Unlock()
+		c.closeIfIdle()
+		return
+	}
+	if c.idleTimer != nil {
+		c.idleTimer.Stop()
+	}
+	c.idleTimer = time.AfterFunc(c.pool.idleTimeout, func() {
+		if c.running.Load() <= 0 && c.idleGeneration.Load() == generation {
+			c.pool.retire(c)
+		}
+	})
+	c.timerAccess.Unlock()
+}
+
+// retire takes an idle client out of the pool and closes it.
+func (p *pool) retire(client *poolClient) {
+	p.access.Lock()
+	for i, candidate := range p.clients {
+		if candidate == client {
+			p.clients = append(p.clients[:i], p.clients[i+1:]...)
+			break
+		}
+	}
+	// a client a reset closed meanwhile is not listed again
+	if client.generation == p.generation {
+		p.retireLocked(client)
+	}
+	p.access.Unlock()
+	client.removed.Store(true)
+	client.closeIfIdle()
+}
+
+func (c *poolClient) closeIfIdle() {
+	if c.removed.Load() && c.running.Load() <= 0 {
+		c.shutdown()
+		c.pool.access.Lock()
+		delete(c.pool.retired, c)
+		c.pool.access.Unlock()
+	}
+}
+
+func (c *poolClient) shutdown() {
+	c.timerAccess.Lock()
+	if c.idleTimer != nil {
+		c.idleTimer.Stop()
+		c.idleTimer = nil
+	}
+	c.timerAccess.Unlock()
+	c.closed.Store(true)
+	c.closeOnce.Do(c.connection.close)
+}
+
+// closeIdle takes the clients no session or request uses out of the pool and closes
+// them; the busy ones stay. A get counts its client as running under the lock, so
+// a client found idle here is not handed out meanwhile.
+func (p *pool) closeIdle() {
+	p.access.Lock()
+	var idle []*poolClient
+	busy := p.clients[:0]
+	for _, client := range p.clients {
+		if client.running.Load() > 0 {
+			busy = append(busy, client)
+			continue
+		}
+		p.retireLocked(client)
+		idle = append(idle, client)
+	}
+	clear(p.clients[len(busy):])
+	p.clients = busy
+	p.access.Unlock()
+	for _, client := range idle {
+		client.closeIfIdle()
+	}
+}
+
+// close closes every client, those in the pool and those retired from it that
+// sessions still hold, and forgets what it held against the server: the pool
+// starts anew, with the next get opening a connection. The sessions on the
+// closed clients fail through them and let go of them as they end.
+func (p *pool) close() {
+	p.access.Lock()
+	clients := p.clients
+	for client := range p.retired {
+		clients = append(clients, client)
+	}
+	p.clients = nil
+	p.retired = nil
+	p.generation++
+	p.failures = 0
+	p.lastFail = time.Time{}
+	p.retryAt = time.Time{}
+	p.lastErr = nil
+	p.access.Unlock()
+	for _, client := range clients {
+		client.removed.Store(true)
+		client.shutdown()
+	}
+}
+
+// connTracker remembers the connections a pooled connection dialed, so that it
+// can close them all: the HTTP transports close only idle connections on
+// request, and a pooled connection taken out of service must not keep its
+// sockets until the idle timeout.
+type connTracker struct {
+	access sync.Mutex
+	conns  map[*trackedConn]struct{}
+	closed bool
+}
+
+type trackedConn struct {
+	net.Conn
+	tracker *connTracker
+}
+
+func (t *connTracker) track(conn net.Conn, err error) (net.Conn, error) {
+	if err != nil {
+		return nil, err
+	}
+	t.access.Lock()
+	defer t.access.Unlock()
+	if t.closed {
+		conn.Close()
+		return nil, net.ErrClosed
+	}
+	if t.conns == nil {
+		t.conns = make(map[*trackedConn]struct{})
+	}
+	tracked := &trackedConn{Conn: conn, tracker: t}
+	t.conns[tracked] = struct{}{}
+	return tracked, nil
+}
+
+func (t *connTracker) closeAll() {
+	t.access.Lock()
+	conns := t.conns
+	t.conns = nil
+	t.closed = true
+	t.access.Unlock()
+	for conn := range conns {
+		conn.Conn.Close()
+	}
+}
+
+func (c *trackedConn) Close() error {
+	c.tracker.access.Lock()
+	delete(c.tracker.conns, c)
+	c.tracker.access.Unlock()
+	return c.Conn.Close()
+}
+
+func (c *trackedConn) Upstream() any {
+	return c.Conn
+}
+
+// http2Connection carries every request of its sessions as streams of one
+// HTTP/2 connection (one per pooled connection, as Xray's XMUX does).
+type http2Connection struct {
+	transport *http2.Transport
+	tracker   connTracker
+}
+
+func newHTTP2Connection(tlsDialer tls.Dialer, serverAddr M.Socksaddr, keepAlivePeriod time.Duration) *http2Connection {
+	connection := &http2Connection{}
+	connection.transport = &http2.Transport{
+		DialTLSContext: func(ctx context.Context, network, addr string, cfg *tls.STDConfig) (net.Conn, error) {
+			conn, err := tlsDialer.DialTLSContext(ctx, serverAddr)
+			if err != nil {
+				return nil, err
+			}
+			return connection.tracker.track(&frameSizeCapConn{Conn: conn}, nil)
+		},
+		ReadIdleTimeout: keepAlivePeriod,
+		IdleConnTimeout: connectionIdleTimeout,
+	}
+	return connection
+}
+
+func (c *http2Connection) roundTrip(request *http.Request) (*http.Response, error) {
+	return c.transport.RoundTrip(request)
+}
+
+func (c *http2Connection) close() {
+	c.transport.CloseIdleConnections()
+	c.tracker.closeAll()
+}
+
+// http1Connection is the HTTP/1.1 form: a stream (a download or a streamed
+// upload) takes a connection of its own, as with Xray, whose client turns
+// keep-alives off for them. Packet-up uploads reuse connections and, unlike
+// Xray's raw pipelining, read every response, so that nothing piles up in a
+// socket that is written to six hundred times.
+type http1Connection struct {
+	streams *http.Transport
+	packets *http.Transport
+	tracker connTracker
+}
+
+func newHTTP1Connection(dialer N.Dialer, tlsDialer tls.Dialer, serverAddr M.Socksaddr) *http1Connection {
+	connection := &http1Connection{}
+	dial := func(ctx context.Context, network, addr string) (net.Conn, error) {
+		if tlsDialer != nil {
+			return connection.tracker.track(tlsDialer.DialTLSContext(ctx, serverAddr))
+		}
+		return connection.tracker.track(dialer.DialContext(ctx, N.NetworkTCP, serverAddr))
+	}
+	connection.streams = &http.Transport{
+		DialContext:       dial,
+		DialTLSContext:    dial,
+		DisableKeepAlives: true,
+		IdleConnTimeout:   connectionIdleTimeout,
+	}
+	connection.packets = &http.Transport{
+		DialContext:         dial,
+		DialTLSContext:      dial,
+		MaxIdleConnsPerHost: 4,
+		// Xray writes these requests itself, without Accept-Encoding.
+		DisableCompression: true,
+		IdleConnTimeout:    connectionIdleTimeout,
+	}
+	return connection
+}
+
+func (c *http1Connection) roundTrip(request *http.Request) (*http.Response, error) {
+	if isPacketRequest(request) {
+		return c.packets.RoundTrip(request)
+	}
+	return c.streams.RoundTrip(request)
+}
+
+func (c *http1Connection) close() {
+	c.streams.CloseIdleConnections()
+	c.packets.CloseIdleConnections()
+	c.tracker.closeAll()
+}
+
+type packetRequestKey struct{}
+
+// isPacketRequest tells a packet-up upload (which may be a GET with its data in
+// headers) from a download.
+func isPacketRequest(request *http.Request) bool {
+	return request.Context().Value(packetRequestKey{}) != nil
+}
