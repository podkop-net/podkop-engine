+// Closed sessions leave nothing behind while the pool lives on: measured
+// against a warmed pool of one connection, before the client is closed.
+func TestXHTTPSessionsLeaveNothing(t *testing.T) {
+	for _, mode := range []string{modePacketUp, modeStreamUp, modeStreamOne} {
+		t.Run(mode, func(t *testing.T) {
+			options := option.V2RayXHTTPOptions{Mode: mode}
+			options.Xmux = &option.V2RayXHTTPXmuxOptions{MaxConnections: &option.V2RayXHTTPRange{From: 1, To: 1}}
+			client, _ := newTestPair(t, options, "h2", nil)
+			warmup, err := client.DialContext(context.Background())
+			require.NoError(t, err)
+			echo(t, warmup, 1024)
+			warmup.Close()
+			time.Sleep(200 * time.Millisecond)
+			baseline := runtime.NumGoroutine()
+			var wg sync.WaitGroup
+			for i := 0; i < 8; i++ {
+				wg.Add(1)
+				go func() {
+					defer wg.Done()
+					conn, err := client.DialContext(context.Background())
+					if !assertNoError(t, err) {
+						return
+					}
+					echo(t, conn, 32*1024)
+					// Leave a read and a write in flight when closing.
+					go conn.Read(make([]byte, 1))
+					conn.Close()
+				}()
+			}
+			wg.Wait()
+			waitGoroutines(t, baseline)
+		})
+	}
+}
+
+// download sends the download half to another server (the same test server
+// here, on a second listener), its own TLS and pool.
+func TestXHTTPDownloadLeg(t *testing.T) {
+	for _, mode := range []string{modePacketUp, modeStreamUp} {
+		t.Run(mode, func(t *testing.T) {
+			options := option.V2RayXHTTPOptions{Mode: mode}
+			options.Path = "/x"
+			serverConfig, err := newRequestConfig(options.V2RayXHTTPBaseOptions, mode)
+			require.NoError(t, err)
+			server := newTestServer(t, serverConfig, "h2")
+			second := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				server.count("on-second")
+				server.serveHTTP(w, r)
+			}))
+			second.EnableHTTP2 = true
+			second.StartTLS()
+			t.Cleanup(second.Close)
+			secondAddr := M.ParseSocksaddr(second.Listener.Addr().String())
+			options.Download = &option.V2RayXHTTPDownloadOptions{
+				ServerOptions:               option.ServerOptions{Server: secondAddr.AddrString(), ServerPort: secondAddr.Port},
+				OutboundTLSOptionsContainer: option.OutboundTLSOptionsContainer{TLS: &option.OutboundTLSOptions{Enabled: true, Insecure: true, ServerName: "cdn.example.com"}},
+			}
+			options.Download.Path = "/x"
+			tlsConfig, err := tls.NewClient(context.Background(), log.StdLogger(), "example.com", option.OutboundTLSOptions{Enabled: true, Insecure: true, ServerName: "example.com"})
+			require.NoError(t, err)
+			transport, err := NewClient(context.Background(), N.SystemDialer, M.ParseSocksaddr(server.server.Listener.Addr().String()), options, tlsConfig)
+			require.NoError(t, err)
+			defer transport.Close()
+			conn, err := transport.DialContext(context.Background())
+			require.NoError(t, err)
+			echo(t, conn, 128*1024)
+			conn.Close()
+			require.Equal(t, 1, server.requestCount("on-second"), "only the download goes to the second server")
+			require.Equal(t, 1, server.requestCount("download"))
+		})
+	}
+}
+
+// Through the read waiter the download arrives whole and in order, whether it
+// comes after a pause (probe first) or in a stream, and a close ends the wait.
+func TestXHTTPReadWaiter(t *testing.T) {
+	for _, mode := range []string{modePacketUp, modeStreamOne} {
+		t.Run(mode, func(t *testing.T) {
+			client, _ := newTestPair(t, option.V2RayXHTTPOptions{Mode: mode}, "h2", nil)
+			conn, err := client.DialContext(context.Background())
+			require.NoError(t, err)
+			waiter, created := conn.(N.ReadWaitCreator).CreateReadWaiter()
+			require.True(t, created)
+			waiter.InitializeReadWaiter(N.ReadWaitOptions{})
+			var sent bytes.Buffer
+			go func() {
+				for _, size := range []int{1, 100, 511, 512, 513, 4096, 200 * 1024, 7} {
+					data := randomBytes(size)
+					sent.Write(data)
+					conn.Write(data)
+					time.Sleep(30 * time.Millisecond)
+				}
+			}()
+			const total = 1 + 100 + 511 + 512 + 513 + 4096 + 200*1024 + 7
+			received := make([]byte, 0, total)
+			for len(received) < total {
+				buffer, err := waiter.WaitReadBuffer()
+				require.NoError(t, err)
+				received = append(received, buffer.Bytes()...)
+				buffer.Release()
+			}
+			require.True(t, bytes.Equal(sent.Bytes(), received))
+			done := make(chan error, 1)
+			go func() {
+				_, err := waiter.WaitReadBuffer()
+				done <- err
+			}()
+			time.Sleep(50 * time.Millisecond)
+			conn.Close()
+			require.ErrorIs(t, <-done, net.ErrClosed)
+		})
+	}
+}
+
+// A pooled connection no session uses is retired after the idle timeout, for
+// every HTTP version (HTTP/3 would otherwise stay open on its keep-alive).
+func TestXHTTPPoolIdleRetire(t *testing.T) {
+	saved := poolIdleTimeout
+	poolIdleTimeout = 300 * time.Millisecond
+	defer func() { poolIdleTimeout = saved }()
+	for _, version := range []string{"h1", "h2"} {
+		t.Run(version, func(t *testing.T) {
+			client, _ := newTestPair(t, option.V2RayXHTTPOptions{Mode: modePacketUp}, version, nil)
+			baseline := settledGoroutines()
+			conn, err := client.DialContext(context.Background())
+			require.NoError(t, err)
+			echo(t, conn, 4096)
+			time.Sleep(500 * time.Millisecond)
+			pooled := func() int {
+				client.upPool.access.Lock()
+				defer client.upPool.access.Unlock()
+				return len(client.upPool.clients)
+			}
+			require.Equal(t, 1, pooled(), "an open session keeps its connection")
+			conn.Close()
+			// the session stays for closeGrace after its last write, then the
+			// connection idles out
+			require.Eventually(t, func() bool { return pooled() == 0 }, 3*time.Second, 20*time.Millisecond)
+			waitGoroutines(t, baseline)
+			conn, err = client.DialContext(context.Background())
+			require.NoError(t, err)
+			echo(t, conn, 4096)
+			conn.Close()
+		})
+	}
+}
+
+// A server (or a CDN) that resets every upload must not be redialled as fast
+// as the client reconnects: each young connection that fails delays the next
+// (sing-box-lx SPEC 076 saw both cores of a router spin on this).
+func TestXHTTPResetStorm(t *testing.T) {
+	client, server := newTestPair(t, option.V2RayXHTTPOptions{Mode: modeStreamUp}, "h2", func(s *testServer) {
+		s.abortUploads = true
+	})
+	deadline := time.Now().Add(3 * time.Second)
+	var dials, refused int
+	for time.Now().Before(deadline) {
+		dials++
+		conn, err := client.DialContext(context.Background())
+		if err != nil {
+			refused++
+			continue
+		}
+		conn.Write([]byte("x"))
+		conn.Read(make([]byte, 1))
+		conn.Close()
+	}
+	t.Logf("%d dials in 3 s, %d refused during the backoff, %d connections to the server", dials, refused, server.connections())
+	require.LessOrEqual(t, server.connections(), 10)
+}
