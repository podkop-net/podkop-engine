+
+	"github.com/stretchr/testify/require"
+)
+
+// A range as wide as int32 used to panic in rand: `sing-box check` for the
+// XMUX pool sizes, the running process for the rest.
+func TestXHTTPWideRanges(t *testing.T) {
+	for _, r := range []valueRange{{0, math.MaxInt32}, {-1, math.MaxInt32}, {math.MinInt32, math.MaxInt32}, {math.MinInt32, 0}, {5, 5}, {7, 3}} {
+		for i := 0; i < 100; i++ {
+			value := r.rand()
+			if r.to > r.from {
+				require.True(t, value >= r.from && value <= r.to, "%v gave %d", r, value)
+			}
+		}
+	}
+	wide := xrange(0, math.MaxInt32)
+	options := option.V2RayXHTTPOptions{Mode: modePacketUp}
+	options.ScMinPostsIntervalMs = xrange(-1, -1)
+	options.Xmux = &option.V2RayXHTTPXmuxOptions{MaxConnections: wide, CMaxReuseTimes: wide, HMaxRequestTimes: wide, HMaxReusableSecs: wide}
+	client, _ := newTestPair(t, options, "h2", nil)
+	conn, err := client.DialContext(context.Background())
+	require.NoError(t, err)
+	echo(t, conn, 4096)
+	conn.Close()
+}
+
+func TestXHTTPIPv6Host(t *testing.T) {
+	transport, err := NewClient(context.Background(), N.SystemDialer, M.ParseSocksaddr("[2001:db8::5]:443"), option.V2RayXHTTPOptions{}, nil)
+	require.NoError(t, err)
+	defer transport.Close()
+	client := transport.(*Client)
+	require.Equal(t, "[2001:db8::5]", client.up.host)
+	request := client.up.newStreamRequest(context.Background(), "http", "id", nil)
+	require.Equal(t, "[2001:db8::5]", request.Host)
+	require.Contains(t, request.Header.Get("Referer"), "http://[2001:db8::5]/?x_padding=")
+}
+
+// max_concurrency counts sessions, once each, as Xray does: not the requests
+// a session has in flight.
+func TestXHTTPConcurrencyCountsSessions(t *testing.T) {
+	for _, mode := range []string{modePacketUp, modeStreamUp, modeStreamOne} {
+		t.Run(mode, func(t *testing.T) {
+			options := option.V2RayXHTTPOptions{Mode: mode}
+			options.Xmux = &option.V2RayXHTTPXmuxOptions{MaxConcurrency: xrange(2, 2)}
+			client, _ := newTestPair(t, options, "h2", nil)
+			var conns []net.Conn
+			for i := 0; i < 4; i++ {
+				conn, err := client.DialContext(context.Background())
+				require.NoError(t, err)
+				echo(t, conn, 1024)
+				conns = append(conns, conn)
+			}
+			client.upPool.access.Lock()
+			clients := len(client.upPool.clients)
+			client.upPool.access.Unlock()
+			require.Equal(t, 2, clients, "four sessions, two to a connection")
+			for _, conn := range conns {
+				conn.Close()
+			}
+			// a closed session is gone once its upload has been sent to the end
+			require.Eventually(t, func() bool {
+				client.upPool.access.Lock()
+				defer client.upPool.access.Unlock()
+				for _, pooled := range client.upPool.clients {
+					if pooled.sessions.Load() != 0 {
+						return false
+					}
+				}
+				return true
+			}, 2*time.Second, 5*time.Millisecond)
+		})
+	}
+}
+
+// The body of an error answer may never end: the session fails at once.
+func TestXHTTPErrorStatusWithEndlessBody(t *testing.T) {
+	client, _ := newTestPair(t, option.V2RayXHTTPOptions{Mode: modePacketUp}, "h2", func(s *testServer) {
+		s.downloadStatus, s.endlessErrorBody = http.StatusForbidden, true
+	})
+	conn, err := client.DialContext(context.Background())
+	require.NoError(t, err)
+	defer conn.Close()
+	done := make(chan error, 1)
+	go func() {
+		_, err := conn.Read(make([]byte, 1))
+		done <- err
+	}()
+	select {
+	case err = <-done:
+		require.ErrorContains(t, err, "403")
+	case <-time.After(3 * time.Second):
+		t.Fatal("read still waits for the body of the error answer")
+	}
+}
+
+// A download detour that leads back to its own outbound must not dial itself
+// without end.
+func TestXHTTPDialDepth(t *testing.T) {
+	client, _ := newTestPair(t, option.V2RayXHTTPOptions{Mode: modePacketUp}, "h2", nil)
+	ctx := context.Background()
+	for i := 0; i < maxDialDepth; i++ {
+		s := newSession(dialDepth(ctx))
+		ctx = s.ctx
+		defer s.Close()
+	}
+	_, err := client.DialContext(ctx)
+	require.ErrorContains(t, err, "leads back")
+}
+
+// Closing the transport closes the connections retired from the pool that a
+// session still holds.
+func TestXHTTPCloseReachesRetiredClients(t *testing.T) {
+	options := option.V2RayXHTTPOptions{Mode: modeStreamOne}
+	options.Xmux = &option.V2RayXHTTPXmuxOptions{MaxConnections: xrange(1, 1), HMaxRequestTimes: xrange(1, 1)}
+	client, _ := newTestPair(t, options, "h2", nil)
+	first, err := client.DialContext(context.Background())
+	require.NoError(t, err)
+	echo(t, first, 1024)
+	second, err := client.DialContext(context.Background())
+	require.NoError(t, err)
+	echo(t, second, 1024)
+	client.Close()
+	first.SetDeadline(time.Time{})
+	done := make(chan error, 1)
+	go func() {
+		first.Write([]byte("x"))
+		_, err := first.Read(make([]byte, 1))
+		done <- err
+	}()
+	select {
+	case err = <-done:
+		require.Error(t, err)
+	case <-time.After(3 * time.Second):
+		t.Fatal("a session on a retired connection outlived the transport")
+	}
+	second.Close()
+	first.Close()
+}
+
+// An upload whose headers are larger than the server takes fails its own
+// session, with the setting named, and nothing else: the connection stays in
+// service and other sessions of the outbound are not made to wait.
+//
+// The HTTP/2 client can refuse such a request only once it has read the
+// settings of the server, which carry the limit. Until then it sends the
+// request, and a Go server, Xray among them, answers a header block of more
+// than twice its limit by ending the connection (GOAWAY, PROTOCOL_ERROR). That
+// takes the first write of a session on a new connection to be over the limit,
+// and the pool opens a connection for each of its first three sessions: with a
+// write right after the dial it is a race, which this test lost in most runs.
+// So the upload here waits for the answer to the download: it comes on the
+// same connection after the settings.
+func TestXHTTPHeadersTooLarge(t *testing.T) {
+	size := option.V2RayXHTTPRange{From: 16384, To: 16384}
+	options := option.V2RayXHTTPOptions{Mode: modePacketUp, V2RayXHTTPBaseOptions: option.V2RayXHTTPBaseOptions{
+		UplinkDataPlacement: placementHeader,
+		ScMaxEachPostBytes:  &size,
+	}}
+	for name, test := range map[string]struct {
+		version   string
+		configure func(*testServer)
+	}{
+		// the HTTP/2 client refuses to send the request
+		"advertised limit": {"h2-8k", nil},
+		// a proxy that does not announce its limit answers
+		"status 431": {"h2", func(s *testServer) { s.maxPacket = 6000 }},
+	} {
+		t.Run(name, func(t *testing.T) {
+			client, server := newTestPair(t, options, test.version, test.configure)
+			for round := 0; round < 3; round++ {
+				conn, err := client.DialContext(context.Background())
+				require.NoError(t, err, "round %d", round)
+				select {
+				case <-conn.(*session).downloadReady:
+				case <-time.After(5 * time.Second):
+					t.Fatal("no answer to the download, round ", round)
+				}
+				_, err = conn.Write(randomBytes(16384))
+				if err == nil {
+					_, err = conn.Read(make([]byte, 1))
+				}
+				require.ErrorContains(t, err, "sc_max_each_post_bytes", "round %d", round)
+				conn.Close()
+			}
+			// small uploads of other sessions pass at once, through the same connection
+			connections := server.connections()
+			for i := 0; i < 5; i++ {
+				conn, err := client.DialContext(context.Background())
+				require.NoError(t, err)
+				echo(t, conn, 1000)
+				conn.Close()
+			}
+			require.Equal(t, connections, server.connections())
+		})
+	}
+}
+
+// What was written before a Close reaches the server: sing-box closes the
+// connection as soon as its source is done.
+func TestXHTTPWriteThenClose(t *testing.T) {
+	for _, version := range []string{"h2", "h1-tls"} {
+		for _, mode := range []string{modePacketUp, modeStreamUp, modeStreamOne} {
+			if mode == modeStreamOne && version != "h2" {
+				continue
+			}
+			for _, size := range []int{100, 5000, 300000} {
+				t.Run(F.ToString(version, "/", mode, "/", size), func(t *testing.T) {
+					client, server := newTestPair(t, option.V2RayXHTTPOptions{Mode: mode}, version, nil)
+					baseline := settledGoroutines()
+					const sessions = 10
+					for i := 0; i < sessions; i++ {
+						conn, err := client.DialContext(context.Background())
+						require.NoError(t, err)
+						_, err = conn.Write(randomBytes(size))
+						require.NoError(t, err)
+						require.NoError(t, conn.Close())
+						_, err = conn.Write([]byte{0})
+						require.ErrorIs(t, err, net.ErrClosed)
+					}
+					require.Eventually(t, func() bool { return server.received.Load() == int64(sessions*size) },
+						5*time.Second, 10*time.Millisecond, "the server got %d of %d bytes", server.received.Load(), sessions*size)
+					// and the closed sessions leave nothing behind, once the
+					// connections of the pool are closed too
+					client.Close()
+					waitGoroutines(t, baseline)
+				})
+			}
+		}
+	}
+}
+
+// A closed session whose data cannot be sent is gone after the linger at most,
+// and at once when it has failed.
+func TestXHTTPCloseDoesNotWaitForAFailedSession(t *testing.T) {
+	client, _ := newTestPair(t, option.V2RayXHTTPOptions{Mode: modePacketUp}, "h2", func(s *testServer) { s.abortUploads = true })
+	baseline := settledGoroutines()
+	conn, err := client.DialContext(context.Background())
+	require.NoError(t, err)
+	_, err = conn.Write(randomBytes(1000))
+	require.NoError(t, err)
+	require.NoError(t, conn.Close())
+	client.Close()
+	waitGoroutines(t, baseline)
+}
+
+// The backoff holds back new connections, not the sessions a working
+// connection can take: one user's request that makes a proxy drop connections
+// must not cut the outbound off for everyone.
+func TestXHTTPBackoffKeepsWorkingConnections(t *testing.T) {
+	client, _ := newTestPair(t, option.V2RayXHTTPOptions{Mode: modePacketUp}, "h2", nil)
+	// a working connection, held by an open session
+	held, err := client.DialContext(context.Background())
+	require.NoError(t, err)
+	defer held.Close()
+	echo(t, held, 100)
+	// the pool in backoff, as after two young connections failed
+	client.upPool.access.Lock()
+	client.upPool.failures = 2
+	client.upPool.lastErr = E.New("test")
+	client.upPool.retryAt = time.Now().Add(time.Minute)
+	clients := len(client.upPool.clients)
+	client.upPool.access.Unlock()
+	require.Equal(t, 1, clients)
+	for i := 0; i < 5; i++ {
+		conn, err := client.DialContext(context.Background())
+		require.NoError(t, err)
+		echo(t, conn, 100)
+		conn.Close()
+	}
+	client.upPool.access.Lock()
+	clients = len(client.upPool.clients)
+	client.upPool.access.Unlock()
+	require.Equal(t, 1, clients, "no new connection during the backoff")
+}
+
+// A pooled connection is not given new sessions past h_max_reusable_secs; the
+// sessions it has go on.
+func TestXHTTPRotationByTime(t *testing.T) {
+	for _, mode := range []string{modePacketUp, modeStreamUp, modeStreamOne} {
+		t.Run(mode, func(t *testing.T) {
+			options := option.V2RayXHTTPOptions{Mode: mode}
+			options.Xmux = &option.V2RayXHTTPXmuxOptions{MaxConnections: xrange(1, 1), HMaxReusableSecs: xrange(1, 1)}
+			client, server := newTestPair(t, options, "h2", nil)
+			held, err := client.DialContext(context.Background())
+			require.NoError(t, err)
+			defer held.Close()
+			echo(t, held, 1000)
+			second, err := client.DialContext(context.Background())
+			require.NoError(t, err)
+			echo(t, second, 1000)
+			second.Close()
+			require.Equal(t, 1, server.connections(), "one connection while it may be reused")
+			time.Sleep(1200 * time.Millisecond)
+			third, err := client.DialContext(context.Background())
+			require.NoError(t, err)
+			defer third.Close()
+			echo(t, third, 1000)
+			require.Equal(t, 2, server.connections(), "a new connection after the time is up")
+			// the session opened before goes on, uploads included
+			echo(t, held, 100000)
+			echo(t, third, 100000)
+		})
+	}
+}
+
+// Deadlines are not supported, and say so: sing-box then arranges for its own
+// (a deadline that silently did nothing would leave reads without one).
+func TestXHTTPDeadlines(t *testing.T) {
+	client, _ := newTestPair(t, option.V2RayXHTTPOptions{Mode: modePacketUp}, "h2", nil)
+	conn, err := client.DialContext(context.Background())
+	require.NoError(t, err)
+	defer conn.Close()
+	require.ErrorIs(t, conn.SetDeadline(time.Now().Add(time.Second)), os.ErrInvalid)
+	require.ErrorIs(t, conn.SetReadDeadline(time.Now().Add(time.Second)), os.ErrInvalid)
+	require.ErrorIs(t, conn.SetWriteDeadline(time.Now().Add(time.Second)), os.ErrInvalid)
+	require.True(t, conn.(*session).NeedAdditionalReadDeadline())
+	echo(t, conn, 1000)
+}
+
+// A range of post intervals that starts at zero means no waiting, as with Xray.
+func TestXHTTPPostIntervalFromZero(t *testing.T) {
+	options := option.V2RayXHTTPOptions{Mode: modePacketUp}
+	options.ScMinPostsIntervalMs = xrange(0, 400)
+	client, server := newTestPair(t, options, "h2", nil)
+	conn, err := client.DialContext(context.Background())
+	require.NoError(t, err)
+	defer conn.Close()
+	start := time.Now()
+	for i := 0; i < 10; i++ {
+		echo(t, conn, 10)
+	}
+	require.Less(t, time.Since(start), time.Second, "ten posts, none waited for")
+	require.GreaterOrEqual(t, server.requestCount("packet"), 10)
+}
diff --git a/transport/v2rayxhttp/server_test.go b/transport/v2rayxhttp/server_test.go
new file mode 100644
index 000000000..8a1fb4275
--- /dev/null
+++ b/transport/v2rayxhttp/server_test.go
@@ -0,0 +1,395 @@
+package v2rayxhttp
+
+import (
+	"encoding/base64"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// testServer is an XHTTP server for the tests, after Xray's hub.go: it reads the
+// session ID, the sequence number and packet-up data where config places them,
+// checks the padding, puts packet-up uploads back in order and echoes every
+// session's upload on its download.
+type testServer struct {
+	t      *testing.T
+	config *requestConfig
+	server *httptest.Server
+
+	// holdDownload makes a download wait for the first upload of its session,
+	// as an Xray server behind a CDN effectively does.
+	holdDownload   bool
+	downloadStatus int
+	// endlessErrorBody makes the body of an error answer never end.
+	endlessErrorBody bool
+	uploadStatus     int
+	// maxPacket makes the server refuse larger packets as a proxy with a
+	// limit on request headers does, with status 431.
+	maxPacket int
+	// abortUploads resets every upload request (RST_STREAM on HTTP/2).
+	abortUploads bool
+	// endUploadAfterData ends the answer to a stream-up upload once its first
+	// data is read, as Xray does when the connection ends, while the download
+	// stays; resetUploadAfterData resets that upload instead. endStreamOneAfterData
+	// ends a stream-one request once its first data is echoed.
+	endUploadAfterData    bool
+	resetUploadAfterData  bool
+	endStreamOneAfterData bool
+	// received counts the upload bytes of all sessions.
+	received atomic.Int64
+
+	access   sync.Mutex
+	sessions map[string]*testSession
+	requests map[string]int
+	remotes  map[string]struct{}
+}
+
+type testSession struct {
+	access    sync.Mutex
+	nextSeq   int64
+	buffered  map[int64][]byte
+	echo      chan []byte
+	firstData chan struct{}
+	firstOnce sync.Once
+}
+
+func newTestServer(t *testing.T, config *requestConfig, mode string) *testServer {
+	s := &testServer{
+		t:        t,
+		config:   config,
+		sessions: make(map[string]*testSession),
+		requests: make(map[string]int),
+	}
+	s.server = httptest.NewUnstartedServer(http.HandlerFunc(s.serveHTTP))
+	switch mode {
+	case "h2":
+		s.server.EnableHTTP2 = true
+		s.server.StartTLS()
+	case "h2-8k":
+		// the header limit of an Xray server with its defaults
+		s.server.Config.MaxHeaderBytes = 8192
+		s.server.EnableHTTP2 = true
+		s.server.StartTLS()
+	case "h1-tls":
+		s.server.StartTLS()
+	default:
+		s.server.Start()
+	}
+	t.Cleanup(s.server.Close)
+	return s
+}
+
+func (s *testServer) session(id string) *testSession {
+	s.access.Lock()
+	defer s.access.Unlock()
+	session := s.sessions[id]
+	if session == nil {
+		session = &testSession{
+			buffered:  make(map[int64][]byte),
+			echo:      make(chan []byte, 1024),
+			firstData: make(chan struct{}),
+		}
+		s.sessions[id] = session
+	}
+	return session
+}
+
+func (s *testServer) count(kind string) {
+	s.access.Lock()
+	s.requests[kind]++
+	s.access.Unlock()
+}
+
+// connections is the number of client connections requests came on.
+func (s *testServer) connections() int {
+	s.access.Lock()
+	defer s.access.Unlock()
+	return len(s.remotes)
+}
+
+func (s *testServer) requestCount(kind string) int {
+	s.access.Lock()
+	defer s.access.Unlock()
+	return s.requests[kind]
+}
+
+func (ts *testSession) push(data []byte) {
+	ts.firstOnce.Do(func() { close(ts.firstData) })
+	if len(data) > 0 {
+		ts.echo <- data
+	}
+}
+
+// pushPacket queues one packet-up upload and releases those now in order.
+func (ts *testSession) pushPacket(seq int64, data []byte) {
+	ts.access.Lock()
+	ts.buffered[seq] = data
+	var ready [][]byte
+	for {
+		next, loaded := ts.buffered[ts.nextSeq]
+		if !loaded {
+			break
+		}
+		delete(ts.buffered, ts.nextSeq)
+		ts.nextSeq++
+		ready = append(ready, next)
+	}
+	ts.access.Unlock()
+	for _, data := range ready {
+		ts.push(data)
+	}
+}
+
+func (s *testServer) checkPadding(r *http.Request) bool {
+	c := s.config
+	var padding string
+	if !c.paddingObfsMode {
+		referer, err := url.Parse(r.Header.Get("Referer"))
+		if err != nil {
+			return false
+		}
+		padding = referer.Query().Get("x_padding")
+	} else {
+		switch c.paddingPlacement {
+		case placementHeader:
+			padding = r.Header.Get(c.paddingHeader)
+		case placementQueryInHeader:
+			value, err := url.Parse(r.Header.Get(c.paddingHeader))
+			if err != nil {
+				return false
+			}
+			padding = value.Query().Get(c.paddingKey)
+		case placementCookie:
+			cookie, err := r.Cookie(c.paddingKey)
+			if err != nil {
+				return false
+			}
+			padding = cookie.Value
+		case placementQuery:
+			padding = r.URL.Query().Get(c.paddingKey)
+		}
+	}
+	if c.paddingObfsMode && c.paddingMethod == paddingMethodTokenish {
+		// tokenish is sized by its Huffman length, within 2.
+		return len(padding) > 0
+	}
+	return len(padding) >= int(c.paddingBytes.from) && len(padding) <= int(c.paddingBytes.to)
+}
+
+// meta reads the session ID and the sequence number as Xray's
+// ExtractMetaFromRequest does.
+func (s *testServer) meta(r *http.Request) (string, string) {
+	c := s.config
+	var parts []string
+	if c.sessionPlacement == placementPath || c.seqPlacement == placementPath {
+		parts = strings.Split(strings.TrimPrefix(r.URL.Path, c.normalizedPath()), "/")
+	}
+	index := 0
+	read := func(placement string, key string) string {
+		switch placement {
+		case placementPath:
+			if index < len(parts) {
+				index++
+				return parts[index-1]
+			}
+		case placementQuery:
+			return r.URL.Query().Get(key)
+		case placementHeader:
+			return r.Header.Get(key)
+		case placementCookie:
+			if cookie, err := r.Cookie(key); err == nil {
+				return cookie.Value
+			}
+		}
+		return ""
+	}
+	sessionID := read(c.sessionPlacement, c.sessionKey)
+	seq := read(c.seqPlacement, c.seqKey)
+	return sessionID, seq
+}
+
+func (s *testServer) packetData(r *http.Request) ([]byte, error) {
+	c := s.config
+	switch c.uplinkDataPlacement {
+	case placementHeader:
+		var encoded strings.Builder
+		for i := 0; ; i++ {
+			value := r.Header.Get(c.uplinkDataKey + "-" + strconv.Itoa(i))
+			if value == "" {
+				break
+			}
+			encoded.WriteString(value)
+		}
+		return base64.RawURLEncoding.DecodeString(encoded.String())
+	case placementCookie:
+		var encoded strings.Builder
+		for i := 0; ; i++ {
+			cookie, err := r.Cookie(c.uplinkDataKey + "_" + strconv.Itoa(i))
+			if err != nil {
+				break
+			}
+			encoded.WriteString(cookie.Value)
+		}
+		return base64.RawURLEncoding.DecodeString(encoded.String())
+	default:
+		return io.ReadAll(r.Body)
+	}
+}
+
+func (s *testServer) serveHTTP(w http.ResponseWriter, r *http.Request) {
+	s.access.Lock()
+	if s.remotes == nil {
+		s.remotes = make(map[string]struct{})
+	}
+	s.remotes[r.RemoteAddr] = struct{}{}
+	s.access.Unlock()
+	if !strings.HasPrefix(r.URL.Path, s.config.normalizedPath()) {
+		s.count("not-found")
+		w.WriteHeader(http.StatusNotFound)
+		return
+	}
+	if !s.checkPadding(r) {
+		s.count("bad-padding")
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	sessionID, seq := s.meta(r)
+	isUpload := r.Method != http.MethodGet || seq != ""
+	switch {
+	case sessionID == "":
+		s.count("stream-one")
+		s.serveStreamOne(w, r)
+	case !isUpload:
+		s.count("download")
+		s.serveDownload(w, r, s.session(sessionID))
+	case seq != "":
+		s.count("packet")
+		if s.abortUploads {
+			panic(http.ErrAbortHandler)
+		}
+		if s.uploadStatus != 0 {
+			w.WriteHeader(s.uploadStatus)
+			return
+		}
+		number, err := strconv.ParseInt(seq, 10, 64)
+		if err != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		data, err := s.packetData(r)
+		if err != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		if s.maxPacket > 0 && len(data) > s.maxPacket {
+			w.WriteHeader(http.StatusRequestHeaderFieldsTooLarge)
+			return
+		}
+		s.received.Add(int64(len(data)))
+		s.session(sessionID).pushPacket(number, data)
+		w.WriteHeader(http.StatusOK)
+	default:
+		s.count("stream-up")
+		if s.abortUploads {
+			panic(http.ErrAbortHandler)
+		}
+		if s.uploadStatus != 0 {
+			w.WriteHeader(s.uploadStatus)
+			return
+		}
+		session := s.session(sessionID)
+		http.NewResponseController(w).EnableFullDuplex()
+		w.WriteHeader(http.StatusOK)
+		w.(http.Flusher).Flush()
+		buffer := make([]byte, 32*1024)
+		for {
+			n, err := r.Body.Read(buffer)
+			if n > 0 {
+				s.received.Add(int64(n))
+				session.push(append([]byte(nil), buffer[:n]...))
+				if s.resetUploadAfterData {
+					panic(http.ErrAbortHandler)
+				}
+				if s.endUploadAfterData {
+					return
+				}
+			}
+			if err != nil {
+				return
+			}
+		}
+	}
+}
+
+func (s *testServer) serveDownload(w http.ResponseWriter, r *http.Request, session *testSession) {
+	if s.holdDownload {
+		select {
+		case <-session.firstData:
+		case <-r.Context().Done():
+			return
+		}
+	}
+	if s.downloadStatus != 0 {
+		w.WriteHeader(s.downloadStatus)
+		for s.endlessErrorBody && r.Context().Err() == nil {
+			w.Write([]byte("error page "))
+			w.(http.Flusher).Flush()
+			time.Sleep(10 * time.Millisecond)
+		}
+		return
+	}
+	w.Header().Set("Content-Type", "text/event-stream")
+	w.WriteHeader(http.StatusOK)
+	w.(http.Flusher).Flush()
+	for {
+		select {
+		case data := <-session.echo:
+			if _, err := w.Write(data); err != nil {
+				return
+			}
+			w.(http.Flusher).Flush()
+		case <-r.Context().Done():
+			return
+		}
+	}
+}
+
+func (s *testServer) serveStreamOne(w http.ResponseWriter, r *http.Request) {
+	if s.downloadStatus != 0 {
+		w.WriteHeader(s.downloadStatus)
+		return
+	}
+	http.NewResponseController(w).EnableFullDuplex()
+	w.WriteHeader(http.StatusOK)
+	w.(http.Flusher).Flush()
+	buffer := make([]byte, 32*1024)
+	// As with Xray, the upload is read to its end whatever becomes of the
+	// download: a client that is done reading may still be sending.
+	var downloadOver bool
+	for {
+		n, err := r.Body.Read(buffer)
+		if n > 0 {
+			s.received.Add(int64(n))
+			if !downloadOver {
+				if _, writeErr := w.Write(buffer[:n]); writeErr != nil {
+					downloadOver = true
+				} else {
+					w.(http.Flusher).Flush()
+				}
+				if s.endStreamOneAfterData {
+					return
+				}
+			}
+		}
+		if err != nil {
+			return
+		}
+	}
+}
diff --git a/transport/v2rayxhttp/upload.go b/transport/v2rayxhttp/upload.go
