+	{"IPv4", "192.0.2.10:40000", "203.0.113.5:443", MethodWrongTimestamp, 0x3e8, "450000470000000040067ca1c000020acb0071059c4001bb123456789abcdef08018ffff03c80000080a00000000000000000000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv6", "[2001:db8::10]:40000", "[2001:db8:1::5]:443", MethodWrongSequence, 0xa1b2c3, "600000000027064020010db800000000000000000000001020010db80001000000000000000000059c4001bb123456659abcdef05018ffffde790000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv6", "[2001:db8::10]:40000", "[2001:db8:1::5]:443", MethodWrongChecksum, 0xa1b2c3, "600000000027064020010db800000000000000000000001020010db80001000000000000000000059c4001bb123456789abcdef05018ffff21990000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv6", "[2001:db8::10]:40000", "[2001:db8:1::5]:443", MethodWrongAcknowledgment, 0xa1b2c3, "600000000027064020010db800000000000000000000001020010db80001000000000000000000059c4001bb123456789abc5ef15018ffff5e660000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv6", "[2001:db8::10]:40000", "[2001:db8:1::5]:443", MethodWrongMD5Sig, 0xa1b2c3, "60000000003b064020010db800000000000000000000001020010db80001000000000000000000059c4001bb123456789abcdef0a018ffff7b4000001312000000000000000000000000000000000000666f726765642d636c69656e742d68656c6c6f"},
+	{"IPv6", "[2001:db8::10]:40000", "[2001:db8:1::5]:443", MethodWrongTimestamp, 0xa1b2c3, "600000000033064020010db800000000000000000000001020010db80001000000000000000000059c4001bb123456789abcdef08018ffffe1a20000080a006ac443000000000000666f726765642d636c69656e742d68656c6c6f"},
