From e7034df026148577d096dea1a7dbb0e67baa1f11 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Fri, 6 Nov 2026 08:47:24 +0300
Subject: [PATCH 186/193] urltest: a probe the URL failed holds no member back;
 one member a device

- A loss probe before a switch holds the candidate back only when its body
  began and stopped (ErrDownloadStopped); a status, no body, or a body
  shorter than asked proves nothing about the member, and a loss URL that
  fails would otherwise keep the group on its member for good.
- The probe connection is the first dial under the context that connects:
  a failed address of the server leaves the mark to the next one.
- A device of a balance is its source address alone: its TCP and its UDP
  (HTTPS and QUIC of a site) go by one member; a connection of a network
  its member does not carry goes by another without moving the device.
---
 common/probesock/probesock.go       |  8 +++--
 common/urltest/loss.go              | 16 ++++++++--
 protocol/group/urltest_balance.go   | 30 ++++++++++---------
 protocol/group/urltest_download.go  |  5 ++--
 protocol/group/urltest_loss_test.go | 46 ++++++++++++++++++++++++++---
 5 files changed, 80 insertions(+), 25 deletions(-)

diff --git a/common/probesock/probesock.go b/common/probesock/probesock.go
index 9f40f4ed1..534b86835 100644
--- a/common/probesock/probesock.go
+++ b/common/probesock/probesock.go
@@ -66,8 +66,8 @@ func (s *Socket) take() bool {
 	return true
 }
 
-// Dial dials address with dialer. The first dial under the context is the probe
-// connection: its receive buffer is set before the connect, when the window scale is
+// Dial dials address with dialer. The first dial under the context that connects is the
+// probe connection: its receive buffer is set before the connect, when the window scale is
 // chosen, and its packets are captured from the connect on (no data moves before the
 // connect returns). Every later dial is an ordinary one.
 func (s *Socket) Dial(ctx context.Context, dialer net.Dialer, network string, address string) (net.Conn, error) {
@@ -78,6 +78,10 @@ func (s *Socket) Dial(ctx context.Context, dialer net.Dialer, network string, ad
 	start := time.Now()
 	conn, err := dialer.DialContext(ctx, network, address)
 	if err != nil {
+		// the next address of the server, dialed after this one, is the probe connection
+		s.access.Lock()
+		s.taken = false
+		s.access.Unlock()
 		return nil, err
 	}
 	connect := time.Since(start)
diff --git a/common/urltest/loss.go b/common/urltest/loss.go
index 23e3ccb79..f280e3525 100644
--- a/common/urltest/loss.go
+++ b/common/urltest/loss.go
@@ -53,7 +53,10 @@ type LossSample struct {
 
 // LossProbe downloads size bytes of link through detour over a probe connection and returns
 // what its packets showed. An error wrapping ErrLossNotCounted tells a download that went
-// but could not be counted; another error, a download that did not go.
+// but could not be counted; one wrapping ErrDownloadStopped, a body that began and stopped
+// on the way (the member's failure, as in the download test); another error, a probe that
+// could not run (the URL answered with a status, the dial failed), which proves nothing
+// about the member.
 func LossProbe(ctx context.Context, link string, size int64, detour N.Dialer) (LossSample, error) {
 	var sample LossSample
 	linkURL, err := url.Parse(link)
@@ -97,8 +100,15 @@ func LossProbe(ctx context.Context, link string, size int64, detour N.Dialer) (L
 	received, err := io.CopyN(io.Discard, resp.Body, size)
 	sample.Elapsed = time.Since(start)
 	sample.Received = received
-	if err != nil && !(errors.Is(err, io.EOF) && received > 0 && received == resp.ContentLength) {
-		return sample, E.Cause(err, "after ", received, " bytes")
+	if err != nil {
+		switch {
+		case received == 0:
+			return sample, E.Cause(err, "no body")
+		case errors.Is(err, io.EOF):
+			// the whole body, shorter than asked: counted as it is
+		default:
+			return sample, E.Cause(errors.Join(ErrDownloadStopped, err), "after ", received, " bytes")
+		}
 	}
 	result, err := socket.Finish()
 	if err != nil {
