From d28ea3ad0ba82fb4401de9eaec8ead64cd0a64d9 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Mon, 19 Oct 2026 00:22:47 +0300
Subject: [PATCH 138/160] ruletext: text lists carry their trie as DomainSet

The domains of a text list are built into a succinct.Set of their own,
as rule sets of the source format are, with the description of the
first names.
---
 common/ruletext/ruletext.go      | 16 ++++++++++++----
 common/ruletext/ruletext_test.go | 14 +++++---------
 2 files changed, 17 insertions(+), 13 deletions(-)

diff --git a/common/ruletext/ruletext.go b/common/ruletext/ruletext.go
index c3a60b642..56479b6c3 100644
--- a/common/ruletext/ruletext.go
+++ b/common/ruletext/ruletext.go
@@ -33,8 +33,8 @@ type Skipped struct {
 // item is an error: a page served in place of the list (a block page, a captive
 // portal) is no list, and a line of it is no item.
 //
-// The domains come as the matcher of the rule (DomainMatcher), built by common/domainset
-// from where they are in the content: a name in lower case already is not copied.
+// The domains come as the trie of the rule (DomainSet), built by common/domainset from
+// where they are in the content: a name in lower case already is not copied.
 func Read(content []byte) (option.PlainRuleSetCompat, Skipped, error) {
 	return read(content, true)
 }
@@ -51,6 +51,8 @@ func read(content []byte, build bool) (option.PlainRuleSetCompat, Skipped, error
 		prefixes []string
 		skipped  Skipped
 		domains  int
+		// the first names, for the description of the rule
+		first []string
 	)
 	names := domainset.NewCollector(content)
 	if build {
@@ -94,6 +96,9 @@ func read(content []byte, build bool) (option.PlainRuleSetCompat, Skipped, error
 			if build {
 				// the item is a part of the content: where it is, from what is left after it
 				start := cap(content) - cap(item[from:])
+				if len(first) < 3 {
+					first = append(first, strings.ToLower(string(item[from:to])))
+				}
 				if hasUpper(item[from:to]) {
 					err := names.AddBytes(bytes.ToLower(item[from:to]), true)
 					if err != nil {
@@ -113,6 +118,9 @@ func read(content []byte, build bool) (option.PlainRuleSetCompat, Skipped, error
 			if domain, isDomain := parseDomain(string(item)); isDomain {
 				domains++
 				if build {
+					if len(first) < 3 {
+						first = append(first, domain)
+					}
 					err := names.AddString(domain, true)
 					if err != nil {
 						return option.PlainRuleSetCompat{}, skipped, err
@@ -137,11 +145,11 @@ func read(content []byte, build bool) (option.PlainRuleSetCompat, Skipped, error
 	}
 	var rules []option.HeadlessRule
 	if build && names.Len() > 0 {
-		matcher, err := names.Matcher()
+		set, err := names.Set(domainset.Describe(nil, 0, first, domains))
 		if err != nil {
 			return option.PlainRuleSetCompat{}, skipped, err
 		}
-		rules = append(rules, option.HeadlessRule{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultHeadlessRule{DomainMatcher: matcher}})
+		rules = append(rules, option.HeadlessRule{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultHeadlessRule{DomainSet: set}})
 	}
 	if len(prefixes) > 0 {
 		rules = append(rules, option.HeadlessRule{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultHeadlessRule{IPCIDR: badoption.Listable[string](prefixes)}})
diff --git a/common/ruletext/ruletext_test.go b/common/ruletext/ruletext_test.go
index 870ae54d4..c887f9d57 100644
--- a/common/ruletext/ruletext_test.go
+++ b/common/ruletext/ruletext_test.go
@@ -6,6 +6,7 @@ import (
 	"testing"
 
 	"github.com/sagernet/sing/common/domain"
+	"github.com/sagernet/sing/common/varbin"
 
 	"github.com/stretchr/testify/require"
 )
@@ -16,7 +17,7 @@ func TestRead(t *testing.T) {
 	require.NoError(t, err)
 	require.Len(t, ruleSet.Options.Rules, 2)
 	require.Equal(t, written(t, domain.NewMatcher(nil, []string{"example.com", "sub.example.org", "x.example", "ru", "last.example"}, false)),
-		written(t, ruleSet.Options.Rules[0].DefaultOptions.DomainMatcher))
+		written(t, ruleSet.Options.Rules[0].DefaultOptions.DomainSet))
 	require.Equal(t, []string{"10.0.0.0/8", "192.0.2.1/32", "2001:db8::/32"}, []string(ruleSet.Options.Rules[1].DefaultOptions.IPCIDR))
 	require.Equal(t, Skipped{Count: 2, First: "not a domain"}, skipped)
 
@@ -33,15 +34,10 @@ func TestRead(t *testing.T) {
 	require.Error(t, err)
 }
 
-// written is a matcher as a rule set carries it after it was read once: a matcher that
-// domain.ReadMatcher made pads its leaves.
-func written(t *testing.T, matcher *domain.Matcher) []byte {
+// written is a trie as a rule set carries it.
+func written(t *testing.T, matcher interface{ Write(varbin.Writer) error }) []byte {
 	var content bytes.Buffer
 	require.NoError(t, matcher.Write(&content))
-	read, err := domain.ReadMatcher(bytes.NewReader(content.Bytes()))
-	require.NoError(t, err)
-	content.Reset()
-	require.NoError(t, read.Write(&content))
 	return content.Bytes()
 }
 
@@ -67,7 +63,7 @@ func TestReadNames(t *testing.T) {
 	ruleSet, skipped, err := Read([]byte(strings.Join(lines, "\n")))
 	require.NoError(t, err)
 	require.Equal(t, 5, skipped.Count)
-	require.Equal(t, written(t, domain.NewMatcher(nil, expected, false)), written(t, ruleSet.Options.Rules[0].DefaultOptions.DomainMatcher))
+	require.Equal(t, written(t, domain.NewMatcher(nil, expected, false)), written(t, ruleSet.Options.Rules[0].DefaultOptions.DomainSet))
 	require.Equal(t, []string{"10.0.0.1/32", "10.0.0.0/8", "2001:db8::/32"}, []string(ruleSet.Options.Rules[1].DefaultOptions.IPCIDR))
 	// without the matcher: the same addresses, the same lines left out
 	addresses, skippedToo, err := ReadAddresses([]byte(strings.Join(lines, "\n")))
-- 
2.53.0

