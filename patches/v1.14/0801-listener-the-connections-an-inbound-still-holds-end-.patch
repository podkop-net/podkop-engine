diff --git a/common/listener/listener_accepted.go b/common/listener/listener_accepted.go
new file mode 100644
index 000000000..0eb749c1c
--- /dev/null
+++ b/common/listener/listener_accepted.go
@@ -0,0 +1,64 @@
+package listener
+
+import (
+	"context"
+	"net"
+	"sync"
+
+	"github.com/sagernet/sing-box/adapter"
+)
+
+// The TCP connections a listener accepted and its inbound still holds (podkop-engine): those whose
+// handler has not returned. The handler of an inbound returns when the connection is closed or when
+// the router has it, which closes it with what it dialed; until then nothing but its peer ends it: a
+// handshake that does not come, a client of an HTTP proxy between two requests of a connection kept
+// alive. When the listener closes, such a connection would be served on by an inbound that is
+// closed: the next request of the kept-alive connection would be authenticated by the users the
+// inbound had, and answered "502 Bad Gateway" by a router that is closed. They are closed with the
+// listener, as an HTTP server closes its idle connections; a client dials again.
+type acceptedConns struct {
+	access sync.Mutex
+	conns  map[net.Conn]struct{}
+	closed bool
+}
+
+// add takes a connection, false once the listener is closed.
+func (c *acceptedConns) add(conn net.Conn) bool {
+	c.access.Lock()
+	defer c.access.Unlock()
+	if c.closed {
+		return false
+	}
+	if c.conns == nil {
+		c.conns = make(map[net.Conn]struct{})
+	}
+	c.conns[conn] = struct{}{}
+	return true
+}
+
+func (c *acceptedConns) remove(conn net.Conn) {
+	c.access.Lock()
+	defer c.access.Unlock()
+	delete(c.conns, conn)
+}
+
+// close closes the connections held, and those accepted from now on.
+func (c *acceptedConns) close() {
+	c.access.Lock()
+	conns := c.conns
+	c.conns, c.closed = nil, true
+	c.access.Unlock()
+	for conn := range conns {
+		conn.Close()
+	}
+}
+
+// handleTCP hands a connection to the inbound, which holds it until the call returns.
+func (l *Listener) handleTCP(ctx context.Context, conn net.Conn, metadata adapter.InboundContext) {
+	if !l.accepted.add(conn) {
+		conn.Close()
+		return
+	}
+	defer l.accepted.remove(conn)
+	l.connHandler.NewConnection(ctx, conn, metadata, nil)
+}
diff --git a/common/listener/listener_accepted_test.go b/common/listener/listener_accepted_test.go
new file mode 100644
index 000000000..80e293f19
--- /dev/null
+++ b/common/listener/listener_accepted_test.go
@@ -0,0 +1,129 @@
+package listener
+
+import (
+	"bufio"
+	"context"
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/json/badoption"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+// testInbound is the handler of a listener: a connection that says "hold" stays in its handler
+// until it ends, one that says "route" goes to the router (routed) and the handler returns.
+type testInbound struct {
+	routed chan net.Conn
+	ended  chan error
+}
+
+func (i *testInbound) NewConnection(ctx context.Context, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	reader := bufio.NewReader(conn)
+	line, err := reader.ReadString('\n')
+	if err != nil {
+		i.ended <- err
+		conn.Close()
+		return
+	}
+	conn.Write([]byte("ok\n"))
+	if line == "route\n" {
+		i.routed <- conn
+		return
+	}
+	_, err = reader.ReadString('\n')
+	i.ended <- err
+	conn.Close()
+}
+
+func newTestListener(t *testing.T) (*Listener, *testInbound) {
+	inbound := &testInbound{routed: make(chan net.Conn, 1), ended: make(chan error, 1)}
+	listen := badoption.Addr(netip.MustParseAddr("127.0.0.1"))
+	listener := New(Options{
+		Context:           context.Background(),
+		Logger:            log.NewNOPFactory().NewLogger("test"),
+		Network:           []string{N.NetworkTCP},
+		Listen:            option.ListenOptions{Listen: common.Ptr(listen)},
+		ConnectionHandler: inbound,
+	})
+	require.NoError(t, listener.Start())
+	t.Cleanup(func() { listener.Close() })
+	return listener, inbound
+}
+
+func dialTestListener(t *testing.T, listener *Listener, say string) (net.Conn, *bufio.Reader) {
+	conn, err := net.DialTimeout("tcp", listener.TCPListener().Addr().String(), testWait)
+	require.NoError(t, err)
+	t.Cleanup(func() { conn.Close() })
+	require.NoError(t, conn.SetDeadline(time.Now().Add(testWait)))
+	reader := bufio.NewReader(conn)
+	if say != "" {
+		_, err = conn.Write([]byte(say + "\n"))
+		require.NoError(t, err)
+		answer, err := reader.ReadString('\n')
+		require.NoError(t, err)
+		require.Equal(t, "ok\n", answer)
+	}
+	return conn, reader
+}
+
+func held(listener *Listener) int {
+	listener.accepted.access.Lock()
+	defer listener.accepted.access.Unlock()
+	return len(listener.accepted.conns)
+}
+
+// The connections an inbound holds end with its listener: one that waits for its handshake, one that
+// waits for the next request. One that was handed over does not.
+func TestCloseEndsHeldConnections(t *testing.T) {
+	t.Parallel()
+	for _, say := range []string{"", "hold"} {
+		listener, inbound := newTestListener(t)
+		_, reader := dialTestListener(t, listener, say)
+		_, routedReader := dialTestListener(t, listener, "route")
+		routed := <-inbound.routed
+		defer routed.Close()
+		require.Eventually(t, func() bool { return held(listener) == 1 }, testWait, 5*time.Millisecond, "the connection handed over is not held")
+		require.NoError(t, listener.Close())
+		_, err := reader.ReadByte()
+		require.Error(t, err)
+		require.False(t, E.IsTimeout(err), "the held connection was left open: %v", err)
+		require.Error(t, <-inbound.ended)
+		// the router has the other one
+		_, err = routed.Write([]byte("from the router\n"))
+		require.NoError(t, err)
+		answer, err := routedReader.ReadString('\n')
+		require.NoError(t, err)
+		require.Equal(t, "from the router\n", answer)
+		require.Zero(t, held(listener))
+	}
+}
+
+// A connection that ended by itself is not kept, and one accepted while the listener closes is
+// closed.
+func TestHeldConnectionsForgotten(t *testing.T) {
+	t.Parallel()
+	listener, inbound := newTestListener(t)
+	conn, _ := dialTestListener(t, listener, "hold")
+	require.Equal(t, 1, held(listener))
+	conn.Close()
+	require.Error(t, <-inbound.ended)
+	require.Eventually(t, func() bool { return held(listener) == 0 }, testWait, 5*time.Millisecond)
+	require.NoError(t, listener.Close())
+
+	client, server := net.Pipe()
+	defer client.Close()
+	listener.handleTCP(context.Background(), server, adapter.InboundContext{InboundType: C.TypeMixed})
+	_, err := client.Read(make([]byte, 1))
+	require.Error(t, err)
+	require.Empty(t, inbound.ended, "a closed inbound serves nothing")
+}
