+
+type connInfo struct {
+	mss    int
+	minRTT time.Duration
+}
+
+func tcpInfo(conn *net.TCPConn) (connInfo, error) {
+	return connInfo{}, E.New("not supported on this platform")
+}
+
+type capture struct{}
+
+func startCapture(conn *net.TCPConn, window time.Duration) (*capture, error) {
+	return nil, E.New("the capture is not supported on this platform")
+}
+
+func (c *capture) stop() (Counts, int) {
+	return Counts{}, 0
+}
diff --git a/common/probesock/count.go b/common/probesock/count.go
new file mode 100644
index 000000000..1ac9fbe53
--- /dev/null
+++ b/common/probesock/count.go
@@ -0,0 +1,138 @@
+// Package probesock counts what a probe connection lost on its way to this host
+// (podkop-engine).
+//
+// A loss probe downloads through a server over a TCP connection of its own, opened with a
+// small receive buffer: the window the host offers stays at a few segments, so the server
+// never sends a burst that a shallow queue on the way (the subscriber's line, mostly) would
+// drop. Loss the probe made itself would show on every server alike. While the probe runs,
+// the headers of the packets of its connection are captured, and the incoming sequence is
+// followed: a hole a later packet fills is reordering when it is filled sooner than a
+// quarter of the RTT, and a loss when filled later, by the retransmission of the lost
+// segment. The kernel's own counters cannot tell the two apart: its count of out-of-order
+// packets grows with the window, not with the loss, and calls a server that reorders lossy.
+package probesock
+
+import (
+	"time"
+)
+
+// Counts are what the capture saw of the incoming data of the probe connection.
+type Counts struct {
+	Packets      int   // incoming packets with data
+	Bytes        int64 // the sequence space they covered, once
+	Holes        int   // gaps in the sequence that opened
+	LostBytes    int64 // bytes of holes filled late: retransmitted
+	LostFills    int   // packets that filled a hole late
+	ReorderBytes int64 // bytes of holes filled soon: reordered
+	DupBytes     int64 // bytes that came twice
+	Unfilled     int64 // bytes of holes still open at the end
+}
+
+// minReorderWindow is the least time a hole may take to fill and still be reordering: a
+// quarter of the RTT, but not less than this, so that the scheduling of the capture on a
+// nearby server does not turn reordering into loss.
+const minReorderWindow = 3 * time.Millisecond
+
+// reorderWindow is that time for a connection whose connect took rtt.
+func reorderWindow(rtt time.Duration) time.Duration {
+	return max(rtt/4, minReorderWindow)
+}
+
+type hole struct {
+	start, end int64
+	at         time.Time
+}
+
+// counter follows the incoming sequence of one connection, packet by packet.
+type counter struct {
+	window  time.Duration
+	started bool
+	base    uint32
+	highest int64
+	holes   []hole
+	Counts
+}
+
+// maxAhead bounds how far past the highest byte a packet may start: a sequence number
+// further away is not of this stream (an older packet, wrapped around).
+const maxAhead = 1 << 30
+
+// add takes an incoming packet with payload bytes of data starting at seq, captured at at.
+func (c *counter) add(at time.Time, seq uint32, payload int) {
+	if payload <= 0 {
+		return
+	}
+	if !c.started {
+		c.base, c.started = seq, true
+	}
+	start := int64(seq - c.base)
+	if start > c.highest+maxAhead {
+		return
+	}
+	end := start + int64(payload)
+	c.Packets++
+	if start > c.highest {
+		c.holes = append(c.holes, hole{c.highest, start, at})
+		c.Holes++
+		c.highest = end
+		return
+	}
+	limit := min(end, c.highest)
+	covered := int64(0)
+	filledLate := false
+	kept := c.holes[:0]
+	for _, h := range c.holes {
+		from, to := max(start, h.start), min(limit, h.end)
+		if from >= to {
+			kept = append(kept, h)
+			continue
+		}
+		covered += to - from
+		if at.Sub(h.at) < c.window {
+			c.ReorderBytes += to - from
+		} else {
+			c.LostBytes += to - from
+			filledLate = true
+		}
+		if h.start < from {
+			kept = append(kept, hole{h.start, from, h.at})
+		}
+		if to < h.end {
+			kept = append(kept, hole{to, h.end, h.at})
+		}
+	}
+	c.holes = kept
+	if filledLate {
+		c.LostFills++
+	}
+	c.DupBytes += (limit - start) - covered
+	if end > c.highest {
+		c.highest = end
+	}
+}
+
+// finish returns the counts of the connection so far.
+func (c *counter) finish() Counts {
+	counts := c.Counts
+	counts.Bytes = c.highest
+	for _, h := range c.holes {
+		counts.Unfilled += h.end - h.start
+	}
+	return counts
+}
+
+// segments turns the counts into segments of size mss: how many the data took, and how many
+// of them were lost (a lost segment is at least one late fill).
+func (c Counts) segments(mss int) (segments int, lost int) {
+	if mss <= 0 {
+		mss = defaultMSS
+	}
+	segments = int((c.Bytes + int64(mss) - 1) / int64(mss))
+	lost = int((c.LostBytes + int64(mss)/2) / int64(mss))
+	lost = max(lost, c.LostFills)
+	return
+}
+
+// defaultMSS is the segment size when the connection does not tell its own: Ethernet, IPv4,
+// TCP timestamps.
+const defaultMSS = 1448
diff --git a/common/probesock/count_test.go b/common/probesock/count_test.go
new file mode 100644
index 000000000..b115d5b14
--- /dev/null
+++ b/common/probesock/count_test.go
@@ -0,0 +1,107 @@
+package probesock
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func at(milliseconds int) time.Time {
+	return time.Unix(1000, 0).Add(time.Duration(milliseconds) * time.Millisecond)
+}
+
+func newCounter() *counter {
+	return &counter{window: 10 * time.Millisecond}
+}
+
+func TestCounterInOrder(t *testing.T) {
+	c := newCounter()
+	for i := 0; i < 10; i++ {
+		c.add(at(i), uint32(5000+i*1000), 1000)
+	}
+	counts := c.finish()
+	require.Equal(t, int64(10000), counts.Bytes)
+	require.Zero(t, counts.Holes)
+	require.Zero(t, counts.LostBytes)
+	require.Equal(t, 10, counts.Packets)
+}
+
+// A hole filled later than the window is a loss: the retransmission of the segment.
+func TestCounterLoss(t *testing.T) {
+	c := newCounter()
+	c.add(at(0), 0, 1000)
+	c.add(at(1), 1000, 1000)
+	c.add(at(2), 3000, 1000)
+	c.add(at(3), 4000, 1000)
+	c.add(at(100), 2000, 1000)
+	counts := c.finish()
+	require.Equal(t, 1, counts.Holes)
+	require.Equal(t, int64(1000), counts.LostBytes)
+	require.Equal(t, 1, counts.LostFills)
+	require.Zero(t, counts.ReorderBytes)
+	require.Zero(t, counts.Unfilled)
+	require.Equal(t, int64(5000), counts.Bytes)
+}
+
+// A hole filled within the window is reordering, not a loss.
+func TestCounterReorder(t *testing.T) {
+	c := newCounter()
+	c.add(at(0), 0, 1000)
+	c.add(at(1), 2000, 1000)
+	c.add(at(2), 1000, 1000)
+	counts := c.finish()
+	require.Equal(t, int64(1000), counts.ReorderBytes)
+	require.Zero(t, counts.LostBytes)
+	require.Zero(t, counts.LostFills)
+}
+
+func TestCounterDuplicateAndUnfilled(t *testing.T) {
+	c := newCounter()
+	c.add(at(0), 0, 1000)
+	c.add(at(1), 0, 1000)
+	c.add(at(2), 2000, 1000)
+	counts := c.finish()
+	require.Equal(t, int64(1000), counts.DupBytes)
+	require.Equal(t, int64(1000), counts.Unfilled)
+}
+
+// A hole of two segments filled late by two retransmissions is two lost segments.
+func TestCounterPartialFills(t *testing.T) {
+	c := newCounter()
+	c.add(at(0), 0, 1000)
+	c.add(at(1), 3000, 1000)
+	c.add(at(50), 1000, 1000)
+	c.add(at(60), 2000, 1000)
+	counts := c.finish()
+	require.Equal(t, int64(2000), counts.LostBytes)
+	require.Equal(t, 2, counts.LostFills)
+	segments, lost := counts.segments(1000)
+	require.Equal(t, 4, segments)
+	require.Equal(t, 2, lost)
+}
+
+// The sequence number wraps around; a number far behind the stream is not taken.
+func TestCounterWrap(t *testing.T) {
+	c := newCounter()
+	c.add(at(0), 0xffffff00, 0x100)
+	c.add(at(1), 0, 1000)
+	c.add(at(2), 0x7fff0000, 1000)
+	counts := c.finish()
+	require.Equal(t, int64(0x100+1000), counts.Bytes)
+	require.Zero(t, counts.Holes)
+}
+
+func TestSegments(t *testing.T) {
+	segments, lost := Counts{Bytes: 14480, LostBytes: 1448}.segments(1448)
+	require.Equal(t, 10, segments)
+	require.Equal(t, 1, lost)
+	segments, lost = Counts{Bytes: 14480, LostBytes: 100, LostFills: 2}.segments(0)
+	require.Equal(t, 10, segments)
+	require.Equal(t, 2, lost)
+}
+
+func TestReorderWindow(t *testing.T) {
+	require.Equal(t, minReorderWindow, reorderWindow(time.Millisecond))
+	require.Equal(t, 25*time.Millisecond, reorderWindow(100*time.Millisecond))
+}
diff --git a/common/probesock/probesock.go b/common/probesock/probesock.go
new file mode 100644
index 000000000..9f40f4ed1
--- /dev/null
+++ b/common/probesock/probesock.go
@@ -0,0 +1,150 @@
+package probesock
+
+import (
+	"context"
+	"net"
+	"sync"
+	"time"
+
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// Window is the receive buffer a probe connection asks for: the kernel doubles it, and the
+// window it offers stays near 16-24 KB, a dozen segments. On the stand a 1 MB download with
+// it lost nothing on a 25-packet queue and on a 10 Mbit/s line, where a download with the
+// ordinary buffer lost 6-13 %, and still showed a random loss of 1 % as 0.8-1.25 %.
+const Window = 16 << 10
+
+type contextKey struct{}
+
+// Socket is the probe connection of a context: the first TCP connection a dialer opens
+// under it (see Dial). One probe, one socket: a context is made for each probe.
+type Socket struct {
+	window int
+
+	access  sync.Mutex
+	taken   bool
+	conn    *net.TCPConn
+	connect time.Duration
+	capture *capture
+	err     error
+}
+
+// With returns a context under which the first TCP dial is a probe connection with a
+// receive buffer of window bytes.
+func With(ctx context.Context, window int) (context.Context, *Socket) {
+	socket := &Socket{window: window}
+	return context.WithValue(ctx, contextKey{}, socket), socket
+}
+
+// From returns the probe socket of the context, nil when it has none.
+func From(ctx context.Context) *Socket {
+	socket, _ := ctx.Value(contextKey{}).(*Socket)
+	return socket
+}
+
+// Without returns a context whose dials are no probe connection: for the dials a probe
+// causes on the side, as the queries that resolve the server's name.
+func Without(ctx context.Context) context.Context {
+	if From(ctx) == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, contextKey{}, (*Socket)(nil))
+}
+
+// take reports whether this dial is the probe connection: the first one under the context.
+func (s *Socket) take() bool {
+	if s == nil {
+		return false
+	}
+	s.access.Lock()
+	defer s.access.Unlock()
+	if s.taken {
+		return false
+	}
+	s.taken = true
+	return true
+}
+
+// Dial dials address with dialer. The first dial under the context is the probe
+// connection: its receive buffer is set before the connect, when the window scale is
+// chosen, and its packets are captured from the connect on (no data moves before the
+// connect returns). Every later dial is an ordinary one.
+func (s *Socket) Dial(ctx context.Context, dialer net.Dialer, network string, address string) (net.Conn, error) {
+	if !s.take() {
+		return dialer.DialContext(ctx, network, address)
+	}
+	dialer.Control = appendControl(dialer.Control, s.window)
+	start := time.Now()
+	conn, err := dialer.DialContext(ctx, network, address)
+	if err != nil {
+		return nil, err
+	}
+	connect := time.Since(start)
+	s.access.Lock()
+	defer s.access.Unlock()
+	s.connect = connect
+	tcpConn, isTCP := conn.(*net.TCPConn)
+	if !isTCP {
+		s.err = E.New("not a TCP connection")
+		return conn, nil
+	}
+	s.conn = tcpConn
+	s.capture, s.err = startCapture(tcpConn, reorderWindow(connect))
+	return conn, nil
+}
+
+// Result is what a probe connection showed.
+type Result struct {
+	Counts
+	Segments int           // segments of data that came
+	Lost     int           // of them lost on the way
+	RTT      time.Duration // the least RTT of the connection, or its connect time
+	MSS      int
+	Dropped  int // packets the capture could not keep: the counts are short
+}
+
+// Finish ends the capture and returns the counts, before the connection is closed (its
+// TCP information is read). An error tells that the probe had no connection of its own to
+// count: the dial went over a connection opened before (a multiplexed transport), over UDP,
+// or the capture could not run.
+func (s *Socket) Finish() (Result, error) {
+	s.access.Lock()
+	defer s.access.Unlock()
+	var result Result
+	if !s.taken || s.conn == nil {
+		if s.err != nil {
+			return result, s.err
+		}
+		return result, E.New("no connection of its own")
+	}
+	if s.capture == nil {
+		return result, E.Cause(s.err, "capture")
+	}
+	counts, dropped := s.capture.stop()
+	s.capture = nil
+	result.Counts = counts
+	result.Dropped = dropped
+	result.RTT = s.connect
+	if info, err := tcpInfo(s.conn); err == nil {
+		result.MSS = info.mss
+		if info.minRTT > 0 {
+			result.RTT = info.minRTT
+		}
+	}
+	result.Segments, result.Lost = counts.segments(result.MSS)
+	return result, nil
+}
+
+// Close ends a capture that Finish did not end: the probe failed on the way.
+func (s *Socket) Close() {
+	if s == nil {
+		return
+	}
+	s.access.Lock()
+	defer s.access.Unlock()
+	if s.capture != nil {
+		s.capture.stop()
+		s.capture = nil
+	}
+}
diff --git a/common/urltest/loss.go b/common/urltest/loss.go
new file mode 100644
index 000000000..23e3ccb79
--- /dev/null
+++ b/common/urltest/loss.go
@@ -0,0 +1,273 @@
+package urltest
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"time"
+
+	"github.com/sagernet/sing-box/common/probesock"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// The loss probe (podkop-engine).
+//
+// A URL test cannot see loss: a few hundred bytes cross a lossy path as fast as a clean one.
+// A loss probe downloads LossProbeSmall or LossProbeLarge bytes through a server over a TCP
+// connection of its own with a small receive window, and counts the segments of that
+// connection that were lost on the way (probesock). On the stand a single probe of 1 MB
+// called no clean path lossy, found a loss of 2 % or more every time and one of 1 % eight or
+// nine times in ten; one of 256 KB is too short for a decision of its own, and the probes of
+// a server are summed over windows of hours (LossOfWindow).
+
+const (
+	// LossProbeSmall is the size of the periodic probe of a server.
+	LossProbeSmall = 256 << 10
+	// LossProbeLarge is the size of the probe of a server before a switch to it.
+	LossProbeLarge = 1 << 20
+	// LossProbeTimeout bounds a probe: a megabyte at a window of 16 KB over a path of 300 ms is
+	// some twenty seconds.
+	LossProbeTimeout = 30 * time.Second
+)
+
+// ErrLossNotCounted is the failure of a probe that downloaded but could not count: the
+// connection was not its own (a multiplexed transport, QUIC), or the capture could not
+// keep up. It says nothing about the server, and probing it again soon would not either.
+var ErrLossNotCounted = E.New("loss not counted")
+
+// LossSample is what one loss probe counted.
+type LossSample struct {
+	At        time.Time
+	Received  int64 // bytes of the body
+	Elapsed   time.Duration
+	Segments  int
+	Lost      int
+	Reordered int64 // bytes that came out of order and were not lost
+	RTT       time.Duration
+}
+
+// LossProbe downloads size bytes of link through detour over a probe connection and returns
+// what its packets showed. An error wrapping ErrLossNotCounted tells a download that went
+// but could not be counted; another error, a download that did not go.
+func LossProbe(ctx context.Context, link string, size int64, detour N.Dialer) (LossSample, error) {
+	var sample LossSample
+	linkURL, err := url.Parse(link)
+	if err != nil {
+		return sample, err
+	}
+	hostname := linkURL.Hostname()
+	port := linkURL.Port()
+	if port == "" {
+		switch linkURL.Scheme {
+		case "http":
+			port = "80"
+		case "https":
+			port = "443"
+		}
+	}
+	probeCtx, socket := probesock.With(ctx, probesock.Window)
+	defer socket.Close()
+	start := time.Now()
+	instance, err := detour.DialContext(probeCtx, "tcp", M.ParseSocksaddrHostPortStr(hostname, port))
+	if err != nil {
+		return sample, err
+	}
+	defer instance.Close()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, link, nil)
+	if err != nil {
+		return sample, err
+	}
+	req.Header.Set("Range", "bytes=0-"+strconv.FormatInt(size-1, 10))
+	client := probeClient(ctx, instance)
+	client.Timeout = LossProbeTimeout
+	defer client.CloseIdleConnections()
+	resp, err := client.Do(req)
+	if err != nil {
+		return sample, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK && resp.StatusCode != http.StatusPartialContent {
+		return sample, E.New("HTTP ", resp.StatusCode)
+	}
+	received, err := io.CopyN(io.Discard, resp.Body, size)
+	sample.Elapsed = time.Since(start)
+	sample.Received = received
+	if err != nil && !(errors.Is(err, io.EOF) && received > 0 && received == resp.ContentLength) {
+		return sample, E.Cause(err, "after ", received, " bytes")
+	}
+	result, err := socket.Finish()
+	if err != nil {
+		return sample, E.Cause(ErrLossNotCounted, err)
+	}
+	switch {
+	case result.Dropped > 0:
+		return sample, E.Cause(ErrLossNotCounted, "the capture dropped ", result.Dropped, " packets")
+	case result.Bytes < received:
+		// the body came over another connection: the one counted was not the probe's
+		return sample, E.Cause(ErrLossNotCounted, "the connection counted carried ", result.Bytes, " bytes of ", received)
+	}
+	sample.At = time.Now()
+	sample.Segments = result.Segments
+	sample.Lost = result.Lost
+	sample.Reordered = result.ReorderBytes
+	sample.RTT = result.RTT
+	return sample, nil
+}
+
+// LossKeep is how long the samples of a tag are kept: the longest window.
+const LossKeep = 24 * time.Hour
+
+// lossKeepCount bounds the samples of a tag: a probe every minute for a day.
+const lossKeepCount = 1440
+
+type lossState struct {
+	samples []LossSample
+	// when a probe of the tag downloaded and could not count: its connections are not its
+	// own, and probing it again soon would not count either
+	notCounted time.Time
+}
+
+// StoreLossSample keeps a sample of a tag for LossKeep.
+func (s *HistoryStorage) StoreLossSample(tag string, sample LossSample) {
+	s.access.Lock()
+	defer s.access.Unlock()
+	state := s.losses[tag]
+	if state == nil {
+		state = &lossState{}
+		s.losses[tag] = state
+	}
+	kept := state.samples[:0]
+	for _, old := range state.samples {
+		if sample.At.Sub(old.At) < LossKeep {
+			kept = append(kept, old)
+		}
+	}
+	if len(kept) >= lossKeepCount {
+		kept = kept[len(kept)-lossKeepCount+1:]
+	}
+	state.samples = append(kept, sample)
+	state.notCounted = time.Time{}
+	s.notifyUpdated()
+}
+
+// StoreLossNotCounted records that a probe of a tag could not count.
+func (s *HistoryStorage) StoreLossNotCounted(tag string, at time.Time) {
+	s.access.Lock()
+	defer s.access.Unlock()
+	state := s.losses[tag]
+	if state == nil {
+		state = &lossState{}
+		s.losses[tag] = state
+	}
+	state.notCounted = at
+}
+
+// LossNotCounted returns when a probe of a tag last could not count, zero when the last
+// probe counted or there was none.
+func (s *HistoryStorage) LossNotCounted(tag string) time.Time {
+	if s == nil {
+		return time.Time{}
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	if state := s.losses[tag]; state != nil {
+		return state.notCounted
+	}
+	return time.Time{}
+}
+
+// LossWindow is the sum of the samples of a tag over the last hours.
+type LossWindow struct {
+	Hours    int
+	Probes   int
+	Segments int
+	Lost     int
+}
+
+// Rate is the share of the segments that were lost, in percent.
+func (w LossWindow) Rate() float64 {
+	if w.Segments == 0 {
+		return 0
+	}
+	return float64(w.Lost) * 100 / float64(w.Segments)
+}
+
+// LossWindowHours are the windows the loss of a server is told over.
+var LossWindowHours = []int{1, 3, 6, 12, 24}
+
+// LossWindows sums the samples of a tag over each of LossWindowHours before now.
+func (s *HistoryStorage) LossWindows(tag string, now time.Time) []LossWindow {
+	if s == nil {
+		return nil
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	state := s.losses[tag]
+	if state == nil || len(state.samples) == 0 {
+		return nil
+	}
+	windows := make([]LossWindow, len(LossWindowHours))
+	for i, hours := range LossWindowHours {
+		windows[i].Hours = hours
+		for _, sample := range state.samples {
+			if now.Sub(sample.At) < time.Duration(hours)*time.Hour {
+				windows[i].Probes++
+				windows[i].Segments += sample.Segments
+				windows[i].Lost += sample.Lost
+			}
+		}
+	}
+	return windows
+}
+
+// LossOfWindow returns the shortest window of a tag with at least minSegments segments,
+// false when even the longest has fewer: what the loss of the server is decided by, as
+// recent as the probes allow.
+func (s *HistoryStorage) LossOfWindow(tag string, now time.Time, minSegments int) (LossWindow, bool) {
+	for _, window := range s.LossWindows(tag, now) {
+		if window.Segments >= minSegments {
+			return window, true
+		}
+	}
+	return LossWindow{}, false
+}
+
+// LastLossSample returns the newest sample of a tag.
+func (s *HistoryStorage) LastLossSample(tag string) (LossSample, bool) {
+	if s == nil {
+		return LossSample{}, false
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	state := s.losses[tag]
+	if state == nil || len(state.samples) == 0 {
+		return LossSample{}, false
+	}
+	return state.samples[len(state.samples)-1], true
+}
+
+// LossRTT returns the least RTT the samples of a tag measured in the last LossKeep: the
+// RTT of the path to the server, which the loss is weighed by.
+func (s *HistoryStorage) LossRTT(tag string, now time.Time) time.Duration {
+	if s == nil {
+		return 0
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	state := s.losses[tag]
+	if state == nil {
+		return 0
+	}
+	var least time.Duration
+	for _, sample := range state.samples {
+		if sample.RTT > 0 && now.Sub(sample.At) < LossKeep && (least == 0 || sample.RTT < least) {
+			least = sample.RTT
+		}
+	}
+	return least
+}
