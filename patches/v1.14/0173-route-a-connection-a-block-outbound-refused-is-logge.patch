From: FiyeroT <me@fiyero.xyz>
Date: Thu, 29 Oct 2026 01:38:43 +0300
Subject: [PATCH 173/174] route: a connection a block outbound refused is
 logged at debug

As one the reject action refused: a section of podkop whose group has no
server goes to a block outbound, and an error line a connection would
flood the log.
---
 route/conn.go             |  4 ++--
 route/conn_podkop.go      | 21 +++++++++++++++++
 route/conn_podkop_test.go | 47 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 70 insertions(+), 2 deletions(-)
 create mode 100644 route/conn_podkop.go
 create mode 100644 route/conn_podkop_test.go

diff --git a/route/conn.go b/route/conn.go
index 54b1e947d..e83116e82 100644
--- a/route/conn.go
+++ b/route/conn.go
@@ -123,7 +123,7 @@ func (m *ConnectionManager) NewConnection(ctx context.Context, this N.Dialer, co
 		err = E.Cause(err, "open connection to ", remoteString, dialerString)
 		m.deleteURLTestHistory(metadata.OutboundChain)
 		N.CloseOnHandshakeFailure(conn, onClose, err)
-		m.logger.ErrorContext(ctx, err)
+		m.logDialError(ctx, this, err)
 		return
 	}
 	err = N.ReportConnHandshakeSuccess(conn, remoteConn)
@@ -223,7 +223,7 @@ func (m *ConnectionManager) NewPacketConnection(ctx context.Context, this N.Dial
 			err = E.Cause(err, "listen packet connection using ", dialerString)
 			m.deleteURLTestHistory(metadata.OutboundChain)
 			N.CloseOnHandshakeFailure(conn, onClose, err)
-			m.logger.ErrorContext(ctx, err)
+			m.logDialError(ctx, this, err)
 			return
 		}
 	}
diff --git a/route/conn_podkop.go b/route/conn_podkop.go
new file mode 100644
index 000000000..7453d4bc0
--- /dev/null
+++ b/route/conn_podkop.go
@@ -0,0 +1,21 @@
+package route
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// logDialError logs a connection that could not be opened. One a block outbound refused was
+// refused on purpose, as the reject action refuses (logged at debug there): a section of
+// podkop whose group has no server goes to a block outbound, and an error line a connection
+// would flood the log (podkop-engine).
+func (m *ConnectionManager) logDialError(ctx context.Context, this N.Dialer, err error) {
+	if outbound, isOutbound := this.(adapter.Outbound); isOutbound && outbound.Type() == C.TypeBlock {
+		m.logger.DebugContext(ctx, err)
+		return
+	}
+	m.logger.ErrorContext(ctx, err)
+}
diff --git a/route/conn_podkop_test.go b/route/conn_podkop_test.go
new file mode 100644
index 000000000..74bcf4449
--- /dev/null
+++ b/route/conn_podkop_test.go
@@ -0,0 +1,47 @@
+package route
+
+import (
+	"context"
+	"net"
+	"os"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter/outbound"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+)
+
+type levelLogger struct {
+	logger.ContextLogger
+	debug, errors int
+}
+
+func (l *levelLogger) DebugContext(context.Context, ...any) { l.debug++ }
+func (l *levelLogger) ErrorContext(context.Context, ...any) { l.errors++ }
+
+type typedOutbound struct {
+	outbound.Adapter
+}
+
+func (o *typedOutbound) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return nil, os.ErrInvalid
+}
+
+func (o *typedOutbound) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, os.ErrInvalid
+}
+
+// A connection a block outbound refused is logged at debug, as one the reject action refused;
+// another that could not be opened stays an error.
+func TestLogDialError(t *testing.T) {
+	logged := &levelLogger{}
+	manager := &ConnectionManager{logger: logged}
+	manager.logDialError(context.Background(), &typedOutbound{Adapter: outbound.NewAdapter(C.TypeBlock, "block-out", nil, nil)}, os.ErrPermission)
+	require.Equal(t, 1, logged.debug)
+	require.Zero(t, logged.errors)
+	manager.logDialError(context.Background(), &typedOutbound{Adapter: outbound.NewAdapter(C.TypeVLESS, "server", nil, nil)}, os.ErrDeadlineExceeded)
+	require.Equal(t, 1, logged.errors)
+}
