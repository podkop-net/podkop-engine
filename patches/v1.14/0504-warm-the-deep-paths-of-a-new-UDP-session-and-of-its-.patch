diff --git a/common/warm/warm.go b/common/warm/warm.go
new file mode 100644
index 000000000..43100a13d
--- /dev/null
+++ b/common/warm/warm.go
@@ -0,0 +1,87 @@
+// Package warm runs functions on goroutines that are kept for a while after they finish one.
+//
+// A new goroutine starts with a small stack, and the runtime keeps no grown stack for the next
+// goroutine when one exits: a path deeper than that stack (the route of a new UDP session, a DNS
+// exchange) copies its stack larger, often more than once, every time it runs on a new
+// goroutine. A worker of the pool keeps the stack it grew while it waits for the next function;
+// the garbage collector may still shrink the stack of a worker that waits, so the growth comes
+// back at most once a collection, not once a function.
+package warm
+
+import (
+	"sync/atomic"
+	"time"
+)
+
+// Pool hands functions to its waiting workers. It never makes a caller wait: with no worker
+// waiting, a function gets a new goroutine, which joins the pool while the pool has room.
+type Pool struct {
+	jobs chan func()
+	idle time.Duration
+	most int32
+	// workers are the goroutines of the pool, busy or waiting; started counts every one made
+	workers atomic.Int32
+	started atomic.Int64
+}
+
+// New makes a pool of at most most workers, each of which ends after waiting idle.
+func New(most int, idle time.Duration) *Pool {
+	return &Pool{jobs: make(chan func()), idle: idle, most: int32(most)}
+}
+
+// Go runs f on a waiting worker, or on a new goroutine.
+func (p *Pool) Go(f func()) {
+	select {
+	case p.jobs <- f:
+		return
+	default:
+	}
+	if p.workers.Add(1) <= p.most {
+		p.started.Add(1)
+		go p.work(f)
+		return
+	}
+	p.workers.Add(-1)
+	go f()
+}
+
+func (p *Pool) work(f func()) {
+	defer p.workers.Add(-1)
+	timer := time.NewTimer(p.idle)
+	defer timer.Stop()
+	for {
+		f()
+		f = nil
+		timer.Reset(p.idle)
+		select {
+		case f = <-p.jobs:
+		case <-timer.C:
+			return
+		}
+	}
+}
+
+// Workers is how many workers the pool has now, busy or waiting; Started how many it made.
+func (p *Pool) Workers() int { return int(p.workers.Load()) }
+
+func (p *Pool) Started() int64 { return p.started.Load() }
+
+// The pool of the process. At DNS saturation (16 queries at a time, one core of an arm64 server)
+// at most 8 workers were busy or waiting, and the process held no more memory than without the
+// pool; 64 bounds what a burst may keep. A worker waits 10 s, as a DNS session waits for its next
+// packet (C.DNSTimeout): every worker had ended 15 s after the load.
+var (
+	defaultWorkers = 64
+	defaultIdle    = 10 * time.Second
+	defaultPool    = New(defaultWorkers, defaultIdle)
+)
+
+// Go runs f on a worker of the pool of the process (Pool.Go).
+func Go(f func()) {
+	defaultPool.Go(f)
+}
+
+// Default is the pool of the process.
+func Default() *Pool {
+	return defaultPool
+}
diff --git a/common/warm/warm_test.go b/common/warm/warm_test.go
new file mode 100644
index 000000000..b952cba53
--- /dev/null
+++ b/common/warm/warm_test.go
@@ -0,0 +1,84 @@
+package warm
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+// Functions one after another run on one worker; a worker waits idle, then ends.
+func TestPoolReusesItsWorker(t *testing.T) {
+	pool := New(4, 200*time.Millisecond)
+	for range 10 {
+		done := make(chan struct{})
+		pool.Go(func() { close(done) })
+		<-done
+		time.Sleep(time.Millisecond)
+	}
+	if got := pool.Started(); got != 1 {
+		t.Fatalf("started %d workers for functions one after another, want 1", got)
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	for pool.Workers() != 0 && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if pool.Workers() != 0 {
+		t.Fatalf("%d workers left after their wait", pool.Workers())
+	}
+}
+
+// A caller never waits: past most busy workers, a function gets a goroutine of its own.
+func TestPoolNeverWaits(t *testing.T) {
+	pool := New(2, time.Second)
+	release := make(chan struct{})
+	var running sync.WaitGroup
+	running.Add(5)
+	for range 5 {
+		pool.Go(func() {
+			running.Done()
+			<-release
+		})
+	}
+	waited := make(chan struct{})
+	go func() { running.Wait(); close(waited) }()
+	select {
+	case <-waited:
+	case <-time.After(2 * time.Second):
+		t.Fatal("not every function started while the workers were busy")
+	}
+	if got := pool.Workers(); got != 2 {
+		t.Fatalf("%d workers, want the most, 2", got)
+	}
+	close(release)
+}
+
+// deep uses a few KB of stack a call, as the route of a session does.
+//
+//go:noinline
+func deep(depth int) byte {
+	var frame [512]byte
+	frame[depth%len(frame)] = byte(depth)
+	if depth == 0 {
+		return frame[0]
+	}
+	return deep(depth-1) + frame[depth%len(frame)]
+}
+
+// A deep function on a new goroutine against on a warm worker: the stack copied larger each time,
+// or once.
+func BenchmarkDeepOnNewGoroutine(b *testing.B) {
+	for range b.N {
+		done := make(chan struct{})
+		go func() { deep(64); close(done) }()
+		<-done
+	}
+}
+
+func BenchmarkDeepOnWarmWorker(b *testing.B) {
+	pool := New(4, time.Minute)
+	for range b.N {
+		done := make(chan struct{})
+		pool.Go(func() { deep(64); close(done) })
+		<-done
+	}
+}
