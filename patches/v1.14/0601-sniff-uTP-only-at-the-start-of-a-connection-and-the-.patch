+func TestSniffDHT(t *testing.T) {
+	t.Parallel()
+	packets := []string{
+		// BEP 5: ping, find_node, get_peers, a response, an error
+		"d1:ad2:id20:abcdefghij0123456789e1:q4:ping1:t2:aa1:y1:qe",
+		"d1:ad2:id20:abcdefghij01234567896:target20:mnopqrstuvwxyz123456e1:q9:find_node1:t2:aa1:y1:qe",
+		"d1:ad2:id20:abcdefghij01234567899:info_hash20:mnopqrstuvwxyz123456e1:q9:get_peers1:t2:aa1:y1:qe",
+		"d1:rd2:id20:mnopqrstuvwxyz123456e1:t2:aa1:y1:re",
+		"d1:eli201e23:A Generic Error Ocurrede1:t2:aa1:y1:ee",
+		// libtorrent's queries to the bootstrap nodes: the key bs before id
+		"d1:ad2:bsi1e2:id20:abcdefghij0123456789e1:q4:ping1:t2:aa1:y1:qe",
+		// a response with the address of the asker (BEP 42) and a version
+		"d2:ip6:\x01\x02\x03\x04\x1a\xe11:rd2:id20:mnopqrstuvwxyz123456e1:t2:aa1:v4:LT\x02\x001:y1:re",
+		// Transmission (dht of jech): a transaction id of 4 bytes, the version in a query
+		"d1:ad2:id20:abcdefghij0123456789e1:q4:ping1:t4:\x00\x01\x02\x031:v4:TR\x40\x001:y1:qe",
+		// a transaction id of 1 byte, the families wanted (BEP 32)
+		"d1:ad2:id20:abcdefghij01234567899:info_hash20:mnopqrstuvwxyz1234564:wantl2:n42:n6ee1:q9:get_peers1:t1:x1:y1:qe",
+		// a node that only asks (BEP 43)
+		"d1:ad2:id20:abcdefghij0123456789e1:q4:ping2:roi1e1:t2:aa1:y1:qe",
+	}
+	for _, text := range packets {
+		var metadata adapter.InboundContext
+		require.NoError(t, sniff.DHT(context.TODO(), &metadata, []byte(text)), text)
+		require.Equal(t, C.ProtocolBitTorrent, metadata.Protocol)
+	}
