From 236d861bf221c4021f6d4ad981af24dcd04bd2c7 Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Fri, 13 Nov 2026 21:14:28 +0300
Subject: [PATCH 60/60] dns: the question of the exchange debug line formatted
 only when it is logged

The router logged every query as "exchange <question>" with the question formatted before the
logger knew its level: at warn the line is dropped, yet each query paid for the String of the
question and FormatQuestion's replacements (3.3 % of the CPU at DNS saturation on a Cortex-A53).
dns.QuestionLine formats it when a logger does; a dropped line allocates 2 times instead of 7.

Pdk-Feature: dns-question-line
Pdk-Zone: core
Pdk-Layer: 05
---
 dns/question_line.go      | 15 +++++++++++++++
 dns/question_line_test.go | 38 ++++++++++++++++++++++++++++++++++++++
 dns/router.go             |  4 ++--
 3 files changed, 55 insertions(+), 2 deletions(-)
 create mode 100644 dns/question_line.go
 create mode 100644 dns/question_line_test.go

diff --git a/dns/question_line.go b/dns/question_line.go
new file mode 100644
index 000000000..a435fc70c
--- /dev/null
+++ b/dns/question_line.go
@@ -0,0 +1,15 @@
+package dns
+
+import (
+	mDNS "github.com/miekg/dns"
+)
+
+// QuestionLine is a question as a log line shows it (FormatQuestion), formatted only when a logger
+// formats it: the path of every query must not pay for a line its level drops.
+type QuestionLine struct {
+	Question mDNS.Question
+}
+
+func (l QuestionLine) String() string {
+	return FormatQuestion(l.Question.String())
+}
diff --git a/dns/question_line_test.go b/dns/question_line_test.go
new file mode 100644
index 000000000..75a294992
--- /dev/null
+++ b/dns/question_line_test.go
@@ -0,0 +1,38 @@
+package dns
+
+import (
+	"context"
+	"io"
+	"testing"
+
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	F "github.com/sagernet/sing/common/format"
+
+	mDNS "github.com/miekg/dns"
+)
+
+func TestQuestionLine(t *testing.T) {
+	question := mDNS.Question{Name: "example.org.", Qtype: mDNS.TypeA, Qclass: mDNS.ClassINET}
+	if got, want := F.ToString("exchange ", QuestionLine{question}), "exchange "+FormatQuestion(question.String()); got != want {
+		t.Fatalf("line %q, want %q", got, want)
+	}
+	// at warn the debug line is dropped before its arguments are formatted: the question costs
+	// nothing, where the eager form formats it every time
+	factory, err := log.New(log.Options{Context: context.Background(), Options: option.LogOptions{Level: "warn"}, DefaultWriter: io.Discard})
+	if err != nil {
+		t.Fatal(err)
+	}
+	logger := factory.NewLogger("dns")
+	ctx := context.Background()
+	lazy := testing.AllocsPerRun(200, func() {
+		logger.DebugContext(ctx, "exchange ", QuestionLine{question})
+	})
+	eager := testing.AllocsPerRun(200, func() {
+		logger.DebugContext(ctx, "exchange ", FormatQuestion(question.String()))
+	})
+	if lazy >= eager {
+		t.Fatalf("allocations a dropped line: lazy %v, eager %v", lazy, eager)
+	}
+	t.Logf("allocations a dropped debug line: lazy %v, eager %v", lazy, eager)
+}
diff --git a/dns/router.go b/dns/router.go
index 10026873c..2d5f8b5db 100644
--- a/dns/router.go
+++ b/dns/router.go
@@ -1084,7 +1084,7 @@ func (r *Router) prepareExchange(ctx context.Context, message *mDNS.Msg) (*dnsEx
 		}, nil
 	}
 	if isResolverDiscoveryQuery(message.Question[0]) {
-		r.logger.DebugContext(ctx, "rejected resolver discovery query ", FormatQuestion(message.Question[0].String()))
+		r.logger.DebugContext(ctx, "rejected resolver discovery query ", QuestionLine{message.Question[0]})
 		return nil, &mDNS.Msg{
 			MsgHdr: mDNS.MsgHdr{
 				Id:                 message.Id,
@@ -1104,7 +1104,7 @@ func (r *Router) prepareExchange(ctx context.Context, message *mDNS.Msg) (*dnsEx
 	rules := r.rules
 	legacyDNSMode := r.legacyDNSMode
 	r.rulesAccess.RUnlock()
-	r.logger.DebugContext(ctx, "exchange ", FormatQuestion(message.Question[0].String()))
+	r.logger.DebugContext(ctx, "exchange ", QuestionLine{message.Question[0]})
 	ctx, metadata := adapter.ExtendContext(ctx)
 	metadata.Destination = M.Socksaddr{}
 	metadata.QueryType = message.Question[0].Qtype
