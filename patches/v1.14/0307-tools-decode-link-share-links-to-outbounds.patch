diff --git a/common/sharelink/tls.go b/common/sharelink/tls.go
new file mode 100644
index 000000000..b8e722ce7
--- /dev/null
+++ b/common/sharelink/tls.go
@@ -0,0 +1,198 @@
+package sharelink
+
+import (
+	"encoding/base64"
+	"strings"
+
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// The fingerprints sing-box knows by these names (common/tls/utls_client.go).
+var utlsNames = map[string]bool{
+	"chrome": true, "firefox": true, "edge": true, "safari": true, "360": true, "qq": true, "ios": true, "android": true,
+	"random": true, "randomized": true,
+	"chrome_psk": true, "chrome_psk_shuffle": true, "chrome_padding_psk_shuffle": true, "chrome_pq": true, "chrome_pq_psk": true,
+}
+
+// The fingerprints only Xray knows by name (transport/internet/tls/tls.go of Xray-core
+// v26.9.30), each with the one of sing-box of the same browser. Which Client Hello a
+// client imitates is the client's own choice: the server is reached with any.
+var xrayFingerprints = []struct{ prefix, fingerprint string }{
+	{"hellochrome_", "chrome"},
+	{"hellofirefox_", "firefox"},
+	{"hellosafari_", "safari"},
+	{"helloios_", "ios"},
+	{"helloedge_", "edge"},
+	{"hello360_", "360"},
+	{"helloqq_", "qq"},
+	{"helloandroid_", "android"},
+	{"hellorandomized", "randomized"},
+	{"randomizednoalpn", "randomized"},
+}
+
+// utls reads the fingerprint of a link as Xray does: any case, Chrome's when there is
+// none, and no imitation for "unsafe" and for a name Xray does not know (not with
+// REALITY, which is built on uTLS and refuses both).
+func (d *decoder) utls(reality bool) (*option.OutboundUTLSOptions, error) {
+	return d.utlsOf(d.query["fp"], reality)
+}
+
+func (d *decoder) utlsOf(fingerprint string, reality bool) (*option.OutboundUTLSOptions, error) {
+	fingerprint = strings.ToLower(fingerprint)
+	switch {
+	case fingerprint == "":
+		fingerprint = "chrome"
+	case utlsNames[fingerprint]:
+	case (fingerprint == "unsafe" || fingerprint == "hellogolang") && !reality:
+		return nil, nil
+	default:
+		substitute := ""
+		for _, known := range xrayFingerprints {
+			if strings.HasPrefix(fingerprint, known.prefix) {
+				substitute = known.fingerprint
+				break
+			}
+		}
+		switch {
+		case substitute != "":
+			d.warn("the fingerprint", shown(fingerprint), " has no counterpart, ", substitute, " is used")
+			fingerprint = substitute
+		case reality:
+			return nil, refuse("fingerprint-reality", "unsupported fingerprint", shown(fingerprint), ", which REALITY needs")
+		default:
+			d.warn("the fingerprint", shown(fingerprint), " is unknown, no browser is imitated")
+			return nil, nil
+		}
+	}
+	return &option.OutboundUTLSOptions{Enabled: true, Fingerprint: fingerprint}, nil
+}
+
+// The parameters of TLS every scheme reads the same way.
+func (d *decoder) tlsCommon(tlsOptions *option.OutboundTLSOptions) {
+	d.reads("sni", "servername", "peer", "allowinsecure", "allow_insecure", "insecure", "skip-cert-verify",
+		"alpn", "disable_sni", "nosni", "cert", "ech", "pcs", "pinsha256", "vcn", "cs")
+	tlsOptions.Enabled = true
+	if tlsOptions.ServerName == "" {
+		tlsOptions.ServerName = d.first("sni", "servername", "peer")
+	}
+	tlsOptions.Insecure = isTrue(d.first("allowinsecure", "allow_insecure", "insecure", "skip-cert-verify"))
+	if alpn := splitList(d.query["alpn"]); len(alpn) > 0 {
+		tlsOptions.ALPN = alpn
+	}
+	tlsOptions.DisableSNI = isTrue(d.first("disable_sni", "nosni"))
+	if certificate := strings.TrimSpace(d.query["cert"]); certificate != "" {
+		// the certificate to trust, in the link itself (NekoBox, husi)
+		tlsOptions.Certificate = strings.Split(strings.ReplaceAll(certificate, "\r\n", "\n"), "\n")
+	}
+	tlsOptions.ECH = d.ech()
+	if d.first("pcs", "pinsha256") != "" && !tlsOptions.Insecure && len(tlsOptions.Certificate) == 0 {
+		// Xray and Hysteria pin the hash of a certificate, sing-box that of a public key:
+		// one cannot be made from the other
+		d.warn("the pinned certificate (pcs, pinSHA256) is not supported: the server is verified against the system roots, and one with a self-signed certificate is refused")
+	}
+	if names := splitList(d.query["vcn"]); len(names) > 0 && !tlsOptions.Insecure {
+		// Xray verifies the certificate by these names instead of the one it sends
+		same := false
+		for _, name := range names {
+			same = same || strings.EqualFold(name, tlsOptions.ServerName)
+		}
+		if !same {
+			d.warn("vcn (the names the certificate is verified by) is not supported: the certificate is verified by the server name of TLS, and a server with a certificate for another name is refused")
+		}
+	}
+	if d.query["cs"] != "" {
+		d.warn("cs (the cipher suites of TLS) is not supported and is ignored")
+	}
+}
+
+// ech reads the "ech" of a link: the ECH configuration list in base64 or, as Xray takes
+// it, where to ask for it: a resolver, or a name and a resolver joined with "+".
+func (d *decoder) ech() *option.OutboundECHOptions {
+	// form decoding has made a space of every "+"
+	value := strings.ReplaceAll(strings.TrimSpace(d.query["ech"]), " ", "+")
+	if value == "" {
+		return nil
+	}
+	if strings.Contains(value, "://") {
+		echOptions := &option.OutboundECHOptions{Enabled: true}
+		if name, _, named := strings.Cut(value, "+"); named && !strings.Contains(name, "://") {
+			echOptions.QueryServerName = strings.TrimSpace(name)
+		}
+		d.warn("the resolver named in ech is not used: the ECH configuration is asked from the DNS of sing-box")
+		return echOptions
+	}
+	var list []byte
+	for _, encoding := range []*base64.Encoding{base64.StdEncoding, base64.RawStdEncoding, base64.URLEncoding, base64.RawURLEncoding} {
+		decoded, err := encoding.DecodeString(value)
+		if err == nil {
+			list = decoded
+			break
+		}
+	}
+	if len(list) == 0 {
+		d.warn("ech is neither a configuration list in base64 nor a resolver, and is ignored")
+		return nil
+	}
+	lines := []string{"-----BEGIN ECH CONFIGS-----"}
+	encoded := base64.StdEncoding.EncodeToString(list)
+	for len(encoded) > 64 {
+		lines = append(lines, encoded[:64])
+		encoded = encoded[64:]
+	}
+	lines = append(lines, encoded, "-----END ECH CONFIGS-----")
+	return &option.OutboundECHOptions{Enabled: true, Config: lines}
+}
+
+// security reads the TLS of a link of the VLESS family (the proposal of Xray-core
+// discussion #716): "security" chooses none, TLS or REALITY.
+func (d *decoder) security(defaultSecurity string) (*option.OutboundTLSOptions, error) {
+	// also the ones a link without TLS carries along: the generators write them anyway
+	d.reads("security", "fp", "pbk", "sid", "pqv", "spx", "spiderx",
+		"sni", "servername", "peer", "allowinsecure", "allow_insecure", "insecure", "skip-cert-verify",
+		"alpn", "disable_sni", "nosni", "cert", "ech", "pcs", "pinsha256", "vcn", "cs")
+	security := strings.ToLower(d.query["security"])
+	if security == "" {
+		security = defaultSecurity
+	}
+	switch security {
+	case "none":
+		return nil, nil
+	case "tls", "reality":
+	default:
+		return nil, refuse("security", "unsupported security", shown(security))
+	}
+	tlsOptions := new(option.OutboundTLSOptions)
+	d.tlsCommon(tlsOptions)
+	var err error
+	tlsOptions.UTLS, err = d.utls(security == "reality")
+	if err != nil {
+		return nil, err
+	}
+	if security == "reality" {
+		if d.query["pbk"] == "" {
+			return nil, E.New("missing REALITY public key (pbk)")
+		}
+		if shortID := d.query["sid"]; len(shortID) > 16 || len(shortID)%2 != 0 || !isHex(shortID) {
+			return nil, E.New("the REALITY short id (sid) is not hexadecimal digits, up to 16 and an even number of them")
+		}
+		tlsOptions.Reality = &option.OutboundRealityOptions{
+			Enabled:   true,
+			PublicKey: d.query["pbk"],
+			ShortID:   d.query["sid"],
+		}
+		if d.query["pqv"] != "" {
+			d.warn("pqv (the ML-DSA-65 check of the REALITY server) is not supported, the server is not verified with it")
+		}
+	}
+	return tlsOptions, nil
+}
+
+// tlsAlways reads the TLS of a link whose protocol always runs over TLS or QUIC. There
+// is no fingerprint to imitate: over QUIC sing-box has none, and the schemes that carry
+// "fp" read it themselves.
+func (d *decoder) tlsAlways() *option.OutboundTLSOptions {
+	tlsOptions := new(option.OutboundTLSOptions)
+	d.tlsCommon(tlsOptions)
+	return tlsOptions
+}
diff --git a/common/sharelink/tlsproxy.go b/common/sharelink/tlsproxy.go
new file mode 100644
index 000000000..ad69de09f
--- /dev/null
+++ b/common/sharelink/tlsproxy.go
@@ -0,0 +1,63 @@
+package sharelink
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json/badoption"
+)
+
+// anytls reads an AnyTLS link, as its project defines it:
+// "anytls://password@host[:port]/?sni=...&insecure=1#name".
+func (d *decoder) anytls() (any, error) {
+	d.reads("fp")
+	user, _, server, _, err := parseAuthority(d.body, 443)
+	if err != nil {
+		return nil, err
+	}
+	options := option.AnyTLSOutboundOptions{
+		ServerOptions: server,
+		Password:      user,
+	}
+	tlsOptions := d.tlsAlways()
+	if d.query["fp"] != "" {
+		tlsOptions.UTLS, err = d.utls(false)
+		if err != nil {
+			return nil, err
+		}
+	}
+	options.TLS = tlsOptions
+	return options, nil
+}
+
+// naive reads a NaiveProxy link: "naive+https://user:password@host[:port]?parameters#name",
+// or "naive+quic://" for QUIC.
+func (d *decoder) naive() (any, error) {
+	d.reads("extra-headers", "insecure-concurrency", "padding")
+	user, _, server, _, err := parseAuthority(d.body, 443)
+	if err != nil {
+		return nil, err
+	}
+	options := option.NaiveOutboundOptions{
+		ServerOptions: server,
+		QUIC:          d.scheme == "naive+quic",
+	}
+	options.Username, options.Password, _ = strings.Cut(user, ":")
+	if concurrency := d.query["insecure-concurrency"]; concurrency != "" {
+		options.InsecureConcurrency, _ = strconv.Atoi(concurrency)
+	}
+	if headers := d.query["extra-headers"]; headers != "" {
+		// "Name: value" lines
+		options.ExtraHeaders = make(badoption.HTTPHeader)
+		for _, line := range strings.Split(strings.ReplaceAll(headers, "\r\n", "\n"), "\n") {
+			name, value, found := strings.Cut(line, ":")
+			if name = strings.TrimSpace(name); !found || name == "" {
+				continue
+			}
+			options.ExtraHeaders[name] = append(options.ExtraHeaders[name], strings.TrimSpace(value))
+		}
+	}
+	options.TLS = d.tlsAlways()
+	return options, nil
+}
diff --git a/common/sharelink/transport.go b/common/sharelink/transport.go
new file mode 100644
index 000000000..a59c307ba
--- /dev/null
+++ b/common/sharelink/transport.go
@@ -0,0 +1,268 @@
+package sharelink
+
+import (
+	"net/url"
+	"strconv"
+	"strings"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/json"
+	"github.com/sagernet/sing/common/json/badoption"
+)
+
+// The settings of XHTTP a link may carry outside of "extra", added by the
+// initialization of flatKeys: they are read only with that transport, and get
+// no warning with another.
+var knownKeys = make(map[string]bool)
+
+// The masks of Xray's finalmask ("fm") that are the client's own business: the server
+// is reached without them. Every other one changes what goes over the wire, and the
+// server expects it.
+var localMasks = map[string]bool{"fragment": true, "noise": true}
+
+// clientSide warns of the settings of Xray's client that a panel writes into a link: how
+// it fragments and pads its own packets. The server is reached without them.
+func (d *decoder) clientSide() {
+	d.reads("fragment", "noise", "noises")
+	if d.query["fragment"] != "" {
+		d.warn("fragment is a setting of the client of Xray and is not applied (sb.tls.fragment=1 turns on the fragmenting of sing-box)")
+	}
+	if d.first("noise", "noises") != "" {
+		d.warn("noise is a setting of the client of Xray and is not applied")
+	}
+}
+
+// finalMask reads "fm", the finalmask object of Xray.
+func (d *decoder) finalMask() error {
+	d.reads("fm")
+	content := strings.TrimSpace(d.query["fm"])
+	if content == "" {
+		return nil
+	}
+	var mask struct {
+		TCP []struct {
+			Type string `json:"type"`
+		} `json:"tcp"`
+		UDP []struct {
+			Type string `json:"type"`
+		} `json:"udp"`
+	}
+	err := json.Unmarshal([]byte(content), &mask)
+	if err != nil {
+		d.warn("fm (finalmask) is not supported and cannot be read, the connection may not work")
+		return nil
+	}
+	for _, entry := range append(mask.TCP, mask.UDP...) {
+		if !localMasks[strings.ToLower(entry.Type)] {
+			return refuse("finalmask", "fm (finalmask) asks for the mask", shown(entry.Type), ", which is not supported: the server expects it")
+		}
+	}
+	d.warn("fm (finalmask) is not supported and is ignored: what it sets is the client's own")
+	return nil
+}
+
+// ownALPN leaves the ALPN to a transport that speaks one protocol. Xray asks for
+// http/1.1 with WebSocket and HTTPUpgrade, and for h2 with gRPC and HTTP/2, whatever the
+// link says; sing-box asks for the same when no ALPN is set, and for what is set when
+// one is. Panels write one ALPN for every host ("h2,http/1.1"), and a server that is
+// offered both picks HTTP/2, over which no WebSocket handshake goes.
+func ownALPN(tlsOptions *option.OutboundTLSOptions) {
+	if tlsOptions != nil {
+		tlsOptions.ALPN = nil
+	}
+}
+
+// transport reads the transport of a link of the VLESS family. tls tells whether the
+// link has TLS, and serverName the name it is asked by.
+func (d *decoder) transport(tlsOptions *option.OutboundTLSOptions) (*option.V2RayTransportOptions, error) {
+	d.reads("type", "host", "path", "mode", "xhttpmode", "extra", "x_padding_bytes", "headertype", "servicename", "authority",
+		"ed", "eh", "method", "seed", "mtu", "tti", "quicsecurity", "key",
+		// how often the client of Xray pings over WebSocket: its own business
+		"heartbeatperiod")
+	d.clientSide()
+	network := strings.ToLower(d.query["type"])
+	if tlsOptions != nil && tlsOptions.Reality != nil {
+		switch network {
+		case "ws", "http", "h2", "httpupgrade":
+			d.warn("Xray does not serve REALITY over this transport")
+		}
+	}
+	err := d.finalMask()
+	if err != nil {
+		return nil, err
+	}
+	switch network {
+	case "", "tcp", "raw":
+		switch headerType := strings.ToLower(d.query["headertype"]); headerType {
+		case "", "none":
+			return nil, nil
+		case "http":
+			// The HTTP header of the TCP transport: a request line and headers before the
+			// stream. Without TLS the http transport of sing-box speaks the same, HTTP/1.1;
+			// with TLS it would speak HTTP/2, which is another thing.
+			if tlsOptions != nil {
+				return nil, refuse("tcp-http-header-tls", "the HTTP header of the TCP transport (headerType=http) is not supported together with TLS")
+			}
+			// Xray takes a list of paths and asks for one of them at random
+			path := d.query["path"]
+			if paths := splitList(path); len(paths) > 1 {
+				path = paths[0]
+			}
+			return &option.V2RayTransportOptions{
+				Type:        C.V2RayTransportTypeHTTP,
+				HTTPOptions: option.V2RayHTTPOptions{Host: splitList(d.query["host"]), Path: path},
+			}, nil
+		default:
+			return nil, refuse("tcp-header", "unsupported header type of the TCP transport", shown(headerType))
+		}
+	case "ws":
+		path, earlyData := splitEarlyData(d.query["path"], d.query["ed"])
+		options := option.V2RayWebsocketOptions{Path: path, MaxEarlyData: earlyData}
+		if earlyData > 0 {
+			// the only form Xray speaks, unless the link names another ("eh")
+			options.EarlyDataHeaderName = "Sec-WebSocket-Protocol"
+			if header := d.query["eh"]; header != "" {
+				options.EarlyDataHeaderName = header
+			}
+		}
+		host := d.query["host"]
+		if host == "" && tlsOptions != nil {
+			// as Xray does: sing-box would send the address of the server, which a
+			// reverse proxy that chooses the site by Host does not know
+			host = tlsOptions.ServerName
+		}
+		if host != "" {
+			options.Headers = badoption.HTTPHeader{"Host": {host}}
+		}
+		ownALPN(tlsOptions)
+		return &option.V2RayTransportOptions{Type: C.V2RayTransportTypeWebsocket, WebsocketOptions: options}, nil
+	case "grpc":
+		mode := strings.ToLower(d.query["mode"])
+		switch mode {
+		case "", "gun", "multi":
+		default:
+			return nil, refuse("grpc-mode", "unsupported gRPC mode", shown(mode))
+		}
+		serviceName := d.query["servicename"]
+		// Marzban escapes the name of a custom path once more than a link does, and
+		// leaves "/Tun" out of it: an escaped slash in a name can only be that
+		if unescaped, err := url.PathUnescape(serviceName); err == nil && unescaped != serviceName && strings.Contains(unescaped, "/") {
+			if !strings.HasPrefix(unescaped, "/") {
+				unescaped = "/" + unescaped + "/Tun"
+			}
+			serviceName = unescaped
+		}
+		if strings.HasPrefix(serviceName, "/") {
+			// Xray reads a name that starts with "/" as a whole path with its own stream
+			// name (in the mode multi, the name of the other stream). sing-box makes the
+			// path "/<name>/Tun", the name being one escaped segment: only that shape
+			// can be said.
+			lastSlash := strings.LastIndexByte(serviceName, '/')
+			stream, _, _ := strings.Cut(serviceName[lastSlash+1:], "|")
+			name := strings.Trim(serviceName[:lastSlash], "/")
+			if mode == "multi" || stream != "Tun" || name == "" || strings.Contains(name, "/") {
+				return nil, refuse("grpc-custom-path", "a gRPC service name that is a custom path is supported only as /name/Tun")
+			}
+			serviceName = name
+		} else if mode == "multi" {
+			// the server answers both kinds of stream under the usual names
+			d.warn("the gRPC mode multi is not supported, gun is used")
+		}
+		// sing-box sends the server name of TLS, or the address of the server, there
+		if authority := d.query["authority"]; authority != "" {
+			sent := ""
+			if tlsOptions != nil {
+				sent = tlsOptions.ServerName
+			}
+			if !strings.EqualFold(authority, sent) {
+				d.warn("the gRPC authority is not supported: the server name of TLS is sent instead, and a reverse proxy that chooses the server by the authority may not find it")
+			}
+		}
+		ownALPN(tlsOptions)
+		return &option.V2RayTransportOptions{
+			Type:        C.V2RayTransportTypeGRPC,
+			GRPCOptions: option.V2RayGRPCOptions{ServiceName: serviceName},
+		}, nil
+	case "http", "h2":
+		if tlsOptions == nil {
+			// Xray speaks HTTP/2 there (h2c), sing-box HTTP/1.1; a server of sing-box
+			// takes both
+			d.warn("the HTTP/2 transport without TLS is spoken as HTTP/1.1: a server of Xray, which expects HTTP/2 there, does not answer")
+		}
+		ownALPN(tlsOptions)
+		return &option.V2RayTransportOptions{
+			Type:        C.V2RayTransportTypeHTTP,
+			HTTPOptions: option.V2RayHTTPOptions{Host: splitList(d.query["host"]), Path: d.query["path"], Method: d.query["method"]},
+		}, nil
+	case "httpupgrade":
+		// Xray takes early data here as with WebSocket; sing-box has none for this
+		// transport, and the "?ed=" of the path is not a part of the path the server sees
+		path, earlyData := splitEarlyData(d.query["path"], d.query["ed"])
+		if earlyData > 0 {
+			d.warn("early data is not supported with the httpupgrade transport and is not sent")
+		}
+		ownALPN(tlsOptions)
+		return &option.V2RayTransportOptions{
+			Type:               C.V2RayTransportTypeHTTPUpgrade,
+			HTTPUpgradeOptions: option.V2RayHTTPUpgradeOptions{Host: d.query["host"], Path: path},
+		}, nil
+	case "xhttp", "splithttp":
+		options, err := d.xhttp()
+		if err != nil {
+			return nil, err
+		}
+		return &option.V2RayTransportOptions{Type: C.V2RayTransportTypeXHTTP, XHTTPOptions: *options}, nil
+	case "quic":
+		// the QUIC transport of V2Ray; its packet masks are not in sing-box
+		if security := strings.ToLower(d.query["quicsecurity"]); security != "" && security != "none" {
+			return nil, refuse("quic-security", "the encryption of the QUIC transport (quicSecurity) is not supported")
+		}
+		if headerType := strings.ToLower(d.query["headertype"]); headerType != "" && headerType != "none" {
+			return nil, refuse("quic-header", "the packet header of the QUIC transport (headerType) is not supported")
+		}
+		if tlsOptions != nil {
+			// QUIC has TLS of its own, and no browser is imitated there: with uTLS in
+			// the options every connection fails ("unsupported usage for uTLS")
+			tlsOptions.UTLS = nil
+			if len(tlsOptions.ALPN) == 0 {
+				// with no ALPN named Xray offers h2 and http/1.1, and sing-box h3; a
+				// server of either kind takes only its own
+				tlsOptions.ALPN = []string{"h3", "h2", "http/1.1"}
+			}
+		}
+		return &option.V2RayTransportOptions{Type: C.V2RayTransportTypeQUIC}, nil
+	case "kcp", "mkcp":
+		return nil, refuse("kcp", "the mKCP transport is not supported")
+	default:
+		return nil, E.New("unsupported transport", shown(network))
+	}
+}
+
+// splitEarlyData takes the size of WebSocket early data from the "ed"
+// parameter of the link or, the usual place, from "?ed=" in the path, which
+// is not a part of the path the server sees. Not a number is no early data, as
+// with Xray.
+func splitEarlyData(path string, linkValue string) (string, uint32) {
+	value := linkValue
+	if base, pathQuery, found := strings.Cut(path, "?"); found {
+		var kept []string
+		for _, pair := range strings.Split(pathQuery, "&") {
+			if strings.HasPrefix(pair, "ed=") {
+				value = pair[len("ed="):]
+			} else if pair != "" {
+				kept = append(kept, pair)
+			}
+		}
+		path = base
+		if len(kept) > 0 {
+			path += "?" + strings.Join(kept, "&")
+		}
+	}
+	earlyData, err := strconv.ParseUint(value, 10, 32)
+	if err != nil {
+		return path, 0
+	}
+	return path, uint32(earlyData)
+}
diff --git a/common/sharelink/tree.go b/common/sharelink/tree.go
new file mode 100644
index 000000000..090d7792a
--- /dev/null
+++ b/common/sharelink/tree.go
@@ -0,0 +1,239 @@
+package sharelink
+
+import (
+	"bytes"
+	"strings"
+
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/json"
+)
+
+// object is a JSON object that keeps the order of its keys: the options of an outbound as
+// the configuration writes them, by name. The decoder fills it by option names and not
+// through the option structures, so that its text is the same for every sing-box it is
+// built into, whatever options that one has; what an option is worth there is for the
+// configuration reader and the outbound itself to say.
+//
+// A value is another object, a list ([]any), or anything else JSON has a form for.
+type object struct {
+	keys   []string
+	values map[string]any
+}
+
+func newObject() *object {
+	return &object{values: make(map[string]any)}
+}
+
+func (o *object) get(key string) (any, bool) {
+	value, exists := o.values[key]
+	return value, exists
+}
+
+func (o *object) put(key string, value any) {
+	if _, exists := o.values[key]; !exists {
+		o.keys = append(o.keys, key)
+	}
+	o.values[key] = value
+}
+
+func (o *object) remove(key string) {
+	if _, exists := o.values[key]; !exists {
+		return
+	}
+	delete(o.values, key)
+	for index, name := range o.keys {
+		if name == key {
+			o.keys = append(o.keys[:index], o.keys[index+1:]...)
+			break
+		}
+	}
+}
+
+func (o *object) empty() bool {
+	return len(o.keys) == 0
+}
+
+// child returns the object under key, making it when there is none. A value that is not
+// an object is replaced.
+func (o *object) child(key string) *object {
+	if existing, isObject := o.values[key].(*object); isObject {
+		return existing
+	}
+	created := newObject()
+	o.put(key, created)
+	return created
+}
+
+// set puts value at a path of names separated by dots.
+func (o *object) set(path string, value any) {
+	current := o
+	for {
+		name, rest, nested := strings.Cut(path, ".")
+		if !nested {
+			current.put(name, value)
+			return
+		}
+		current = current.child(name)
+		path = rest
+	}
+}
+
+// at returns the value at a path of names separated by dots.
+func (o *object) at(path string) (any, bool) {
+	current := o
+	for {
+		name, rest, nested := strings.Cut(path, ".")
+		value, exists := current.values[name]
+		if !exists || !nested {
+			return value, exists
+		}
+		next, isObject := value.(*object)
+		if !isObject {
+			return nil, false
+		}
+		current = next
+		path = rest
+	}
+}
+
+// text returns the string at a path, empty when there is none.
+func (o *object) text(path string) string {
+	value, _ := o.at(path)
+	text, _ := value.(string)
+	return text
+}
+
+func (o *object) MarshalJSON() ([]byte, error) {
+	var buffer bytes.Buffer
+	buffer.WriteByte('{')
+	for index, key := range o.keys {
+		if index > 0 {
+			buffer.WriteByte(',')
+		}
+		name, err := json.Marshal(key)
+		if err != nil {
+			return nil, err
+		}
+		buffer.Write(name)
+		buffer.WriteByte(':')
+		value, err := json.Marshal(o.values[key])
+		if err != nil {
+			return nil, err
+		}
+		buffer.Write(value)
+	}
+	buffer.WriteByte('}')
+	return buffer.Bytes(), nil
+}
+
+// parseObject reads a JSON object, keeping the order of its keys and the text of its
+// numbers.
+func parseObject(content []byte) (*object, error) {
+	value, err := parseValue(content)
+	if err != nil {
+		return nil, err
+	}
+	parsed, isObject := value.(*object)
+	if !isObject {
+		return nil, E.New("not a JSON object")
+	}
+	return parsed, nil
+}
+
+func parseValue(content []byte) (any, error) {
+	content = bytes.TrimSpace(content)
+	if len(content) == 0 {
+		return nil, E.New("empty JSON value")
+	}
+	switch content[0] {
+	case '{':
+		decoder := json.NewDecoder(bytes.NewReader(content))
+		_, err := decoder.Token()
+		if err != nil {
+			return nil, err
+		}
+		result := newObject()
+		for decoder.More() {
+			keyToken, err := decoder.Token()
+			if err != nil {
+				return nil, err
+			}
+			key, isString := keyToken.(string)
+			if !isString {
+				return nil, E.New("invalid JSON object")
+			}
+			var raw json.RawMessage
+			err = decoder.Decode(&raw)
+			if err != nil {
+				return nil, err
+			}
+			value, err := parseValue(raw)
+			if err != nil {
+				return nil, err
+			}
+			result.put(key, value)
+		}
+		_, err = decoder.Token()
+		if err != nil {
+			return nil, err
+		}
+		if decoder.More() {
+			return nil, E.New("text after the JSON object")
+		}
+		return result, nil
+	case '[':
+		var items []json.RawMessage
+		err := json.Unmarshal(content, &items)
+		if err != nil {
+			return nil, err
+		}
+		list := make([]any, 0, len(items))
+		for _, item := range items {
+			value, err := parseValue(item)
+			if err != nil {
+				return nil, err
+			}
+			list = append(list, value)
+		}
+		return list, nil
+	case '"':
+		var text string
+		err := json.Unmarshal(content, &text)
+		if err != nil {
+			return nil, err
+		}
+		return text, nil
+	case 't', 'f':
+		var flag bool
+		err := json.Unmarshal(content, &flag)
+		if err != nil {
+			return nil, err
+		}
+		return flag, nil
+	case 'n':
+		var null any
+		err := json.Unmarshal(content, &null)
+		if err != nil {
+			return nil, err
+		}
+		return nil, nil
+	default:
+		// a number, kept as it is written
+		var number json.RawMessage
+		err := json.Unmarshal(content, &number)
+		if err != nil {
+			return nil, err
+		}
+		return number, nil
+	}
+}
+
+// objectOf turns the options of an outbound into an object, through the JSON they are
+// written as.
+func objectOf(options any) (*object, error) {
+	content, err := json.Marshal(options)
+	if err != nil {
+		return nil, err
+	}
+	return parseObject(content)
+}
diff --git a/common/sharelink/vless.go b/common/sharelink/vless.go
new file mode 100644
index 000000000..987a3f989
--- /dev/null
+++ b/common/sharelink/vless.go
@@ -0,0 +1,127 @@
+package sharelink
+
+import (
+	"encoding/hex"
+	"strings"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/protocol/vless/encryption"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// vless reads a VLESS link: "vless://uuid@host:port?parameters#name" (the proposal of
+// Xray-core discussion #716).
+func (d *decoder) vless() (any, error) {
+	d.reads("encryption", "flow", "packetencoding", "packet-encoding")
+	user, server, err := parseServer(d.body)
+	if err != nil {
+		return nil, err
+	}
+	// VLESS Encryption is a layer of its own under VLESS, and a server that has it set
+	// takes no client without it. Its setting begins with the name of the key exchange
+	// and is passed as it is written; anything else in the parameter cannot stand for
+	// it, and Xray itself refuses such a configuration.
+	var encryptionSetting string
+	switch setting := d.query["encryption"]; {
+	case setting == "" || setting == "none":
+	case strings.HasPrefix(setting, encryption.Prefix):
+		// whether it is one Xray takes is looked at with the whole outbound (consistent)
+		encryptionSetting = setting
+	default:
+		d.warn("encryption has a value that is not VLESS encryption, it is read as none")
+	}
+	uuid, err := xrayUUID(user)
+	if err != nil {
+		return nil, err
+	}
+	flow := d.query["flow"]
+	switch flow {
+	case "", "xtls-rprx-vision":
+	case "xtls-rprx-vision-udp443":
+		// the same flow that also carries UDP to port 443, which sing-box
+		// does not single out
+		flow = "xtls-rprx-vision"
+	default:
+		return nil, refuse("flow", "unsupported flow", shown(flow))
+	}
+	options := option.VLESSOutboundOptions{
+		ServerOptions: server,
+		UUID:          uuid,
+		Flow:          flow,
+		Encryption:    encryptionSetting,
+	}
+	if packetEncoding := d.first("packetencoding", "packet-encoding"); packetEncoding != "" {
+		switch packetEncoding {
+		case "none":
+			packetEncoding = ""
+		case "packet":
+			// the name NekoBox and mihomo give packetaddr
+			packetEncoding = "packetaddr"
+		}
+		options.PacketEncoding = &packetEncoding
+	}
+	options.TLS, err = d.security("none")
+	if err != nil {
+		return nil, err
+	}
+	options.Transport, err = d.transport(options.TLS)
+	if err != nil {
+		return nil, err
+	}
+	// what a flow needs is looked at when every parameter has been read (consistent)
+	return options, nil
+}
+
+// xrayUUID reads the user of a VLESS or VMess link as Xray does (common/uuid of
+// Xray-core): a UUID in hexadecimal, with or without its dashes, or a string of up to 30
+// bytes that stands for the UUID made of it. sing-box makes the same UUID of such a
+// string but takes hexadecimal only in the usual form, so that form is what is written.
+func xrayUUID(user string) (string, error) {
+	if len(user) <= 30 {
+		return user, nil
+	}
+	if len(user) < 32 || len(user) > 36 {
+		return "", E.New("the user of the link is not a UUID")
+	}
+	text := user
+	var groups []string
+	for _, size := range []int{8, 4, 4, 4, 12} {
+		text = strings.TrimPrefix(text, "-")
+		if len(text) < size {
+			return "", E.New("the user of the link is not a UUID")
+		}
+		_, err := hex.DecodeString(text[:size])
+		if err != nil {
+			return "", E.New("the user of the link is not a UUID")
+		}
+		groups = append(groups, strings.ToLower(text[:size]))
+		text = text[size:]
+	}
+	return strings.Join(groups, "-"), nil
+}
+
+// trojan reads a Trojan link: "trojan://password@host:port?parameters#name", with TLS
+// unless the link says otherwise.
+func (d *decoder) trojan() (any, error) {
+	d.reads("flow", "encryption")
+	password, server, err := parseServer(d.body)
+	if err != nil {
+		return nil, err
+	}
+	options := option.TrojanOutboundOptions{
+		ServerOptions: server,
+		Password:      password,
+	}
+	if d.query["flow"] != "" {
+		d.warn("flow is not a setting of Trojan and is ignored")
+	}
+	options.TLS, err = d.security("tls")
+	if err != nil {
+		return nil, err
+	}
+	options.Transport, err = d.transport(options.TLS)
+	if err != nil {
+		return nil, err
+	}
+	return options, nil
+}
diff --git a/common/sharelink/vmess.go b/common/sharelink/vmess.go
new file mode 100644
index 000000000..ba2d3121b
--- /dev/null
+++ b/common/sharelink/vmess.go
@@ -0,0 +1,189 @@
+package sharelink
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/json"
+)
+
+// vmessText is a value of the JSON of a VMess link: the generators write numbers both as
+// numbers and as strings.
+type vmessText string
+
+func (t *vmessText) UnmarshalJSON(content []byte) error {
+	var text string
+	err := json.Unmarshal(content, &text)
+	if err == nil {
+		*t = vmessText(text)
+		return nil
+	}
+	var number json.RawMessage
+	err = json.Unmarshal(content, &number)
+	if err != nil {
+		return err
+	}
+	switch string(number) {
+	case "null":
+	case "true", "false":
+		*t = vmessText(number)
+	default:
+		if len(number) > 0 && (number[0] == '{' || number[0] == '[') {
+			return E.New("not a plain value")
+		}
+		*t = vmessText(number)
+	}
+	return nil
+}
+
+// The JSON of a VMess link, as v2rayN defined it.
+type vmessLink struct {
+	Name          vmessText `json:"ps"`
+	Address       vmessText `json:"add"`
+	Port          vmessText `json:"port"`
+	ID            vmessText `json:"id"`
+	AlterID       vmessText `json:"aid"`
+	Security      vmessText `json:"scy"`
+	Network       vmessText `json:"net"`
+	HeaderType    vmessText `json:"type"`
+	Host          vmessText `json:"host"`
+	Path          vmessText `json:"path"`
+	TLS           vmessText `json:"tls"`
+	SNI           vmessText `json:"sni"`
+	ALPN          vmessText `json:"alpn"`
+	Fingerprint   vmessText `json:"fp"`
+	AllowInsecure vmessText `json:"allowInsecure"`
+	Insecure      vmessText `json:"insecure"`
+	PublicKey     vmessText `json:"pbk"`
+	ShortID       vmessText `json:"sid"`
+}
+
+// vmess reads a VMess link in either of its forms: the one of v2rayN, base64 of a JSON
+// object, and a URL with the parameters of the VLESS proposal,
+// "vmess://uuid@host:port?parameters#name".
+func (d *decoder) vmess() (any, error) {
+	body := d.body
+	if index := strings.IndexByte(body, '#'); index >= 0 {
+		body = body[:index]
+	}
+	decoded, isBase64 := decodeBase64(body)
+	if !isBase64 || !strings.HasPrefix(strings.TrimSpace(string(decoded)), "{") {
+		err := d.split(d.body)
+		if err != nil {
+			return nil, err
+		}
+		return d.vmessURL()
+	}
+	var link vmessLink
+	err := json.Unmarshal(decoded, &link)
+	if err != nil {
+		return nil, E.New("read the JSON of the link: ", plainJSONError(err))
+	}
+	if link.Address == "" {
+		return nil, E.New("invalid server address")
+	}
+	port, err := strconv.ParseUint(string(link.Port), 10, 16)
+	if err != nil || port == 0 {
+		return nil, E.New("invalid server port", shown(string(link.Port)))
+	}
+	d.tag = string(link.Name)
+	// the rest is read as the parameters of the URL form are
+	d.query = map[string]string{
+		"type":          strings.ToLower(string(link.Network)),
+		"host":          string(link.Host),
+		"path":          string(link.Path),
+		"security":      strings.ToLower(string(link.TLS)),
+		"sni":           string(link.SNI),
+		"alpn":          string(link.ALPN),
+		"fp":            string(link.Fingerprint),
+		"allowinsecure": string(link.AllowInsecure),
+		"pbk":           string(link.PublicKey),
+		"sid":           string(link.ShortID),
+		"encryption":    string(link.Security),
+	}
+	if d.query["allowinsecure"] == "" {
+		d.query["allowinsecure"] = string(link.Insecure)
+	}
+	switch d.query["type"] {
+	case "grpc":
+		// the service name is in "path", the mode in "type"
+		d.query["servicename"] = d.query["path"]
+		if mode := strings.ToLower(string(link.HeaderType)); mode == "gun" || mode == "multi" {
+			d.query["mode"] = mode
+		}
+		delete(d.query, "path")
+	case "kcp", "mkcp":
+	case "quic":
+		// the encryption is in "host", its key in "path"
+		d.query["quicsecurity"] = d.query["host"]
+		d.query["headertype"] = string(link.HeaderType)
+	default:
+		d.query["headertype"] = string(link.HeaderType)
+	}
+	d.names = make(map[string]string, len(d.query))
+	for key, value := range d.query {
+		if value == "" {
+			delete(d.query, key)
+			continue
+		}
+		d.names[key] = key
+	}
+	alterID, _ := strconv.Atoi(string(link.AlterID))
+	// some generators write an IPv6 address in brackets here too
+	address := strings.TrimSuffix(strings.TrimPrefix(string(link.Address), "["), "]")
+	return d.vmessOptions(string(link.ID), option.ServerOptions{Server: address, ServerPort: uint16(port)}, alterID)
+}
+
+func (d *decoder) vmessURL() (any, error) {
+	d.reads("alterid", "aid")
+	user, server, err := parseServer(d.body)
+	if err != nil {
+		return nil, err
+	}
+	alterID, _ := strconv.Atoi(d.first("alterid", "aid"))
+	return d.vmessOptions(user, server, alterID)
+}
+
+func (d *decoder) vmessOptions(user string, server option.ServerOptions, alterID int) (any, error) {
+	d.reads("encryption", "packetencoding", "packet-encoding")
+	uuid, err := xrayUUID(user)
+	if err != nil {
+		return nil, err
+	}
+	security := strings.ToLower(d.query["encryption"])
+	switch security {
+	case "", "auto":
+		security = "auto"
+	case "aes-128-gcm", "chacha20-poly1305":
+	default:
+		// As the client of Xray reads it: any other name is auto. Its server refuses a
+		// request with none, zero or aes-128-cfb since 2026, and every VMess server takes
+		// the two ciphers auto chooses from.
+		d.warn("the VMess security", shown(security), " is read as auto, as Xray does: its server refuses any other")
+		security = "auto"
+	}
+	options := option.VMessOutboundOptions{
+		ServerOptions: server,
+		UUID:          uuid,
+		Security:      security,
+		AlterId:       alterID,
+	}
+	switch packetEncoding := d.first("packetencoding", "packet-encoding"); packetEncoding {
+	case "", "none":
+	case "packet":
+		options.PacketEncoding = "packetaddr"
+	default:
+		options.PacketEncoding = packetEncoding
+	}
+	options.TLS, err = d.security("none")
+	if err != nil {
+		return nil, err
+	}
+	options.Transport, err = d.transport(options.TLS)
+	if err != nil {
+		return nil, err
+	}
+	return options, nil
+}
diff --git a/common/sharelink/xhttp.go b/common/sharelink/xhttp.go
new file mode 100644
index 000000000..ebdb330c0
--- /dev/null
+++ b/common/sharelink/xhttp.go
@@ -0,0 +1,499 @@
+package sharelink
+
+import (
+	"net/url"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/json"
+	"github.com/sagernet/sing/common/json/badoption"
+)
+
+// The settings of XHTTP as Xray writes them (infra/conf, v26.9.9). A link
+// carries them as JSON in the "extra" parameter.
+type xraySplitHTTP struct {
+	Host                 string                  `json:"host"`
+	Path                 string                  `json:"path"`
+	Mode                 string                  `json:"mode"`
+	Headers              map[string]string       `json:"headers"`
+	XPaddingBytes        *option.V2RayXHTTPRange `json:"xPaddingBytes"`
+	XPaddingObfsMode     bool                    `json:"xPaddingObfsMode"`
+	XPaddingKey          string                  `json:"xPaddingKey"`
+	XPaddingHeader       string                  `json:"xPaddingHeader"`
+	XPaddingPlacement    string                  `json:"xPaddingPlacement"`
+	XPaddingMethod       string                  `json:"xPaddingMethod"`
+	UplinkHTTPMethod     string                  `json:"uplinkHTTPMethod"`
+	SessionIDPlacement   string                  `json:"sessionIDPlacement"`
+	SessionIDKey         string                  `json:"sessionIDKey"`
+	SessionIDTable       string                  `json:"sessionIDTable"`
+	SessionIDLength      *option.V2RayXHTTPRange `json:"sessionIDLength"`
+	SeqPlacement         string                  `json:"seqPlacement"`
+	SeqKey               string                  `json:"seqKey"`
+	UplinkDataPlacement  string                  `json:"uplinkDataPlacement"`
+	UplinkDataKey        string                  `json:"uplinkDataKey"`
+	UplinkChunkSize      *option.V2RayXHTTPRange `json:"uplinkChunkSize"`
+	NoGRPCHeader         bool                    `json:"noGRPCHeader"`
+	NoSSEHeader          bool                    `json:"noSSEHeader"`
+	ScMaxEachPostBytes   *option.V2RayXHTTPRange `json:"scMaxEachPostBytes"`
+	ScMinPostsIntervalMs *option.V2RayXHTTPRange `json:"scMinPostsIntervalMs"`
+	ScMaxBufferedPosts   int64                   `json:"scMaxBufferedPosts"`
+	ScStreamUpServerSecs *option.V2RayXHTTPRange `json:"scStreamUpServerSecs"`
+	ServerMaxHeaderBytes int32                   `json:"serverMaxHeaderBytes"`
+	Xmux                 json.RawMessage         `json:"xmux"`
+	DownloadSettings     json.RawMessage         `json:"downloadSettings"`
+	Extra                json.RawMessage         `json:"extra"`
+
+	// The names of the session settings before Xray v26.6.22; some panels
+	// still write them, alone or next to the new ones.
+	SessionPlacement string `json:"sessionPlacement"`
+	SessionKey       string `json:"sessionKey"`
+	// Settings Xray has dropped, still written by Marzban.
+	ScMaxConcurrentPosts json.RawMessage `json:"scMaxConcurrentPosts"`
+	KeepAlivePeriod      json.RawMessage `json:"keepAlivePeriod"`
+}
+
+type xrayXmux struct {
+	MaxConcurrency   *option.V2RayXHTTPRange `json:"maxConcurrency"`
+	MaxConnections   *option.V2RayXHTTPRange `json:"maxConnections"`
+	CMaxReuseTimes   *option.V2RayXHTTPRange `json:"cMaxReuseTimes"`
+	HMaxRequestTimes *option.V2RayXHTTPRange `json:"hMaxRequestTimes"`
+	HMaxReusableSecs *option.V2RayXHTTPRange `json:"hMaxReusableSecs"`
+	HKeepAlivePeriod int64                   `json:"hKeepAlivePeriod"`
+}
+
+type xrayStream struct {
+	Address           string          `json:"address"`
+	Port              uint16          `json:"port"`
+	Network           string          `json:"network"`
+	Security          string          `json:"security"`
+	TLSSettings       json.RawMessage `json:"tlsSettings"`
+	REALITYSettings   json.RawMessage `json:"realitySettings"`
+	XHTTPSettings     json.RawMessage `json:"xhttpSettings"`
+	SplitHTTPSettings json.RawMessage `json:"splithttpSettings"`
+}
+
+type xrayTLS struct {
+	AllowInsecure bool           `json:"allowInsecure"`
+	ServerName    string         `json:"serverName"`
+	ALPN          xrayStringList `json:"alpn"`
+	Fingerprint   string         `json:"fingerprint"`
+}
+
+type xrayREALITY struct {
+	Fingerprint string `json:"fingerprint"`
+	ServerName  string `json:"serverName"`
+	Password    string `json:"password"`
+	PublicKey   string `json:"publicKey"`
+	ShortID     string `json:"shortId"`
+	SpiderX     string `json:"spiderX"`
+}
+
+// xrayStringList is a list written as an array or as one comma separated string.
+type xrayStringList []string
+
+func (l *xrayStringList) UnmarshalJSON(content []byte) error {
+	var list []string
+	if err := json.Unmarshal(content, &list); err == nil {
+		*l = list
+		return nil
+	}
+	var value string
+	if err := json.Unmarshal(content, &value); err != nil {
+		return err
+	}
+	*l = splitList(value)
+	return nil
+}
+
+// readObject reads a JSON object into the Xray structure and reports the keys
+// the structure does not have: Xray ignores them, and so does the link, but a
+// setting silently dropped is how a link "does not work" with no reason shown.
+//
+// It returns the keys the object has, in lower case.
+func (d *decoder) readObject(name string, content []byte, target any) (map[string]bool, error) {
+	err := json.Unmarshal(content, target)
+	if err != nil {
+		return nil, E.New("read ", name, ": ", plainJSONError(err))
+	}
+	var keys map[string]json.RawMessage
+	err = json.Unmarshal(content, &keys)
+	if err != nil {
+		return nil, E.New("read ", name, ": ", plainJSONError(err))
+	}
+	present := make(map[string]bool, len(keys))
+	for key := range keys {
+		present[strings.ToLower(key)] = true
+	}
+	known := make(map[string]bool)
+	targetType := reflect.TypeOf(target).Elem()
+	for i := 0; i < targetType.NumField(); i++ {
+		known[strings.ToLower(targetType.Field(i).Tag.Get("json"))] = true
+	}
+	var unknown []string
+	for key := range keys {
+		if !known[strings.ToLower(key)] {
+			unknown = append(unknown, key)
+		}
+	}
+	sort.Strings(unknown)
+	odd := false
+	for _, key := range unknown {
+		// a key is as free a text as the name of a parameter is
+		if !plainName(key) {
+			odd = true
+			continue
+		}
+		d.warn(name, ": ", key, " is not supported and is ignored")
+	}
+	if odd {
+		d.warn(name, ": a key that is not a name is ignored")
+	}
+	return present, nil
+}
+
+// plainJSONError drops from an error of the JSON decoder the names of this
+// package's types and the value it could not read: a link is a secret, and a
+// second link glued to it would be a part of that value.
+func plainJSONError(err error) string {
+	message := err.Error()
+	if strings.Contains(message, "Go value of type ") {
+		return "not a JSON object"
+	}
+	for _, marker := range []string{"invalid range", "range out of bounds", "not a whole number"} {
+		if strings.Contains(message, marker) {
+			return marker
+		}
+	}
+	const marker = "Go struct field "
+	if index := strings.Index(message, marker); index >= 0 {
+		field := message[index+len(marker):]
+		if dot := strings.IndexByte(field, '.'); dot >= 0 {
+			field = field[dot+1:]
+		}
+		if space := strings.IndexByte(field, ' '); space >= 0 {
+			field = field[:space]
+		}
+		return field + " has a value of the wrong type"
+	}
+	return strings.TrimPrefix(message, "json: ")
+}
+
+func (d *decoder) xhttp() (*option.V2RayXHTTPOptions, error) {
+	settings := new(xraySplitHTTP)
+	var present map[string]bool
+	if extra := strings.TrimSpace(d.query["extra"]); extra != "" {
+		// escaped twice by some panels and clients
+		if strings.HasPrefix(extra, "%7B") || strings.HasPrefix(extra, "%7b") {
+			if decoded, err := url.QueryUnescape(extra); err == nil {
+				extra = decoded
+			}
+		}
+		var err error
+		present, err = d.readObject("extra", []byte(extra), settings)
+		if err != nil {
+			return nil, err
+		}
+	}
+	// As in Xray, these three always come from the link itself, also when the
+	// link leaves them empty and "extra" has them. v2rayA names the mode its
+	// own way.
+	settings.Host, settings.Path, settings.Mode = d.query["host"], d.query["path"], d.first("mode", "xhttpmode")
+	// 3x-ui repeats the padding outside of "extra" under this name
+	if !present["xpaddingbytes"] && d.query["x_padding_bytes"] != "" {
+		settings.XPaddingBytes = new(option.V2RayXHTTPRange)
+		err := settings.XPaddingBytes.UnmarshalJSON([]byte(strconv.Quote(d.query["x_padding_bytes"])))
+		if err != nil {
+			return nil, E.New("invalid range in the link parameter x_padding_bytes")
+		}
+	}
+	err := d.flatSettings(settings, present)
+	if err != nil {
+		return nil, err
+	}
+	hasDownload := len(settings.DownloadSettings) > 0 && string(settings.DownloadSettings) != "null"
+	if hasDownload && settings.Mode == "stream-one" {
+		// as Xray: one request cannot have its download elsewhere
+		return nil, E.New("downloadSettings cannot be used with the stream-one mode")
+	}
+	options := &option.V2RayXHTTPOptions{Mode: settings.Mode}
+	options.V2RayXHTTPBaseOptions, err = d.xhttpBase("extra", settings)
+	if err != nil {
+		return nil, err
+	}
+	if hasDownload {
+		download, err := d.xhttpDownload(settings.DownloadSettings)
+		if err != nil {
+			return nil, err
+		}
+		options.Download = download
+	}
+	return options, nil
+}
+
+func nonZero(value *option.V2RayXHTTPRange) *option.V2RayXHTTPRange {
+	// zero is "the default" for every range of Xray's
+	if value == nil || (value.From == 0 && value.To == 0) {
+		return nil
+	}
+	return value
+}
+
+// flatKeys are the settings of XHTTP some generators (3x-ui's panel among
+// them) also write as parameters of the link, under Xray's names: the plain
+// values, not the objects.
+var flatKeys = func() map[string]int {
+	keys := make(map[string]int)
+	settingsType := reflect.TypeOf(xraySplitHTTP{})
+	for i := 0; i < settingsType.NumField(); i++ {
+		field := settingsType.Field(i)
+		switch field.Name {
+		case "Host", "Path", "Mode", "Extra", "ScMaxConcurrentPosts", "KeepAlivePeriod":
+			continue
+		}
+		switch field.Type.Kind() {
+		case reflect.String, reflect.Bool, reflect.Int32, reflect.Int64, reflect.Pointer:
+			key := strings.ToLower(field.Tag.Get("json"))
+			keys[key] = i
+			knownKeys[key] = true
+		}
+	}
+	return keys
+}()
+
+// The session settings have an older name each; one of a pair set in "extra"
+// settles both.
+var sameSetting = map[string]string{
+	"sessionplacement": "sessionidplacement", "sessionidplacement": "sessionplacement",
+	"sessionkey": "sessionidkey", "sessionidkey": "sessionkey",
+}
+
+// flatSettings fills what "extra" does not mention from the parameters of the
+// link: a setting "extra" has, also as false or empty, is settled there.
+func (d *decoder) flatSettings(settings *xraySplitHTTP, present map[string]bool) error {
+	value := reflect.ValueOf(settings).Elem()
+	keys := make([]string, 0, len(flatKeys))
+	for key := range flatKeys {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	for _, key := range keys {
+		text := d.query[key]
+		field := value.Field(flatKeys[key])
+		if text == "" || present[key] || present[sameSetting[key]] {
+			continue
+		}
+		switch field.Kind() {
+		case reflect.String:
+			field.SetString(text)
+		case reflect.Bool:
+			field.SetBool(isTrue(text))
+		case reflect.Int32, reflect.Int64:
+			number, err := strconv.ParseInt(text, 10, 32)
+			if err != nil {
+				return E.New("invalid number in the link parameter ", key)
+			}
+			field.SetInt(number)
+		case reflect.Pointer:
+			valueRange := new(option.V2RayXHTTPRange)
+			err := valueRange.UnmarshalJSON([]byte(strconv.Quote(text)))
+			if err != nil {
+				return E.New("invalid range in the link parameter ", key)
+			}
+			field.Set(reflect.ValueOf(valueRange))
+		}
+	}
+	return nil
+}
+
+func (d *decoder) xhttpBase(name string, settings *xraySplitHTTP) (option.V2RayXHTTPBaseOptions, error) {
+	options := option.V2RayXHTTPBaseOptions{
+		Host:                 settings.Host,
+		Path:                 settings.Path,
+		XPaddingBytes:        nonZero(settings.XPaddingBytes),
+		XPaddingObfsMode:     settings.XPaddingObfsMode,
+		XPaddingKey:          settings.XPaddingKey,
+		XPaddingHeader:       settings.XPaddingHeader,
+		XPaddingPlacement:    settings.XPaddingPlacement,
+		XPaddingMethod:       settings.XPaddingMethod,
+		UplinkHTTPMethod:     settings.UplinkHTTPMethod,
+		SessionPlacement:     settings.SessionIDPlacement,
+		SessionKey:           settings.SessionIDKey,
+		SessionIDTable:       settings.SessionIDTable,
+		SessionIDLength:      nonZero(settings.SessionIDLength),
+		SeqPlacement:         settings.SeqPlacement,
+		SeqKey:               settings.SeqKey,
+		UplinkDataPlacement:  settings.UplinkDataPlacement,
+		UplinkDataKey:        settings.UplinkDataKey,
+		UplinkChunkSize:      nonZero(settings.UplinkChunkSize),
+		NoGRPCHeader:         settings.NoGRPCHeader,
+		ScMaxEachPostBytes:   nonZero(settings.ScMaxEachPostBytes),
+		ScMinPostsIntervalMs: nonZero(settings.ScMinPostsIntervalMs),
+		NoSSEHeader:          settings.NoSSEHeader,
+		ScMaxBufferedPosts:   settings.ScMaxBufferedPosts,
+		ScStreamUpServerSecs: nonZero(settings.ScStreamUpServerSecs),
+		ServerMaxHeaderBytes: int(settings.ServerMaxHeaderBytes),
+	}
+	if options.SessionPlacement == "" {
+		options.SessionPlacement = settings.SessionPlacement
+	}
+	if options.SessionKey == "" {
+		options.SessionKey = settings.SessionKey
+	}
+	if len(settings.Headers) > 0 {
+		headers := make(badoption.HTTPHeader)
+		// in the order of the names: with several spellings of Host the result
+		// must not depend on the order of a map
+		names := make([]string, 0, len(settings.Headers))
+		for key := range settings.Headers {
+			names = append(names, key)
+		}
+		sort.Strings(names)
+		for _, key := range names {
+			value := settings.Headers[key]
+			// Xray refuses a Host among the headers; panels put it there for
+			// the lack of a host of their own
+			if strings.EqualFold(key, "Host") {
+				if options.Host == "" {
+					options.Host = value
+				} else if options.Host != value {
+					d.warn(name, ": the Host header is ignored, the host of the link is used", shown(options.Host))
+				}
+				continue
+			}
+			headers[key] = badoption.Listable[string]{value}
+		}
+		if len(headers) > 0 {
+			options.Headers = headers
+		}
+	}
+	if len(settings.Xmux) > 0 && string(settings.Xmux) != "null" {
+		xmux := new(xrayXmux)
+		_, err := d.readObject(name+".xmux", settings.Xmux, xmux)
+		if err != nil {
+			return options, err
+		}
+		xmuxOptions := option.V2RayXHTTPXmuxOptions{
+			MaxConcurrency:   nonZero(xmux.MaxConcurrency),
+			MaxConnections:   nonZero(xmux.MaxConnections),
+			CMaxReuseTimes:   nonZero(xmux.CMaxReuseTimes),
+			HMaxRequestTimes: nonZero(xmux.HMaxRequestTimes),
+			HMaxReusableSecs: nonZero(xmux.HMaxReusableSecs),
+			HKeepAlivePeriod: xmux.HKeepAlivePeriod,
+		}
+		if xmuxOptions != (option.V2RayXHTTPXmuxOptions{}) {
+			options.Xmux = &xmuxOptions
+		}
+	}
+	return options, nil
+}
+
+// xhttpDownload reads "downloadSettings": a whole stream configuration of
+// Xray's, with the address of the server the download half goes to.
+func (d *decoder) xhttpDownload(content []byte) (*option.V2RayXHTTPDownloadOptions, error) {
+	const name = "downloadSettings"
+	stream := new(xrayStream)
+	_, err := d.readObject(name, content, stream)
+	if err != nil {
+		return nil, err
+	}
+	stream.Address = strings.TrimSuffix(strings.TrimPrefix(stream.Address, "["), "]")
+	stream.Network, stream.Security = strings.ToLower(stream.Network), strings.ToLower(stream.Security)
+	if stream.Address == "" {
+		return nil, E.New(name, ": missing address")
+	}
+	if stream.Port == 0 {
+		return nil, E.New(name, ": missing port")
+	}
+	switch stream.Network {
+	case "", "xhttp", "splithttp":
+	default:
+		return nil, E.New(name, ": unsupported network", shown(stream.Network))
+	}
+	options := &option.V2RayXHTTPDownloadOptions{
+		ServerOptions: option.ServerOptions{Server: stream.Address, ServerPort: stream.Port},
+	}
+	switch stream.Security {
+	case "", "none":
+	case "tls":
+		tlsSettings := new(xrayTLS)
+		if len(stream.TLSSettings) > 0 {
+			_, err = d.readObject(name+".tlsSettings", stream.TLSSettings, tlsSettings)
+			if err != nil {
+				return nil, err
+			}
+		}
+		options.TLS = &option.OutboundTLSOptions{
+			Enabled:    true,
+			ServerName: tlsSettings.ServerName,
+			Insecure:   tlsSettings.AllowInsecure,
+			ALPN:       badoption.Listable[string](tlsSettings.ALPN),
+		}
+		options.TLS.UTLS, err = d.utlsOf(tlsSettings.Fingerprint, false)
+		if err != nil {
+			return nil, E.Cause(err, name)
+		}
+	case "reality":
+		realitySettings := new(xrayREALITY)
+		if len(stream.REALITYSettings) > 0 {
+			_, err = d.readObject(name+".realitySettings", stream.REALITYSettings, realitySettings)
+			if err != nil {
+				return nil, err
+			}
+		}
+		// "password" is the name of the public key since Xray v25.x
+		publicKey := realitySettings.Password
+		if publicKey == "" {
+			publicKey = realitySettings.PublicKey
+		}
+		if publicKey == "" {
+			return nil, E.New(name, ": missing REALITY public key")
+		}
+		utls, err := d.utlsOf(realitySettings.Fingerprint, true)
+		if err != nil {
+			return nil, E.Cause(err, name)
+		}
+		options.TLS = &option.OutboundTLSOptions{
+			Enabled:    true,
+			ServerName: realitySettings.ServerName,
+			UTLS:       utls,
+			Reality:    &option.OutboundRealityOptions{Enabled: true, PublicKey: publicKey, ShortID: realitySettings.ShortID},
+		}
+	default:
+		return nil, E.New(name, ": unsupported security", shown(stream.Security))
+	}
+	content = stream.XHTTPSettings
+	if len(content) == 0 || string(content) == "null" {
+		content = stream.SplitHTTPSettings
+	}
+	settings := new(xraySplitHTTP)
+	if len(content) > 0 && string(content) != "null" {
+		_, err = d.readObject(name+".xhttpSettings", content, settings)
+		if err != nil {
+			return nil, err
+		}
+		// "extra" replaces everything but the host, the path and the mode
+		if len(settings.Extra) > 0 && string(settings.Extra) != "null" {
+			inner := new(xraySplitHTTP)
+			_, err = d.readObject(name+".xhttpSettings.extra", settings.Extra, inner)
+			if err != nil {
+				return nil, err
+			}
+			inner.Host, inner.Path, inner.Mode = settings.Host, settings.Path, settings.Mode
+			settings = inner
+		}
+	}
+	// The download leg sends GETs only: what says how uploads go is not its.
+	settings.UplinkHTTPMethod, settings.UplinkDataPlacement, settings.UplinkDataKey, settings.UplinkChunkSize = "", "", "", nil
+	if len(settings.DownloadSettings) > 0 && string(settings.DownloadSettings) != "null" {
+		d.warn(name, ": nested downloadSettings are ignored")
+	}
+	options.V2RayXHTTPBaseOptions, err = d.xhttpBase(name+".xhttpSettings", settings)
+	if err != nil {
+		return nil, err
+	}
+	return options, nil
+}
