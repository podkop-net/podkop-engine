+	for outboundType, optionsType := range optionTypes {
+		leaves := make(map[string]string)
+		optionLeaves(optionsType, "", "", leaves, 0)
+		require.NotEmpty(t, leaves, outboundType)
+		for path, class := range leaves {
+			lines = append(lines, outboundType+" "+path+" "+class)
+			if strings.HasSuffix(path, "_path") && !strings.HasSuffix(path, "tcp_multi_path") {
+				require.True(t, strings.HasPrefix(class, "denied"), "%s %s: a file", outboundType, path)
+			}
+		}
+	}
+	sort.Strings(lines)
+	got := strings.Join(lines, "\n") + "\n"
+	file := "testdata/options-" + line + ".txt"
+	want, err := os.ReadFile(file)
+	if err != nil || string(want) != got {
+		t.Logf("the options of this line, for %s:\n==== BEGIN OPTIONS\n%s==== END OPTIONS", file, got)
+		t.Fatalf("%s is not the list of options of this line (see the log for the list)", file)
+	}
+	// a path of the list that is for a link to set is taken by the decoder
+	require.Contains(t, got, C.TypeVLESS+" tls.fragment sb\n")
+	require.Contains(t, got, C.TypeVLESS+" detour denied: another object\n")
+}
diff --git a/common/sharelink/link.go b/common/sharelink/link.go
new file mode 100644
index 000000000..45f49b6b5
--- /dev/null
+++ b/common/sharelink/link.go
@@ -0,0 +1,635 @@
+// Package sharelink turns share links of proxy servers ("vless://...") into
+// the options of sing-box outbounds.
+//
+// There is no single specification of these links. The VLESS and Trojan forms
+// follow the proposal the Xray project keeps (XTLS/Xray-core discussion #716)
+// and the links the common panels generate; where the generators disagree, the
+// behaviour of Xray-core decides.
+package sharelink
+
+import (
+	"encoding/json"
+	"errors"
+	"net/url"
+	"sort"
+	"strconv"
+	"strings"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/protocol/vless/encryption"
+	"github.com/sagernet/sing-box/transport/sip003"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// Outbound is a decoded link: an outbound of the given type with its options,
+// tagged with the name the link carries.
+type Outbound struct {
+	Type string
+	Tag  string
+	// the options as the configuration writes them, without the type and the tag
+	options *object
+}
+
+// MarshalJSON gives the outbound as an object of the "outbounds" list.
+func (o Outbound) MarshalJSON() ([]byte, error) {
+	whole := newObject()
+	whole.put("type", o.Type)
+	if o.Tag != "" {
+		whole.put("tag", o.Tag)
+	}
+	if o.options != nil {
+		for _, key := range o.options.keys {
+			whole.put(key, o.options.values[key])
+		}
+	}
+	return whole.MarshalJSON()
+}
+
+// Refusal is the error of a link that asks for what sing-box cannot do, where the server
+// cannot be reached without it. ID names the rule (see the policy table).
+type Refusal struct {
+	ID      string
+	message string
+}
+
+func (r *Refusal) Error() string {
+	return r.message
+}
+
+func refuse(id string, message ...any) error {
+	return &Refusal{ID: id, message: E.New(message...).Error()}
+}
+
+// A scheme is a kind of share link.
+type scheme struct {
+	// the type of the outbound the link makes
+	outbound string
+	// decode reads the link into the options of the outbound
+	decode func(d *decoder) (any, error)
+	// the link is not "user@host:port?parameters#name": decode takes it whole
+	opaque bool
+}
+
+var schemes map[string]scheme
+
+func init() {
+	schemes = map[string]scheme{
+		"vless":       {outbound: C.TypeVLESS, decode: (*decoder).vless},
+		"trojan":      {outbound: C.TypeTrojan, decode: (*decoder).trojan},
+		"ss":          {outbound: C.TypeShadowsocks, decode: (*decoder).shadowsocks},
+		"socks":       {outbound: C.TypeSOCKS, decode: (*decoder).socks},
+		"socks4":      {outbound: C.TypeSOCKS, decode: (*decoder).socks},
+		"socks4a":     {outbound: C.TypeSOCKS, decode: (*decoder).socks},
+		"socks5":      {outbound: C.TypeSOCKS, decode: (*decoder).socks},
+		"socks5h":     {outbound: C.TypeSOCKS, decode: (*decoder).socks},
+		"hysteria2":   {outbound: C.TypeHysteria2, decode: (*decoder).hysteria2},
+		"hy2":         {outbound: C.TypeHysteria2, decode: (*decoder).hysteria2},
+		"tuic":        {outbound: C.TypeTUIC, decode: (*decoder).tuic},
+		"vmess":       {outbound: C.TypeVMess, decode: (*decoder).vmess, opaque: true},
+		"http":        {outbound: C.TypeHTTP, decode: (*decoder).httpProxy},
+		"https":       {outbound: C.TypeHTTP, decode: (*decoder).httpProxy},
+		"hysteria":    {outbound: C.TypeHysteria, decode: (*decoder).hysteria},
+		"anytls":      {outbound: C.TypeAnyTLS, decode: (*decoder).anytls},
+		"naive+https": {outbound: C.TypeNaive, decode: (*decoder).naive},
+		"naive+quic":  {outbound: C.TypeNaive, decode: (*decoder).naive},
+	}
+}
+
+// Schemes lists the kinds of links the decoder reads, each with the type of the outbound
+// it makes.
+func Schemes() map[string]string {
+	list := make(map[string]string, len(schemes))
+	for name, linkScheme := range schemes {
+		list[name] = linkScheme.outbound
+	}
+	return list
+}
+
+// The outbound types that are configured as an outbound and not as a link: nothing
+// generates links for them, and what they need (a second outbound, local files, host
+// keys) is not for a link to say.
+var noLinkForm = map[string]bool{
+	"tor": true, "ssh": true, "shadowtls": true, "snell": true,
+}
+
+// Decode reads one share link. The warnings name what the link asks for and
+// the outbound cannot do, where the connection is still expected to work.
+func Decode(link string) (*Outbound, []string, error) {
+	link = strings.TrimSpace(strings.TrimPrefix(link, "\ufeff"))
+	schemeName, rest, found := strings.Cut(link, "://")
+	if !found || schemeName == "" || strings.ContainsAny(schemeName, " \t@?#/&=") {
+		return nil, nil, E.New("not a share link")
+	}
+	schemeName = strings.ToLower(schemeName)
+	linkScheme, known := schemes[schemeName]
+	if !known {
+		if noLinkForm[schemeName] {
+			return nil, nil, refuse("no-link-form", "a ", schemeName, " outbound has no link form, configure it as an outbound")
+		}
+		return nil, nil, E.New("unsupported link type", shown(schemeName))
+	}
+	d := &decoder{scheme: schemeName, known: make(map[string]bool)}
+	if linkScheme.opaque {
+		d.body = rest
+	} else {
+		err := d.split(rest)
+		if err != nil {
+			return nil, nil, err
+		}
+	}
+	typed, err := linkScheme.decode(d)
+	if err != nil {
+		return nil, nil, err
+	}
+	options, err := objectOf(typed)
+	if err != nil {
+		// an option that refuses its value when it is written (an obfuscation of a kind
+		// this sing-box does not have): what it says, without the types on the way
+		for cause := errors.Unwrap(err); cause != nil; cause = errors.Unwrap(cause) {
+			err = cause
+		}
+		return nil, nil, err
+	}
+	err = d.fallback(linkScheme.outbound, options)
+	if err != nil {
+		return nil, nil, err
+	}
+	err = consistent(linkScheme.outbound, options)
+	if err != nil {
+		return nil, nil, err
+	}
+	var unknown []string
+	for key := range d.query {
+		if !knownKeys[key] && !d.known[key] && key != "" {
+			unknown = append(unknown, d.names[key])
+		}
+	}
+	sort.Strings(unknown)
+	for _, key := range unknown {
+		d.warn(key, " is not supported and is ignored")
+	}
+	return &Outbound{Type: linkScheme.outbound, Tag: strings.TrimSpace(d.tag), options: options}, d.warnings, nil
+}
+
+// consistent refuses what the options of an outbound say together and none says alone.
+// It looks at the outbound as it will be written, after the parameters with names of
+// their own and the ones that name options by their paths: both can set a flow, a
+// transport or TLS.
+func consistent(outboundType string, options *object) error {
+	if spoof, _ := options.at("tls.spoof"); spoof != nil && spoof != "" {
+		// the forged ClientHello is sent on an established connection, before the real
+		// one; with TCP Fast Open the real one leaves with the connection attempt
+		if fastOpen, _ := options.at("tcp_fast_open"); fastOpen == true {
+			return refuse("spoof-fast-open", "tls.spoof does not work with tcp_fast_open")
+		}
+	}
+	switch outboundType {
+	case C.TypeShadowsocks:
+		return checkPlugin(options)
+	case C.TypeHysteria, C.TypeHysteria2:
+		return checkServerPorts(options)
+	}
+	if outboundType != C.TypeVLESS {
+		return nil
+	}
+	// VLESS Encryption, from the parameter of the link or set by its path: a setting Xray
+	// would not take is not passed on
+	encryptionSetting := options.text("encryption")
+	if encryptionSetting == "none" {
+		encryptionSetting = ""
+	}
+	if encryptionSetting != "" {
+		_, err := encryption.NewClient(encryptionSetting)
+		if err != nil {
+			return refuse("vless-encryption", "invalid VLESS encryption: ", err.Error())
+		}
+	}
+	flow := options.text("flow")
+	if flow == "" {
+		return nil
+	}
+	// set by its path a flow is any text, and so is the type of a transport: neither is
+	// repeated as it is
+	if flow != "xtls-rprx-vision" {
+		return refuse("flow", "unsupported flow", shown(flow))
+	}
+	if encryptionSetting != "" {
+		// with VLESS Encryption Vision works on that layer, over any transport and
+		// without TLS, as in Xray
+		return nil
+	}
+	if transport, hasTransport := options.values["transport"].(*object); hasTransport && transport.text("type") != "" {
+		// Vision works on the TLS connection itself. Over ws, grpc and http sing-box has
+		// none to give it and fails every connection; over httpupgrade and xhttp an Xray
+		// server refuses the flow (over xhttp it takes one only with VLESS Encryption).
+		kind := transport.text("type")
+		if shown(kind) == "" {
+			kind = "this"
+		}
+		return refuse("flow-transport", "flow ", flow, " is not supported over the ", kind, " transport")
+	}
+	if enabled, _ := options.at("tls.enabled"); enabled != true {
+		return refuse("flow-no-tls", "flow ", flow, " needs TLS or REALITY")
+	}
+	return nil
+}
+
+// checkPlugin looks at the plugin of a Shadowsocks outbound, which has options of its own
+// in one string. v2ray-plugin reads the file its option "cert" names when the outbound is
+// built: a local file, as the options that end in _path are.
+func checkPlugin(options *object) error {
+	name, arguments := options.text("plugin"), options.text("plugin_opts")
+	if name == "" && arguments == "" {
+		return nil
+	}
+	if !plainWord(name) {
+		return E.New("the plugin of the link is not a name")
+	}
+	// read as sing-box reads them: an escaped name is the name
+	parsed, err := sip003.ParsePluginOptions(arguments)
+	if err != nil {
+		return E.New("the options of the plugin of the link cannot be read")
+	}
+	for _, denied := range deniedPluginOptions {
+		if _, named := parsed[denied]; named {
+			return refuse("sb-denied", "the plugin option ", denied, " is not for a link to set: a local file")
+		}
+	}
+	return nil
+}
+
+// The options of the plugins of sing-box that name local files. pluginOptions is every
+// option they read: a test fails when sing-box gets one that is in neither list.
+var (
+	deniedPluginOptions = []string{"cert"}
+	pluginOptions       = []string{"tls", "cert", "certRaw", "mode", "host", "path", "mux", "obfs", "obfs-host"}
+)
+
+// checkServerPorts bounds the ports a Hysteria outbound hops over. sing-box writes the
+// ranges out port by port when it builds the outbound, and a list may repeat a range as
+// many times as a link is long.
+func checkServerPorts(options *object) error {
+	value, _ := options.at("server_ports")
+	var ranges []string
+	switch value := value.(type) {
+	case string:
+		ranges = []string{value}
+	case []any:
+		for _, item := range value {
+			if text, isText := item.(string); isText {
+				ranges = append(ranges, text)
+			}
+		}
+	}
+	total := 0
+	for _, item := range ranges {
+		from, to, isRange := strings.Cut(item, ":")
+		if !isRange {
+			to = from
+		}
+		// as sing-box reads a range: without its first port it begins at 0, without its
+		// last one it ends at 65535
+		if isRange && from == "" {
+			from = "0"
+		}
+		if isRange && to == "" {
+			to = "65535"
+		}
+		low, lowErr := strconv.ParseUint(from, 10, 16)
+		high, highErr := strconv.ParseUint(to, 10, 16)
+		if lowErr != nil || highErr != nil || high < low {
+			return E.New("invalid port in the list of ports")
+		}
+		total += int(high-low) + 1
+		if total > 65535 {
+			return refuse("ports", "the list of ports names more ports than there are")
+		}
+	}
+	return nil
+}
+
+// Secrets lists what the outbound has that a message must not repeat: the user, the
+// passwords and the keys the link carries.
+func (o *Outbound) Secrets() []string {
+	var secrets []string
+	var walk func(node *object)
+	walk = func(node *object) {
+		for _, key := range node.keys {
+			switch value := node.values[key].(type) {
+			case *object:
+				walk(value)
+			case string:
+				switch key {
+				case "uuid", "password", "auth_str", "username", "private_key", "pre_shared_key", "obfs", "plugin_opts":
+					if len(value) >= 4 {
+						secrets = append(secrets, value)
+					}
+				}
+			}
+		}
+	}
+	if o.options != nil {
+		walk(o.options)
+	}
+	return secrets
+}
+
+// Unplain lists the values of the outbound that are not plain names: free text of the
+// link, which a message is not to repeat either.
+func (o *Outbound) Unplain() []string {
+	var texts []string
+	var walk func(value any)
+	walk = func(value any) {
+		switch value := value.(type) {
+		case *object:
+			for _, key := range value.keys {
+				walk(value.values[key])
+			}
+		case []any:
+			for _, item := range value {
+				walk(item)
+			}
+		case string:
+			if len(value) >= 4 && !plainWord(value) {
+				texts = append(texts, value)
+			}
+		}
+	}
+	if o.options != nil {
+		walk(o.options)
+	}
+	return texts
+}
+
+// split takes the name ("#...") and the parameters ("?...") off a link that is a URL.
+func (d *decoder) split(rest string) error {
+	if index := strings.IndexByte(rest, '#'); index >= 0 {
+		d.tag = rest[index+1:]
+		// a name is free text, often with a stray "%"
+		if decoded, err := url.PathUnescape(d.tag); err == nil {
+			d.tag = decoded
+		}
+		rest = rest[:index]
+	}
+	var rawQuery string
+	if index := strings.IndexByte(rest, '?'); index >= 0 {
+		rawQuery = rest[index+1:]
+		rest = rest[:index]
+	}
+	// Two links on one line would read as one, with the first as its user.
+	if strings.ContainsAny(rest, " \t\r\n") || strings.Contains(rest, "://") {
+		return E.New("the address of the link contains a space or another link")
+	}
+	var (
+		odd bool
+		err error
+	)
+	d.query, d.names, odd, err = parseQuery(rawQuery)
+	if err != nil {
+		return err
+	}
+	if odd {
+		d.warn("a link parameter whose name is not a name is ignored")
+	}
+	// The same for a link after the last parameter: its user would end up in
+	// that parameter, and in an error message about it.
+	for key, value := range d.query {
+		if key == "ech" {
+			// a name and a resolver joined with "+", which form decoding reads as a space
+			continue
+		}
+		if key == "extra" && json.Valid([]byte(value)) {
+			// JSON may hold both in its texts, a browser's User-Agent and a Referer;
+			// a link after it is no JSON
+			continue
+		}
+		if strings.Contains(value, "://") && strings.ContainsAny(value, " \t\r\n") {
+			return E.New("the link parameter ", d.names[key], " contains a space and another link")
+		}
+	}
+	d.body = rest
+	return nil
+}
+
+type decoder struct {
+	scheme string
+	// the link between "://" and its parameters, or all of it after "://" for a scheme
+	// that is not a URL
+	body string
+	tag  string
+	// the parameters by their names in lower case, and the names as the link writes them
+	query map[string]string
+	names map[string]string
+	// the parameters the scheme reads
+	known    map[string]bool
+	warnings []string
+}
+
+// reads marks the parameters the scheme reads: any other gets a warning.
+func (d *decoder) reads(keys ...string) {
+	for _, key := range keys {
+		d.known[key] = true
+	}
+}
+
+func (d *decoder) warn(message ...any) {
+	d.warnings = append(d.warnings, E.New(message...).Error())
+}
+
+// shown gives a value of the link for an error message, as ": value", when it
+// is a plain word. Anything else may be a piece of the link that landed in
+// the wrong place, its user or password included, and is left out: a link is
+// a secret, and error messages end up in logs.
+func shown(value string) string {
+	if value == "" || len(value) > 24 {
+		return ""
+	}
+	for _, c := range []byte(value) {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '_' || c == '.') {
+			return ""
+		}
+	}
+	return ": " + value
+}
+
+// plainWord tells whether a value of a link that an error of sing-box may quote is a
+// name and nothing else: letters, digits, "-", "_" and ".", forty at most. A user of a
+// link that is not of the shape its scheme has may be a password in the place of a name.
+func plainWord(value string) bool {
+	if value == "" || len(value) > 40 {
+		return false
+	}
+	for _, c := range []byte(value) {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '_' || c == '.') {
+			return false
+		}
+	}
+	return true
+}
+
+// isHex tells whether text is hexadecimal digits only.
+func isHex(text string) bool {
+	for _, c := range []byte(text) {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F') {
+			return false
+		}
+	}
+	return true
+}
+
+// isUUID tells whether text is a UUID as it is usually written, with or without dashes.
+func isUUID(text string) bool {
+	switch len(text) {
+	case 32:
+		return isHex(text)
+	case 36:
+		return text[8] == '-' && text[13] == '-' && text[18] == '-' && text[23] == '-' && isHex(strings.ReplaceAll(text, "-", "")) && strings.Count(text, "-") == 4
+	default:
+		return false
+	}
+}
+
+// parseQuery splits the query of a link. "+" is a space: the generators that
+// use form encoding (3x-ui, Marzban) write spaces that way, and those that
+// follow the proposal escape a real "+". The first of repeated keys wins.
+// The names are lowered, as the clients differ in their case ("allowInsecure",
+// "allowinsecure"), and lose the "amp;" of a link copied out of HTML.
+//
+// A parameter whose name is not a name (letters, digits, "-", "_", ".") is left out,
+// and odd tells that there was one: no parameter anything reads is named so, and the
+// messages repeat the names, while what stands in the place of a name may be anything,
+// a part of another link included.
+func parseQuery(rawQuery string) (values map[string]string, names map[string]string, odd bool, err error) {
+	values = make(map[string]string)
+	// the names as the link writes them, for the messages
+	names = make(map[string]string)
+	for _, pair := range strings.Split(rawQuery, "&") {
+		if pair == "" {
+			continue
+		}
+		rawKey, rawValue, _ := strings.Cut(pair, "=")
+		key, err := url.QueryUnescape(rawKey)
+		if err != nil {
+			return nil, nil, false, E.New("invalid escape in the name of a link parameter")
+		}
+		value, err := url.QueryUnescape(rawValue)
+		if err != nil {
+			return nil, nil, false, E.New("invalid escape in a link parameter", shown(key))
+		}
+		// the name as written, for the messages, and the key: both without the "amp;"
+		if len(key) >= len("amp;") && strings.EqualFold(key[:len("amp;")], "amp;") {
+			key = key[len("amp;"):]
+		}
+		if key != "" && !plainName(key) {
+			odd = true
+			continue
+		}
+		name := key
+		key = strings.ToLower(key)
+		if _, exists := values[key]; !exists {
+			values[key] = value
+			names[key] = name
+		}
+	}
+	return values, names, odd, nil
+}
+
+// plainName tells whether the name of a link parameter is a name and nothing else. The
+// longest ones are paths of options.
+func plainName(name string) bool {
+	if name == "" || len(name) > 128 {
+		return false
+	}
+	for _, c := range []byte(name) {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '_' || c == '.') {
+			return false
+		}
+	}
+	return true
+}
+
+// parseServer reads "userinfo@host:port", with anything after the port
+// ignored. The user is everything up to the last "@": a Trojan password is
+// often base64, with "/" and "=", and not always escaped.
+func parseServer(authority string) (string, option.ServerOptions, error) {
+	user, hasUser, server, _, err := parseAuthority(authority, 0)
+	if err != nil {
+		return "", option.ServerOptions{}, err
+	}
+	if !hasUser || user == "" {
+		return "", option.ServerOptions{}, E.New("missing user in the link")
+	}
+	return user, server, nil
+}
+
+// parseAuthority reads "[userinfo@]host[:port][/path]". A link without a port gets
+// defaultPort, when that is not zero. The port is returned as written too: some schemes
+// have a list of ports there.
+func parseAuthority(authority string, defaultPort uint16) (user string, hasUser bool, server option.ServerOptions, path string, err error) {
+	hostPort := authority
+	if index := strings.LastIndexByte(authority, '@'); index >= 0 {
+		hasUser = true
+		user, err = url.PathUnescape(authority[:index])
+		if err != nil {
+			return "", false, option.ServerOptions{}, "", E.New("invalid escape in the user of the link")
+		}
+		hostPort = authority[index+1:]
+	}
+	if slash := strings.IndexByte(hostPort, '/'); slash >= 0 {
+		path = hostPort[slash:]
+		hostPort = hostPort[:slash]
+	}
+	var host, port string
+	if strings.HasPrefix(hostPort, "[") {
+		end := strings.IndexByte(hostPort, ']')
+		if end < 0 {
+			return "", false, option.ServerOptions{}, "", E.New("invalid server address")
+		}
+		host = hostPort[1:end]
+		port = strings.TrimPrefix(hostPort[end+1:], ":")
+	} else {
+		host, port, _ = strings.Cut(hostPort, ":")
+	}
+	if host == "" || strings.ContainsAny(host, " \t@?#") {
+		return "", false, option.ServerOptions{}, "", E.New("invalid server address")
+	}
+	server.Server = host
+	if port == "" {
+		if defaultPort == 0 {
+			return "", false, option.ServerOptions{}, "", E.New("missing server port")
+		}
+		server.ServerPort = defaultPort
+		return user, hasUser, server, path, nil
+	}
+	portNumber, err := strconv.ParseUint(port, 10, 16)
+	if err != nil || portNumber == 0 {
+		return "", false, option.ServerOptions{}, "", E.New("invalid server port", shown(port))
+	}
+	server.ServerPort = uint16(portNumber)
+	return user, hasUser, server, path, nil
+}
+
+// first returns the first of the link parameters that is set.
+func (d *decoder) first(keys ...string) string {
+	for _, key := range keys {
+		if value := d.query[key]; value != "" {
+			return value
+		}
+	}
+	return ""
+}
+
+func isTrue(value string) bool {
+	return value == "1" || strings.EqualFold(value, "true")
+}
+
+func splitList(value string) []string {
+	var list []string
+	for _, item := range strings.Split(value, ",") {
+		if item = strings.TrimSpace(item); item != "" {
+			list = append(list, item)
+		}
+	}
+	return list
+}
diff --git a/common/sharelink/link_review2_test.go b/common/sharelink/link_review2_test.go
new file mode 100644
index 000000000..86c1dea40
--- /dev/null
+++ b/common/sharelink/link_review2_test.go
@@ -0,0 +1,198 @@
+package sharelink
+
+import (
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/stretchr/testify/require"
+)
+
+// What the second review of the decoder showed.
+
+// A parameter name with the "amp;" of a link copied out of HTML is the name without it,
+// in what it sets and in what is said of it: a path of an option is applied without a
+// word, and one a link may not set is refused as any other.
+func TestParameterNamesFromHTML(t *testing.T) {
+	t.Parallel()
+	content, warnings := decodeJSON(t, policyBase+"security=tls&amp;sb.tls.min_version=1.3&AMP;TFO=1&amp;fp=firefox")
+	require.Contains(t, content, `"min_version":"1.3"`)
+	require.Contains(t, content, `"tcp_fast_open":true`)
+	require.Contains(t, content, `"fingerprint":"firefox"`)
+	require.Empty(t, warnings)
+
+	require.Equal(t, "sb-denied", refusalID(t, policyBase+"security=tls&amp;sb.detour=other"))
+	require.Equal(t, "sb-unknown", refusalID(t, policyBase+"security=tls&amp;sb.no_such_option=1"))
+	_, warnings = decodeJSON(t, policyBase+"security=tls&amp;NoSuchName=1")
+	require.Equal(t, []string{"NoSuchName is not supported and is ignored"}, warnings)
+}
+
+// What stands in the place of a parameter name may be anything, another link included.
+// Such a parameter is left out, and no message repeats it.
+func TestParameterNamesThatAreNone(t *testing.T) {
+	t.Parallel()
+	const canary = "CANARY0f6d2c"
+	for name, parameter := range map[string]string{
+		"another link":      "vless://" + canary + "@h.example.org:443?type=ws",
+		"several lines":     "sb.tls.alpn%0Aerror%3A%20" + canary + "=h2",
+		"a path with space": "sb.transport.headers.X%20" + canary + "=1",
+		"a long one":        strings.Repeat("a", 129) + canary + "=1",
+		// a name that grows when lowered: found by the fuzzer
+		"not ASCII": "SB.%C4%B0=1",
+	} {
+		outbound, warnings, err := Decode(policyBase + "security=tls&" + parameter + "&fp=safari")
+		require.NoError(t, err, name)
+		require.Equal(t, "safari", optionsOf[option.OutboundTLSOptionsContainer](t, outbound).TLS.UTLS.Fingerprint, name)
+		require.Equal(t, []string{"a link parameter whose name is not a name is ignored"}, warnings, name)
+	}
+	// the names every scheme reads, and the paths of options, are names
+	_, warnings := decodeJSON(t, policyBase+"security=tls&type=ws&allowInsecure=1&packet-encoding=xudp&x_padding_bytes=1&sb.transport.headers.X-Forwarded-For=h")
+	require.Empty(t, warnings)
+	require.True(t, plainName("sb.transport.download.tls.reality.public_key"))
+	require.False(t, plainName(""))
+}
+
+// The JSON in extra may hold spaces and addresses at once: it is no second link on the line. A
+// link after the JSON is, and no message repeats it.
+func TestExtraHoldsSpacesAndAddresses(t *testing.T) {
+	t.Parallel()
+	const canary = "CANARY0f6d2c"
+	base := "vless://" + testUUID + "@example.org:443?type=xhttp&security=tls&sni=example.org&extra="
+	for name, extra := range map[string]string{
+		"a browser":     `{"headers":{"User-Agent":"Mozilla/5.0 (X11; Linux x86_64)","Referer":"https://example.org/a"}}`,
+		"several lines": "{\n  \"headers\": {\n    \"Referer\": \"https://example.org/a\"\n  }\n}\n",
+	} {
+		content, warnings := decodeJSON(t, base+url.QueryEscape(extra))
+		require.Contains(t, content, "https://example.org/a", name)
+		require.Empty(t, warnings, name)
+	}
+	_, _, err := Decode(base + url.QueryEscape(`{"headers":{"Referer":"https://example.org/a"}}`) + "%20vless://" + canary + "@h.example.org:443")
+	require.ErrorContains(t, err, "the link parameter extra contains a space and another link")
+	require.NotContains(t, err.Error(), canary)
+}
+
+// The keys and the values of the JSON in extra are as free a text as the names of
+// parameters: what is not a name is not repeated.
+func TestExtraIsNotRepeated(t *testing.T) {
+	t.Parallel()
+	const canary = "CANARY0f6d2c"
+	for _, key := range []string{"vless://" + canary + "@h.example.org:443", `a\nerror:` + canary} {
+		_, warnings := transportOf(t, xhttpLink(`{"`+key+`":1,"future":3}`, uriComponent, ""))
+		require.Equal(t, []string{"extra: future is not supported and is ignored", "extra: a key that is not a name is ignored"}, warnings, key)
+	}
+	for _, extra := range []string{
+		`{"downloadSettings":{"address":"a","port":1,"network":"x ` + canary + `"}}`,
+		`{"downloadSettings":{"address":"a","port":1,"security":"x\n` + canary + `"}}`,
+	} {
+		_, _, err := Decode(xhttpLink(extra, uriComponent, ""))
+		require.Error(t, err, extra)
+		require.NotContains(t, err.Error(), strings.ToLower(canary), extra)
+		require.NotContains(t, err.Error(), canary, extra)
+	}
+	_, _, err := Decode(xhttpLink(`{"downloadSettings":{"address":"a","port":1,"network":"kcp"}}`, uriComponent, ""))
+	require.ErrorContains(t, err, "downloadSettings: unsupported network: kcp")
+	_, warnings := transportOf(t, xhttpLink(`{"headers":{"Host":"other.example.org"}}`, uriComponent, ""))
+	require.Equal(t, []string{"extra: the Host header is ignored, the host of the link is used: cdn.example.org"}, warnings)
+}
+
+// A list of one is the one: a path that sets what the link has set already replaces
+// nothing.
+func TestPathRepeatsWhatTheLinkSets(t *testing.T) {
+	t.Parallel()
+	_, warnings := decodeJSON(t, policyBase+"security=tls&alpn=h2&sb.tls.alpn=h2")
+	require.Empty(t, warnings)
+	_, warnings = decodeJSON(t, policyBase+"security=tls&alpn=h2&sb.tls.alpn=h2,http/1.1")
+	require.Equal(t, []string{"sb.tls.alpn replaces what the link sets otherwise"}, warnings)
+}
+
+// The pause between the pieces of a fragmented ClientHello is slept through whatever
+// happens to the connection: a link does not set it. The name another client has for it
+// is ignored, and the link works with the pause sing-box has by default.
+func TestFragmentDelayIsNotForALink(t *testing.T) {
+	t.Parallel()
+	require.Equal(t, "sb-denied", refusalID(t, policyBase+"security=tls&sb.tls.fragment=1&sb.tls.fragment_fallback_delay=87600h"))
+	require.Equal(t, "sb-denied", refusalID(t, xhttpLink(`{"downloadSettings":{"address":"a","port":1,"security":"tls"}}`, uriComponent, "&sb.transport.download.tls.fragment_fallback_delay=1s")))
+	content, warnings := decodeJSON(t, policyBase+"security=tls&tls_fragment=1&tls_fragment_fallback_delay=87600h")
+	require.Contains(t, content, `"fragment":true`)
+	require.NotContains(t, content, "fragment_fallback_delay")
+	require.Equal(t, []string{"tls_fragment_fallback_delay is not supported and is ignored"}, warnings)
+}
+
+// The security of a VMess link as the client of Xray reads it: any name other than the
+// two ciphers is auto. Its server has refused none, zero and aes-128-cfb since 2026, and
+// every VMess server takes what auto chooses.
+func TestVMessSecurity(t *testing.T) {
+	t.Parallel()
+	json := func(security string) string {
+		return "vmess://" + b64(`{"add":"example.org","port":"443","id":"`+testUUID+`","net":"ws","tls":"tls","scy":"`+security+`"}`)
+	}
+	for _, security := range []string{"none", "zero", "aes-128-cfb", "ZERO"} {
+		for _, link := range []string{json(security), "vmess://" + testUUID + "@example.org:443?security=tls&encryption=" + security} {
+			outbound, warnings, err := Decode(link)
+			require.NoError(t, err, link)
+			require.Equal(t, "auto", optionsOf[option.VMessOutboundOptions](t, outbound).Security, link)
+			require.Equal(t, []string{"the VMess security: " + strings.ToLower(security) + " is read as auto, as Xray does: its server refuses any other"}, warnings, link)
+		}
+	}
+	for security, written := range map[string]string{"": "auto", "auto": "auto", "aes-128-gcm": "aes-128-gcm", "chacha20-poly1305": "chacha20-poly1305", "AES-128-GCM": "aes-128-gcm"} {
+		outbound, warnings, err := Decode(json(security))
+		require.NoError(t, err, security)
+		require.Equal(t, written, optionsOf[option.VMessOutboundOptions](t, outbound).Security, security)
+		require.Empty(t, warnings, security)
+	}
+	// what is not a name is not repeated
+	_, warnings, err := Decode(json("CANARY 0f6d2c"))
+	require.NoError(t, err)
+	require.Equal(t, []string{"the VMess security is read as auto, as Xray does: its server refuses any other"}, warnings)
+	// the option of sing-box is set by its path
+	outbound, warnings, err := Decode("vmess://" + testUUID + "@example.org:443?security=tls&sb.security=zero")
+	require.NoError(t, err)
+	require.Equal(t, "zero", optionsOf[option.VMessOutboundOptions](t, outbound).Security)
+	require.Equal(t, []string{"sb.security replaces what the link sets otherwise"}, warnings)
+}
+
+// A flow and the type of a transport set by their paths are any text: a refusal does not
+// repeat them as they are.
+func TestRefusalsOfWhatPathsSet(t *testing.T) {
+	t.Parallel()
+	const canary = "CANARY0f6d2c"
+	for link, id := range map[string]string{
+		policyBase + "security=tls&type=ws&sb.flow=AAA%0A" + canary:                                   "flow",
+		policyBase + "security=tls&sb.flow=" + canary + "%20x":                                        "flow",
+		policyBase + "sb.flow=xtls-rprx-vision":                                                       "flow-no-tls",
+		policyBase + "security=tls&type=ws&sb.flow=xtls-rprx-vision":                                  "flow-transport",
+		policyBase + "security=tls&flow=xtls-rprx-vision&sb.transport.type=httpupgrade":               "flow-transport",
+		policyBase + "security=tls&type=ws&sb.transport.type=x%20" + canary + "&sb.transport.path=/p": "",
+	} {
+		_, _, err := Decode(link)
+		require.Error(t, err, link)
+		require.NotContains(t, err.Error(), canary, link)
+		require.NotContains(t, err.Error(), "\n", link)
+		if id != "" {
+			require.Equal(t, id, refusalID(t, link), link)
+		}
+	}
+	_, _, err := Decode(policyBase + "security=tls&type=ws&sb.flow=xtls-rprx-vision")
+	require.ErrorContains(t, err, "flow xtls-rprx-vision is not supported over the ws transport")
+}
+
+// The ranges of ports as sing-box reads them: without its first port a range begins at
+// 0, without its last one it ends at 65535. The bound is on how many ports a list names.
+func TestOpenEndedPortRanges(t *testing.T) {
+	t.Parallel()
+	for value, ports := range map[string]string{
+		"20000%3A":             `"server_ports":["20000:"]`,
+		"%3A3000":              `"server_ports":[":3000"]`,
+		"1000%3A2000,30000%3A": `"server_ports":["1000:2000","30000:"]`,
+		"1%3A65535":            `"server_ports":["1:65535"]`,
+	} {
+		content, _ := decodeJSON(t, "hysteria2://p@example.org:443?sb.server_ports="+value)
+		require.Contains(t, content, ports, value)
+	}
+	require.Equal(t, "ports", refusalID(t, "hysteria2://p@example.org:443?sb.server_ports=%3A,1%3A"))
+	require.Equal(t, "ports", refusalID(t, "hysteria2://p@example.org:443?sb.server_ports=1%3A,1%3A"))
+	_, _, err := Decode("hysteria2://p@example.org:443?sb.server_ports=3000%3A2000")
+	require.ErrorContains(t, err, "invalid port in the list of ports")
+}
diff --git a/common/sharelink/link_review_test.go b/common/sharelink/link_review_test.go
new file mode 100644
index 000000000..426f1fe1c
--- /dev/null
+++ b/common/sharelink/link_review_test.go
@@ -0,0 +1,329 @@
+package sharelink
+
+import (
+	"context"
+	"net/url"
+	"os"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json"
+
+	"github.com/stretchr/testify/require"
+)
+
+// optionsOf reads the options of a decoded outbound into the structure of its type, as
+// the configuration reader would.
+func optionsOf[T any](t *testing.T, outbound *Outbound) T {
+	t.Helper()
+	content, err := json.Marshal(outbound.options)
+	require.NoError(t, err)
+	var options T
+	require.NoError(t, json.UnmarshalContext(context.Background(), content, &options))
+	return options
+}
+
+func tlsOf(t *testing.T, link string) *option.OutboundTLSOptions {
+	t.Helper()
+	outbound, _, err := Decode(link)
+	require.NoError(t, err)
+	return optionsOf[option.OutboundTLSOptionsContainer](t, outbound).TLS
+}
+
+// Fingerprints as Xray reads them: any case, Chrome's by default, "unsafe" for
+// none, and nothing sing-box would refuse later.
+func TestFingerprints(t *testing.T) {
+	t.Parallel()
+	base := "vless://" + testUUID + "@example.org:443?security=tls"
+	require.Equal(t, "chrome", tlsOf(t, base).UTLS.Fingerprint)
+	require.Equal(t, "firefox", tlsOf(t, base+"&fp=Firefox").UTLS.Fingerprint)
+	require.Nil(t, tlsOf(t, base+"&fp=unsafe").UTLS)
+	require.Equal(t, "chrome", tlsOf(t, "trojan://p@example.org:443").UTLS.Fingerprint)
+	require.Equal(t, "chrome", tlsOf(t, "vless://"+testUUID+"@example.org:443?security=REALITY&pbk=K").UTLS.Fingerprint)
+	// a name only Xray knows gives the fingerprint of the same browser, with a warning
+	for link, fingerprint := range map[string]string{
+		base + "&fp=hellochrome_131":  "chrome",
+		base + "&fp=HelloFirefox_148": "firefox",
+		base + "&fp=randomizednoalpn": "randomized",
+		"vless://" + testUUID + "@h:1?security=reality&pbk=K&fp=hellosafari_26_3": "safari",
+	} {
+		outbound, warnings, err := Decode(link)
+		require.NoError(t, err, link)
+		require.Equal(t, fingerprint, optionsOf[option.OutboundTLSOptionsContainer](t, outbound).TLS.UTLS.Fingerprint, link)
+		require.Len(t, warnings, 1, link)
+		require.Contains(t, warnings[0], "has no counterpart, "+fingerprint+" is used", link)
+	}
+	options, warnings := transportOf(t, xhttpLink(`{"downloadSettings":{"address":"a","port":1,"security":"tls","tlsSettings":{"fingerprint":"hellochrome_131"}}}`, url.QueryEscape, ""))
+	require.Equal(t, "chrome", options.Download.TLS.UTLS.Fingerprint)
+	require.Len(t, warnings, 1)
+	// a name nobody knows: no imitation with TLS, as in Xray; REALITY cannot do without
+	outbound, warnings, err := Decode(base + "&fp=netscape")
+	require.NoError(t, err)
+	require.Nil(t, optionsOf[option.OutboundTLSOptionsContainer](t, outbound).TLS.UTLS)
+	require.Len(t, warnings, 1)
+	for _, link := range []string{
+		"vless://" + testUUID + "@example.org:443?security=reality&pbk=K&fp=unsafe",
+		"vless://" + testUUID + "@example.org:443?security=reality&pbk=K&fp=netscape",
+	} {
+		_, _, err := Decode(link)
+		require.ErrorContains(t, err, "unsupported fingerprint", link)
+	}
+	options, _ = transportOf(t, xhttpLink(`{"downloadSettings":{"address":"[2001:db8::1]","port":1,"network":"XHTTP","security":"TLS","tlsSettings":{"fingerprint":"Edge"},"xhttpSettings":null,"splithttpSettings":{"path":"/s"}}}`, url.QueryEscape, ""))
+	require.Equal(t, "edge", options.Download.TLS.UTLS.Fingerprint)
+	require.Equal(t, "2001:db8::1", options.Download.Server)
+	require.Equal(t, "/s", options.Download.Path)
+}
+
+func TestFlows(t *testing.T) {
+	t.Parallel()
+	base := "vless://" + testUUID + "@example.org:443?security=reality&pbk=K&flow="
+	outbound, _, err := Decode(base + "xtls-rprx-vision-udp443")
+	require.NoError(t, err)
+	require.Equal(t, "xtls-rprx-vision", optionsOf[option.VLESSOutboundOptions](t, outbound).Flow)
+	for _, flow := range []string{"xtls-rprx-direct", "none", "xtls-rprx-origin"} {
+		_, _, err = Decode(base + flow)
+		require.ErrorContains(t, err, "unsupported flow", flow)
+	}
+	_, _, err = Decode(base + "xtls-rprx-vision&type=xhttp")
+	require.ErrorContains(t, err, "not supported over the xhttp transport")
+	_, warnings, err := Decode("trojan://p@example.org:443?flow=xtls-rprx-vision")
+	require.NoError(t, err)
+	require.Len(t, warnings, 1)
+}
+
+// What must be refused, and without repeating the link: an error message ends
+// up in a log.
+func TestRefusedWithoutEcho(t *testing.T) {
+	t.Parallel()
+	const secret = "5ec2e7aa-0000-4000-8000-5ec2e7000000"
+	for name, link := range map[string]string{
+		"two links on a line":  "vless://" + testUUID + "@h:1 vless://" + secret + "@h:2",
+		"a link in a value":    "vless://" + testUUID + "@h:1?type=tcp vless://" + secret + "@h:2?type=ws",
+		"a link after a mode":  "vless://" + testUUID + "@h:1?type=xhttp&mode=packet-up vless://" + secret + "@h:2?type=xhttp",
+		"no scheme":            secret + "@example.org:443?type=ws&path=x://y",
+		"bare ipv6":            "vless://" + secret + "@2001:db8::1:443",
+		"security with a tail": "vless://" + secret + "@h:1?security=tls1sni=" + secret + ".example.org",
+		"header type":          "vless://" + testUUID + "@h:1?type=tcp&headerType=none@" + secret,
+		"not a uuid":           "vless://" + secret + "-and-more-of-it@h:1",
+		"grpc custom path":     "vless://" + testUUID + "@h:1?type=grpc&serviceName=%2Fa%2Fb",
+		"stream-one download":  "vless://" + testUUID + "@h:1?type=xhttp&mode=stream-one&extra=" + url.QueryEscape(`{"downloadSettings":{"address":"a","port":1}}`),
+	} {
+		outbound, _, err := Decode(link)
+		require.Error(t, err, name)
+		require.Nil(t, outbound, name)
+		require.NotContains(t, strings.ToLower(err.Error()), secret[:13], name)
+		require.NotContains(t, err.Error(), "://", name)
+	}
+	// what could not be read is not repeated, and no type of the program is named
+	for name, test := range map[string]struct{ link, say string }{
+		"extra that is not an object": {xhttpLink(`"text"`, url.QueryEscape, ""), "read extra: not a JSON object"},
+		"a range in extra":            {xhttpLink(`{"xPaddingBytes":"a-`+secret+`"}`, url.QueryEscape, ""), "invalid range"},
+		"a range in a parameter":      {xhttpLink(`{}`, url.QueryEscape, "&x_padding_bytes=a-"+secret), "invalid range in the link parameter x_padding_bytes"},
+	} {
+		_, _, err := Decode(test.link)
+		require.ErrorContains(t, err, test.say, name)
+		require.NotContains(t, err.Error(), secret[:13], name)
+		require.NotContains(t, err.Error(), "sharelink", name)
+	}
+	// a short user is Xray's "string turned into a UUID"
+	_, _, err := Decode("vless://my-user@h:1")
+	require.NoError(t, err)
+	// a plain word is shown
+	_, _, err = Decode("vless://" + testUUID + "@h:1?type=tor")
+	require.ErrorContains(t, err, "unsupported transport: tor")
+	// a byte order mark before the link
+	_, _, err = Decode("\ufeffvless://" + testUUID + "@h:1")
+	require.NoError(t, err)
+}
+
+func TestExtraSettlesWhatItNames(t *testing.T) {
+	t.Parallel()
+	base := "vless://" + testUUID + "@example.org:443?type=xhttp&"
+	options, _ := transportOf(t, base+"noGRPCHeader=true&sessionIDPlacement=query&xPaddingBytes=5-9&x_padding_bytes=7-8&uplinkHTTPMethod=PUT&extra="+
+		url.QueryEscape(`{"noGRPCHeader":false,"sessionPlacement":"header","xPaddingBytes":0}`))
+	require.False(t, options.NoGRPCHeader, "false in extra is a setting")
+	require.Equal(t, "header", options.SessionPlacement, "the older name in extra settles the newer one of the link")
+	require.Nil(t, options.XPaddingBytes)
+	require.Equal(t, "PUT", options.UplinkHTTPMethod, "what extra does not name comes from the link")
+
+	// several spellings of Host: the same answer every time
+	link := base + "extra=" + url.QueryEscape(`{"headers":{"host":"b","Host":"a","HOST":"c","X":"y"}}`)
+	for i := 0; i < 20; i++ {
+		options, warnings := transportOf(t, link)
+		require.Equal(t, "c", options.Host)
+		require.Len(t, warnings, 2)
+		require.Len(t, options.Headers, 1)
+	}
+
+	// the download leg sends GETs only
+	options, _ = transportOf(t, base+"mode=packet-up&extra="+url.QueryEscape(
+		`{"downloadSettings":{"address":"d","port":1,"xhttpSettings":{"uplinkHTTPMethod":"GET","uplinkDataPlacement":"header","mode":"stream-one","path":"/d"}}}`))
+	content, err := json.Marshal(options.Download)
+	require.NoError(t, err)
