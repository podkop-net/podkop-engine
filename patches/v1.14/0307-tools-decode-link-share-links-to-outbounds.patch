+		},
+		"hysteria": {
+			"hysteria://example.org:36712?protocol=udp&auth=secret&peer=s.example.org&insecure=1&upmbps=10&downmbps=50&alpn=hysteria&obfs=xplus&obfsParam=obfs#v1",
+			`{"type":"hysteria","tag":"v1","server":"example.org","server_port":36712,"up_mbps":10,"down_mbps":50,"obfs":"obfs","auth_str":"secret",
+			"tls":{"enabled":true,"server_name":"s.example.org","insecure":true,"alpn":"hysteria"}}`, nil,
+		},
+		"anytls": {
+			"anytls://pass%2Fword@example.org/?sni=s.example.org&insecure=1#a",
+			`{"type":"anytls","tag":"a","server":"example.org","server_port":443,"tls":{"enabled":true,"server_name":"s.example.org","insecure":true},"password":"pass/word"}`, nil,
+		},
+		"anytls with a fingerprint": {
+			"anytls://p@example.org:8443?fp=chrome",
+			`{"type":"anytls","server":"example.org","server_port":8443,"tls":{"enabled":true,"utls":{"enabled":true,"fingerprint":"chrome"}},"password":"p"}`, nil,
+		},
+		"naive over HTTPS": {
+			"naive+https://user:pass@example.org?sni=s.example.org&extra-headers=X-A%3A%20one%0D%0AX-B%3A%20two&insecure-concurrency=2#n",
+			`{"type":"naive","tag":"n","server":"example.org","server_port":443,"username":"user","password":"pass","insecure_concurrency":2,
+			"extra_headers":{"X-A":"one","X-B":"two"},"tls":{"enabled":true,"server_name":"s.example.org"}}`, nil,
+		},
+		"naive over QUIC": {
+			"naive+quic://user:pass@example.org:8443",
+			`{"type":"naive","server":"example.org","server_port":8443,"username":"user","password":"pass","quic":true,"tls":{"enabled":true}}`, nil,
+		},
+	} {
+		content, warnings := decodeJSON(t, test.link)
+		require.JSONEq(t, test.want, content, name)
+		require.Len(t, warnings, len(test.warnings), "%s: %v", name, warnings)
+		for index, warning := range test.warnings {
+			require.Contains(t, warnings[index], warning, name)
+		}
+	}
+}
+
+func TestSchemeRefusals(t *testing.T) {
+	t.Parallel()
+	for link, id := range map[string]string{
+		"ss://" + b64url("aes-256-gcm:p") + "@example.org:443?type=ws&path=%2Fw": "shadowsocks-transport",
+		"ss://" + b64url("aes-256-gcm:p") + "@example.org:443?security=tls":      "shadowsocks-transport",
+		"ss://" + b64url("aes-256-gcm:p") + "@example.org:443?headerType=http":   "shadowsocks-transport",
+		"https://example.org":                       "http-not-a-proxy",
+		"https://example.org/sub/TOKEN":             "http-not-a-proxy",
+		"http://user:pass@example.org:8080/path":    "http-not-a-proxy",
+		"hysteria://example.org:1?protocol=faketcp": "hysteria-protocol",
+		"hysteria://example.org:1?obfs=salamander":  "hysteria-obfs",
+		"tuic://token@example.org:443":              "tuic-v4",
+		"vmess://" + b64(`{"add":"h","port":1,"id":"`+testUUID+`","net":"kcp","type":"none","path":"seed"}`):        "kcp",
+		"vmess://" + b64(`{"add":"h","port":1,"id":"`+testUUID+`","net":"quic","host":"aes-128-gcm","path":"key"}`): "quic-security",
+		"hysteria2://p@example.org?fm=" + uriComponent(`{"udp":[{"type":"xdns"}]}`):                                 "finalmask",
+	} {
+		require.Equal(t, id, refusalID(t, link), link)
+	}
+	for name, link := range map[string]string{
+		"shadowsocks without a method": "ss://" + b64url("justapassword") + "@example.org:443",
+		"shadowsocks, not base64":      "ss://not_base64_at_all!!!",
+		"vmess, neither form":          "vmess://nothing-here",
+		"vmess without an address":     "vmess://" + b64(`{"port":1,"id":"`+testUUID+`"}`),
+		"vmess with a bad port":        "vmess://" + b64(`{"add":"h","port":"x","id":"`+testUUID+`"}`),
+		"vmess JSON with an object":    "vmess://" + b64(`{"add":{"a":1},"port":1,"id":"x"}`),
+		"hysteria2 with a bad port":    "hysteria2://p@example.org:0",
+		"hysteria2 with bad ports":     "hysteria2://p@example.org:443,x-y",
+		"socks with a bad port":        "socks5://127.0.0.1:99999",
+	} {
+		outbound, _, err := Decode(link)
+		require.Error(t, err, name)
+		require.Nil(t, outbound, name)
+	}
+}
diff --git a/common/sharelink/simple.go b/common/sharelink/simple.go
new file mode 100644
index 000000000..1d4c0fb94
--- /dev/null
+++ b/common/sharelink/simple.go
@@ -0,0 +1,164 @@
+package sharelink
+
+import (
+	"encoding/base64"
+	"strings"
+
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// decodeBase64 reads base64 in any of its forms: the generators differ in the alphabet
+// and in the padding.
+func decodeBase64(text string) ([]byte, bool) {
+	text = strings.TrimSpace(text)
+	if text == "" {
+		return nil, false
+	}
+	for _, encoding := range []*base64.Encoding{base64.RawURLEncoding, base64.URLEncoding, base64.RawStdEncoding, base64.StdEncoding} {
+		decoded, err := encoding.DecodeString(text)
+		if err == nil {
+			return decoded, true
+		}
+	}
+	return nil, false
+}
+
+// The names of Shadowsocks methods some generators use for the ones sing-box has.
+var shadowsocksMethods = map[string]string{
+	"chacha20-poly1305":  "chacha20-ietf-poly1305",
+	"xchacha20-poly1305": "xchacha20-ietf-poly1305",
+}
+
+// shadowsocks reads a Shadowsocks link: SIP002, "ss://userinfo@host:port/?plugin=...#name"
+// with the method and the password in base64 or, for the methods of 2022, as they are;
+// or the older form with everything before the name in base64.
+func (d *decoder) shadowsocks() (any, error) {
+	d.reads("plugin", "uot", "udp-over-tcp", "type", "security", "headertype")
+	body := d.body
+	if !strings.Contains(body, "@") {
+		// the older form: base64 of "method:password@host:port"
+		decoded, isBase64 := decodeBase64(strings.TrimSuffix(body, "/"))
+		if !isBase64 || !strings.Contains(string(decoded), "@") {
+			return nil, E.New("the link has neither a server nor base64 with one")
+		}
+		body = string(decoded)
+		index := strings.LastIndexByte(body, '@')
+		// the user of this form is not escaped: a password may have a "%" of its own
+		body = strings.ReplaceAll(body[:index], "%", "%25") + body[index:]
+	}
+	user, _, server, _, err := parseAuthority(body, 0)
+	if err != nil {
+		return nil, err
+	}
+	method, password, plain := strings.Cut(user, ":")
+	if !plain {
+		decoded, isBase64 := decodeBase64(user)
+		if isBase64 {
+			method, password, plain = strings.Cut(string(decoded), ":")
+		}
+	}
+	if !plain || method == "" {
+		return nil, E.New("the user of the link is not a method and a password")
+	}
+	method = strings.ToLower(method)
+	if renamed, isAlias := shadowsocksMethods[method]; isAlias {
+		method = renamed
+	}
+	if !plainWord(method) {
+		// sing-box names a method it does not know in its error
+		return nil, E.New("the user of the link is not a method and a password")
+	}
+	// Xray carries Shadowsocks over its transports and TLS; sing-box only as it is.
+	if network := strings.ToLower(d.query["type"]); network != "" && network != "tcp" && network != "raw" {
+		return nil, refuse("shadowsocks-transport", "Shadowsocks over the transport", shown(network), " is not supported")
+	}
+	if security := strings.ToLower(d.query["security"]); security != "" && security != "none" {
+		return nil, refuse("shadowsocks-transport", "Shadowsocks over TLS is not supported")
+	}
+	if headerType := strings.ToLower(d.query["headertype"]); headerType != "" && headerType != "none" {
+		return nil, refuse("shadowsocks-transport", "Shadowsocks with a header of the TCP transport is not supported")
+	}
+	options := option.ShadowsocksOutboundOptions{
+		ServerOptions: server,
+		Method:        method,
+		Password:      password,
+	}
+	if plugin := d.query["plugin"]; plugin != "" {
+		// "name;option;option": SIP003
+		name, pluginOptions, _ := strings.Cut(plugin, ";")
+		if name == "simple-obfs" {
+			// the same plugin under its older name
+			name = "obfs-local"
+		}
+		options.Plugin = name
+		options.PluginOptions = pluginOptions
+	}
+	if isTrue(d.first("uot", "udp-over-tcp")) {
+		options.UDPOverTCP = &option.UDPOverTCPOptions{Enabled: true}
+	}
+	return options, nil
+}
+
+// socks reads a SOCKS proxy: "socks5://[user:password@]host:port", also socks4, socks4a,
+// socks5h and the "socks://" of v2rayN with the user in base64.
+func (d *decoder) socks() (any, error) {
+	d.reads("uot", "udp-over-tcp")
+	user, hasUser, server, _, err := parseAuthority(d.body, 1080)
+	if err != nil {
+		return nil, err
+	}
+	options := option.SOCKSOutboundOptions{ServerOptions: server}
+	switch d.scheme {
+	case "socks4":
+		options.Version = "4"
+	case "socks4a":
+		options.Version = "4a"
+	}
+	if hasUser && user != "" {
+		username, password, plain := strings.Cut(user, ":")
+		if !plain {
+			if decoded, isBase64 := decodeBase64(user); isBase64 && strings.Contains(string(decoded), ":") {
+				username, password, _ = strings.Cut(string(decoded), ":")
+			}
+		}
+		options.Username = username
+		options.Password = password
+	}
+	if isTrue(d.first("uot", "udp-over-tcp")) {
+		options.UDPOverTCP = &option.UDPOverTCPOptions{Enabled: true}
+	}
+	return options, nil
+}
+
+// httpProxy reads an HTTP proxy: "http://[user:password@]host:port" and, over TLS,
+// "https://". Only with a port and without a path: anything else is the address of a
+// page or of a subscription, pasted where a proxy was meant.
+func (d *decoder) httpProxy() (any, error) {
+	user, hasUser, server, path, err := parseAuthority(d.body, 0)
+	if err != nil {
+		if strings.Contains(err.Error(), "missing server port") {
+			return nil, refuse("http-not-a-proxy", "an http address without a port is read as the address of a page, not of a proxy")
+		}
+		return nil, err
+	}
+	if path != "" && path != "/" {
+		return nil, refuse("http-not-a-proxy", "an http address with a path is read as the address of a page, not of a proxy")
+	}
+	options := option.HTTPOutboundOptions{ServerOptions: server}
+	if hasUser && user != "" {
+		options.Username, options.Password, _ = strings.Cut(user, ":")
+	}
+	if d.scheme == "https" {
+		d.reads("fp")
+		tlsOptions := d.tlsAlways()
+		if d.query["fp"] != "" {
+			tlsOptions.UTLS, err = d.utls(false)
+			if err != nil {
+				return nil, err
+			}
+		}
+		options.TLS = tlsOptions
+	}
+	return options, nil
+}
