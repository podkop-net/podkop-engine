diff --git a/cmd/sing-box/cmd_tools_decode_link.go b/cmd/sing-box/cmd_tools_decode_link.go
new file mode 100644
index 000000000..ac9547576
--- /dev/null
+++ b/cmd/sing-box/cmd_tools_decode_link.go
@@ -0,0 +1,203 @@
+package main
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	stdJSON "encoding/json"
+	"io"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/sagernet/sing-box"
+	"github.com/sagernet/sing-box/common/sharelink"
+	"github.com/sagernet/sing-box/experimental/deprecated"
+	"github.com/sagernet/sing-box/include"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/json"
+	"github.com/sagernet/sing/service"
+
+	"github.com/spf13/cobra"
+)
+
+var commandDecodeLinkFlagCompact bool
+
+var commandDecodeLink = &cobra.Command{
+	Use:   "decode-link [link]",
+	Short: "Convert a share link (vless://, trojan://, ss://, hysteria2://, ...) to an outbound",
+	Long: "Convert a share link to an outbound: vless://, trojan://, ss://, socks://, hysteria2://\n" +
+		"(hy2://), tuic://, http(s)://; in a build with every outbound also vmess://, hysteria://,\n" +
+		"anytls:// and naive+https:// (naive+quic://).\n\n" +
+		"The link is the argument or, with no argument, the standard input. The outbound is\n" +
+		"printed to the standard output as JSON.\n\n" +
+		"Exit status:\n" +
+		"  0  the outbound is printed; lines \"warning: ...\" on the standard error name what\n" +
+		"     the link asks for and the outbound cannot do\n" +
+		"  2  the link cannot be used; a line \"error: ...\" on the standard error says why,\n" +
+		"     and nothing is printed\n" +
+		"  1  anything else, such as an option the command does not have",
+	Args: cobra.MaximumNArgs(1),
+	Run: func(cmd *cobra.Command, args []string) {
+		os.Exit(decodeLink(args, os.Stdin, os.Stdout, os.Stderr))
+	},
+}
+
+func init() {
+	commandDecodeLink.Flags().BoolVar(&commandDecodeLinkFlagCompact, "compact", false, "Print the outbound on one line")
+	commandTools.AddCommand(commandDecodeLink)
+}
+
+// The exit statuses of decode-link: a script tells a link that cannot be used
+// from a sing-box that has no such command (1, as for any unknown command).
+const (
+	decodeLinkExitOther   = 1
+	decodeLinkExitBadLink = 2
+)
+
+// maxLinkLine bounds the link read from the standard input: one with a
+// certificate chain in it is a few kilobytes.
+const maxLinkLine = 4 * 1024 * 1024
+
+// decodeLink reports with plain lines, not through the logger: the output is
+// read by scripts. The messages do not repeat the link, which is a secret.
+func decodeLink(args []string, input io.Reader, output io.Writer, errorOutput io.Writer) int {
+	var link string
+	if len(args) == 1 {
+		link = args[0]
+	} else {
+		scanner := bufio.NewScanner(input)
+		scanner.Buffer(make([]byte, 64*1024), maxLinkLine)
+		for scanner.Scan() {
+			line := strings.TrimSpace(strings.TrimPrefix(scanner.Text(), "\ufeff"))
+			if line == "" {
+				continue
+			}
+			if link != "" {
+				io.WriteString(errorOutput, "error: more than one link\n")
+				return decodeLinkExitBadLink
+			}
+			link = line
+		}
+		if err := scanner.Err(); err != nil {
+			io.WriteString(errorOutput, "error: "+E.Cause(err, "read the link").Error()+"\n")
+			return decodeLinkExitOther
+		}
+	}
+	if strings.TrimSpace(link) == "" {
+		io.WriteString(errorOutput, "error: no link\n")
+		return decodeLinkExitBadLink
+	}
+	outbound, warnings, err := sharelink.Decode(link)
+	if err != nil {
+		io.WriteString(errorOutput, "error: "+plainMessage(err.Error(), nil)+"\n")
+		return decodeLinkExitBadLink
+	}
+	content, err := json.Marshal(outbound)
+	if err != nil {
+		io.WriteString(errorOutput, "error: "+E.Cause(err, "encode the outbound").Error()+"\n")
+		return decodeLinkExitOther
+	}
+	notes, err := checkDecoded(content)
+	if err != nil {
+		io.WriteString(errorOutput, "error: "+plainMessage(err.Error(), append(outbound.Secrets(), outbound.Unplain()...))+"\n")
+		return decodeLinkExitBadLink
+	}
+	for _, warning := range append(warnings, notes...) {
+		io.WriteString(errorOutput, "warning: "+oneLine(warning)+"\n")
+	}
+	if !commandDecodeLinkFlagCompact {
+		var indented bytes.Buffer
+		err = stdJSON.Indent(&indented, content, "", "  ")
+		if err != nil {
+			io.WriteString(errorOutput, "error: "+E.Cause(err, "encode the outbound").Error()+"\n")
+			return decodeLinkExitOther
+		}
+		content = indented.Bytes()
+	}
+	output.Write(content)
+	io.WriteString(output, "\n")
+	return 0
+}
+
+// plainMessage and oneLine are those of the package that decodes links: other code that
+// reports about a link writes its messages the same way.
+func plainMessage(message string, secrets []string) string {
+	return sharelink.PlainMessage(message, secrets)
+}
+
+func oneLine(message string) string {
+	return sharelink.OneLine(message)
+}
+
+// decodeLinkNotes collects what sing-box would report as deprecated while it builds the
+// outbound: the manager of a run prints such a note, and for one about to be removed
+// ends the process.
+type decodeLinkNotes struct {
+	notes []string
+}
+
+func (n *decodeLinkNotes) ReportDeprecated(feature deprecated.Note) {
+	n.notes = append(n.notes, feature.Message())
+}
+
+// decodeLinkBuildTimeout bounds the building of the outbound: milliseconds as a rule. One
+// that waits for something a link has made it wait for is a link that cannot be used.
+var decodeLinkBuildTimeout = 20 * time.Second
+
+// checkDecoded builds the outbound (buildDecoded) and takes what comes of it: the notes
+// of sing-box, its error, a failure of its code, or no end in time.
+func checkDecoded(outbound []byte) ([]string, error) {
+	type built struct {
+		notes []string
+		err   error
+	}
+	done := make(chan built, 1)
+	go func() {
+		var result built
+		// The outbounds are built here of what a link says, which their code was not
+		// written for: one that fails on it (a value longer than the place it is decoded
+		// into) is a link that cannot be used, not a crash of the command.
+		defer func() {
+			if recover() != nil {
+				result = built{nil, E.New("this sing-box cannot build the outbound of the link")}
+			}
+			done <- result
+		}()
+		result.notes, result.err = buildDecoded(outbound)
+	}()
+	select {
+	case result := <-done:
+		return result.notes, result.err
+	case <-time.After(decodeLinkBuildTimeout):
+		// what is still being built is left behind: the command ends
+		return nil, E.New("this sing-box takes too long to build the outbound of the link")
+	}
+}
+
+// buildDecoded builds the outbound the way "sing-box check" builds a configuration, as
+// the only outbound of one: what is printed is then an outbound this very sing-box
+// takes, with the protocols and the options it was built with. Nothing is opened, read
+// or dialed by it: an outbound from a link names no files, and connections are made
+// when it is used. A variable: a test replaces it.
+var buildDecoded = func(outbound []byte) ([]string, error) {
+	notes := new(decodeLinkNotes)
+	ctx, cancel := context.WithCancel(service.ExtendContext(include.Context(service.ContextWith[deprecated.Manager](context.Background(), notes))))
+	defer cancel()
+	configuration := append(append([]byte(`{"log":{"disabled":true},"outbounds":[`), outbound...), "]}"...)
+	options, err := json.UnmarshalExtendedContext[option.Options](ctx, configuration)
+	if err != nil {
+		return nil, E.New("this sing-box does not take the outbound of the link: ", strings.TrimPrefix(err.Error(), "outbounds[0]."))
+	}
+	instance, err := box.New(box.Options{Context: ctx, Options: options})
+	if err != nil {
+		message := err.Error()
+		for _, prefix := range []string{"initialize outbound[0]: ", "create client transport: "} {
+			message = strings.TrimPrefix(message, prefix)
+		}
+		return nil, E.New(message)
+	}
+	instance.Close()
+	return notes.notes, nil
+}
diff --git a/cmd/sing-box/cmd_tools_decode_link_test.go b/cmd/sing-box/cmd_tools_decode_link_test.go
new file mode 100644
index 000000000..75ea65fb5
--- /dev/null
+++ b/cmd/sing-box/cmd_tools_decode_link_test.go
@@ -0,0 +1,320 @@
+package main
+
+import (
+	"bytes"
+	"encoding/base64"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/common/sharelink"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/json"
+
+	"github.com/stretchr/testify/require"
+)
+
+// The contract of "tools decode-link" that scripts rely on: the exit status
+// and what goes where.
+func TestDecodeLinkCommand(t *testing.T) {
+	const link = "vless://6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11@example.org:443?type=xhttp&security=tls&path=%2Fa&mode=packet-up"
+	run := func(input string, args ...string) (int, string, string) {
+		var output, errorOutput bytes.Buffer
+		status := decodeLink(args, strings.NewReader(input), &output, &errorOutput)
+		return status, output.String(), errorOutput.String()
+	}
+	for name, test := range map[string]struct {
+		input string
+		args  []string
+	}{
+		"argument":           {"", []string{link}},
+		"standard input":     {link + "\n", nil},
+		"blank lines, CRLF":  {"\n\r\n" + link + "\r\n\n", nil},
+		"a byte order mark":  {"\ufeff" + link, nil},
+		"argument wins":      {"vless://ignored\n", []string{link}},
+		"with a warning too": {"", []string{link + "&pinSHA256=x&mux=1"}},
+	} {
+		status, output, errorOutput := run(test.input, test.args...)
+		require.Zero(t, status, name)
+		var outbound map[string]any
+		require.NoError(t, json.Unmarshal([]byte(output), &outbound), name)
+		require.Equal(t, "vless", outbound["type"], name)
+		require.Equal(t, "xhttp", outbound["transport"].(map[string]any)["type"], name)
+		for _, line := range strings.Split(strings.TrimSpace(errorOutput), "\n") {
+			if line != "" {
+				require.True(t, strings.HasPrefix(line, "warning: "), "%s: %q", name, line)
+			}
+		}
+		if name == "with a warning too" {
+			require.Equal(t, 2, strings.Count(errorOutput, "warning: "), errorOutput)
+		} else {
+			require.Empty(t, errorOutput, name)
+		}
+	}
+	for name, test := range map[string]struct {
+		input string
+		args  []string
+		say   string
+	}{
+		"unsupported":         {"", []string{"vless://u@example.org:443?type=kcp"}, "error: the mKCP transport is not supported\n"},
+		"refused by xhttp":    {"", []string{strings.Replace(link, "mode=packet-up", "mode=stream-up", 1) + "&extra=%7B%22uplinkHTTPMethod%22%3A%22GET%22%7D"}, "error: xhttp: "},
+		"flow over xhttp":     {"", []string{link + "&flow=xtls-rprx-vision"}, "error: flow xtls-rprx-vision is not supported over the xhttp transport\n"},
+		"no link":             {"\n\n", nil, "error: no link\n"},
+		"empty argument":      {"", []string{""}, "error: no link\n"},
+		"two links on input":  {link + "\n" + link + "\n", nil, "error: more than one link\n"},
+		"two links on a line": {"", []string{link + " " + link}, "error: "},
+	} {
+		status, output, errorOutput := run(test.input, test.args...)
+		require.Equal(t, decodeLinkExitBadLink, status, name)
+		require.Empty(t, output, name)
+		require.True(t, strings.HasPrefix(errorOutput, test.say), "%s: %q", name, errorOutput)
+		require.Equal(t, 1, strings.Count(errorOutput, "\n"), name)
+		require.NotContains(t, errorOutput, "6f1c9a0e", name)
+	}
+	// an xhttp link whose options pass the check must not crash the command
+	status, _, _ := run("", link+"&extra=%7B%22xmux%22%3A%7B%22maxConnections%22%3A2%7D%7D")
+	require.Zero(t, status)
+}
+
+// A link is somebody else's text: the command reads no file for it, and what it says of
+// an outbound that cannot be built is one line that does not quote the link.
+func TestDecodeLinkReadsNoFile(t *testing.T) {
+	const marker = "MARKER-0f6d2c-not-a-certificate"
+	file := filepath.Join(t.TempDir(), "secret.txt")
+	require.NoError(t, os.WriteFile(file, []byte(marker+"\n"), 0o600))
+	base := "vless://6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11@example.org:443?security=tls&sni=example.org"
+	for name, parameter := range map[string]string{
+		"a group of options as JSON":   "sb.tls=" + url.QueryEscape(`{"enabled":true,"certificate_path":"`+file+`"}`),
+		"the ECH options as JSON":      "sb.tls.ech=" + url.QueryEscape(`{"enabled":true,"config_path":"`+file+`"}`),
+		"the option by its path":       "sb.tls.certificate_path=" + url.QueryEscape(file),
+		"the client key by its path":   "sb.tls.client_key_path=" + url.QueryEscape(file),
+		"a certificate that is no PEM": "cert=" + url.QueryEscape(marker+"\n"+marker),
+	} {
+		var output, errorOutput bytes.Buffer
+		status := decodeLink([]string{base + "&" + parameter}, strings.NewReader(""), &output, &errorOutput)
+		require.Equal(t, decodeLinkExitBadLink, status, name)
+		require.Empty(t, output.String(), name)
+		require.NotContains(t, errorOutput.String(), marker, name)
+		require.True(t, strings.HasPrefix(errorOutput.String(), "error: "), name)
+		require.Equal(t, 1, strings.Count(errorOutput.String(), "\n"), name)
+	}
+	// the plugin of Shadowsocks has an option that names a file
+	for name, link := range map[string]string{
+		"the plugin of the link":       "ss://YWVzLTEyOC1nY206cGFzc3dvcmQ=@example.org:443?plugin=" + url.QueryEscape("v2ray-plugin;tls;cert="+file),
+		"the plugin options by a path": "ss://YWVzLTEyOC1nY206cGFzc3dvcmQ=@example.org:443?sb.plugin=v2ray-plugin&sb.plugin_opts=" + url.QueryEscape("tls;cert="+file),
+	} {
+		var output, errorOutput bytes.Buffer
+		status := decodeLink([]string{link}, strings.NewReader(""), &output, &errorOutput)
+		require.Equal(t, decodeLinkExitBadLink, status, name)
+		require.Empty(t, output.String(), name)
+		require.Contains(t, errorOutput.String(), "not for a link to set", name)
+		require.NotContains(t, errorOutput.String(), marker, name)
+	}
+	// and no secret of the link in what the outbound itself says
+	require.Equal(t, "invalid ...", plainMessage("invalid 6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11:\n\nmore", []string{"6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11"}))
+}
+
+// An error is one line, and says nothing of what the link keeps secret, whoever wrote
+// it: the decoder, or the outbound of sing-box when it is built.
+func TestDecodeLinkErrorsAreOneLine(t *testing.T) {
+	const canary = "CANARY0f6d2c"
+	const uuid = "6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11"
+	for name, link := range map[string]string{
+		"tuic, a user that is no UUID":           "tuic://" + canary + ":" + canary + "@example.org:443?alpn=h3",
+		"shadowsocks, no method":                 "ss://" + canary + "@example.org:443",
+		"shadowsocks, an unknown method":         "ss://" + base64.StdEncoding.EncodeToString([]byte("no-such-method:"+canary)) + "@example.org:443",
+		"shadowsocks 2022, a key of no length":   "ss://" + base64.StdEncoding.EncodeToString([]byte("2022-blake3-aes-128-gcm:"+canary)) + "@example.org:443",
+		"hysteria2, an unknown obfuscation":      "hysteria2://" + canary + "@example.org:443?obfs=no-such&obfs-password=" + canary,
+		"reality, a key that is none":            "vless://" + uuid + "@example.org:443?security=reality&pbk=" + canary + "&sid=01",
+		"reality, a short id too long":           "vless://" + uuid + "@example.org:443?security=reality&pbk=YBZ6SAP7KfiD5YJiyAGvD49eNYW-f-7IlhMarfyy4k0&sid=0123456789abcdef0123",
+		"a certificate that is none":             "trojan://" + canary + "@example.org:443?cert=" + canary,
+		"free text in an option set by its path": "vless://" + uuid + "@example.org:443?security=tls&sb.tls.min_version=" + canary + "%20%40x",
+		"a flow of several lines":                "vless://" + uuid + "@example.org:443?security=tls&type=ws&sb.flow=AAA%0A" + canary,
+		"a transport type of several lines":      "vless://" + uuid + "@example.org:443?security=tls&type=ws&sb.transport.type=x%0A" + canary + "&sb.transport.path=/p",
+		// these two are refused by sing-box, which quotes what it was given
+		"a transport type with a tab":      "vless://" + uuid + "@example.org:443?security=tls&type=ws&sb.transport.type=x%09" + canary,
+		"a transport type with a new line": "vless://" + uuid + "@example.org:443?security=tls&type=ws&sb.transport.type=x%0A" + canary,
+	} {
+		var output, errorOutput bytes.Buffer
+		status := decodeLink([]string{link}, strings.NewReader(""), &output, &errorOutput)
+		require.Equal(t, decodeLinkExitBadLink, status, "%s: %s", name, errorOutput.String())
+		require.Empty(t, output.String(), name)
+		require.True(t, strings.HasPrefix(errorOutput.String(), "error: "), "%s: %s", name, errorOutput.String())
+		require.Equal(t, 1, strings.Count(errorOutput.String(), "\n"), "%s: %s", name, errorOutput.String())
+		require.NotContains(t, errorOutput.String(), canary, name)
+		require.NotContains(t, errorOutput.String(), "goroutine", name)
+	}
+	// an outbound whose building fails outright is a link that cannot be used
+	require.Equal(t, `invalid "..."`, plainMessage(`invalid "a\"b\\c1"`, []string{`a"b\c1`}))
+	// what the link keeps secret is taken out as it stands in the message, then the
+	// message is made one line
+	require.Equal(t, "bad ... here", plainMessage("bad x\tSECRET here", []string{"x\tSECRET"}))
+	require.Equal(t, "bad ... here", plainMessage("bad x\nSECRET here\nmore", []string{"x\nSECRET"}))
+	require.Equal(t, "a b c", plainMessage("a\rb\tc", nil))
+}
+
+// A warning is one line too, whatever stands in the link in the place of a name.
+func TestDecodeLinkWarningsAreLines(t *testing.T) {
+	const canary = "CANARY0f6d2c"
+	const uuid = "6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11"
+	for name, link := range map[string]string{
+		"a name of several lines": "vless://" + uuid + "@example.org:443?security=tls&x%0Aerror%3A%20" + canary + "=1",
+		"another link for a name": "vless://" + uuid + "@example.org:443?security=tls&vless://" + canary + "@example.org:443?type=ws",
+		"an unknown name":         "vless://" + uuid + "@example.org:443?security=tls&NoSuchName=" + canary,
+	} {
+		var output, errorOutput bytes.Buffer
+		status := decodeLink([]string{link}, strings.NewReader(""), &output, &errorOutput)
+		require.Equal(t, 0, status, "%s: %s", name, errorOutput.String())
+		require.NotEmpty(t, output.String(), name)
+		lines := strings.Split(strings.TrimSuffix(errorOutput.String(), "\n"), "\n")
+		require.Len(t, lines, 1, "%s: %s", name, errorOutput.String())
+		require.True(t, strings.HasPrefix(lines[0], "warning: "), "%s: %s", name, errorOutput.String())
+		require.NotContains(t, errorOutput.String(), canary, name)
+	}
+	require.Equal(t, "a b c", oneLine("a\nb\tc"))
+}
+
+// An outbound that does not get built in time is a link that cannot be used.
+func TestDecodeLinkBuildTimeout(t *testing.T) {
+	timeout, build := decodeLinkBuildTimeout, buildDecoded
+	t.Cleanup(func() { decodeLinkBuildTimeout, buildDecoded = timeout, build })
+	decodeLinkBuildTimeout = 200 * time.Millisecond
+	entered, release := make(chan struct{}), make(chan struct{})
+	t.Cleanup(func() { close(release) })
+	buildDecoded = func([]byte) ([]string, error) {
+		close(entered)
+		<-release
+		return nil, nil
+	}
+	var output, errorOutput bytes.Buffer
+	start := time.Now()
+	status := decodeLink([]string{"vless://6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11@example.org:443"}, strings.NewReader(""), &output, &errorOutput)
+	require.Equal(t, decodeLinkExitBadLink, status)
+	require.Empty(t, output.String())
+	require.Equal(t, "error: this sing-box takes too long to build the outbound of the link\n", errorOutput.String())
+	require.Less(t, time.Since(start), 5*time.Second)
+	// the build that was left behind has taken its function: the variable is free again
+	<-entered
+	// and one whose building fails outright
+	buildDecoded = func([]byte) ([]string, error) {
+		var short [8]byte
+		index := 9
+		return nil, E.New(short[index%len(short)+index])
+	}
+	errorOutput.Reset()
+	status = decodeLink([]string{"vless://6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11@example.org:443"}, strings.NewReader(""), &output, &errorOutput)
+	require.Equal(t, decodeLinkExitBadLink, status)
+	require.Equal(t, "error: this sing-box cannot build the outbound of the link\n", errorOutput.String())
+}
+
+// Scripts read the features as whole names between commas, and ask for the ones they
+// depend on by name: the names of the releases before stay, in their order.
+func TestVersionFeatures(t *testing.T) {
+	seen := make(map[string]bool)
+	for _, feature := range versionFeatures {
+		require.NotContains(t, feature, ",")
+		require.NotContains(t, feature, " ")
+		require.False(t, seen[feature], feature)
+		seen[feature] = true
+	}
+	require.Equal(t, []string{"urltest.fallbacks", "urltest.download_url", "transport.xhttp", "tools.decode-link"}, versionFeatures[:4])
+	require.True(t, seen["tls.utls-fallback"])
+}
+
+// outboundAvailable reports whether this sing-box was built with the outbound type: one
+// left out of the build is there as a stub that refuses to be made, with these words.
+func outboundAvailable(outboundType string) bool {
+	_, err := checkDecoded([]byte(`{"type":"` + outboundType + `","tag":"probe"}`))
+	return err == nil || !(strings.Contains(err.Error(), "is not included in this build") || strings.Contains(err.Error(), "unknown outbound type"))
+}
+
+// One link of every scheme: the command prints an outbound exactly when this build has
+// the type of the outbound, and names the build otherwise. What is printed has been
+// built, so "sing-box check" takes it.
+func TestDecodeLinkEveryScheme(t *testing.T) {
+	const uuid = "6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11"
+	links := map[string]string{
+		"vless":       "vless://" + uuid + "@example.org:443?security=reality&pbk=YBZ6SAP7KfiD5YJiyAGvD49eNYW-f-7IlhMarfyy4k0&sid=0123456789abcdef&flow=xtls-rprx-vision&sni=www.example.com",
+		"trojan":      "trojan://password@example.org:443?type=ws&path=%2Fws&sni=example.org",
+		"ss":          "ss://MjAyMi1ibGFrZTMtYWVzLTI1Ni1nY206ZG1DbHkvWmgxNVd3OStzK0dGWGlGVElrcHc3Yy9xQ0lTYUJyYWk3V2hoWT0@127.0.0.1:25144",
+		"socks":       "socks://dXNlcjpwYXNz@127.0.0.1:1080",
+		"socks4":      "socks4://127.0.0.1:1080",
+		"socks4a":     "socks4a://127.0.0.1:1080",
+		"socks5":      "socks5://user:pass@127.0.0.1:1080",
+		"socks5h":     "socks5h://127.0.0.1:1080",
+		"hysteria2":   "hysteria2://password@example.org:443,5000-6000/?sni=example.org&obfs=salamander&obfs-password=x&insecure=1",
+		"hy2":         "hy2://password@example.org",
+		"tuic":        "tuic://" + uuid + ":password@example.org:443?congestion_control=bbr&udp_relay_mode=native&alpn=h3",
+		"vmess":       "vmess://" + uuid + "@example.org:443?type=ws&security=tls&path=%2Fws",
+		"http":        "http://user:pass@example.org:3128",
+		"https":       "https://user:pass@example.org:8443",
+		"hysteria":    "hysteria://example.org:36712?auth=secret&upmbps=10&downmbps=50&peer=example.org",
+		"anytls":      "anytls://password@example.org:8443?sni=example.org",
+		"naive+https": "naive+https://user:pass@example.org",
+		"naive+quic":  "naive+quic://user:pass@example.org",
+	}
+	require.False(t, outboundAvailable("no-such-type-is-a-stub"), "an unknown type is not a type of the build")
+	for scheme, outboundType := range sharelink.Schemes() {
+		link, hasLink := links[scheme]
+		require.True(t, hasLink, "no test link of the scheme %s", scheme)
+		var output, errorOutput bytes.Buffer
+		status := decodeLink([]string{link}, strings.NewReader(""), &output, &errorOutput)
+		if outboundAvailable(outboundType) {
+			require.Zero(t, status, "%s: %s", scheme, errorOutput.String())
+			var outbound map[string]any
+			require.NoError(t, json.Unmarshal(output.Bytes(), &outbound), scheme)
+			require.Equal(t, outboundType, outbound["type"], scheme)
+			_, err := checkDecoded(output.Bytes())
+			require.NoError(t, err, scheme)
+		} else {
+			require.Equal(t, decodeLinkExitBadLink, status, scheme)
+			require.Empty(t, output.String(), scheme)
+			require.Contains(t, errorOutput.String(), "error: "+outboundType+" outbound is not included in this build", scheme)
+		}
+		require.NotContains(t, errorOutput.String(), uuid, scheme)
+	}
+}
+
+// An option named by its path goes through the same building: what the outbound takes is
+// printed, what it refuses is the error of the command.
+func TestDecodeLinkOptionPaths(t *testing.T) {
+	const link = "vless://6f1c9a0e-3b52-4c1e-9a55-2d4a1b0f7c11@example.org:443?security=tls&sni=example.org&type=ws"
+	run := func(parameters string) (int, string, string) {
+		var output, errorOutput bytes.Buffer
+		status := decodeLink([]string{link + parameters}, strings.NewReader(""), &output, &errorOutput)
+		return status, output.String(), errorOutput.String()
+	}
+	status, output, errorOutput := run("&sb.multiplex.enabled=1&sb.multiplex.protocol=h2mux&sb.tls.fragment=1&sb.tls.spoof=packagist.org&sb.tls.spoof_method=wrong-md5")
+	require.Zero(t, status, errorOutput)
+	require.Empty(t, errorOutput)
+	var outbound struct {
+		TLS struct {
+			Fragment bool   `json:"fragment"`
+			Spoof    string `json:"spoof"`
+		} `json:"tls"`
+		Multiplex struct {
+			Protocol string `json:"protocol"`
+		} `json:"multiplex"`
+	}
+	require.NoError(t, json.Unmarshal([]byte(output), &outbound))
+	require.True(t, outbound.TLS.Fragment)
+	require.Equal(t, "packagist.org", outbound.TLS.Spoof)
+	require.Equal(t, "h2mux", outbound.Multiplex.Protocol)
+	for parameters, say := range map[string]string{
+		"&sb.tls.min_version=9.9":                                   "error: ",
+		"&sb.tls.spoof=example.org":                                 "error: `spoof` must differ from `server_name`",
+		"&sb.multiplex.enabled=1&sb.multiplex.protocol=carrier":     "error: ",
+		"&sb.detour=direct":                                         "error: the option detour is not for a link to set (another object)",
+		"&sb.tls.certificate_path=%2Fetc":                           "error: the option tls.certificate_path is not for a link to set (a local file)",
+		"&sb.no_such=1":                                             "error: this sing-box has no option no_such",
+		"&sb.multiplex.enabled=1&sb.multiplex.max_connections=many": "error: the value of the link parameter sb.multiplex.max_connections does not fit the option",
+	} {
+		status, output, errorOutput := run(parameters)
+		require.Equal(t, decodeLinkExitBadLink, status, parameters)
+		require.Empty(t, output, parameters)
+		require.True(t, strings.HasPrefix(errorOutput, say), "%s: %q", parameters, errorOutput)
+	}
+}
diff --git a/common/sharelink/encryption_test.go b/common/sharelink/encryption_test.go
new file mode 100644
index 000000000..9b570513b
--- /dev/null
+++ b/common/sharelink/encryption_test.go
@@ -0,0 +1,75 @@
+package sharelink
+
+import (
+	"encoding/base64"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/stretchr/testify/require"
+)
+
+// VLESS Encryption: the setting of a link is passed as it is written, and with it the
+// flow is taken where it is refused without.
+func TestVLESSEncryption(t *testing.T) {
+	t.Parallel()
+	key := base64.RawURLEncoding.EncodeToString(make([]byte, 32))
+	setting := "mlkem768x25519plus.native.0rtt." + key
+	vless := func(link string) option.VLESSOutboundOptions {
+		outbound, _, err := Decode(link)
+		require.NoError(t, err, link)
+		return optionsOf[option.VLESSOutboundOptions](t, outbound)
+	}
+	// the link that came from the field: xhttp over REALITY
+	options := vless(policyBase + "encryption=" + setting + "&security=reality&pbk=" + key + "&sid=ab&sni=s.example.org&fp=firefox&type=xhttp&mode=stream-up&path=%2Fapi")
+	require.Equal(t, setting, options.Encryption)
+	require.Equal(t, "xhttp", options.Transport.Type)
+	// none and nothing are no encryption
+	require.Empty(t, vless(policyBase+"encryption=none&security=tls").Encryption)
+	require.Empty(t, vless(policyBase+"security=tls").Encryption)
+	// the padding and several keys
+	long := "mlkem768x25519plus.random.1rtt.100-111-1111.75-0-111.50-0-3333." + key + "." + key
+	require.Equal(t, long, vless(policyBase+"encryption="+long).Encryption)
+	// with the encryption the flow goes over a transport and without TLS, as in Xray
+	for _, parameters := range []string{
+		"&security=tls&type=xhttp&path=%2Fx",
+		"&security=tls&type=ws&path=%2Fws",
+		"&security=tls&type=grpc&serviceName=s",
+		"&security=none&type=tcp",
+		"&security=reality&pbk=" + key,
+	} {
+		options := vless(policyBase + "encryption=" + setting + "&flow=xtls-rprx-vision" + parameters)
+		require.Equal(t, "xtls-rprx-vision", options.Flow, parameters)
+		require.Equal(t, setting, options.Encryption, parameters)
+	}
+	// by its path too
+	require.Equal(t, setting, vless(policyBase+"security=tls&sb.encryption="+setting).Encryption)
+
+	// a setting Xray would not take is refused
+	for _, bad := range []string{
+		"mlkem768x25519plus.native.0rtt.KEY",
+		"mlkem768x25519plus.native.0rtt",
+		"mlkem768x25519plus.plain.0rtt." + key,
+		"mlkem768x25519plus.native.2rtt." + key,
+		"mlkem768x25519plus.native.0rtt." + key[:40],
+	} {
+		require.Equal(t, "vless-encryption", refusalID(t, policyBase+"encryption="+bad), bad)
+	}
+	// one set by its path as well
+	require.Equal(t, "vless-encryption", refusalID(t, policyBase+"security=tls&sb.encryption=mlkem768x25519plus.native.0rtt.KEY"))
+	require.Equal(t, "vless-encryption", refusalID(t, policyBase+"security=tls&sb.encryption=aes-128-gcm"))
+
+	// what is said of a refused setting repeats nothing of the link: a second link glued
+	// to the first one, a key where the mode belongs, a wrong padding
+	for _, bad := range []string{
+		"mlkem768x25519plus.native.0rttvless://" + testUUID + "@192.0.2.9:443?security=tls",
+		"mlkem768x25519plus." + key + ".native.0rtt",
+		"mlkem768x25519plus.native.1rtt.100-s3cret-5." + key,
+	} {
+		_, _, err := Decode(policyBase + "encryption=" + bad)
+		require.Error(t, err, bad)
+		for _, piece := range []string{key, testUUID, "192.0.2.9", "vless://", "s3cret"} {
+			require.NotContains(t, err.Error(), piece, bad)
+		}
+	}
+}
diff --git a/common/sharelink/fallback.go b/common/sharelink/fallback.go
new file mode 100644
index 000000000..efcc57b90
--- /dev/null
+++ b/common/sharelink/fallback.go
@@ -0,0 +1,472 @@
+package sharelink
+
+import (
+	"context"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/json"
+)
+
+// The options of sing-box that no link has a name for.
+//
+// A link names an option of the outbound by its path in the configuration, after "sb.":
+// "sb.tls.fragment=1", "sb.multiplex.protocol=h2mux", "sb.transport.headers.User-Agent=...".
+// The value is read by the type the option has in this very sing-box: a flag as 1 or 0,
+// a list by commas or as a JSON list, anything else as the configuration writes it. A
+// path names one option: a JSON object, which would set several at once by names nothing
+// has looked at, is not taken. The names a few clients already use are read as the
+// options they stand for (linkAliases).
+//
+// A link is somebody else's text. It may tune how its own server is reached, and nothing
+// more: what points at other objects of the configuration, chooses the local route, reads
+// local files or turns on a feature of the system is not for a link to set (deniedOption).
+
+// optionTypes are the options of the outbound types a link makes.
+var optionTypes = map[string]reflect.Type{
+	C.TypeVLESS:       reflect.TypeOf(option.VLESSOutboundOptions{}),
+	C.TypeTrojan:      reflect.TypeOf(option.TrojanOutboundOptions{}),
+	C.TypeShadowsocks: reflect.TypeOf(option.ShadowsocksOutboundOptions{}),
+	C.TypeSOCKS:       reflect.TypeOf(option.SOCKSOutboundOptions{}),
+	C.TypeHysteria2:   reflect.TypeOf(option.Hysteria2OutboundOptions{}),
+	C.TypeTUIC:        reflect.TypeOf(option.TUICOutboundOptions{}),
+	C.TypeVMess:       reflect.TypeOf(option.VMessOutboundOptions{}),
+	C.TypeHTTP:        reflect.TypeOf(option.HTTPOutboundOptions{}),
+	C.TypeHysteria:    reflect.TypeOf(option.HysteriaOutboundOptions{}),
+	C.TypeAnyTLS:      reflect.TypeOf(option.AnyTLSOutboundOptions{}),
+	C.TypeNaive:       reflect.TypeOf(option.NaiveOutboundOptions{}),
+}
+
+// linkAliases are the names clients use in links for options of sing-box: tfo and
+// tcp-fast-open (sing-box-extended), uot and udp-over-tcp (mihomo), the rest Throne's.
+// The bare "mux" and "fragment" are not among them: clients mean different things by each.
+var linkAliases = map[string]string{
+	"tfo":                 "tcp_fast_open",
+	"tcp-fast-open":       "tcp_fast_open",
+	"tcp_fast_open":       "tcp_fast_open",
+	"uot":                 "udp_over_tcp",
+	"udp-over-tcp":        "udp_over_tcp",
+	"tls_fragment":        "tls.fragment",
+	"tls_record_fragment": "tls.record_fragment",
+	"tls_spoof":           "tls.spoof",
+	"tls_spoof_method":    "tls.spoof_method",
+	"mux_protocol":        "multiplex.protocol",
+	"mux_max_connections": "multiplex.max_connections",
+	"mux_min_streams":     "multiplex.min_streams",
+	"mux_max_streams":     "multiplex.max_streams",
+	"mux_padding":         "multiplex.padding",
+	"brutal_up_mbps":      "multiplex.brutal.up_mbps",
+	"brutal_down_mbps":    "multiplex.brutal.down_mbps",
+}
+
+// The options a link does not set, by the name of the option at any depth.
+var deniedNames = map[string]string{
+	// other objects of the configuration
+	"detour": "another object", "domain_resolver": "another object", "netns": "another object", "http_client": "another object",
+	// the local route
+	"bind_interface": "the local route", "inet4_bind_address": "the local route", "inet6_bind_address": "the local route",
+	"bind_address_no_port": "the local route", "reuse_addr": "the local route", "routing_mark": "the local route",
+	"protect_path": "the local route", "network_strategy": "the local route", "network_type": "the local route",
+	"fallback_network_type": "the local route", "fallback_delay": "the local route",
+	// features of the system
+	"engine": "the system", "kernel_tx": "the system", "kernel_rx": "the system",
+	// how long a dial of this host may wait: a server that never answers a handshake
+	// would hold every connection for as long as its link says, and the pause between
+	// the pieces of a fragmented ClientHello is slept through whatever happens meanwhile
+	"handshake_timeout": "a limit of this host", "fragment_fallback_delay": "a limit of this host",
+	// the Hysteria realm: other servers are asked, and ports of the gateway opened
+	"realm": "another service",
+	// deprecated: a run ends at one about to be removed
+	"domain_strategy": "deprecated", "pq_signature_schemes_enabled": "deprecated", "dynamic_record_sizing_disabled": "deprecated",
+	"recv_window_conn": "deprecated", "recv_window": "deprecated", "disable_mtu_discovery": "deprecated",
+}
+
+// What a link says by itself: the type of the outbound, its name and its server.
+var linkOptions = map[string]bool{"type": true, "tag": true, "server": true, "server_port": true}
+
+// deniedOption tells why a link may not set an option, by its name and by how the option
+// is declared: a reference to another object, an option left out of the schema, a file.
+func deniedOption(name string, field *reflect.StructField) string {
+	if reason, denied := deniedNames[name]; denied {
+		return reason
+	}
+	// tcp_multi_path is not a path
+	if strings.HasSuffix(name, "_path") && name != "tcp_multi_path" {
+		return "a local file"
+	}
+	if field != nil {
+		if _, isReference := field.Tag.Lookup("reference"); isReference {
+			return "another object"
+		}
+		if field.Tag.Get("schema") == "omit" {
+			return "deprecated"
+		}
+	}
+	return ""
+}
+
+// Structures of options with several shapes keep the shapes in fields left out of JSON,
+// and write the one that their type names. unionMembers maps the type to the field.
+var unionMembers = map[string]string{
+	"http":        "HTTPOptions",
+	"ws":          "WebsocketOptions",
+	"quic":        "QUICOptions",
+	"grpc":        "GRPCOptions",
+	"httpupgrade": "HTTPUpgradeOptions",
+	"xhttp":       "XHTTPOptions",
+	"gecko":       "GeckoOptions",
+}
+
+type optionField struct {
+	field reflect.StructField
+	// the union member the field belongs to, if any
+	member string
+}
+
+// jsonFields lists the options a structure has, by their names in JSON, each with every
+// field of that name: the shapes of a union may have options of one name.
+func jsonFields(structType reflect.Type) map[string][]optionField {
+	fields := make(map[string][]optionField)
+	collectFields(structType, "", fields)
+	return fields
+}
+
+func collectFields(structType reflect.Type, member string, fields map[string][]optionField) {
+	for index := 0; index < structType.NumField(); index++ {
+		field := structType.Field(index)
+		if !field.IsExported() {
+			continue
+		}
+		fieldType := field.Type
+		if fieldType.Kind() == reflect.Pointer {
+			fieldType = fieldType.Elem()
+		}
+		tag, hasTag := field.Tag.Lookup("json")
+		name, _, _ := strings.Cut(tag, ",")
+		switch {
+		case name == "-":
+			if fieldType.Kind() == reflect.Struct {
+				collectFields(fieldType, field.Name, fields)
+			}
+		case field.Anonymous && (!hasTag || name == "") && fieldType.Kind() == reflect.Struct:
+			collectFields(fieldType, member, fields)
+		case name != "":
+			fields[name] = append(fields[name], optionField{field, member})
+		}
+	}
+}
+
+// optionType finds the type of the option at a path, as this sing-box declares it, and
+// whether it is a value of a map (a header). node is what the outbound has at the path so
+// far: it tells the shape of a union.
+func optionType(valueType reflect.Type, segments []string, node *object, walked string) (reflect.Type, bool, error) {
+	mapValue := valueType.Kind() == reflect.Map
+	if mapValue {
+		valueType = valueType.Elem()
+	}
+	for valueType.Kind() == reflect.Pointer {
+		valueType = valueType.Elem()
+	}
+	if len(segments) == 0 {
+		return valueType, mapValue, nil
+	}
+	name := segments[0]
+	walked = strings.TrimPrefix(walked+"."+name, ".")
+	var child *object
+	if node != nil {
+		child, _ = node.values[name].(*object)
+	}
+	switch valueType.Kind() {
+	case reflect.Struct:
+		name = strings.ToLower(name)
+		candidates := jsonFields(valueType)[name]
+		if len(candidates) == 0 {
+			return nil, false, refuse("sb-unknown", "this sing-box has no option ", walked)
+		}
+		chosen := candidates[0]
+		if node != nil && node.text("type") != "" {
+			// the shape the structure has now: an option of another shape is not one
+			// the outbound has
+			member := unionMembers[strings.ToLower(node.text("type"))]
+			found := false
+			for _, candidate := range candidates {
+				if candidate.member == "" || candidate.member == member {
+					chosen = candidate
+					found = true
+					break
+				}
+			}
+			if !found {
+				return nil, false, refuse("sb-unknown", "this sing-box has no option ", walked, " for the type", shown(node.text("type")))
+			}
+		}
+		if reason := deniedOption(name, &chosen.field); reason != "" {
+			return nil, false, refuse("sb-denied", "the option ", walked, " is not for a link to set (", reason, ")")
+		}
+		if chosen.field.Type.Kind() == reflect.Map {
+			if len(segments) == 1 {
+				return nil, false, refuse("sb-unknown", "the option ", walked, " is set by its names: ", walked, ".<name>")
+			}
+			// the next name is a key of the map
+			return optionType(chosen.field.Type, segments[2:], nil, walked+"."+segments[1])
+		}
+		return optionType(chosen.field.Type, segments[1:], child, walked)
+	default:
+		return nil, false, refuse("sb-unknown", "this sing-box has no option ", walked)
+	}
+}
+
+var (
+	unmarshalerType        = reflect.TypeOf((*interface{ UnmarshalJSON([]byte) error })(nil)).Elem()
+	contextUnmarshalerType = reflect.TypeOf((*json.ContextUnmarshaler)(nil)).Elem()
+)
+
+func readsItself(valueType reflect.Type) bool {
+	pointer := reflect.PointerTo(valueType)
+	return pointer.Implements(unmarshalerType) || pointer.Implements(contextUnmarshalerType)
+}
+
+func fits(valueType reflect.Type, content []byte) bool {
+	return json.UnmarshalContext(context.Background(), content, reflect.New(valueType).Interface()) == nil
+}
+
+// optionValue reads the text of a link parameter as a value of the type: a flag as 1, 0,
+// true or false, a list by commas, JSON when the text begins with a bracket or a quote,
+// and for a type that reads itself, the first of these that it takes. whole is for a
+// value that is not split by commas: a header has commas of its own.
+func optionValue(valueType reflect.Type, text string, whole bool) (any, bool) {
+	trimmed := strings.TrimSpace(text)
+	quoted, _ := json.Marshal(text)
+	var candidates [][]byte
+	if trimmed != "" && strings.ContainsRune(`{["`, rune(trimmed[0])) {
+		candidates = append(candidates, []byte(trimmed))
+	}
+	list := func() []byte {
+		elementType := valueType.Elem()
+		var items []json.RawMessage
+		for _, item := range strings.Split(text, ",") {
+			value, fit := optionValue(elementType, strings.TrimSpace(item), true)
+			if !fit {
+				return nil
+			}
+			content, err := json.Marshal(value)
+			if err != nil {
+				return nil
+			}
+			items = append(items, content)
+		}
+		content, _ := json.Marshal(items)
+		return content
+	}
+	flag := func() []byte {
+		switch strings.ToLower(trimmed) {
+		case "1", "true":
+			return []byte("true")
+		case "0", "false":
+			return []byte("false")
+		}
+		return nil
+	}
+	plain := func() []byte {
+		if _, err := strconv.ParseFloat(trimmed, 64); err == nil {
+			return []byte(trimmed)
+		}
+		return nil
+	}
+	if readsItself(valueType) {
+		if valueType.Kind() == reflect.Slice && !whole {
+			candidates = append(candidates, list())
+		}
+		candidates = append(candidates, quoted, plain(), flag())
+	} else {
+		switch valueType.Kind() {
+		case reflect.Bool:
+			candidates = append(candidates, flag())
+		case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
+			reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Float32, reflect.Float64:
+			candidates = append(candidates, plain())
+		case reflect.String:
+			candidates = append(candidates, quoted)
+		case reflect.Slice:
+			if valueType.Elem().Kind() == reflect.Uint8 {
+				candidates = append(candidates, quoted)
+			} else if !whole {
+				candidates = append(candidates, list())
+			}
+		}
+	}
+	for _, candidate := range candidates {
+		if candidate == nil || !fits(valueType, candidate) {
+			continue
+		}
+		value, err := parseValue(candidate)
+		if err != nil {
+			continue
+		}
+		return value, true
+	}
+	return nil, false
+}
+
+// fallback sets the options a link names by their paths ("sb.<path>") and by the names
+// of other clients. A path wins over what the link says otherwise, and a name of another
+// client over nothing: it is skipped when the scheme has read it itself.
+func (d *decoder) fallback(outboundType string, options *object) error {
+	type setting struct {
+		key  string // the parameter, as the link writes it
+		path string
+		text string
+	}
+	var settings []setting
+	for key, text := range d.query {
+		if path, isAlias := linkAliases[key]; isAlias && !d.known[key] {
+			settings = append(settings, setting{d.names[key], path, text})
+		}
+	}
+	for key, text := range d.query {
+		if strings.HasPrefix(key, "sb.") {
+			// the path with the case the link writes: a header has one
+			name := d.names[key]
+			if len(name) < len("sb.") {
+				continue
+			}
+			settings = append(settings, setting{name, name[len("sb."):], text})
+		}
+	}
+	if len(settings) == 0 {
+		return nil
+	}
+	sort.SliceStable(settings, func(i, j int) bool {
+		iPath, jPath := strings.HasPrefix(strings.ToLower(settings[i].key), "sb."), strings.HasPrefix(strings.ToLower(settings[j].key), "sb.")
+		if iPath != jPath {
+			return jPath
+		}
+		// a type first: it tells which options the structure has
+		iType, jType := strings.HasSuffix(settings[i].path, ".type"), strings.HasSuffix(settings[j].path, ".type")
+		if iType != jType {
+			return iType
+		}
+		return settings[i].key < settings[j].key
+	})
+	structType, known := optionTypes[outboundType]
+	if !known {
+		return E.New("no options are known for the outbound type ", outboundType)
+	}
+	for _, entry := range settings {
+		d.reads(strings.ToLower(entry.key))
+		segments := strings.Split(entry.path, ".")
+		for _, segment := range segments {
+			if segment == "" {
+				return refuse("sb-unknown", "the link parameter ", entry.key, " names no option")
+			}
+		}
+		if linkOptions[strings.ToLower(segments[0])] {
+			return refuse("sb-denied", "the option ", strings.ToLower(segments[0]), " is not for a link parameter to set (the link)")
+		}
+		valueType, mapValue, err := optionType(structType, segments, options, "")
+		if err != nil {
+			if strings.HasPrefix(strings.ToLower(entry.key), "sb.") {
+				return err
+			}
+			// the name of another client for an option this outbound does not have
+			d.warn(entry.key, " is not an option of this outbound and is ignored")
+			continue
+		}
+		value, fit := optionValue(valueType, entry.text, mapValue)
+		if !fit {
+			return refuse("sb-value", "the value of the link parameter ", entry.key, " does not fit the option")
+		}
+		if hasObject(value) {
+			// the names inside would pass by the list of what a link may not set
+			return refuse("sb-value", "the link parameter ", entry.key, " gives several options at once: each option is set by its own path")
+		}
+		path := lowerOptionNames(structType, segments)
+		if previous, exists := options.at(path); exists {
+			// a list of one is the one: the configuration reads both the same way
+			previousJSON, _ := json.Marshal(single(previous))
+			valueJSON, _ := json.Marshal(single(value))
+			if string(previousJSON) != string(valueJSON) {
+				d.warn(entry.key, " replaces what the link sets otherwise")
+			}
+		}
+		options.set(path, value)
+	}
+	d.notEnabled(structType, options, "")
+	return nil
+}
+
+// single returns the item of a list of one, and any other value as it is.
+func single(value any) any {
+	if list, isList := value.([]any); isList && len(list) == 1 {
+		return list[0]
+	}
+	return value
+}
+
+// hasObject reports whether a value read from a link holds a JSON object at any depth.
+func hasObject(value any) bool {
+	switch typed := value.(type) {
+	case *object:
+		return true
+	case []any:
+		for _, item := range typed {
+			if hasObject(item) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// lowerOptionNames gives a path with the names of options in lower case, as the
+// configuration has them, and the keys of maps as written.
+func lowerOptionNames(valueType reflect.Type, segments []string) string {
+	path := make([]string, 0, len(segments))
+	for _, segment := range segments {
+		for valueType.Kind() == reflect.Pointer {
+			valueType = valueType.Elem()
+		}
+		switch valueType.Kind() {
+		case reflect.Struct:
+			segment = strings.ToLower(segment)
+			candidates := jsonFields(valueType)[segment]
+			if len(candidates) == 0 {
+				return strings.Join(append(path, segment), ".")
+			}
+			valueType = candidates[0].field.Type
+		case reflect.Map:
+			valueType = valueType.Elem()
+		}
+		path = append(path, segment)
+	}
+	return strings.Join(path, ".")
+}
+
+// notEnabled warns of a group of options that has a switch, has options set and is not
+// switched on: sing-box would not use it.
+func (d *decoder) notEnabled(valueType reflect.Type, node *object, path string) {
+	for valueType.Kind() == reflect.Pointer {
+		valueType = valueType.Elem()
+	}
+	if valueType.Kind() != reflect.Struct || node == nil {
+		return
+	}
+	fields := jsonFields(valueType)
+	if switches, hasSwitch := fields["enabled"]; hasSwitch && switches[0].field.Type.Kind() == reflect.Bool && path != "" && !node.empty() {
+		if enabled, _ := node.values["enabled"].(bool); !enabled {
+			d.warn(path, " has options and is not enabled (sb.", path, ".enabled=1): it is not used")
+		}
+	}
+	for _, name := range node.keys {
+		child, isObject := node.values[name].(*object)
+		if !isObject || len(fields[name]) == 0 {
+			continue
+		}
+		d.notEnabled(fields[name][0].field.Type, child, strings.TrimPrefix(path+"."+name, "."))
+	}
+}
