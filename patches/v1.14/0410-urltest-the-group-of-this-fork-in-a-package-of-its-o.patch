+	_, _ = urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	waitSelected(t, group, "second")
+	_, _ = urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	waitConfirmed(t, group, "second")
+	require.Nil(t, group.history.LoadURLTestHistory("second"))
