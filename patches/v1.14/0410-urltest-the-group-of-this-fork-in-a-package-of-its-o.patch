@@ -0,0 +1,992 @@
+package urltestgroup
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/protocol/group"
+	"io"
+	"maps"
+	"net"
+	"slices"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/common/interrupt"
+	"github.com/sagernet/sing-box/common/urltest"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common"
+	"github.com/sagernet/sing/common/batch"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/x/list"
+	"github.com/sagernet/sing/service"
+	"github.com/sagernet/sing/service/pause"
+)
+
+func RegisterURLTest(registry *outbound.Registry) {
+	outbound.Register[option.URLTestOutboundOptions](registry, C.TypeURLTest, NewURLTest)
+}
+
+var (
+	_ adapter.OutboundGroup           = (*URLTest)(nil)
+	_ adapter.InterfaceUpdateListener = (*URLTest)(nil)
+	_ adapter.Referrer                = (*URLTest)(nil)
+)
+
+type URLTest struct {
+	outbound.Adapter
+	ctx                          context.Context
+	outbound                     adapter.OutboundManager
+	logger                       log.ContextLogger
+	tags                         []string
+	fallbackTags                 []string
+	all                          []string
+	links                        []string
+	downloadLink                 string
+	interval                     time.Duration
+	tolerance                    uint16
+	idleTimeout                  time.Duration
+	group                        *URLTestGroup
+	checkAccess                  sync.Mutex
+	interruptExternalConnections bool
+	mode                         string
+	loss                         lossOptions
+}
+
+func NewURLTest(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.URLTestOutboundOptions) (adapter.Outbound, error) {
+	// a new slice: appending to the decoded options could write into their array
+	all := slices.Concat(options.Outbounds, options.Fallbacks)
+	outbound := &URLTest{
+		Adapter:                      outbound.NewAdapter(C.TypeURLTest, tag, []string{N.NetworkTCP, N.NetworkUDP}, all),
+		ctx:                          ctx,
+		outbound:                     service.FromContext[adapter.OutboundManager](ctx),
+		logger:                       logger,
+		tags:                         options.Outbounds,
+		fallbackTags:                 options.Fallbacks,
+		all:                          all,
+		links:                        testLinks(options),
+		interval:                     time.Duration(options.Interval),
+		tolerance:                    options.Tolerance,
+		idleTimeout:                  time.Duration(options.IdleTimeout),
+		interruptExternalConnections: options.InterruptExistConnections,
+	}
+	// without outbounds the fallbacks are all there is (podkop-engine): a provider that took
+	// every server away leaves what the rule falls back on
+	if len(outbound.tags) == 0 && len(outbound.fallbackTags) == 0 {
+		return nil, E.New("missing tags")
+	}
+	for i, tag := range outbound.tags {
+		if slices.Contains(outbound.tags[:i], tag) {
+			return nil, E.New("duplicate tag: ", tag)
+		}
+	}
+	if len(outbound.fallbackTags) > 0 {
+		listed := make(map[string]bool, len(all))
+		for _, member := range outbound.tags {
+			listed[member] = true
+		}
+		for _, member := range outbound.fallbackTags {
+			if listed[member] {
+				return nil, E.New("fallback ", member, " is already listed in outbounds or fallbacks")
+			}
+			listed[member] = true
+		}
+	}
+	for _, link := range outbound.links {
+		if err := checkTestLink(link); err != nil {
+			return nil, err
+		}
+	}
+	var err error
+	outbound.mode, outbound.loss, err = groupMode(options.Mode, options.LossURL, time.Duration(options.LossInterval),
+		options.LossThreshold, options.BalanceSize, time.Duration(options.BalanceIdle))
+	if err != nil {
+		return nil, err
+	}
+	outbound.downloadLink, err = groupDownloadLink(options.DownloadURL)
+	if err != nil {
+		return nil, err
+	}
+	if options.DownloadURL == nil && outbound.downloadLink != "" {
+		err = checkDownloadLink("SING_BOX_URLTEST_DOWNLOAD_URL", outbound.downloadLink)
+		if err != nil {
+			logger.Warn("download test is off: ", err)
+			outbound.downloadLink = ""
+		}
+	}
+	return outbound, nil
+}
+
+func (s *URLTest) Start(stage adapter.StartStage, scope *adapter.Scope) error {
+	switch stage {
+	case adapter.StartStateStart:
+		outbounds := make([]adapter.Outbound, 0, len(s.tags))
+		for i, tag := range s.tags {
+			detour, loaded := s.outbound.Outbound(tag)
+			if !loaded {
+				return E.New("outbound ", i, " not found: ", tag)
+			}
+			outbounds = append(outbounds, detour)
+		}
+		fallbacks := make([]adapter.Outbound, 0, len(s.fallbackTags))
+		for i, tag := range s.fallbackTags {
+			detour, loaded := s.outbound.Outbound(tag)
+			if !loaded {
+				return E.New("fallback ", i, " not found: ", tag)
+			}
+			fallbacks = append(fallbacks, detour)
+		}
+		group, err := NewURLTestGroup(s.ctx, s.outbound, s.logger, outbounds, fallbacks, "", s.downloadLink, s.interval, s.tolerance, s.idleTimeout, s.interruptExternalConnections)
+		if err != nil {
+			return err
+		}
+		group.links = s.links
+		group.mode, group.loss = s.mode, s.loss
+		if s.mode == modeBalance {
+			group.balance.Store(newBalancer())
+		}
+		s.group = group
+	case adapter.StartStateStarted:
+		s.group.PostStart()
+		scope.Add(s.group.Close)
+	}
+	return nil
+}
+
+func (s *URLTest) Now() string {
+	if selected := s.group.selectedOutboundTCP.Load(); selected != nil {
+		return selected.Tag()
+	} else if selected := s.group.selectedOutboundUDP.Load(); selected != nil {
+		return selected.Tag()
+	}
+	return ""
+}
+
+// All lists the outbounds, then the fallbacks.
+func (s *URLTest) All() []string {
+	return s.all
+}
+
+// Fallbacks lists the fallbacks, the end of All (podkop-engine): what is tested is the rest.
+func (s *URLTest) Fallbacks() []string {
+	return s.fallbackTags
+}
+
+func (s *URLTest) Selected(network string) adapter.Outbound {
+	var outbound adapter.Outbound
+	if network == N.NetworkUDP {
+		outbound = s.group.selectedOutboundUDP.Load()
+	} else {
+		outbound = s.group.selectedOutboundTCP.Load()
+	}
+	if outbound == nil {
+		outbound, _ = s.group.Select(network)
+	}
+	return outbound
+}
+
+func (s *URLTest) AttachConnection(closer io.Closer) func() {
+	s.group.Touch()
+	return s.group.interruptGroup.Add(closer, true)
+}
+
+func (s *URLTest) References() []string {
+	group := s.group
+	if group == nil {
+		return nil
+	}
+	var references []string
+	selectedTCP, selectedUDP := group.selectedOutboundTCP.Load(), group.selectedOutboundUDP.Load()
+	if selectedTCP != nil {
+		references = append(references, selectedTCP.Tag())
+	}
+	if selectedUDP != nil && selectedUDP != selectedTCP {
+		references = append(references, selectedUDP.Tag())
+	}
+	// the members of a balance carry connections too (podkop-engine): their idle connections
+	// are kept as the choice's are
+	for _, tag := range group.balanceReferences() {
+		if !slices.Contains(references, tag) {
+			references = append(references, tag)
+		}
+	}
+	return references
+}
+
+func (s *URLTest) URLTest(ctx context.Context) (map[string]uint16, error) {
+	return s.group.URLTest(ctx)
+}
+
+func (s *URLTest) CheckOutbounds() {
+	s.group.CheckOutbounds(s.ctx, true)
+}
+
+// PerformUpdateCheck is the Clash API's: it does not wait for the selection, which may run a
+// download test.
+func (s *URLTest) PerformUpdateCheck() {
+	s.group.requestUpdateCheck()
+}
+
+// NetworkReset is called at a reset of the network before the reset ends the dials in
+// flight (podkop-engine).
+func (s *URLTest) NetworkReset() {
+	if s.group != nil {
+		s.group.networkReset()
+	}
+}
+
+func (s *URLTest) InterfaceUpdated(ctx context.Context) {
+	group := s.group
+	if group == nil {
+		return
+	}
+	group.networkReset()
+	// asked of the group, not of the manager: the group tells a report of no network
+	// that the members have refuted (podkop-engine)
+	if group.networkPaused() {
+		return
+	}
+	go func() {
+		s.checkAccess.Lock()
+		defer s.checkAccess.Unlock()
+		if ctx.Err() != nil {
+			return
+		}
+		group.CheckOutbounds(ctx, true)
+	}()
+}
+
+func (s *URLTest) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	s.group.Touch()
+	var outbound adapter.Outbound
+	switch N.NetworkName(network) {
+	case N.NetworkTCP:
+		outbound = s.group.selectedOutboundTCP.Load()
+	case N.NetworkUDP:
+		outbound = s.group.selectedOutboundUDP.Load()
+	default:
+		return nil, E.Extend(N.ErrUnknownNetwork, network)
+	}
+	balanced, release := s.group.balanced(ctx, N.NetworkName(network))
+	if balanced != nil {
+		outbound = balanced
+	} else if outbound == nil || s.group.selectionPending(outbound) {
+		outbound, _ = s.group.Select(network)
+	}
+	if outbound == nil {
+		return nil, E.New("missing supported outbound")
+	}
+	start := time.Now()
+	conn, err := outbound.DialContext(ctx, network, destination)
+	if err == nil {
+		if N.NetworkName(network) == N.NetworkTCP {
+			s.group.memberSucceeded(outbound)
+		}
+		var handshake *handshakeConn
+		if N.NeedHandshakeForWrite(conn) {
+			handshake = &handshakeConn{Conn: conn, failed: func(err error) {
+				// a write that carries the connect is ended by a change of the network
+				// as a dial is
+				if !s.group.networkChangedSince(start) {
+					s.group.memberFailed(ctx, outbound, N.NetworkName(network), err, time.Time{})
+				}
+			}}
+			conn = handshake
+		}
+		if N.NetworkName(network) == N.NetworkTCP {
+			if watched, isWatched := s.group.watchResponse(conn, outbound, destination).(*responseConn); isWatched {
+				if handshake != nil {
+					handshake.writing = watched.wrote // a write held back by the transport starts the clock
+				}
+				conn = watched
+			}
+		}
+		return s.group.newUseConn(outbound, conn, interrupt.IsExternalConnectionFromContext(ctx), release), nil
+	}
+	if release != nil {
+		release()
+	}
+	s.group.memberFailed(ctx, outbound, N.NetworkName(network), err, start)
+	return nil, memberError(outbound, err)
+}
+
+// memberError names the member a dial through the group failed on. The caller logs the
+// error once, with the tag of the outbound it dialed (the group, or a selector above it):
+// without the member in it nothing in the log says which server failed.
+func memberError(member adapter.Outbound, err error) error {
+	return E.Cause(err, "outbound/", member.Type(), "[", member.Tag(), "]")
+}
+
+func (s *URLTest) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	s.group.Touch()
+	outbound := s.group.selectedOutboundUDP.Load()
+	balanced, release := s.group.balanced(ctx, N.NetworkUDP)
+	if balanced != nil {
+		outbound = balanced
+	} else if outbound == nil || s.group.selectionPending(outbound) {
+		outbound, _ = s.group.Select(N.NetworkUDP)
+	}
+	if outbound == nil {
+		return nil, E.New("missing supported outbound")
+	}
+	conn, err := outbound.ListenPacket(ctx, destination)
+	if err == nil {
+		return s.group.newUsePacketConn(outbound, conn, interrupt.IsExternalConnectionFromContext(ctx), release), nil
+	}
+	if release != nil {
+		release()
+	}
+	s.group.memberFailed(ctx, outbound, N.NetworkUDP, err, time.Time{})
+	return nil, memberError(outbound, err)
+}
+
+type URLTestGroup struct {
+	ctx                          context.Context
+	outbound                     adapter.OutboundManager
+	pause                        pause.Manager
+	pauseCallback                *list.Element[pause.Callback]
+	logger                       log.Logger
+	outbounds                    []adapter.Outbound
+	fallbacks                    []adapter.Outbound
+	members                      []adapter.Outbound // the outbounds, then the fallbacks: what a round tests
+	links                        []string           // the URLs of the tests, one a round in turn (roundPlan)
+	interval                     time.Duration
+	tolerance                    uint16
+	idleTimeout                  time.Duration
+	history                      *urltest.HistoryStorage
+	checking                     atomic.Bool
+	recheck                      atomic.Bool
+	lastRound                    atomic.Int64  // when the last round began, since epoch
+	roundDone                    atomic.Bool   // a round has tested the members (see selectAmong)
+	blockRetry                   time.Duration // the delay of the round retryBlock armed last; under updateAccess
+	blockRetryTimer              *time.Timer   // that round while it waits; under updateAccess
+	selectedOutboundTCP          common.TypedValue[adapter.Outbound]
+	selectedOutboundUDP          common.TypedValue[adapter.Outbound]
+	interruptGroup               *interrupt.Group
+	interruptExternalConnections bool
+	access                       sync.Mutex
+	updateAccess                 sync.Mutex
+	ticker                       *time.Ticker
+	close                        chan struct{}
+	started                      bool
+	lastActive                   common.TypedValue[time.Time]
+	updatePending                atomic.Bool
+	confirmAccess                sync.Mutex
+	confirms                     map[string]*memberConfirm
+	unansweredConfirms           map[string]*memberConfirm
+	epoch                        time.Time
+	successes                    sync.Map // member tag → *atomic.Int64, its last successful TCP dial, since epoch
+	localFailures                sync.Map // member tag → a failure of this host's own network waits to be judged
+	// when the network last paused or woke, and when the pause in force was reported,
+	// since epoch (networkChangedSince, networkPaused)
+	networkEvent    atomic.Int64
+	networkPauseAt  atomic.Int64
+	networkCallback *list.Element[pause.Callback]
+	downloadLink    string
+	frozen          common.TypedValue[map[string]time.Time] // member tag → when it last failed the download test
+	responses       sync.Map                                // member tag → *memberResponses
+	responsesClosed atomic.Bool
+	// cancel ends the rounds, the selection and the tests of the group at its close, and
+	// closed tells it was closed: set under access, so that Touch starts no ticker after
+	// (podkop-engine)
+	cancel context.CancelFunc
+	closed atomic.Bool
+	// hotStart makes the first round test only the members without a result (TakeOver)
+	hotStart bool
+	// uses are the connections the group dialed that are open, by member (MembersInUse)
+	useAccess sync.Mutex
+	uses      map[adapter.Outbound]int
+	// the mode and its options (urltest_loss.go, urltest_balance.go); the loss probes of a
+	// round run while lossRunning
+	mode         string
+	loss         lossOptions
+	balance      atomic.Pointer[balancer]
+	lossRunning  atomic.Bool
+	switchProbes sync.Map // member tag → a probe before a switch to it runs
+	switchProbed sync.Map // member tag → when the last probe before a switch to it began
+}
+
+func NewURLTestGroup(ctx context.Context, outboundManager adapter.OutboundManager, logger log.Logger, outbounds []adapter.Outbound, fallbacks []adapter.Outbound, link string, downloadLink string, interval time.Duration, tolerance uint16, idleTimeout time.Duration, interruptExternalConnections bool) (*URLTestGroup, error) {
+	if interval == 0 {
+		interval = C.DefaultURLTestInterval
+	}
+	if tolerance == 0 {
+		tolerance = 50
+	}
+	if idleTimeout == 0 {
+		idleTimeout = C.DefaultURLTestIdleTimeout
+	}
+	if interval > idleTimeout {
+		return nil, E.New("interval must be less or equal than idle_timeout")
+	}
+	history := service.PtrFromContext[urltest.HistoryStorage](ctx)
+	if history == nil {
+		return nil, E.New("missing URL test history storage")
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	group := &URLTestGroup{
+		ctx:                          ctx,
+		cancel:                       cancel,
+		outbound:                     outboundManager,
+		logger:                       logger,
+		outbounds:                    outbounds,
+		fallbacks:                    fallbacks,
+		members:                      slices.Concat(outbounds, fallbacks),
+		links:                        linkList(link),
+		interval:                     interval,
+		tolerance:                    tolerance,
+		idleTimeout:                  idleTimeout,
+		history:                      history,
+		close:                        make(chan struct{}),
+		pause:                        service.FromContext[pause.Manager](ctx),
+		interruptGroup:               interrupt.NewGroup(),
+		interruptExternalConnections: interruptExternalConnections,
+		epoch:                        time.Now(),
+		downloadLink:                 downloadLink,
+		uses:                         make(map[adapter.Outbound]int),
+		mode:                         modeFastest,
+	}
+	group.watchPause(group.pause)
+	return group, nil
+}
+
+func (g *URLTestGroup) PostStart() {
+	g.access.Lock()
+	defer g.access.Unlock()
+	if g.closed.Load() {
+		return
+	}
+	g.started = true
+	g.lastActive.Store(time.Now())
+	if g.hotStart {
+		go g.checkUntested()
+		return
+	}
+	go g.CheckOutbounds(g.ctx, false)
+}
+
+func (g *URLTestGroup) Touch() {
+	if !g.started {
+		return
+	}
+	g.access.Lock()
+	defer g.access.Unlock()
+	if g.closed.Load() {
+		return
+	}
+	if g.ticker != nil {
+		g.lastActive.Store(time.Now())
+		g.probeUnseenNetwork()
+		return
+	}
+	ticker := time.NewTicker(g.interval)
+	g.ticker = ticker
+	g.pauseCallback = pause.RegisterTicker(g.pause, ticker, g.interval, nil)
+	g.keepTicking()
+	go g.loopCheck(ticker, g.close)
+}
+
+func (g *URLTestGroup) Close() error {
+	g.responsesClosed.Store(true)
+	g.access.Lock()
+	defer g.access.Unlock()
+	if g.closed.Swap(true) {
+		return nil
+	}
+	if g.cancel != nil {
+		g.cancel()
+	}
+	if g.networkCallback != nil {
+		g.pause.UnregisterCallback(g.networkCallback)
+		g.networkCallback = nil
+	}
+	if g.ticker == nil {
+		return nil
+	}
+	g.ticker.Stop()
+	g.ticker = nil
+	g.pause.UnregisterCallback(g.pauseCallback)
+	g.pauseCallback = nil
+	close(g.close)
+	return nil
+}
+
+func (g *URLTestGroup) Select(network string) (adapter.Outbound, bool) {
+	return g.selectAmong(network, nil)
+}
+
+// selectAmong is Select without the members that skip says to pass over. The fastest of the
+// outbounds is chosen, by the tolerance; only when none of them is a candidate, the first
+// fallback that is, in the order of the list.
+func (g *URLTestGroup) selectAmong(network string, skip func(tag string, history *adapter.URLTestHistory) bool) (adapter.Outbound, bool) {
+	var minDelay uint16
+	var minOutbound adapter.Outbound
+	var selected adapter.Outbound
+	// in the mode loss the delays compared are weighed by the loss of the members
+	view := g.lossView()
+	switch network {
+	case N.NetworkTCP:
+		selected = g.selectedOutboundTCP.Load()
+	case N.NetworkUDP:
+		selected = g.selectedOutboundUDP.Load()
+	}
+	// a fallback in use holds back no outbound: it is chosen only while none is a candidate
+	if selected != nil && !g.isFallback(selected) {
+		tag := group.RealTag(selected, network)
+		if history := g.history.LoadURLTestHistory(tag); history != nil && (skip == nil || !skip(tag, history)) {
+			minOutbound = selected
+			minDelay = view.delay(tag, history)
+		}
+	}
+	for _, detour := range g.outbounds {
+		if !common.Contains(detour.Network(), network) {
+			continue
+		}
+		tag := group.RealTag(detour, network)
+		history := g.history.LoadURLTestHistory(tag)
+		if history == nil || (skip != nil && skip(tag, history)) {
+			continue
+		}
+		delay := view.delay(tag, history)
+		if minDelay == 0 || int(minDelay) > int(delay)+int(g.tolerance) {
+			minDelay = delay
+			minOutbound = detour
+		}
+	}
+	if minOutbound == nil {
+		if !g.roundDone.Load() {
+			// before a round has tested them the members have no results, which is no
+			// reason to fall back (podkop-engine): at a start or after a swap a block
+			// fallback would refuse every connection, a direct one send it past the proxy.
+			// The first member, as without fallbacks; in a group of fallbacks alone the
+			// first fallback, not a block further down.
+			for _, detour := range g.members {
+				if common.Contains(detour.Network(), network) {
+					return detour, false
+				}
+			}
+		}
+		for _, detour := range g.fallbacks {
+			if !common.Contains(detour.Network(), network) {
+				continue
+			}
+			if detour.Type() == C.TypeBlock {
+				// a block fallback answers by refusing (podkop-engine): it is what the
+				// rule does when nothing before it answers, never tested
+				return detour, true
+			}
+			tag := group.RealTag(detour, network)
+			history := g.history.LoadURLTestHistory(tag)
+			if history == nil || (skip != nil && skip(tag, history)) {
+				continue
+			}
+			return detour, true
+		}
+		// the plain choice: the first outbound for the network, or, without one, fallback
+		for _, detour := range g.members {
+			if !common.Contains(detour.Network(), network) {
+				continue
+			}
+			return detour, false
+		}
+		return nil, false
+	}
+	return minOutbound, true
+}
+
+func (g *URLTestGroup) isFallback(detour adapter.Outbound) bool {
+	return len(g.fallbacks) > 0 && common.Contains(g.fallbacks, detour)
+}
+
+func (g *URLTestGroup) loopCheck(ticker *time.Ticker, closeChan <-chan struct{}) {
+	if time.Since(g.lastActive.Load()) > g.interval {
+		g.lastActive.Store(time.Now())
+		g.CheckOutbounds(g.ctx, false)
+	}
+	for {
+		select {
+		case <-closeChan:
+			return
+		case <-ticker.C:
+		}
+		if time.Since(g.lastActive.Load()) > g.idleTimeout {
+			g.access.Lock()
+			if g.ticker == ticker {
+				g.ticker.Stop()
+				g.ticker = nil
+				g.pause.UnregisterCallback(g.pauseCallback)
+				g.pauseCallback = nil
+			}
+			g.access.Unlock()
+			return
+		}
+		g.CheckOutbounds(g.ctx, false)
+	}
+}
+
+// requestRecheck asks for one more forced round after the one in progress: that one
+// began before whatever forced this one (a new default interface, mostly), and its
+// results are of the old state.
+func (g *URLTestGroup) requestRecheck() {
+	g.recheck.Store(true)
+	// that round may have ended, and looked at the flag, between the caller's look at it
+	// and the statement above: then this call is the only one left to act on the flag
+	if !g.checking.Load() && g.recheck.Swap(false) && g.ctx.Err() == nil && !g.networkPaused() {
+		go g.CheckOutbounds(g.ctx, true)
+	}
+}
+
+func (g *URLTestGroup) CheckOutbounds(ctx context.Context, force bool) {
+	_, _ = g.urlTest(ctx, force)
+}
+
+// URLTest is the Clash API's round: it does not wait for the selection, which may run a
+// download test, nor for those of the nested urltest groups.
+func (g *URLTestGroup) URLTest(ctx context.Context) (map[string]uint16, error) {
+	if g.closed.Load() {
+		return nil, E.New("the group is closed")
+	}
+	// the round ends with the group too: a group that was replaced must not write results
+	// for the tags another group tests now (podkop-engine)
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	defer context.AfterFunc(g.ctx, cancel)()
+	result, err := g.urlTestRound(ctx, true, false)
+	g.requestUpdateCheck()
+	return result, err
+}
+
+func (g *URLTestGroup) urlTest(ctx context.Context, force bool) (map[string]uint16, error) {
+	result, err := g.urlTestRound(ctx, force, true)
+	g.performUpdateCheck()
+	g.lossRound()
+	return result, err
+}
+
+// urlTestRound tests the members, one round at a time; the selection is not part of the round.
+// With wait, a nested urltest group among the members selects within the round (see
+// URLTestOutbounds).
+func (g *URLTestGroup) urlTestRound(ctx context.Context, force bool, wait bool) (map[string]uint16, error) {
+	return g.urlTestMembers(ctx, g.members, urlTestConcurrency, force, wait)
+}
+
+// urlTestMembers is urlTestRound of some of the members, so many at a time.
+func (g *URLTestGroup) urlTestMembers(ctx context.Context, members []adapter.Outbound, concurrency int, force bool, wait bool) (map[string]uint16, error) {
+	if g.closed.Load() {
+		return make(map[string]uint16), nil
+	}
+	if g.checking.Swap(true) {
+		if force {
+			g.requestRecheck()
+		}
+		return make(map[string]uint16), nil
+	}
+	g.lastRound.Store(int64(time.Since(g.epoch)))
+	defer func() {
+		g.checking.Store(false)
+		g.access.Lock()
+		g.keepTicking()
+		g.access.Unlock()
+		if g.recheck.Swap(false) && g.ctx.Err() == nil && !g.networkPaused() {
+			go g.CheckOutbounds(g.ctx, true)
+		}
+	}()
+	result := urlTestOutbounds(ctx, g.outbound, g.history, g.logger, members, roundPlan(g.links, g.interval, time.Now()), g.interval, force, wait, concurrency)
+	if ctx.Err() == nil {
+		// a round cut short (a delay test of the Clash API that timed out) tested only some
+		g.roundDone.Store(true)
+	}
+	return result, nil
+}
+
+type urlTestResult struct {
+	delay uint16
+	err   error
+}
+
+type urlTestBatch struct {
+	ctx      context.Context
+	outbound adapter.OutboundManager
+	history  *urltest.HistoryStorage
+	logger   log.Logger
+	batch    *batch.Batch[any]
+	checked  map[string]bool
+	groups   []adapter.OutboundGroup
+	wait     bool
+	access   sync.Mutex
+	result   map[string]uint16
+}
+
+// URLTestOutbounds tests outbounds and, through them, the members of nested groups. A nested
+// urltest group runs its own round and then selects. With wait, the call returns after
+// that selection: a periodic round of the group above selects by the nested group's new
+// choice. Without, the selection runs after the call returns: the Clash API answers its
+// client in time, while the selection may run a download test of up to 15 s per candidate.
+func URLTestOutbounds(ctx context.Context, outboundManager adapter.OutboundManager, history *urltest.HistoryStorage, logger log.Logger, outbounds []adapter.Outbound, link string, interval time.Duration, force bool, wait bool) map[string]uint16 {
+	// a test the Clash API asks for has its own URL, and the delay it stores is the one measured
+	return urlTestOutbounds(ctx, outboundManager, history, logger, outbounds, probePlan{links: []string{link}}, interval, force, wait, urlTestConcurrency)
+}
+
+// urlTestConcurrency is how many outbounds a round tests at a time.
+const urlTestConcurrency = 10
+
+func urlTestOutbounds(ctx context.Context, outboundManager adapter.OutboundManager, history *urltest.HistoryStorage, logger log.Logger, outbounds []adapter.Outbound, plan probePlan, interval time.Duration, force bool, wait bool, concurrency int) map[string]uint16 {
+	b, _ := batch.New(ctx, batch.WithConcurrencyNum[any](concurrency))
+	testBatch := &urlTestBatch{
+		ctx:      ctx,
+		outbound: outboundManager,
+		history:  history,
+		logger:   logger,
+		batch:    b,
+		checked:  make(map[string]bool),
+		wait:     wait,
+		result:   make(map[string]uint16),
+	}
+	testBatch.test(outbounds, plan, interval, force)
+	b.Wait()
+	for _, outboundGroup := range testBatch.groups {
+		groupHistory := history.LoadURLTestHistory(group.RealTag(outboundGroup, N.NetworkTCP))
+		if groupHistory != nil {
+			testBatch.result[outboundGroup.Tag()] = groupHistory.Delay
+		}
+	}
+	return testBatch.result
+}
+
+// storeLinkResult keeps whether a test of a round with link answered through the member tag
+// (retryLink, confirmLink): not for a test the Clash API asked for with its own URL, nor for one
+// the end of the round or of the group cut short, which proves nothing of the URL.
+func (b *urlTestBatch) storeLinkResult(plan probePlan, tag string, link string, err error) {
+	if plan.keep == 0 || roundEnded(b.ctx) {
+		return
+	}
+	b.history.StoreURLTestLinkResult(tag, link, err == nil)
+}
+
+// roundEnded tells whether the round of ctx is over (podkop-engine): canceled, or its deadline
+// (a delay test of the Clash API) has come. The timer of the context closes it a moment after
+// the deadline, and until then Err is nil while the tests the deadline cut fail already: a dial
+// under way times out at the deadline, which the dialer takes from the context, and one that
+// got its slot in that moment fails at once with "i/o timeout". Such a failure is the round's,
+// not the member's.
+func roundEnded(ctx context.Context) bool {
+	if ctx.Err() != nil {
+		return true
+	}
+	deadline, hasDeadline := ctx.Deadline()
+	return hasDeadline && !time.Now().Before(deadline)
+}
+
+func (b *urlTestBatch) test(outbounds []adapter.Outbound, plan probePlan, interval time.Duration, force bool) {
+	for _, detour := range outbounds {
+		tag := detour.Tag()
+		if b.checked[tag] || detour.Type() == C.TypeBlock {
+			// a block fallback refuses every test: it answers by being chosen (selectAmong)
+			continue
+		}
+		switch nested := detour.(type) {
+		case *URLTest:
+			b.checked[tag] = true
+			b.groups = append(b.groups, nested)
+			b.batch.Go(tag, func() (any, error) {
+				var nestedResult map[string]uint16
+				if b.wait {
+					nestedResult, _ = nested.group.urlTest(b.ctx, force)
+				} else {
+					nestedResult, _ = nested.group.urlTestRound(b.ctx, force, false)
+					nested.group.requestUpdateCheck()
+				}
+				b.access.Lock()
+				maps.Copy(b.result, nestedResult)
+				b.access.Unlock()
+				return nil, nil
+			})
+		case adapter.OutboundGroup:
+			b.checked[tag] = true
+			b.groups = append(b.groups, nested)
+			b.test(common.FilterNotNil(common.Map(nested.All(), func(it string) adapter.Outbound {
+				member, _ := b.outbound.Outbound(it)
+				return member
+			})), plan, interval, force)
+		default:
+			// A member that some group tested within this round is not tested again. The
+			// group's own test from the previous round must not count: it finished at most
+			// one test timeout after that round began, so it is at least interval minus that
+			// timeout old. Comparing with the whole interval made every other round skip it.
+			history := b.history.LoadURLTestHistory(tag)
+			if !force && history != nil && time.Since(history.Time) < interval-C.TCPTimeout {
+				continue
+			}
+			b.checked[tag] = true
+			b.batch.Go(tag, func() (any, error) {
+				var testResult urlTestResult
+				testResult.delay, testResult.err = testOutbound(b.ctx, b.outbound, plan.links[0], detour)
+				b.storeLinkResult(plan, tag, plan.links[0], testResult.err)
+				if testResult.err != nil && !roundEnded(b.ctx) {
+					// one URL that does not answer through a member is not the member down
+					if retry := plan.retryLink(b.history, tag); retry != "" {
+						b.logger.Debug("outbound ", tag, " did not answer ", plan.links[0], ": ", testResult.err, "; trying ", retry)
+						testResult.delay, testResult.err = testOutbound(b.ctx, b.outbound, retry, detour)
+						b.storeLinkResult(plan, tag, retry, testResult.err)
+					}
+				}
+				// a test the Clash API asked for (plan.keep 0) leaves a member whose delay is the
+				// median of the rounds as it is: one test with the URL of the client is no round
+				byClient := plan.keep == 0 && b.history.URLTestSmoothed(tag)
+				if testResult.err != nil {
+					if roundEnded(b.ctx) || byClient {
+						return nil, nil
+					}
+					b.logger.Debug("outbound ", tag, " unavailable: ", testResult.err)
+					b.history.StoreURLTestFailure(tag, time.Now())
+				} else if byClient {
+					b.access.Lock()
+					b.result[tag] = testResult.delay
+					b.access.Unlock()
+				} else {
+					if b.ctx.Err() != nil {
+						// the round ended with its group (podkop-engine): the tag may be
+						// another outbound's by now
+						return nil, nil
+					}
+					delay := testResult.delay
+					if plan.keep > 0 {
+						delay = b.history.StoreURLTestSample(tag, plan.round, plan.keep, delay)
+						b.logger.Debug("outbound ", tag, " available: ", testResult.delay, "ms, the median of the last ", plan.keep, " rounds ", delay, "ms")
+					} else {
+						b.logger.Debug("outbound ", tag, " available: ", delay, "ms")
+					}
+					b.history.StoreURLTestHistory(tag, &adapter.URLTestHistory{
+						Time:  time.Now(),
+						Delay: delay,
+					})
+					testResult.delay = delay
+					b.access.Lock()
+					b.result[tag] = testResult.delay
+					b.access.Unlock()
+				}
+				return nil, nil
+			})
+		}
+	}
+}
+
+func (g *URLTestGroup) performUpdateCheck() {
+	g.updateAccess.Lock()
+	defer g.updateAccess.Unlock()
+	g.updateSelection()
+}
+
+// updateSelection is performUpdateCheck under its lock. A group that was closed selects no
+// more (podkop-engine): its download test is canceled with it, and what it would choose then
+// was not tested.
+func (g *URLTestGroup) updateSelection() {
+	if g.closed.Load() {
+		return
+	}
+	if g.selectionMayWait() {
+		// new dials already pass over a member without a test result while the selection
+		// waits (selectionPending), which the download test may make long
+		g.closeUnanswered()
+	}
+	var (
+		updated  bool
+		selected bool
+	)
+	// the selection is read by every dial, which may run while it changes: stored atomically
+	outbound, exists := g.selectTested()
+	if g.closed.Load() {
+		return
+	}
+	if outbound != nil {
+		if current := g.selectedOutboundTCP.Load(); current == nil || (exists && outbound != current) {
+			if current != nil {
+				updated = true
+				if g.isFallback(outbound) {
+					g.logger.Warn("switched from outbound ", current.Tag(), " to fallback ", outbound.Tag())
+				} else {
+					g.logger.Warn("switched from outbound ", current.Tag(), " to ", outbound.Tag())
+				}
+			}
+			g.selectedOutboundTCP.Store(outbound)
+			selected = true
+		}
+	}
+	if outbound, exists := g.selectUDP(); outbound != nil {
+		if current := g.selectedOutboundUDP.Load(); current == nil || (exists && outbound != current) {
+			if current != nil {
+				updated = true
+			}
+			g.selectedOutboundUDP.Store(outbound)
+			selected = true
+		}
+	}
+	if g.closed.Load() {
+		return
+	}
+	g.updateBalance()
+	// the connections of a balance do not go by the choice: a new one moves none of them
+	if updated && g.mode != modeBalance {
+		g.interruptGroup.Interrupt(g.interruptExternalConnections)
+	}
+	if selected {
+		g.history.NotifyUpdated()
+	}
+	g.retryBlock()
+	g.closeUnanswered()
+}
+
+// blockRetryFirst is how soon a round follows a selection that left a block fallback chosen
+// (podkop-engine), twice as long each time it still does, at most an interval. Block is
+// never tested and the dials it refuses reach no member, so without these rounds the
+// servers would come back at the next periodic round only, minutes after the network that
+// failed them (an outage of the provider, a start before the WAN is up).
+var blockRetryFirst = 30 * time.Second
+
+// retryBlock arms that round while the TCP choice is a block fallback, and forgets the delay
+// once it is not. Called under updateAccess.
+func (g *URLTestGroup) retryBlock() {
+	current := g.selectedOutboundTCP.Load()
+	if current == nil || current.Type() != C.TypeBlock || !g.isFallback(current) {
+		g.blockRetry = 0
+		if g.blockRetryTimer != nil {
+			g.blockRetryTimer.Stop()
+			g.blockRetryTimer = nil
+		}
+		return
+	}
+	if g.blockRetryTimer != nil {
+		return
+	}
+	if g.blockRetry == 0 {
+		g.blockRetry = blockRetryFirst
+	} else {
+		g.blockRetry = min(2*g.blockRetry, g.interval)
+	}
+	var timer *time.Timer
+	timer = time.AfterFunc(g.blockRetry, func() {
+		g.updateAccess.Lock()
+		if g.blockRetryTimer == timer {
+			// a selection may have disarmed this timer and armed another while this waited
+			g.blockRetryTimer = nil
+		}
+		// an idle group is tested again when a dial comes (Touch), a paused network when it
+		// is back (watchPause); the retries then start over from the first delay
+		resting := g.closed.Load() || g.ctx.Err() != nil || g.networkPaused() || time.Since(g.lastActive.Load()) > g.idleTimeout
+		if resting {
+			g.blockRetry = 0
+		}
+		g.updateAccess.Unlock()
+		if !resting {
+			// not forced: the members without a result, the ones block stands for, are
+			// tested anyway, and a round in progress selects at its end
+			g.CheckOutbounds(g.ctx, false)
+		}
+	})
+	g.blockRetryTimer = timer
+}
diff --git a/protocol/group/urltestgroup/urltest_balance.go b/protocol/group/urltestgroup/urltest_balance.go
new file mode 100644
index 000000000..b7398a353
--- /dev/null
+++ b/protocol/group/urltestgroup/urltest_balance.go
@@ -0,0 +1,331 @@
+package urltestgroup
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/protocol/group"
+	"hash/fnv"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// The mode balance (podkop-engine).
+//
+// The connections of a group are spread over its best members by their source address: a
+// device keeps the member it was given while it has connections and for balance_idle after,
+// so that a site sees one address of it, and is given one by rendezvous hashing over the
+// members of the balance, which moves few devices when a member comes or goes. A device
+// moves at once only when its member is down; otherwise it is hashed again once it has been
+// idle for balance_idle, which returns it to a member that came back. On the stand the
+// balance brought no speed: a device's connections over two servers went no faster than over
+// one, and a slow member made its devices slow; what it gives is the load of the servers
+// spread, and counts of loss of several of them.
+//
+// The members of the balance are at most balance_size outbounds that are up, whose delay
+// (weighed by loss as in the mode loss) is within the tolerance of the best of them, and whose
+// loss, less the loss of the line, is not over loss_threshold. A member comes in only once it
+// has passed the download test, as the member a selection switches to. When none is in, the
+// group goes by its plain choice, the fastest.
+
+const (
+	defaultBalanceSize = 3
+	// maxBalanceSize bounds balance_size: a balance is of a few of the best members.
+	maxBalanceSize = 16
+	// defaultBalanceIdle is how long a device opens no connection before it may move: a
+	// value to be measured on routers with users.
+	defaultBalanceIdle = 5 * time.Minute
+	// balanceForget is how long a device that opens no connection is remembered.
+	balanceForget = time.Hour
+)
+
+type balancer struct {
+	access    sync.Mutex
+	tcp       []adapter.Outbound // the members of the balance for TCP, the best first
+	udp       []adapter.Outbound
+	devices   map[string]*balanceDevice
+	lastSweep time.Time
+}
+
+type balanceDevice struct {
+	member adapter.Outbound
+	active int
+	last   time.Time
+}
+
+func newBalancer() *balancer {
+	return &balancer{devices: make(map[string]*balanceDevice)}
+}
+
+// balanceMembers chooses the members of the balance for the network, passing over those of
+// skip.
+func (g *URLTestGroup) balanceMembers(network string, view lossView, skip map[string]bool) []adapter.Outbound {
+	ranked, delays := g.rankedOutbounds(network, view)
+	var members []adapter.Outbound
+	best := -1
+	for i, member := range ranked {
+		tag := group.RealTag(member, network)
+		if skip[tag] {
+			continue
+		}
+		if loss, known := view[tag]; known && loss.excess > g.loss.threshold {
+			continue
+		}
+		// the tolerance counts from the best member that is in, not from one left out
+		if best < 0 {
+			best = int(delays[i])
+		} else if int(delays[i]) > best+int(g.tolerance) {
+			break
+		}
+		members = append(members, member)
+		if len(members) >= g.loss.balanceSize {
+			break
+		}
+	}
+	return members
+}
+
+// updateBalance chooses the members of the balance anew, after a selection (under
+// updateAccess). A member that was not in the balance passes the download test before it
+// comes in: a server frozen after 16 KB would hang the large downloads of its devices.
+func (g *URLTestGroup) updateBalance() {
+	b := g.balance.Load()
+	if g.mode != modeBalance || b == nil {
+		return
+	}
+	view := g.lossView()
+	b.access.Lock()
+	previous := slices.Clone(b.tcp)
+	b.access.Unlock()
+	failed := make(map[string]bool)
+	tested := make(map[string]bool)
+	var tcp []adapter.Outbound
+	for {
+		tcp = g.balanceMembers(N.NetworkTCP, view, failed)
+		again := false
+		for _, member := range tcp {
+			tag := group.RealTag(member, N.NetworkTCP)
+			if g.downloadLink == "" || member.Type() == C.TypeBlock || slices.Contains(previous, member) || tested[tag] {
+				continue
+			}
+			tested[tag] = true
+			start := time.Now()
+			if g.downloadStopped(tag, member) {
+				g.setFrozen(tag, start)
+				failed[tag] = true
+				again = true
+				break
+			}
+			g.setFrozen(tag, time.Time{})
+		}
+		if !again || g.closed.Load() {
+			break
+		}
+	}
+	udp := g.balanceMembers(N.NetworkUDP, view, failed)
+	b.access.Lock()
+	changed := !slices.Equal(tcp, b.tcp) || !slices.Equal(udp, b.udp)
+	b.tcp, b.udp = tcp, udp
+	b.access.Unlock()
+	if changed {
+		tags := make([]string, len(tcp))
+		for i, member := range tcp {
+			tags[i] = member.Tag()
+		}
+		g.logger.Info("balance over ", len(tags), " outbounds: ", strings.Join(tags, ", "))
+		// the members in use changed: the manager of idle connections keeps theirs
+		g.history.NotifyUpdated()
+	}
+}
+
+// takeBalance hands the balancer of a group that is replaced to its successor (a hot swap):
+// the devices go on with their members and their connections release on the balancer they
+// began on. Its members are those of the new group only, until its first selection chooses
+// them anew; the old group balances no more.
+func (g *URLTestGroup) takeBalance(from *URLTestGroup) {
+	if g.balance.Load() == nil {
+		return
+	}
+	b := from.balance.Swap(nil)
+	if b == nil {
+		return
+	}
+	keep := func(members []adapter.Outbound) []adapter.Outbound {
+		var kept []adapter.Outbound
+		for _, member := range members {
+			if slices.Contains(g.outbounds, member) {
+				kept = append(kept, member)
+			}
+		}
+		return kept
+	}
+	b.access.Lock()
+	b.tcp, b.udp = keep(b.tcp), keep(b.udp)
+	b.access.Unlock()
+	g.balance.Store(b)
+}
+
+// balanceKey is the device a connection comes from: its source address, the same for its TCP
+// and its UDP, so that a site sees one address of it over both (HTTPS and QUIC).
+func balanceKey(ctx context.Context) string {
+	if metadata := adapter.ContextFrom(ctx); metadata != nil && metadata.Source.Addr.IsValid() {
+		return metadata.Source.Addr.Unmap().String()
+	}
+	return ""
+}
+
+// rendezvous is the member of the members the key falls on.
+func rendezvous(key string, members []adapter.Outbound) adapter.Outbound {
+	var (
+		best      adapter.Outbound
+		bestScore uint64
+	)
+	for _, member := range members {
+		hash := fnv.New64a()
+		hash.Write([]byte(key))
+		hash.Write([]byte{0})
+		hash.Write([]byte(member.Tag()))
+		if score := hash.Sum64(); best == nil || score > bestScore {
+			best, bestScore = member, score
+		}
+	}
+	return best
+}
+
+// balanced chooses the member a connection of the network goes by, and returns what to
+// call when the connection is closed; nil when the balance has no member for it. The members
+// are those of the balance that are of the group and up now: one that went down since the
+// last selection takes no device.
+func (g *URLTestGroup) balanced(ctx context.Context, network string) (adapter.Outbound, func()) {
+	b := g.balance.Load()
+	if b == nil {
+		return nil, nil
+	}
+	key := balanceKey(ctx)
+	now := time.Now()
+	b.access.Lock()
+	defer b.access.Unlock()
+	listed := b.tcp
+	if network == N.NetworkUDP {
+		listed = b.udp
+	}
+	var members []adapter.Outbound
+	for _, member := range listed {
+		if slices.Contains(g.outbounds, member) && g.memberAlive(member) {
+			members = append(members, member)
+		}
+	}
+	if len(members) == 0 {
+		return nil, nil
+	}
+	if now.Sub(b.lastSweep) > balanceForget/6 {
+		b.lastSweep = now
+		for oldKey, device := range b.devices {
+			if device.active == 0 && now.Sub(device.last) > balanceForget {
+				delete(b.devices, oldKey)
+			}
+		}
+	}
+	device := b.devices[key]
+	if device == nil {
+		device = &balanceDevice{}
+		b.devices[key] = device
+	}
+	// a device busy or idle for less than balance_idle keeps its member while it is up, in the
+	// balance or not; one idle longer is given the member its address falls on now, which
+	// brings the devices back to a member that was down, and spreads them again
+	keep := device.member != nil && slices.Contains(g.outbounds, device.member) && g.memberAlive(device.member) &&
+		(device.active > 0 || now.Sub(device.last) < g.loss.balanceIdle)
+	member := device.member
+	switch {
+	case keep && slices.Contains(member.Network(), network):
+	case keep:
+		// its member carries no UDP: this connection goes by another, the device keeps its own
+		member = rendezvous(key, members)
+	default:
+		member = rendezvous(key, members)
+		device.member = member
+	}
+	device.active++
+	device.last = now
+	var once sync.Once
+	return member, func() {
+		once.Do(func() {
+			b.access.Lock()
+			device.active--
+			device.last = time.Now()
+			b.access.Unlock()
+		})
+	}
+}
+
+// balanceReferences are the tags of the members the balance uses: those in it and those its
+// devices with connections still go by.
+func (g *URLTestGroup) balanceReferences() []string {
+	b := g.balance.Load()
+	if b == nil {
+		return nil
+	}
+	b.access.Lock()
+	defer b.access.Unlock()
+	var tags []string
+	add := func(member adapter.Outbound) {
+		if member != nil && !slices.Contains(tags, member.Tag()) {
+			tags = append(tags, member.Tag())
+		}
+	}
+	for _, member := range b.tcp {
+		add(member)
+	}
+	for _, member := range b.udp {
+		add(member)
+	}
+	for _, device := range b.devices {
+		if device.active > 0 {
+			add(device.member)
+		}
+	}
+	return tags
+}
+
+// Mode is the mode of the group: fastest, loss or balance.
+func (s *URLTest) Mode() string {
+	return s.mode
+}
+
+// BalanceMember is a member of the balance and the devices it carries.
+type BalanceMember struct {
+	Tag     string `json:"name"`
+	Devices int    `json:"devices"`
+}
+
+// Balance returns the members of the balance for TCP and the devices with open connections
+// on each; nil when the group does not balance.
+func (s *URLTest) Balance() []BalanceMember {
+	g := s.group
+	if g == nil {
+		return nil
+	}
+	b := g.balance.Load()
+	if b == nil {
+		return nil
+	}
+	b.access.Lock()
+	defer b.access.Unlock()
+	members := make([]BalanceMember, len(b.tcp))
+	index := make(map[adapter.Outbound]int, len(b.tcp))
+	for i, member := range b.tcp {
+		members[i].Tag = member.Tag()
+		index[member] = i
+	}
+	for _, device := range b.devices {
+		if i, inBalance := index[device.member]; inBalance && device.active > 0 {
+			members[i].Devices++
+		}
+	}
+	return members
+}
diff --git a/protocol/group/urltestgroup/urltest_download.go b/protocol/group/urltestgroup/urltest_download.go
new file mode 100644
index 000000000..58aa14997
--- /dev/null
+++ b/protocol/group/urltestgroup/urltest_download.go
@@ -0,0 +1,211 @@
+package urltestgroup
+
+import (
+	"context"
+	"errors"
+	"github.com/sagernet/sing-box/protocol/group"
+	"maps"
+	"net/url"
+	"os"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	C "github.com/sagernet/sing-box/constant"
+	E "github.com/sagernet/sing/common/exceptions"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// The download test (podkop-engine).
+//
+// The URL test asks for a few hundred bytes, and a server behind a DPI that freezes every
+// connection after ~16 KB passes it with a good delay: the group selects a member through
+// which nothing but small requests works. So before the group switches to a member, it
+// downloads urltest.DownloadTestSize through it (urltest.DownloadTest). A member whose
+// download stopped on the way is passed over, and tried again once its next test result
+// has come, which the periodic test brings: once an interval while it stays the better
+// choice. A test that could not run (the URL answers with a status, a short body, nothing)
+// says nothing about the member and holds it back from nothing; it is logged, as the URL
+// is the user's. The member in use is tested only when it was taken as the last resort,
+// frozen: a connection that freezes only once it carries data is not seen here.
+//
+// The test URL is the group's download_url; a group without the option takes
+// SING_BOX_URLTEST_DOWNLOAD_URL (the init script sets it from /etc/config/sing-box), and an
+// empty download_url turns the test off for the group. Without either nothing changes.
+// An environment value the test could not use is no reason to refuse the start: the
+// group warns once and goes without the test.
+
+var (
+	downloadTestLink    = os.Getenv("SING_BOX_URLTEST_DOWNLOAD_URL")
+	downloadTestTimeout = C.TCPTimeout
+)
+
+// groupDownloadLink is the download test URL of a group with the download_url option
+// downloadURL (nil when absent). A URL the test could not use is a configuration error,
+// which sing-box check reports: an http or https URL with a host.
+func groupDownloadLink(downloadURL *string) (string, error) {
+	if downloadURL == nil {
+		return downloadTestLink, nil
+	}
+	link := *downloadURL
+	if link == "" {
+		return "", nil
+	}
+	err := checkDownloadLink("download_url", link)
+	if err != nil {
+		return "", err
+	}
+	return link, nil
+}
+
+// checkDownloadLink tells whether the download test can use link, the value of the
+// setting name.
+func checkDownloadLink(name string, link string) error {
+	linkURL, err := url.Parse(link)
+	if err != nil {
+		return E.Cause(err, "parse ", name)
+	}
+	if (linkURL.Scheme != "http" && linkURL.Scheme != "https") || linkURL.Hostname() == "" {
+		return E.New(name, ": an http or https URL with a host expected: ", link)
+	}
+	return nil
+}
+
+// selectTested chooses the TCP member as Select does, except that a member the group would
+// switch to first passes the download test, and in the mode loss is first probed for loss
+// when it has no fresh count (podkop-engine): the probe runs in the background and the member
+// in use stays meanwhile; the probe asks for a selection when it is done. When no candidate
+// passes, a current member with a test result stays; without one, the plain choice is taken:
+// a member frozen after 16 KB carries small requests, a dead one none.
+func (g *URLTestGroup) selectTested() (adapter.Outbound, bool) {
+	if g.downloadLink == "" && g.mode != modeLoss {
+		return g.Select(N.NetworkTCP)
+	}
+	current := g.selectedOutboundTCP.Load()
+	// a member in use that is down is left at once, without a probe, as before
+	currentAlive := current != nil && !g.isFallback(current) && g.memberAlive(current)
+	tried := make(map[string]bool)
+	downloaded := make(map[string]bool)
+	for {
+		candidate, exists := g.selectAmong(N.NetworkTCP, g.skipFrozen(tried))
+		if candidate == nil || !exists {
+			break
+		}
+		if candidate.Type() == C.TypeBlock {
+			// a block fallback downloads nothing: it refuses (podkop-engine)
+			return candidate, true
+		}
+		tag := group.RealTag(candidate, N.NetworkTCP)
+		if candidate == current {
+			if _, wasFrozen := g.frozen.Load()[tag]; !wasFrozen {
+				break
+			}
+			// the member in use was taken as the last resort, frozen, and a newer result
+			// made it a candidate again: it is tested, or it would keep out, by the
+			// tolerance, a member that has recovered meanwhile
+		}
+		if g.downloadLink != "" && !downloaded[tag] {
+			start := time.Now()
+			if g.downloadStopped(tag, candidate) {
+				// frozen as of the start of the test: a URL test that passed while the
+				// download ran (the round forced by a network change, which also cut this
+				// download) is a newer result and brings the member back
+				g.setFrozen(tag, start)
+				tried[tag] = true
+				continue
+			}
+			g.setFrozen(tag, time.Time{})
+			downloaded[tag] = true
+		}
+		if g.mode == modeLoss && currentAlive && candidate != current && g.needsSwitchProbe(tag) {
+			// the switch waits for a count of the candidate: the member in use stays until the
+			// probe is done, and the selection then runs again with what it counted
+			g.startSwitchProbe(tag, candidate)
+			break
+		}
+		return candidate, true
+	}
+	if current != nil && g.history.LoadURLTestHistory(group.RealTag(current, N.NetworkTCP)) != nil {
+		return current, true
+	}
+	return g.Select(N.NetworkTCP)
+}
+
+// selectionPending reports whether the selected member has lost its test result while the
+// download check may keep the next selection waiting (one download test per candidate):
+// connections then go by the plain choice instead of a member known to be down.
+func (g *URLTestGroup) selectionPending(selected adapter.Outbound) bool {
+	return g.selectionMayWait() && g.history.LoadURLTestHistory(group.RealTag(selected, N.NetworkTCP)) == nil
+}
+
+// selectionMayWait tells whether a selection may wait for a test of a candidate: the download
+// test (a loss probe runs in the background).
+func (g *URLTestGroup) selectionMayWait() bool {
+	return g.downloadLink != ""
+}
+
+// selectUDP chooses the UDP member as Select does, passing over the members frozen for TCP.
+func (g *URLTestGroup) selectUDP() (adapter.Outbound, bool) {
+	if candidate, exists := g.selectAmong(N.NetworkUDP, g.skipFrozen(nil)); exists {
+		return candidate, true
+	}
+	return g.Select(N.NetworkUDP)
+}
+
+// skipFrozen passes over the members tried in this selection and those that failed the
+// download test and have no newer test result.
+func (g *URLTestGroup) skipFrozen(tried map[string]bool) func(tag string, history *adapter.URLTestHistory) bool {
+	frozen := g.frozen.Load()
+	return func(tag string, history *adapter.URLTestHistory) bool {
+		if tried[tag] {
+			return true
+		}
+		frozenAt, isFrozen := frozen[tag]
+		return isFrozen && !history.Time.After(frozenAt)
+	}
+}
+
+// setFrozen records when a member failed the download test, or forgets it (zero time).
+// The map is replaced, not changed: selections read it without a lock.
+func (g *URLTestGroup) setFrozen(tag string, at time.Time) {
+	frozen := maps.Clone(g.frozen.Load())
+	if frozen == nil {
+		frozen = make(map[string]time.Time)
+	}
+	if at.IsZero() {
+		delete(frozen, tag)
+	} else {
+		frozen[tag] = at
+	}
+	g.frozen.Store(frozen)
+}
+
+// downloadStopped runs the download test through member and reports whether the download
+// stopped on the way, the one failure that is the member's.
+func (g *URLTestGroup) downloadStopped(tag string, member adapter.Outbound) bool {
+	ctx, cancel := context.WithTimeout(g.ctx, downloadTestTimeout)
+	defer cancel()
+	// a new connection to the first server of the member, like a URL test (probes)
+	if probes.waitHop(ctx, firstHop(g.outbound, member)) != nil {
+		return false
+	}
+	start := time.Now()
+	received, elapsed, err := urltest.DownloadTest(ctx, g.downloadLink, member)
+	switch {
+	case err == nil:
+		g.logger.Debug("outbound ", tag, " download test: ", received, " bytes in ", elapsed.Milliseconds(), "ms")
+		g.history.StoreDownloadResult(tag, urltest.DownloadResult{At: time.Now(), Received: received})
+		g.memberTestPassed(tag, start)
+	case errors.Is(err, urltest.ErrDownloadStopped):
+		g.logger.Warn("outbound ", tag, " download test: ", err)
+		// a download cut by the close of the group or a change of the network says nothing of the
+		// member, and after a swap the tag may be another outbound's
+		if g.ctx.Err() == nil && !g.networkChangedSince(start) {
+			g.history.StoreDownloadResult(tag, urltest.DownloadResult{At: time.Now(), Received: received, Stopped: true})
+		}
+		return true
+	default:
+		g.logger.Warn("outbound ", tag, " download test could not run, the member is not held back: ", err)
+	}
+	return false
+}
diff --git a/protocol/group/urltestgroup/urltest_download_test.go b/protocol/group/urltestgroup/urltest_download_test.go
