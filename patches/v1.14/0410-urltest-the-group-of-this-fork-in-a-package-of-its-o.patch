+	_, err = urlTest.ListenPacket(context.Background(), M.ParseSocksaddr("1.2.3.4:443"))
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "outbound/vless[")
+	require.ErrorIs(t, err, os.ErrInvalid)
+}
