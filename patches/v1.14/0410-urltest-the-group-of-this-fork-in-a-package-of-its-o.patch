diff --git a/common/urltest/download.go b/common/urltest/download.go
new file mode 100644
index 000000000..7ac78518d
--- /dev/null
+++ b/common/urltest/download.go
@@ -0,0 +1,85 @@
+package urltest
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"time"
+
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// DownloadTestSize is how much of the body a download test reads at most: 64 KiB. Connections
+// to foreign servers are reported frozen after 16-20 KB, or 25 packets, in either direction
+// (net4people/bbs#490); 64 KiB is 45 full-size segments, past the largest reported threshold
+// three times over, and what the default test URL asks the server for.
+const DownloadTestSize = 64 * 1024
+
+// ErrDownloadStopped is the failure of a download test that says something about the link:
+// the body began and then stopped, by a stall or a close, before the size arrived. Any other
+// failure (a status, a TLS error, no body at all, a body the server announced shorter than
+// the size) is the test's own and proves nothing about the member.
+var ErrDownloadStopped = E.New("download stopped")
+
+// DownloadTest fetches link through detour and reads DownloadTestSize bytes of the body. It
+// returns the bytes received and the time they took; the error is ErrDownloadStopped when
+// the body stopped on the way (see there), another error when the test could not run.
+func DownloadTest(ctx context.Context, link string, detour N.Dialer) (received int64, elapsed time.Duration, err error) {
+	linkURL, err := url.Parse(link)
+	if err != nil {
+		return
+	}
+	hostname := linkURL.Hostname()
+	port := linkURL.Port()
+	if port == "" {
+		switch linkURL.Scheme {
+		case "http":
+			port = "80"
+		case "https":
+			port = "443"
+		}
+	}
+	start := time.Now()
+	instance, err := detour.DialContext(ctx, "tcp", M.ParseSocksaddrHostPortStr(hostname, port))
+	if err != nil {
+		return
+	}
+	defer instance.Close()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, link, nil)
+	if err != nil {
+		return
+	}
+	// a server that honours ranges sends no more than is read (the default one does not: its
+	// bytes= query sets the size); one that does not is cut off by the read itself. With a
+	// range Go asks for no compression either; the flag below says so explicitly.
+	req.Header.Set("Range", "bytes=0-"+strconv.Itoa(DownloadTestSize-1))
+	client := probeClient(ctx, instance)
+	defer client.CloseIdleConnections()
+	resp, err := client.Do(req)
+	if err != nil {
+		return
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK && resp.StatusCode != http.StatusPartialContent {
+		return 0, 0, E.New("HTTP ", resp.StatusCode)
+	}
+	received, err = io.CopyN(io.Discard, resp.Body, DownloadTestSize)
+	elapsed = time.Since(start)
+	switch {
+	case err == nil:
+		return received, elapsed, nil
+	case received == 0:
+		return 0, elapsed, E.Cause(err, "no body")
+	case errors.Is(err, io.EOF) && (resp.ContentLength < 0 || received == resp.ContentLength):
+		// the whole body, as far as can be told, and it is shorter than the size: the URL
+		// cannot show what the test is for
+		return received, elapsed, E.New("the body is ", received, " bytes, ", DownloadTestSize, " needed")
+	default:
+		return received, elapsed, E.Cause(ErrDownloadStopped, "after ", received, " bytes")
+	}
+}
diff --git a/common/urltest/download_test.go b/common/urltest/download_test.go
new file mode 100644
index 000000000..edbca6eb7
--- /dev/null
+++ b/common/urltest/download_test.go
@@ -0,0 +1,75 @@
+package urltest
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"testing"
+	"time"
+
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestDownloadTest(t *testing.T) {
+	var sawRange, sawEncoding bool
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		sawRange = r.Header.Get("Range") == "bytes=0-"+strconv.Itoa(DownloadTestSize-1)
+		sawEncoding = r.Header.Get("Accept-Encoding") != ""
+		switch r.URL.Path {
+		case "/full":
+			w.Header().Set("Content-Length", strconv.Itoa(DownloadTestSize))
+			w.Write(make([]byte, DownloadTestSize))
+		case "/big": // a server that ignores the range: only the size is read
+			w.Header().Set("Content-Length", strconv.Itoa(4*DownloadTestSize))
+			w.Write(make([]byte, 4*DownloadTestSize))
+		case "/short":
+			w.Header().Set("Content-Length", "1000")
+			w.Write(make([]byte, 1000))
+		case "/chunked-short": // a short body of unknown length cannot be told from a cut one
+			w.(http.Flusher).Flush() // chunked: the server would otherwise count the body itself
+			w.Write(make([]byte, 1000))
+		case "/stall":
+			w.Header().Set("Content-Length", strconv.Itoa(DownloadTestSize))
+			w.Write(make([]byte, 16384))
+			w.(http.Flusher).Flush()
+			<-r.Context().Done()
+		case "/close":
+			w.Header().Set("Content-Length", strconv.Itoa(DownloadTestSize))
+			w.Write(make([]byte, 16384))
+			w.(http.Flusher).Flush()
+			panic(http.ErrAbortHandler)
+		default:
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}))
+	defer server.Close()
+	for _, testCase := range []struct {
+		path     string
+		received int64
+		ok       bool
+		stopped  bool
+	}{
+		{"/full", DownloadTestSize, true, false},
+		{"/big", DownloadTestSize, true, false},
+		{"/short", 1000, false, false},         // the URL cannot show a freeze: not the member's fault
+		{"/chunked-short", 1000, false, false}, // the same, as far as can be told
+		{"/stall", 16384, false, true},         // the body stopped: the link
+		{"/close", 16384, false, true},
+		{"/missing", 0, false, false},
+	} {
+		t.Run(testCase.path, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 500*time.Millisecond)
+			defer cancel()
+			received, _, err := DownloadTest(ctx, server.URL+testCase.path, N.SystemDialer)
+			require.Equal(t, testCase.ok, err == nil, "%v", err)
+			require.Equal(t, testCase.stopped, errors.Is(err, ErrDownloadStopped), "%v", err)
+			require.Equal(t, testCase.received, received)
+			require.True(t, sawRange, "no range asked")
+			require.False(t, sawEncoding, "compression accepted")
+		})
+	}
+}
diff --git a/common/urltest/history_detail.go b/common/urltest/history_detail.go
new file mode 100644
index 000000000..b84522a9e
--- /dev/null
+++ b/common/urltest/history_detail.go
@@ -0,0 +1,195 @@
+package urltest
+
+import (
+	"slices"
+	"time"
+)
+
+// historyDetail is what a HistoryStorage keeps of a tag beyond its last delay, under the lock of
+// the storage: when its last URL test failed, while it has passed none since, and what its last
+// download test found (for a block detector); the delays the URL tests of the last rounds
+// measured (its delay is their median, over keeps[tag] rounds); whether its last URL test with a
+// URL answered, per URL (a server may not reach one operator for good, as its hoster blocks it,
+// and a URL that answered through it last time is the one to try once more after the URL of a
+// round did not); its loss probes.
+type historyDetail struct {
+	failures  map[string]time.Time
+	downloads map[string]DownloadResult
+	samples   map[string][]Sample
+	keeps     map[string]int
+	links     map[string]map[string]bool
+	losses    map[string]*lossState
+}
+
+func newHistoryDetail() historyDetail {
+	return historyDetail{
+		failures:  make(map[string]time.Time),
+		downloads: make(map[string]DownloadResult),
+		samples:   make(map[string][]Sample),
+		keeps:     make(map[string]int),
+		links:     make(map[string]map[string]bool),
+		losses:    make(map[string]*lossState),
+	}
+}
+
+// forget drops all that was found of a tag (DeleteURLTestHistory): it may be another outbound's
+// by now. A failed test is StoreURLTestFailure.
+func (d *historyDetail) forget(tag string) {
+	delete(d.failures, tag)
+	delete(d.downloads, tag)
+	delete(d.samples, tag)
+	delete(d.keeps, tag)
+	delete(d.links, tag)
+	delete(d.losses, tag)
+}
+
+// passed notes a URL test of a tag that passed (StoreURLTestHistory).
+func (d *historyDetail) passed(tag string) {
+	delete(d.failures, tag)
+}
+
+// Sample is the delay a URL test measured in a round (podkop-engine).
+type Sample struct {
+	Round int64
+	Delay uint16
+}
+
+// DownloadResult is what a download test that could run found (podkop-engine).
+type DownloadResult struct {
+	At       time.Time
+	Received int64
+	// the body stopped on the way, after Received bytes
+	Stopped bool
+}
+
+// StoreURLTestLinkResult keeps whether a URL test of a tag with link answered (podkop-engine).
+// A failure of the tag as a whole (StoreURLTestFailure) leaves these alone: which URLs answer
+// through a server is still known when it comes back.
+func (s *HistoryStorage) StoreURLTestLinkResult(tag string, link string, answered bool) {
+	s.access.Lock()
+	defer s.access.Unlock()
+	results := s.detail.links[tag]
+	if results == nil {
+		results = make(map[string]bool)
+		s.detail.links[tag] = results
+	}
+	results[link] = answered
+}
+
+// URLTestLinkAnswered tells whether the last URL test of a tag with link answered, and whether
+// one is known at all (podkop-engine).
+func (s *HistoryStorage) URLTestLinkAnswered(tag string, link string) (answered bool, known bool) {
+	if s == nil {
+		return false, false
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	answered, known = s.detail.links[tag][link]
+	return
+}
+
+// StoreURLTestFailure takes the result of a tag whose URL test failed away, as
+// DeleteURLTestHistory does, and keeps the time of the failure (podkop-engine).
+func (s *HistoryStorage) StoreURLTestFailure(tag string, at time.Time) {
+	s.access.Lock()
+	delete(s.delayHistory, tag)
+	// what it measured before it went down says nothing of it when it comes back
+	delete(s.detail.samples, tag)
+	delete(s.detail.keeps, tag)
+	s.detail.failures[tag] = at
+	s.notifyUpdated()
+	s.access.Unlock()
+}
+
+// StoreURLTestSample keeps the delay a URL test of a tag measured in a round and returns the
+// median of the delays of the last keep rounds, this one among them (podkop-engine). The rounds
+// of a group test its members with its URLs in turn, one a round: the median over as many
+// rounds as there are URLs is the delay to every operator of them, which the delay to one of
+// them is not (a server's way to one operator may be hundreds of milliseconds longer than to
+// another), and one stray test does not move it. A round whose URL did not answer through
+// the member has no sample: it is left out, not counted as slow. A later sample of the same
+// round replaces the earlier one. The median of an even number is the mean of the two
+// middle ones.
+func (s *HistoryStorage) StoreURLTestSample(tag string, round int64, keep int, delay uint16) uint16 {
+	if keep < 1 {
+		keep = 1
+	}
+	s.access.Lock()
+	defer s.access.Unlock()
+	kept := make([]Sample, 0, keep)
+	for _, sample := range s.detail.samples[tag] {
+		// a round ahead of this one is of another schedule (a group that was replaced)
+		if sample.Round > round-int64(keep) && sample.Round < round {
+			kept = append(kept, sample)
+		}
+	}
+	kept = append(kept, Sample{Round: round, Delay: delay})
+	s.detail.samples[tag] = kept
+	s.detail.keeps[tag] = keep
+	return median(kept)
+}
+
+// URLTestSmoothed tells whether the delay of a tag is the median of several rounds
+// (StoreURLTestSample): one test outside the rounds must not replace it (podkop-engine).
+func (s *HistoryStorage) URLTestSmoothed(tag string) bool {
+	if s == nil {
+		return false
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	return s.detail.keeps[tag] > 1 && len(s.detail.samples[tag]) > 0
+}
+
+// LoadURLTestSamples returns the delays StoreURLTestSample keeps of a tag (podkop-engine).
+func (s *HistoryStorage) LoadURLTestSamples(tag string) []Sample {
+	if s == nil {
+		return nil
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	return slices.Clone(s.detail.samples[tag])
+}
+
+func median(samples []Sample) uint16 {
+	delays := make([]int, len(samples))
+	for i, sample := range samples {
+		delays[i] = int(sample.Delay)
+	}
+	slices.Sort(delays)
+	middle := len(delays) / 2
+	if len(delays)%2 == 1 {
+		return uint16(delays[middle])
+	}
+	return uint16((delays[middle-1] + delays[middle] + 1) / 2)
+}
+
+// LoadURLTestFailure returns when the last URL test of a tag failed, if it has passed none since
+// (podkop-engine).
+func (s *HistoryStorage) LoadURLTestFailure(tag string) (at time.Time, loaded bool) {
+	if s == nil {
+		return
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	at, loaded = s.detail.failures[tag]
+	return
+}
+
+// StoreDownloadResult keeps what a download test of a tag found (podkop-engine).
+func (s *HistoryStorage) StoreDownloadResult(tag string, result DownloadResult) {
+	s.access.Lock()
+	s.detail.downloads[tag] = result
+	s.access.Unlock()
+}
+
+// LoadDownloadResult returns what the last download test of a tag that could run found
+// (podkop-engine).
+func (s *HistoryStorage) LoadDownloadResult(tag string) (result DownloadResult, loaded bool) {
+	if s == nil {
+		return
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	result, loaded = s.detail.downloads[tag]
+	return
+}
diff --git a/common/urltest/loss.go b/common/urltest/loss.go
new file mode 100644
index 000000000..373a8391c
--- /dev/null
+++ b/common/urltest/loss.go
@@ -0,0 +1,352 @@
+package urltest
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"time"
+
+	"github.com/sagernet/sing-box/common/probesock"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// The loss probe (podkop-engine).
+//
+// A URL test cannot see loss: a few hundred bytes cross a lossy path as fast as a clean one.
+// A loss probe downloads LossProbeSmall or LossProbeLarge bytes through a server over a TCP
+// connection of its own with a small receive window, and counts the segments of that
+// connection that were lost on the way (probesock). On the stand a single probe of 1 MB
+// called no clean path lossy, found a loss of 2 % or more every time and one of 1 % eight or
+// nine times in ten; one of 256 KB is too short for a decision of its own, and the probes of
+// a server are summed over windows of hours (LossOfWindow).
+
+const (
+	// LossProbeSmall is the size of the periodic probe of a server.
+	LossProbeSmall = 256 << 10
+	// LossProbeLarge is the size of the probe of a server before a switch to it.
+	LossProbeLarge = 1 << 20
+	// LossProbeTimeout bounds a probe: a megabyte at a window of 16 KB over a path of 300 ms is
+	// some twenty seconds.
+	LossProbeTimeout = 30 * time.Second
+)
+
+// ErrLossNotCounted is the failure of a probe that downloaded but could not count: the
+// connection was not its own (a multiplexed transport, QUIC), or the capture could not
+// keep up. It says nothing about the server.
+var ErrLossNotCounted = E.New("loss not counted")
+
+// ErrLossNotOwnConnection wraps ErrLossNotCounted when the probe had no TCP connection of its
+// own (a multiplexed transport, QUIC): probing the member again would not count either.
+var ErrLossNotOwnConnection = E.New("the probe had no connection of its own")
+
+// lossStall is how long a body may bring nothing before the probe calls it stopped: a slow
+// path that keeps bringing data is counted as far as it came, not failed. A variable for the
+// tests, as lossClientTimeout.
+var lossStall = 5 * time.Second
+
+// lossClientTimeout bounds the request of a probe.
+var lossClientTimeout = LossProbeTimeout
+
+// progressReader notes when the last bytes came.
+type progressReader struct {
+	io.Reader
+	last time.Time
+}
+
+func (r *progressReader) Read(p []byte) (int, error) {
+	n, err := r.Reader.Read(p)
+	if n > 0 {
+		r.last = time.Now()
+	}
+	return n, err
+}
+
+// LossSample is what one loss probe counted.
+type LossSample struct {
+	At        time.Time
+	Received  int64 // bytes of the body
+	Elapsed   time.Duration
+	Segments  int
+	Lost      int
+	Reordered int64 // bytes that came out of order and were not lost
+	RTT       time.Duration
+}
+
+// LossProbe downloads size bytes of link through detour over a probe connection and returns
+// what its packets showed. A body cut by the time limit while it still came (a slow path: a
+// megabyte at the window of the probe takes some 50 round trips) is counted as far as it
+// came. An error wrapping ErrLossNotCounted tells a download that went but could not be
+// counted (ErrLossNotOwnConnection: and never will be); one wrapping ErrDownloadStopped, a body
+// that began and then brought nothing for lossStall (the member's failure, as in the
+// download test); another error, a probe that could not run (the URL answered with a status,
+// the dial failed), which proves nothing about the member.
+func LossProbe(ctx context.Context, link string, size int64, detour N.Dialer) (LossSample, error) {
+	var sample LossSample
+	linkURL, err := url.Parse(link)
+	if err != nil {
+		return sample, err
+	}
+	hostname := linkURL.Hostname()
+	port := linkURL.Port()
+	if port == "" {
+		switch linkURL.Scheme {
+		case "http":
+			port = "80"
+		case "https":
+			port = "443"
+		}
+	}
+	probeCtx, socket := probesock.With(ctx, probesock.Window)
+	defer socket.Close()
+	start := time.Now()
+	instance, err := detour.DialContext(probeCtx, "tcp", M.ParseSocksaddrHostPortStr(hostname, port))
+	if err != nil {
+		return sample, err
+	}
+	defer instance.Close()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, link, nil)
+	if err != nil {
+		return sample, err
+	}
+	req.Header.Set("Range", "bytes=0-"+strconv.FormatInt(size-1, 10))
+	client := probeClient(ctx, instance)
+	client.Timeout = lossClientTimeout
+	defer client.CloseIdleConnections()
+	resp, err := client.Do(req)
+	if err != nil {
+		return sample, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK && resp.StatusCode != http.StatusPartialContent {
+		return sample, E.New("HTTP ", resp.StatusCode)
+	}
+	body := &progressReader{Reader: resp.Body, last: time.Now()}
+	received, err := io.CopyN(io.Discard, body, size)
+	sample.Elapsed = time.Since(start)
+	sample.Received = received
+	if err != nil {
+		switch {
+		case received == 0:
+			return sample, E.Cause(err, "no body")
+		case errors.Is(err, io.EOF):
+			// the whole body, shorter than asked: counted as it is
+		case time.Since(body.last) < lossStall:
+			// cut by the time limit (or the end of the group) while it came: counted as far
+			// as it came
+		default:
+			return sample, E.Cause(errors.Join(ErrDownloadStopped, err), "after ", received, " bytes")
+		}
+	}
+	result, err := socket.Finish()
+	if errors.Is(err, probesock.ErrNoOwnConnection) {
+		return sample, E.Cause(errors.Join(ErrLossNotCounted, ErrLossNotOwnConnection), err)
+	}
+	if err != nil {
+		return sample, E.Cause(ErrLossNotCounted, err)
+	}
+	switch {
+	case result.Dropped > 0:
+		return sample, E.Cause(ErrLossNotCounted, "the capture dropped ", result.Dropped, " packets")
+	case result.Bytes < received:
+		// the body came over another connection: the one counted was not the probe's
+		return sample, E.Cause(ErrLossNotCounted, "the connection counted carried ", result.Bytes, " bytes of ", received)
+	}
+	sample.At = time.Now()
+	sample.Segments = result.Segments
+	sample.Lost = result.Lost
+	sample.Reordered = result.ReorderBytes
+	sample.RTT = result.RTT
+	return sample, nil
+}
+
+// LossKeep is how long the samples of a tag are kept: the longest window.
+const LossKeep = 24 * time.Hour
+
+// lossKeepCount bounds the samples of a tag: a probe every minute for a day.
+const lossKeepCount = 1440
+
+type lossState struct {
+	samples []LossSample
+	// when a probe of the tag downloaded and could not count because its connections are not
+	// its own: probing it again soon would not count either
+	notCounted time.Time
+	// when a probe of the tag was made last, and how many in a row failed (no count kept)
+	lastAttempt time.Time
+	failures    int
+}
+
+// StoreLossSample keeps a sample of a tag for LossKeep.
+func (s *HistoryStorage) StoreLossSample(tag string, sample LossSample) {
+	s.access.Lock()
+	defer s.access.Unlock()
+	state := s.detail.losses[tag]
+	if state == nil {
+		state = &lossState{}
+		s.detail.losses[tag] = state
+	}
+	kept := state.samples[:0]
+	for _, old := range state.samples {
+		if sample.At.Sub(old.At) < LossKeep {
+			kept = append(kept, old)
+		}
+	}
+	if len(kept) >= lossKeepCount {
+		kept = kept[len(kept)-lossKeepCount+1:]
+	}
+	state.samples = append(kept, sample)
+	state.notCounted = time.Time{}
+	state.lastAttempt = sample.At
+	state.failures = 0
+	s.notifyUpdated()
+}
+
+// StoreLossFailure records a probe of a tag that kept no count, and returns how many have
+// failed in a row: the next one waits an interval, as after a count.
+func (s *HistoryStorage) StoreLossFailure(tag string, at time.Time) int {
+	s.access.Lock()
+	defer s.access.Unlock()
+	state := s.detail.losses[tag]
+	if state == nil {
+		state = &lossState{}
+		s.detail.losses[tag] = state
+	}
+	state.lastAttempt = at
+	state.failures++
+	return state.failures
+}
+
+// LossAttempt returns when a probe of a tag was made last and how many in a row failed.
+func (s *HistoryStorage) LossAttempt(tag string) (time.Time, int) {
+	if s == nil {
+		return time.Time{}, 0
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	if state := s.detail.losses[tag]; state != nil {
+		return state.lastAttempt, state.failures
+	}
+	return time.Time{}, 0
+}
+
+// StoreLossNotCounted records that a probe of a tag could not count.
+func (s *HistoryStorage) StoreLossNotCounted(tag string, at time.Time) {
+	s.access.Lock()
+	defer s.access.Unlock()
+	state := s.detail.losses[tag]
+	if state == nil {
+		state = &lossState{}
+		s.detail.losses[tag] = state
+	}
+	state.notCounted = at
+	state.lastAttempt = at
+}
+
+// LossNotCounted returns when a probe of a tag last could not count, zero when the last
+// probe counted or there was none.
+func (s *HistoryStorage) LossNotCounted(tag string) time.Time {
+	if s == nil {
+		return time.Time{}
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	if state := s.detail.losses[tag]; state != nil {
+		return state.notCounted
+	}
+	return time.Time{}
+}
+
+// LossWindow is the sum of the samples of a tag over the last hours.
+type LossWindow struct {
+	Hours    int
+	Probes   int
+	Segments int
+	Lost     int
+}
+
+// Rate is the share of the segments that were lost, in percent.
+func (w LossWindow) Rate() float64 {
+	if w.Segments == 0 {
+		return 0
+	}
+	return float64(w.Lost) * 100 / float64(w.Segments)
+}
+
+// LossWindowHours are the windows the loss of a server is told over.
+var LossWindowHours = []int{1, 3, 6, 12, 24}
+
+// LossWindows sums the samples of a tag over each of LossWindowHours before now.
+func (s *HistoryStorage) LossWindows(tag string, now time.Time) []LossWindow {
+	if s == nil {
+		return nil
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	state := s.detail.losses[tag]
+	if state == nil || len(state.samples) == 0 {
+		return nil
+	}
+	windows := make([]LossWindow, len(LossWindowHours))
+	for i, hours := range LossWindowHours {
+		windows[i].Hours = hours
+		for _, sample := range state.samples {
+			if now.Sub(sample.At) < time.Duration(hours)*time.Hour {
+				windows[i].Probes++
+				windows[i].Segments += sample.Segments
+				windows[i].Lost += sample.Lost
+			}
+		}
+	}
+	return windows
+}
+
+// LossOfWindow returns the shortest window of a tag with at least minSegments segments,
+// false when even the longest has fewer: what the loss of the server is decided by, as
+// recent as the probes allow.
+func (s *HistoryStorage) LossOfWindow(tag string, now time.Time, minSegments int) (LossWindow, bool) {
+	for _, window := range s.LossWindows(tag, now) {
+		if window.Segments >= minSegments {
+			return window, true
+		}
+	}
+	return LossWindow{}, false
+}
+
+// LastLossSample returns the newest sample of a tag.
+func (s *HistoryStorage) LastLossSample(tag string) (LossSample, bool) {
+	if s == nil {
+		return LossSample{}, false
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	state := s.detail.losses[tag]
+	if state == nil || len(state.samples) == 0 {
+		return LossSample{}, false
+	}
+	return state.samples[len(state.samples)-1], true
+}
+
+// LossRTT returns the least RTT the samples of a tag measured in the last LossKeep: the
+// RTT of the path to the server, which the loss is weighed by.
+func (s *HistoryStorage) LossRTT(tag string, now time.Time) time.Duration {
+	if s == nil {
+		return 0
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	state := s.detail.losses[tag]
+	if state == nil {
+		return 0
+	}
+	var least time.Duration
+	for _, sample := range state.samples {
+		if sample.RTT > 0 && now.Sub(sample.At) < LossKeep && (least == 0 || sample.RTT < least) {
+			least = sample.RTT
+		}
+	}
+	return least
+}
