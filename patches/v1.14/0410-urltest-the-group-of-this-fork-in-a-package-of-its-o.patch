index 000000000..642e6cc63
--- /dev/null
+++ b/protocol/group/urltestgroup/urltest_download_test.go
@@ -0,0 +1,488 @@
+package urltestgroup
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/common/urltest"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+
+	"github.com/stretchr/testify/require"
+)
+
+// downloadServer answers the URL test at once and the download test as its mode says:
+// "full" (the whole size), "short" (a 1000-byte body), "stall" (16 KB, then nothing, as a
+// frozen connection) or "close" (16 KB, then the connection is closed).
+type downloadServer struct {
+	*httptest.Server
+	mode atomic.Value
+	gets atomic.Int32
+}
+
+func newDownloadServer(t *testing.T, mode string) *downloadServer {
+	s := &downloadServer{}
+	s.mode.Store(mode)
+	s.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodHead {
+			w.WriteHeader(http.StatusNoContent)
+			return
+		}
+		s.gets.Add(1)
+		mode := s.mode.Load().(string)
+		if r.URL.Path != "/" {
+			mode = r.URL.Path[1:] // a mode by path, for several in one server
+		}
+		switch mode {
+		case "full":
+			w.Header().Set("Content-Length", strconv.Itoa(urltest.DownloadTestSize))
+			w.Write(make([]byte, urltest.DownloadTestSize))
+		case "short":
+			w.Header().Set("Content-Length", "1000")
+			w.Write(make([]byte, 1000))
+		case "stall":
+			w.Header().Set("Content-Length", strconv.Itoa(urltest.DownloadTestSize))
+			w.Write(make([]byte, 16384))
+			w.(http.Flusher).Flush()
+			<-r.Context().Done()
+		case "close":
+			w.Header().Set("Content-Length", strconv.Itoa(urltest.DownloadTestSize))
+			w.Write(make([]byte, 16384))
+			w.(http.Flusher).Flush()
+			panic(http.ErrAbortHandler)
+		default:
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}))
+	t.Cleanup(s.Server.Close)
+	return s
+}
+
+// dialTo makes a member whose every connection reaches server, whatever the destination.
+func dialTo(server *downloadServer) func(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return func(ctx context.Context, network string, _ M.Socksaddr) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, network, server.Listener.Addr().String())
+	}
+}
+
+func shortDownloadTimeout(t *testing.T) {
+	saved := downloadTestTimeout
+	downloadTestTimeout = 300 * time.Millisecond
+	t.Cleanup(func() { downloadTestTimeout = saved })
+}
+
+// a dies; b, the next by delay, is frozen after 16 KB: the group passes it over for c,
+// which downloads the whole test, for TCP and UDP alike. b keeps its test result and is not
+// tested again until a newer result comes, then once per result.
+func TestURLTestDownloadCheckPassesOverFrozenMember(t *testing.T) {
+	shortDownloadTimeout(t)
+	full := newDownloadServer(t, "full")
+	frozen := newDownloadServer(t, "stall")
+	var aDead atomic.Bool
+	a := newTestMember(C.TypeVLESS, "a", func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		if aDead.Load() {
+			return nil, syscall.ECONNREFUSED
+		}
+		return dialTo(full)(ctx, network, destination)
+	})
+	b := newTestMember(C.TypeVLESS, "b", dialTo(frozen))
+	c := newTestMember(C.TypeVLESS, "c", dialTo(full))
+	urlTest, group := newTestURLTest(t, full.URL, a, b, c)
+	group.downloadLink = full.URL
+
+	aDead.Store(true)
+	_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	require.Error(t, err)
+	waitSelected(t, group, "c")
+	require.Equal(t, "c", group.selectedOutboundUDP.Load().Tag())
+	require.Equal(t, int32(1), frozen.gets.Load())
+	require.Equal(t, int32(1), full.gets.Load())
+	require.NotNil(t, group.history.LoadURLTestHistory("b"), "the frozen member lost its test result")
+	_, isFrozen := group.frozen.Load()["b"]
+	require.True(t, isFrozen)
+
+	group.performUpdateCheck()
+	require.Equal(t, int32(1), frozen.gets.Load(), "tested again without a new test result")
+	require.Equal(t, "c", group.selectedOutboundTCP.Load().Tag())
+
+	// the next periodic result: b is tried once more, fails again, c stays
+	group.history.StoreURLTestHistory("b", &adapter.URLTestHistory{Time: time.Now(), Delay: 110})
+	group.performUpdateCheck()
+	require.Equal(t, int32(2), frozen.gets.Load())
+	require.Equal(t, "c", group.selectedOutboundTCP.Load().Tag())
+
+	// b recovers: the result after that lets it back, and it is the faster one
+	frozen.mode.Store("full")
+	group.history.StoreURLTestHistory("b", &adapter.URLTestHistory{Time: time.Now(), Delay: 110})
+	group.performUpdateCheck()
+	require.Equal(t, int32(3), frozen.gets.Load())
+	require.Equal(t, "b", group.selectedOutboundTCP.Load().Tag())
+	_, isFrozen = group.frozen.Load()["b"]
+	require.False(t, isFrozen)
+}
+
+// The only other member is frozen: better than a dead one, the group takes it.
+func TestURLTestDownloadCheckFrozenBeatsDead(t *testing.T) {
+	shortDownloadTimeout(t)
+	full := newDownloadServer(t, "full")
+	frozen := newDownloadServer(t, "stall")
+	a := newTestMember(C.TypeVLESS, "a", dialRefused)
+	b := newTestMember(C.TypeVLESS, "b", dialTo(frozen))
+	urlTest, group := newTestURLTest(t, full.URL, a, b)
+	group.downloadLink = full.URL
+
+	_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	require.Error(t, err)
+	waitSelected(t, group, "b")
+	require.Equal(t, int32(1), frozen.gets.Load())
+}
+
+// A connection closed after 16 KB fails the test as a stall does, and at once.
+func TestURLTestDownloadCheckClosedEarly(t *testing.T) {
+	full := newDownloadServer(t, "full")
+	closing := newDownloadServer(t, "close")
+	a := newTestMember(C.TypeVLESS, "a", dialRefused)
+	b := newTestMember(C.TypeVLESS, "b", dialTo(closing))
+	c := newTestMember(C.TypeVLESS, "c", dialTo(full))
+	urlTest, group := newTestURLTest(t, full.URL, a, b, c)
+	group.downloadLink = full.URL
+
+	start := time.Now()
+	_, _ = urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	waitSelected(t, group, "c")
+	require.Less(t, time.Since(start), 2*time.Second)
+}
+
+// A member taken as the last resort, frozen, is tested again when its next result makes it
+// a candidate: a member that has recovered meanwhile, even one within the tolerance, gets
+// its turn instead of being kept out by the member in use.
+func TestURLTestDownloadCheckFrozenLastResortRetested(t *testing.T) {
+	shortDownloadTimeout(t)
+	full := newDownloadServer(t, "full")
+	frozen := newDownloadServer(t, "stall")
+	b := newTestMember(C.TypeVLESS, "b", dialTo(full))
+	a := newTestMember(C.TypeVLESS, "a", dialTo(frozen))
+	_, group := newTestURLTest(t, full.URL, b, a) // b in use, healthy; a frozen
+	group.downloadLink = full.URL
+
+	// b loses its result (a failed test on a lossy link); a fails the download test and is
+	// taken as the last resort
+	group.history.DeleteURLTestHistory("b")
+	group.performUpdateCheck()
+	require.Equal(t, "a", group.selectedOutboundTCP.Load().Tag())
+	require.Equal(t, int32(1), frozen.gets.Load())
+
+	// the next round: both have results again, b within the tolerance of a
+	group.history.StoreURLTestHistory("a", &adapter.URLTestHistory{Time: time.Now(), Delay: 10})
+	group.history.StoreURLTestHistory("b", &adapter.URLTestHistory{Time: time.Now(), Delay: 30})
+	group.performUpdateCheck()
+	require.Equal(t, int32(2), frozen.gets.Load(), "the frozen member in use was not tested again")
+	require.Equal(t, int32(1), full.gets.Load())
+	require.Equal(t, "b", group.selectedOutboundTCP.Load().Tag())
+}
+
+// A test that could not run says nothing about the member: a URL that answers with a
+// status, or with a body shorter than the size, holds no member back.
+func TestURLTestDownloadCheckInconclusive(t *testing.T) {
+	for _, mode := range []string{"short", "missing"} {
+		t.Run(mode, func(t *testing.T) {
+			server := newDownloadServer(t, mode)
+			a := newTestMember(C.TypeVLESS, "a", dialRefused)
+			b := newTestMember(C.TypeVLESS, "b", dialTo(server))
+			urlTest, group := newTestURLTest(t, server.URL, a, b)
+			group.downloadLink = server.URL + "/" + mode
+
+			_, _ = urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+			waitSelected(t, group, "b")
+			require.Equal(t, int32(1), server.gets.Load())
+			require.Empty(t, group.frozen.Load())
+		})
+	}
+}
+
+// While a selection waits (a download test runs), failed dials do not pile up waiting
+// selections: one is pending at most.
+func TestURLTestRequestUpdateCheckCoalesces(t *testing.T) {
+	link, _ := testURL(t, 0)
+	a := newTestMember(C.TypeVLESS, "a", dialRefused)
+	b := newTestMember(C.TypeVLESS, "b", dialWorking)
+	urlTest, group := newTestURLTest(t, link, a, b)
+
+	group.updateAccess.Lock() // as a download test would
+	before := runtime.NumGoroutine()
+	for range 50 {
+		_, _ = urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	}
+	time.Sleep(50 * time.Millisecond)
+	require.LessOrEqual(t, runtime.NumGoroutine()-before, 2, "selections piled up")
+	group.updateAccess.Unlock()
+	waitSelected(t, group, "b")
+}
+
+// The Clash API's update check and round return without waiting for the selection.
+func TestURLTestClashPathsDoNotWait(t *testing.T) {
+	link, _ := testURL(t, 0)
+	a := newTestMember(C.TypeVLESS, "a", dialWorking)
+	urlTest, group := newTestURLTest(t, link, a)
+	group.updateAccess.Lock()
+	defer group.updateAccess.Unlock()
+	done := make(chan struct{})
+	go func() {
+		urlTest.PerformUpdateCheck()
+		_, _ = group.URLTest(context.Background())
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("the Clash API paths waited for the selection")
+	}
+}
+
+// The Clash API's delay test of a group with a nested urltest group (a selector, or a
+// urltest group of groups) does not wait for the nested group's selection either, which
+// then runs afterwards; the periodic round of the group above does wait for it.
+func TestURLTestClashPathsDoNotWaitForNested(t *testing.T) {
+	link, _ := testURL(t, 0)
+	a := newTestMember(C.TypeVLESS, "a", dialWorking)
+	_, nestedGroup := newTestURLTest(t, link, a)
+	nested := &URLTest{Adapter: outbound.NewAdapter(C.TypeURLTest, "nested", []string{N.NetworkTCP, N.NetworkUDP}, nil), group: nestedGroup}
+	manager := &testOutboundManager{members: map[string]adapter.Outbound{"a": a, "nested": nested}}
+	nestedGroup.outbound = manager
+	parent, err := NewURLTestGroup(service.ContextWithPtr(context.Background(), nestedGroup.history), manager, log.NewNOPFactory().Logger(),
+		[]adapter.Outbound{nested}, nil, link, "", time.Minute, 50, 0, false)
+	require.NoError(t, err)
+
+	nestedGroup.updateAccess.Lock() // as a download test would
+	done := make(chan struct{})
+	go func() {
+		URLTestOutbounds(context.Background(), manager, nestedGroup.history, log.NewNOPFactory().Logger(), []adapter.Outbound{nested}, link, 0, true, false)
+		_, _ = parent.URLTest(context.Background())
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("the Clash API paths waited for the selection of the nested group")
+	}
+
+	waited := make(chan struct{})
+	go func() {
+		_, _ = parent.urlTest(context.Background(), true)
+		close(waited)
+	}()
+	select {
+	case <-waited:
+		t.Fatal("the periodic round did not wait for the selection of the nested group")
+	case <-time.After(200 * time.Millisecond):
+	}
+	nestedGroup.updateAccess.Unlock()
+	select {
+	case <-waited:
+	case <-time.After(2 * time.Second):
+		t.Fatal("the periodic round did not end after the selection")
+	}
+}
+
+// While the selected member has no test result (it is down) and the selection waits for a
+// download test, connections go by the plain choice.
+func TestURLTestDialFallsBackWhileSelectionPending(t *testing.T) {
+	link, _ := testURL(t, 0)
+	a := newTestMember(C.TypeVLESS, "a", dialRefused)
+	b := newTestMember(C.TypeVLESS, "b", dialWorking)
+	urlTest, group := newTestURLTest(t, link, a, b)
+	group.downloadLink = link
+	group.history.DeleteURLTestHistory("a")
+	group.updateAccess.Lock() // the selection is busy
+	defer group.updateAccess.Unlock()
+
+	conn, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr(link[len("http://"):]))
+	require.NoError(t, err)
+	conn.Close()
+	require.Equal(t, int32(0), a.dials.Load())
+	require.Equal(t, int32(1), b.dials.Load())
+}
+
+// A test URL whose body is shorter than the size cannot show a freeze: the test is
+// inconclusive and the member is taken.
+func TestURLTestDownloadCheckShortBodyPasses(t *testing.T) {
+	short := newDownloadServer(t, "short")
+	a := newTestMember(C.TypeVLESS, "a", dialRefused)
+	b := newTestMember(C.TypeVLESS, "b", dialTo(short))
+	urlTest, group := newTestURLTest(t, short.URL, a, b)
+	group.downloadLink = short.URL
+
+	_, _ = urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	waitSelected(t, group, "b")
+	require.Equal(t, int32(1), short.gets.Load())
+	require.Empty(t, group.frozen.Load())
+}
+
+// Without a test URL the group switches as before, downloading nothing.
+func TestURLTestDownloadCheckOff(t *testing.T) {
+	frozen := newDownloadServer(t, "stall")
+	a := newTestMember(C.TypeVLESS, "a", dialRefused)
+	b := newTestMember(C.TypeVLESS, "b", dialTo(frozen))
+	urlTest, group := newTestURLTest(t, frozen.URL, a, b)
+	require.Empty(t, group.downloadLink)
+
+	_, _ = urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	waitSelected(t, group, "b")
+	require.Equal(t, int32(0), frozen.gets.Load())
+}
+
+// download_url sets the group's test URL: absent, the environment's is taken; empty, the
+// test is off; a URL the test could not use is an error of the configuration.
+// startURLTest starts a URLTest the way the outbound manager does, in a scope the test
+// closes when it ends.
+func startURLTest(t *testing.T, urlTest *URLTest) error {
+	scope := adapter.NewScope(context.Background(), log.NewNOPFactory().NewLogger("scope"))
+	t.Cleanup(func() { scope.Close() })
+	return urlTest.Start(adapter.StartStateStart, scope)
+}
+
+func TestURLTestDownloadURLOption(t *testing.T) {
+	environment := downloadTestLink
+	t.Cleanup(func() { downloadTestLink = environment })
+	downloadTestLink = "http://environment.test/64k"
+	for _, testCase := range []struct {
+		name   string
+		option *string
+		link   string
+		err    bool
+	}{
+		{"absent", nil, "http://environment.test/64k", false},
+		{"empty", common.Ptr(""), "", false},
+		{"https", common.Ptr("https://download.test/64k"), "https://download.test/64k", false},
+		{"http with a port", common.Ptr("http://download.test:8080/64k"), "http://download.test:8080/64k", false},
+		{"no scheme", common.Ptr("download.test/64k"), "", true},
+		{"not http", common.Ptr("ftp://download.test/64k"), "", true},
+		{"no host", common.Ptr("https:///64k"), "", true},
+		{"unparsable", common.Ptr("://download.test"), "", true},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			member := newTestMember(C.TypeVLESS, "a", dialWorking)
+			ctx := service.ContextWithPtr(context.Background(), urltest.NewHistoryStorage())
+			manager := &testOutboundManager{members: map[string]adapter.Outbound{"a": member}}
+			ctx = service.ContextWith[adapter.OutboundManager](ctx, manager)
+			created, err := NewURLTest(ctx, nil, log.NewNOPFactory().NewLogger("urltest"), "auto", option.URLTestOutboundOptions{
+				Outbounds:   []string{"a"},
+				DownloadURL: testCase.option,
+			})
+			if testCase.err {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			urlTest := created.(*URLTest)
+			require.NoError(t, startURLTest(t, urlTest))
+			require.Equal(t, testCase.link, urlTest.group.downloadLink)
+		})
+	}
+}
+
+type warnLog struct {
+	access sync.Mutex
+	lines  []string
+}
+
+func (l *warnLog) WriteMessage(level log.Level, message string) {
+	if level != log.LevelWarn {
+		return
+	}
+	l.access.Lock()
+	defer l.access.Unlock()
+	l.lines = append(l.lines, message)
+}
+
+func (l *warnLog) take() []string {
+	l.access.Lock()
+	defer l.access.Unlock()
+	lines := l.lines
+	l.lines = nil
+	return lines
+}
+
+// A download test URL from the environment that the test could not use does not stop the
+// start, as a download_url does: the group warns once, when it is created, and works
+// without the download test.
+func TestURLTestDownloadURLEnvironmentUnusable(t *testing.T) {
+	environment := downloadTestLink
+	t.Cleanup(func() { downloadTestLink = environment })
+	for _, testCase := range []struct {
+		name string
+		link string
+		warn bool
+	}{
+		{"usable", "/full", false}, // on the test server
+		{"unset", "", false},
+		{"no scheme", "environment.test/64k", true},
+		{"not http", "ftp://environment.test/64k", true},
+		{"no host", "https:///64k", true},
+		{"unparsable", "://environment.test", true},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			writer := &warnLog{}
+			factory := log.NewDefaultFactory(context.Background(), log.Formatter{BaseTime: time.Now()}, io.Discard, "", writer, false)
+			factory.SetLevel(log.LevelDebug)
+			require.NoError(t, factory.Start())
+			defer factory.Close()
+
+			working := newDownloadServer(t, "full")
+			link := testCase.link
+			if strings.HasPrefix(link, "/") {
+				link = working.URL + link
+			}
+			downloadTestLink = link
+			a := newTestMember(C.TypeVLESS, "a", dialTo(working))
+			b := newTestMember(C.TypeVLESS, "b", dialTo(working))
+			history := urltest.NewHistoryStorage()
+			history.StoreURLTestHistory("a", &adapter.URLTestHistory{Time: time.Now(), Delay: 10})
+			history.StoreURLTestHistory("b", &adapter.URLTestHistory{Time: time.Now(), Delay: 110})
+			ctx := service.ContextWithPtr(context.Background(), history)
+			manager := &testOutboundManager{members: map[string]adapter.Outbound{"a": a, "b": b}}
+			ctx = service.ContextWith[adapter.OutboundManager](ctx, manager)
+			created, err := NewURLTest(ctx, nil, factory.NewLogger("urltest"), "auto", option.URLTestOutboundOptions{
+				Outbounds: []string{"a", "b"},
+				URL:       working.URL,
+			})
+			require.NoError(t, err)
+			urlTest := created.(*URLTest)
+			require.NoError(t, startURLTest(t, urlTest))
+			lines := writer.take()
+			if !testCase.warn {
+				require.Empty(t, lines)
+				require.Equal(t, link, urlTest.group.downloadLink)
+				return
+			}
+			require.Len(t, lines, 1)
+			require.Contains(t, lines[0], "SING_BOX_URLTEST_DOWNLOAD_URL")
+			require.Contains(t, lines[0], "download test is off")
+			require.Empty(t, urlTest.group.downloadLink)
+
+			// the group selects a member without a download and says nothing more of the URL
+			urlTest.group.performUpdateCheck()
+			require.Equal(t, "a", urlTest.group.selectedOutboundTCP.Load().Tag())
+			require.Empty(t, writer.take())
+			require.Equal(t, int32(0), working.gets.Load())
+		})
+	}
+}
diff --git a/protocol/group/urltestgroup/urltest_failure.go b/protocol/group/urltestgroup/urltest_failure.go
new file mode 100644
index 000000000..de60603b7
--- /dev/null
+++ b/protocol/group/urltestgroup/urltest_failure.go
@@ -0,0 +1,470 @@
+package urltestgroup
+
+import (
+	"context"
+	"errors"
+	"github.com/sagernet/sing-box/protocol/group"
+	"io"
+	"net"
+	"os"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	C "github.com/sagernet/sing-box/constant"
+	E "github.com/sagernet/sing/common/exceptions"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service/pause"
+)
+
+// What the group learns from the traffic of its members (podkop-engine).
+//
+// Upstream urltest learns that a member is broken only from its periodic URL test, so a
+// dead server keeps failing every new connection for up to an interval. Here a failed dial
+// through the selected member, or a failed write that carried the handshake the dial
+// deferred, is evidence about the member, used without constants of its own:
+//
+//   - A TCP dial of a protocol that contacts only its own server before the first payload
+//     (see serverOnlyDial) fails for one reason: the server or the way to it. The URL test
+//     dials the same way and would fail the same way, so the failure counts as that test:
+//     the single failed test that already marks a member unavailable. The group selects
+//     again at once; TCP and TLS have already retried until their own timeouts.
+//   - Members that reach the destination when they dial (socks and http CONNECT, direct,
+//     groups) may fail because of the destination, and a packet listen may fail for a
+//     reason the URL test, made over TCP, would not see. One URL test of the member, the
+//     periodic one run out of turn, decides (confirmFailure).
+//
+// A failed dial is not judged at all when another dial through the same member succeeded
+// after it began: the member was reachable meanwhile, the failure was the connection's
+// own (a lost SYN on a lossy link, a destination the proxy could not reach). On a busy
+// router this refutes nearly every chance failure, and a dead member has no successes to
+// refute with. A failed handshake write is not refuted this way: when the server, or the
+// path, drops the first data, every dial succeeds. Only a member with a test result is
+// judged, the others are unavailable already, and a failure the caller caused (it
+// canceled, or closed the connection itself) says nothing.
+//
+// Nor does a failure this host's own network caused, while that network is gone: with no
+// default interface every dial through every member fails at once. The network monitor
+// says so (networkPaused), but a second after the route went: until then the dials fail
+// with "network is unreachable", or with "no such device" when the interface itself is
+// gone (localNetworkError). Such a failure waits for the monitor (afterLocalFailure) and
+// is judged only if the network is still said to be there: then it was the member's own
+// way that was missing. A failure of something that began before the network last went
+// or came back is of the network that was (networkChangedSince): a short outage is over
+// by the time its failures are looked at.
+
+// serverOnlyDial reports whether a dial through outbound contacts only its server, so that a
+// failed dial or handshake write is the server's.
+func serverOnlyDial(outbound adapter.Outbound) bool {
+	switch outbound.Type() {
+	case C.TypeVLESS, C.TypeVMess, C.TypeTrojan, C.TypeShadowsocks, C.TypeShadowTLS,
+		C.TypeHysteria, C.TypeHysteria2, C.TypeTUIC, C.TypeAnyTLS, C.TypeNaive:
+		return true
+	default:
+		return false
+	}
+}
+
+// memberFailed judges a failed dial through member, begun at start, or a failed handshake
+// write (start is zero).
+func (g *URLTestGroup) memberFailed(ctx context.Context, member adapter.Outbound, network string, err error, start time.Time) {
+	if member.Type() == C.TypeBlock {
+		// refusing is what a block fallback is chosen for (podkop-engine)
+		return
+	}
+	if g.closed.Load() {
+		// a group that was replaced judges nothing (podkop-engine): another tests the members
+		// now, and its members may be let go of
+		return
+	}
+	if g.networkPaused() {
+		// without a network every dial fails at once: that says nothing about the member
+		return
+	}
+	// A reset, an EOF, a closed pipe or a timeout are the member's: E.IsClosedOrCanceled
+	// counts them as closed, which suits a copy loop, not this. A timeout stays the
+	// member's even when it also reports itself closed: the idle and handshake timeouts of
+	// quic-go (Hysteria2, TUIC) match net.ErrClosed.
+	// A connect cancelled while its caller still waits was ended by this host: a reset of
+	// the network cancels the one a first write has started (tcp_fast_open). No server
+	// does that.
+	var netErr net.Error
+	timeout := errors.As(err, &netErr) && netErr.Timeout()
+	if ctx.Err() != nil || !timeout && (errors.Is(err, net.ErrClosed) || errors.Is(err, os.ErrClosed) || errors.Is(err, context.Canceled)) {
+		return
+	}
+	tag := group.RealTag(member, network)
+	if localNetworkError(err) {
+		g.afterLocalFailure(tag, func() {
+			g.judgeFailure(tag, member, network, err, start)
+		})
+		return
+	}
+	g.judgeFailure(tag, member, network, err, start)
+}
+
+// judgeFailure decides what a failure that is neither the caller's nor the network's says
+// about the member.
+func (g *URLTestGroup) judgeFailure(tag string, member adapter.Outbound, network string, err error, start time.Time) {
+	if !start.IsZero() && g.networkChangedSince(start) {
+		g.logger.Debug("outbound ", tag, " failed across a change of the network: ", err)
+		return
+	}
+	if !start.IsZero() && g.succeededSince(tag, start) {
+		g.logger.Debug("outbound ", tag, " failed while another connection through it succeeded: ", err)
+		return
+	}
+	if g.history.LoadURLTestHistory(tag) != nil {
+		if network != N.NetworkTCP || !serverOnlyDial(member) {
+			g.confirmFailure(tag, member)
+			return
+		}
+		g.logger.Info("outbound ", tag, " unavailable: ", err)
+		g.history.StoreURLTestFailure(tag, time.Now())
+	}
+	g.requestUpdateCheck()
+}
+
+// localFailureGrace is how long a failure of this host's own network waits for the network
+// monitor, which looks at the routes a second after they change.
+var localFailureGrace = 3 * time.Second
+
+// localNetworkError reports whether err is this host's own refusal to send: no route to
+// the address, no interface that is up, no address to send from, or no interface at all
+// where the socket is bound to one: an interface that is taken down gives the first, one
+// that is removed (a PPPoE session that ended, a modem unplugged) the last.
+func localNetworkError(err error) bool {
+	return errors.Is(err, syscall.ENETUNREACH) || errors.Is(err, syscall.ENETDOWN) || errors.Is(err, syscall.EADDRNOTAVAIL) ||
+		errors.Is(err, syscall.ENODEV)
+}
+
+// afterLocalFailure runs judge for a failure of this host's own network through the member
+// once the network monitor has had time to tell whether the network is gone. It is not run
+// if the network is reported gone by then, or if the member was tested or carried a
+// connection since: the failure is of the past. A member has one failure waiting at a time.
+func (g *URLTestGroup) afterLocalFailure(tag string, judge func()) {
+	if _, waiting := g.localFailures.LoadOrStore(tag, struct{}{}); waiting {
+		return
+	}
+	failed := time.Now()
+	time.AfterFunc(localFailureGrace, func() {
+		g.localFailures.Delete(tag)
+		if g.ctx.Err() != nil || g.networkPaused() || g.networkChangedSince(failed) || g.succeededSince(tag, failed) {
+			return
+		}
+		history := g.history.LoadURLTestHistory(tag)
+		if history != nil && history.Time.After(failed) {
+			return
+		}
+		judge()
+	})
+}
+
+// networkPaused reports whether the device sleeps or has no default interface. The ticker
+// of the group stops for that time, and so must the judgements made from traffic: they
+// would erase the test results of every member the group tries, one after another.
+//
+// The monitor looks for a default route in the main table. Where the routes are elsewhere
+// (another table) it reports no default interface for good while the network works. A
+// member that has passed a URL test after the report is the proof of that, and while
+// some member holds such a result the report is not believed: the members are judged as
+// if the monitor had said nothing, and the ticker of the group runs (keepTicking).
+func (g *URLTestGroup) networkPaused() bool {
+	if g.pause == nil {
+		return false
+	}
+	if g.pause.IsDevicePaused() {
+		return true
+	}
+	if !g.pause.IsNetworkPaused() {
+		return false
+	}
+	reported := g.epoch.Add(time.Duration(g.networkPauseAt.Load()))
+	for _, member := range g.members {
+		history := g.history.LoadURLTestHistory(group.RealTag(member, N.NetworkTCP))
+		if history != nil && history.Time.After(reported) {
+			return false
+		}
+	}
+	return true
+}
+
+// watchPause makes the group follow a pause manager.
+func (g *URLTestGroup) watchPause(manager pause.Manager) {
+	g.pause = manager
+	if manager == nil {
+		return
+	}
+	if manager.IsDevicePaused() || manager.IsNetworkPaused() {
+		g.networkPauseAt.Store(max(int64(time.Since(g.epoch)), 1))
+	}
+	// called under the lock of the manager: nothing of it is asked there
+	g.networkCallback = manager.RegisterCallback(func(event int) {
+		now := max(int64(time.Since(g.epoch)), 1)
+		g.networkEvent.Store(now)
+		if event == pause.EventDevicePaused || event == pause.EventNetworkPause {
+			g.networkPauseAt.Store(now)
+		}
+	})
+}
+
+// keepTicking restarts the ticker of the group where the report of no network is not
+// believed (networkPaused). The manager stops the ticker of a group for as long as it
+// reports a pause; where that is for good no round would test the members again, and
+// each of them would be lost at its first failure. The caller holds the lock.
+func (g *URLTestGroup) keepTicking() {
+	if g.ticker == nil || g.pause == nil || g.pause.IsDevicePaused() || !g.pause.IsNetworkPaused() || g.networkPaused() {
+		return
+	}
+	g.ticker.Reset(g.interval)
+}
+
+// probeUnseenNetwork runs a round where the manager reports no network and no member has
+// a test result: nothing else would. Where the monitor never sees a default route and
+// sing-box started before the uplink was there, the round at start failed, the ticker
+// stays stopped (keepTicking has nothing to refute the report with), and no event comes
+// when the uplink does. A round an interval at most, and only while the group is in use;
+// while a member has a result the report stands: the rounds of a real outage would erase
+// the results it keeps. The caller holds the lock.
+func (g *URLTestGroup) probeUnseenNetwork() {
+	if g.pause == nil || g.pause.IsDevicePaused() || !g.pause.IsNetworkPaused() {
+		return
+	}
+	now, last := int64(time.Since(g.epoch)), g.lastRound.Load()
+	if now-last < int64(g.interval) {
+		return
+	}
+	for _, member := range g.members {
+		if g.history.LoadURLTestHistory(group.RealTag(member, N.NetworkTCP)) != nil {
+			return
+		}
+	}
+	if g.lastRound.CompareAndSwap(last, now) {
+		go g.CheckOutbounds(g.ctx, false)
+	}
+}
+
+// networkReset records a reset of the network: the connections through the members
+// were closed and their outbounds told of a new default interface, which ends their
+// dials in flight. It comes a moment after the monitor's word, or with none at all (an
+// address added on the uplink, the connections closed from the Clash API).
+func (g *URLTestGroup) networkReset() {
+	g.networkEvent.Store(max(int64(time.Since(g.epoch)), 1))
+}
+
+// networkChangedSince reports whether the network went, came back or was reset after t.
+func (g *URLTestGroup) networkChangedSince(t time.Time) bool {
+	return g.networkEvent.Load() > int64(t.Sub(g.epoch))
+}
+
+// memberSucceeded records a successful TCP dial through member.
+func (g *URLTestGroup) memberSucceeded(member adapter.Outbound) {
+	tag := group.RealTag(member, N.NetworkTCP)
+	value, loaded := g.successes.Load(tag)
+	if !loaded {
+		value, _ = g.successes.LoadOrStore(tag, new(atomic.Int64))
+	}
+	value.(*atomic.Int64).Store(int64(time.Since(g.epoch)))
+}
+
+// succeededSince reports whether a TCP dial through the member succeeded after start.
+func (g *URLTestGroup) succeededSince(tag string, start time.Time) bool {
+	value, loaded := g.successes.Load(tag)
+	return loaded && value.(*atomic.Int64).Load() > int64(start.Sub(g.epoch))
+}
+
+// requestUpdateCheck selects again in the background; failures that come while a selection
+// waits to run are covered by it, so at most one selection waits at any time (a selection
+// may run long: the download test).
+func (g *URLTestGroup) requestUpdateCheck() {
+	if g.closed.Load() || g.updatePending.Swap(true) {
+		return
+	}
+	go func() {
+		g.updateAccess.Lock()
+		defer g.updateAccess.Unlock()
+		g.updatePending.Store(false)
+		g.updateSelection()
+	}()
+}
+
+type memberConfirm struct {
+	running     bool
+	notBefore   time.Time
+	pause       time.Duration
+	lastFailure time.Time
+}
+
+// confirmFailure has one URL test of the member tell its failure from the destination's,
+// and reports whether it started one.
+// The test is the periodic one, with its timeout; a failed test makes the member
+// unavailable, and the group selects again. A test that finds the member working changes
+// nothing (the periodic test keeps its schedule), but delays the next one: as long as the
+// test took, then twice as long after each false alarm, at most an interval, after which
+// the periodic test covers the member anyway. The delays grow for as long as failures keep
+// coming, tested or not, and start over after an interval without any. A false alarm that
+// persists, like an application calling a dead site again and again, so costs at most one
+// test per interval, as many as the periodic test, while an isolated one leaves the member
+// unwatched only for the length of a test.
+func (g *URLTestGroup) confirmFailure(tag string, member adapter.Outbound) bool {
+	return g.confirmWith(&g.confirms, tag, member)
+}
+
+// confirmUnanswered is confirmFailure for connections that got no answer (see
+// urltest_response.go), with pauses of its own: a quiet router whose traffic goes to dead
+// destinations keeps the member passing these tests, and must not delay the tests of
+// failed dials.
+func (g *URLTestGroup) confirmUnanswered(tag string, member adapter.Outbound) bool {
+	return g.confirmWith(&g.unansweredConfirms, tag, member)
+}
+
+func (g *URLTestGroup) confirmWith(confirms *map[string]*memberConfirm, tag string, member adapter.Outbound) bool {
+	if g.networkPaused() {
+		return false
+	}
+	now := time.Now()
+	g.confirmAccess.Lock()
+	if *confirms == nil {
+		*confirms = make(map[string]*memberConfirm)
+	}
+	state := (*confirms)[tag]
+	if state == nil {
+		state = &memberConfirm{}
+		(*confirms)[tag] = state
+	}
+	if now.Sub(state.lastFailure) > g.interval {
+		state.pause, state.notBefore = 0, time.Time{}
+	}
+	state.lastFailure = now
+	if state.running || now.Before(state.notBefore) {
+		g.confirmAccess.Unlock()
+		return false
+	}
+	state.running = true
+	g.confirmAccess.Unlock()
+	go func() {
+		// past probeSlots: one test of a member whose connections fail, paced as above, is
+		// no burst, and behind the rounds it would keep the group on a dead member. Its first
+		// server is waited for: the members of a dead detour fail all at once.
+		if probes.waitHop(g.ctx, firstHop(g.outbound, member)) != nil {
+			g.confirmAccess.Lock()
+			state.running = false
+			g.confirmAccess.Unlock()
+			return
+		}
+		start := time.Now()
+		// a URL that answered through the member last time: one its server cannot reach
+		// would call it down while its connections fail for another reason
+		link := roundPlan(g.links, g.interval, start).confirmLink(g.history, tag)
+		_, err := probeOutbound(g.ctx, link, member)
+		now := time.Now()
+		if g.ctx.Err() == nil && !g.networkPaused() && !g.networkChangedSince(start) {
+			g.history.StoreURLTestLinkResult(tag, link, err == nil)
+		}
+		g.confirmAccess.Lock()
+		state.running = false
+		if err == nil {
+			state.pause = min(max(2*state.pause, now.Sub(start)), g.interval)
+			state.notBefore = now.Add(state.pause)
+		}
+		g.confirmAccess.Unlock()
+		if err == nil {
+			g.memberTestPassed(tag, start)
+		}
+		if err == nil || g.ctx.Err() != nil || g.networkPaused() || g.networkChangedSince(start) {
+			// a test that failed because the network went away meanwhile proves nothing
+			return
+		}
+		unavailable := func() {
+			g.logger.Info("outbound ", tag, " unavailable: ", err)
+			g.history.StoreURLTestFailure(tag, time.Now())
+			g.performUpdateCheck()
+		}
+		if localNetworkError(err) {
+			g.afterLocalFailure(tag, unavailable)
+			return
+		}
+		unavailable()
+	}()
+	return true
+}
+
+// probeSlots bound how many URL tests run at once in the whole process (podkop-engine):
+// every group runs its rounds at its own time, ten members at once, so a router with a few
+// groups of large subscriptions would open tens of connections at a time. Bursts of TLS
+// hellos are what operators' DPI freezes, and a small CPU lags under them.
+var probeSlots = make(chan struct{}, 4)
+
+// testOutbound runs one URL test of detour (probeOutbound) once one of probeSlots is free and
+// the first server of detour may take a new connection (probes): the waits do not take the
+// time of the test. A test of detour with link another group runs is waited for instead.
+func testOutbound(ctx context.Context, manager adapter.OutboundManager, link string, detour adapter.Outbound) (uint16, error) {
+	return probes.test(ctx, manager, link, detour, probeSlots)
+}
+
+// probeOutbound runs one URL test of detour, bounded by the TCP timeout.
+func probeOutbound(ctx context.Context, link string, detour adapter.Outbound) (uint16, error) {
+	ctx, cancel := context.WithTimeout(ctx, C.TCPTimeout)
+	defer cancel()
+	type result struct {
+		delay uint16
+		err   error
+	}
+	done := make(chan result, 1)
+	go func() {
+		delay, err := urltest.URLTest(ctx, link, detour)
+		done <- result{delay, err}
+	}()
+	select {
+	case r := <-done:
+		return r.delay, r.err
+	case <-ctx.Done():
+		return 0, ctx.Err()
+	}
+}
+
+// handshakeConn reports a failed write that carried the handshake a dial deferred
+// (N.NeedHandshakeForWrite), then gets out of the way: once the handshake has gone out it is
+// replaceable, and the copy loop writes to the connection under it directly.
+type handshakeConn struct {
+	net.Conn
+	done    atomic.Bool
+	failed  func(error)
+	writing func() // called before a write that carries data, until the handshake is done
+}
+
+func (c *handshakeConn) Write(b []byte) (int, error) {
+	if c.writing != nil && len(b) > 0 && !c.done.Load() {
+		c.writing()
+	}
+	n, err := c.Conn.Write(b)
+	if c.done.Load() {
+		return n, err
+	}
+	if err == nil {
+		if !N.NeedHandshakeForWrite(c.Conn) {
+			c.done.Store(true)
+		}
+	} else if len(b) > 0 || !(E.IsMulti(err, os.ErrInvalid, context.DeadlineExceeded, io.EOF) || E.IsTimeout(err)) {
+		// the connection manager kicks the handshake with an empty write under a short
+		// deadline and does not count its timeout as a failure; the write with payload decides
+		if !c.done.Swap(true) {
+			c.failed(err)
+		}
+	}
+	return n, err
+}
+
+func (c *handshakeConn) ReaderReplaceable() bool {
+	return true
+}
+
+func (c *handshakeConn) WriterReplaceable() bool {
+	return c.done.Load()
+}
+
+func (c *handshakeConn) Upstream() any {
+	return c.Conn
+}
diff --git a/protocol/group/urltestgroup/urltest_failure_test.go b/protocol/group/urltestgroup/urltest_failure_test.go
new file mode 100644
index 000000000..4a2c1af25
--- /dev/null
+++ b/protocol/group/urltestgroup/urltest_failure_test.go
@@ -0,0 +1,494 @@
+package urltestgroup
+
+import (
+	"context"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+
+	"github.com/stretchr/testify/require"
+)
+
+func dialRefused(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return nil, syscall.ECONNREFUSED
+}
+
+// newTestURLTest makes a group of members, the first one selected (fastest by history).
+func newTestURLTest(t *testing.T, link string, members ...*testMember) (*URLTest, *URLTestGroup) {
+	history := urltest.NewHistoryStorage()
+	ctx := service.ContextWithPtr(context.Background(), history)
+	outbounds := make([]adapter.Outbound, len(members))
+	for i, member := range members {
+		outbounds[i] = member
+		history.StoreURLTestHistory(member.Tag(), &adapter.URLTestHistory{Time: time.Now(), Delay: uint16(10 + 100*i)})
+	}
+	group, err := NewURLTestGroup(ctx, nil, log.NewNOPFactory().Logger(), outbounds, nil, link, "", time.Minute, 50, 0, false)
+	require.NoError(t, err)
+	group.performUpdateCheck()
+	require.Equal(t, members[0].Tag(), group.selectedOutboundTCP.Load().Tag())
+	return &URLTest{group: group, logger: log.NewNOPFactory().NewLogger("urltest")}, group
+}
+
+func waitSelected(t *testing.T, group *URLTestGroup, tag string) {
+	t.Helper()
+	require.Eventually(t, func() bool {
+		return group.selectedOutboundTCP.Load().Tag() == tag
+	}, 2*time.Second, 5*time.Millisecond, "selected outbound is not %s", tag)
+}
+
+func confirmState(group *URLTestGroup, tag string) (memberConfirm, bool) {
+	group.confirmAccess.Lock()
+	defer group.confirmAccess.Unlock()
+	state := group.confirms[tag]
+	if state == nil {
+		return memberConfirm{}, false
+	}
+	return *state, true
+}
+
+func waitConfirmed(t *testing.T, group *URLTestGroup, tag string) memberConfirm {
+	t.Helper()
+	require.Eventually(t, func() bool {
+		state, loaded := confirmState(group, tag)
+		return loaded && !state.running
+	}, 2*time.Second, 5*time.Millisecond)
+	state, _ := confirmState(group, tag)
+	return state
+}
+
+// allowConfirm ends the pause before the next test, as if the time had passed, with the
+// member's last failure at lastFailure.
+func allowConfirm(group *URLTestGroup, tag string, lastFailure time.Time) {
+	group.confirmAccess.Lock()
+	defer group.confirmAccess.Unlock()
+	group.confirms[tag].notBefore = time.Time{}
+	group.confirms[tag].lastFailure = lastFailure
+}
+
+// A protocol that contacts only its server failed to dial: that is a failed URL test of
+// the member, the group switches at once and does not test it again.
+func TestURLTestServerFailureSwitches(t *testing.T) {
+	link, requests := testURL(t, 0)
+	dead := newTestMember(C.TypeVLESS, "dead", dialRefused)
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, group := newTestURLTest(t, link, dead, spare)
+
+	_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	require.Error(t, err)
+	waitSelected(t, group, "spare")
+	require.Nil(t, group.history.LoadURLTestHistory("dead"))
+	require.Equal(t, int32(1), dead.dials.Load(), "the failed member was tested again")
+	require.Equal(t, int32(0), requests.Load())
+}
+
+// A server that drops the connection attempts makes the dial time out (its own connect
+// timeout, the caller still waiting): the most common way a blocked server fails, and the
+// server's failure, not a canceled dial.
+func TestURLTestDialTimeoutSwitches(t *testing.T) {
+	link, _ := testURL(t, 0)
+	blackholed := newTestMember(C.TypeVLESS, "blackholed", func(context.Context, string, M.Socksaddr) (net.Conn, error) {
+		return nil, &net.OpError{Op: "dial", Net: "tcp", Err: os.ErrDeadlineExceeded}
+	})
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, group := newTestURLTest(t, link, blackholed, spare)
+
+	_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	require.Error(t, err)
+	waitSelected(t, group, "spare")
+}
+
+// quicIdleTimeout is the error quic-go gives when the server went silent: a timeout that
+// also matches net.ErrClosed.
+type quicIdleTimeout struct{}
+
+func (quicIdleTimeout) Error() string        { return "timeout: no recent network activity" }
+func (quicIdleTimeout) Timeout() bool        { return true }
+func (quicIdleTimeout) Temporary() bool      { return false }
+func (quicIdleTimeout) Is(target error) bool { return target == net.ErrClosed }
+
+// A Hysteria2 or TUIC server went silent: the QUIC connection times out and the dial fails
+// with an error that also reports itself closed. It is the server's failure, not a close
+// the caller made.
+func TestURLTestQUICTimeoutSwitches(t *testing.T) {
+	link, _ := testURL(t, 0)
+	silent := newTestMember(C.TypeHysteria2, "silent", func(context.Context, string, M.Socksaddr) (net.Conn, error) {
+		return nil, quicIdleTimeout{}
+	})
+	spare := newTestMember(C.TypeHysteria2, "spare", dialWorking)
+	urlTest, group := newTestURLTest(t, link, silent, spare)
+
+	_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
+	require.ErrorIs(t, err, net.ErrClosed)
+	waitSelected(t, group, "spare")
+}
+
+// A socks member failed to reach one destination but works: one URL test proves it, the
+// group keeps it and its test result (the periodic test keeps its schedule), and the test
+// is not repeated for every failed connection. Each false alarm doubles the pause before
+// the next test, never beyond the interval; after an interval without failures the pause
+// starts over from the length of the test.
+func TestURLTestDestinationFailureKeepsMember(t *testing.T) {
+	link, requests := testURL(t, 100*time.Millisecond)
+	deadSite := M.ParseSocksaddr("1.2.3.4:443")
+	socks := newTestMember(C.TypeSOCKS, "socks", func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		if destination == deadSite {
+			return nil, syscall.ECONNREFUSED
+		}
+		return dialWorking(ctx, network, destination)
+	})
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, group := newTestURLTest(t, link, socks, spare)
+	tested := group.history.LoadURLTestHistory("socks").Time
+
+	for range 20 { // a burst of failing connections while the test runs
+		_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, deadSite)
+		require.Error(t, err)
+	}
+	first := waitConfirmed(t, group, "socks")
+	require.Equal(t, int32(1), requests.Load(), "one URL test for the whole burst")
+	require.Equal(t, "socks", group.selectedOutboundTCP.Load().Tag())
+	require.Equal(t, tested, group.history.LoadURLTestHistory("socks").Time, "the test result was replaced")
+	require.GreaterOrEqual(t, first.pause, 100*time.Millisecond, "the pause is shorter than the test")
+	require.Less(t, first.pause, time.Second)
+	_, _ = urlTest.DialContext(context.Background(), N.NetworkTCP, deadSite)
+	time.Sleep(20 * time.Millisecond)
+	require.Equal(t, int32(1), requests.Load(), "tested again within the pause")
+
+	allowConfirm(group, "socks", time.Now())
+	_, _ = urlTest.DialContext(context.Background(), N.NetworkTCP, deadSite)
+	require.Eventually(t, func() bool { return requests.Load() == 2 }, 2*time.Second, 5*time.Millisecond)
+	second := waitConfirmed(t, group, "socks")
+	require.GreaterOrEqual(t, second.pause, 2*first.pause)
+	require.LessOrEqual(t, second.pause, group.interval)
+
+	allowConfirm(group, "socks", time.Now().Add(-group.interval-time.Second))
+	_, _ = urlTest.DialContext(context.Background(), N.NetworkTCP, deadSite)
+	require.Eventually(t, func() bool { return requests.Load() == 3 }, 2*time.Second, 5*time.Millisecond)
+	third := waitConfirmed(t, group, "socks")
+	require.Less(t, third.pause, 2*second.pause, "the pause did not start over after an interval without failures")
+}
+
+// A false alarm that persists keeps the pause at the interval, though the tests themselves
+// are then an interval apart: the failures in between, not tested, count.
+func TestURLTestPersistentFalseAlarm(t *testing.T) {
+	link, requests := testURL(t, 0)
+	deadSite := M.ParseSocksaddr("1.2.3.4:443")
+	socks := newTestMember(C.TypeSOCKS, "socks", func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		if destination == deadSite {
+			return nil, syscall.ECONNREFUSED
+		}
+		return dialWorking(ctx, network, destination)
+	})
+	urlTest, group := newTestURLTest(t, link, socks, newTestMember(C.TypeVLESS, "spare", dialWorking))
+
+	_, _ = urlTest.DialContext(context.Background(), N.NetworkTCP, deadSite)
+	waitConfirmed(t, group, "socks")
+	group.confirmAccess.Lock()
+	group.confirms["socks"].pause = group.interval  // the pause has grown to the interval
+	group.confirms["socks"].notBefore = time.Time{} // and has passed, a failure every second
+	group.confirms["socks"].lastFailure = time.Now().Add(-time.Second)
+	group.confirmAccess.Unlock()
+	_, _ = urlTest.DialContext(context.Background(), N.NetworkTCP, deadSite)
+	require.Eventually(t, func() bool { return requests.Load() == 2 }, 2*time.Second, 5*time.Millisecond)
+	state := waitConfirmed(t, group, "socks")
+	require.Equal(t, group.interval, state.pause, "the pause started over while the false alarm went on")
+}
+
+// A dial that fails while another dial through the same member succeeds says nothing: the
+// member was reachable meanwhile. Not even a socks member is tested for it.
+func TestURLTestFailureRefutedBySuccess(t *testing.T) {
+	for _, memberType := range []string{C.TypeVLESS, C.TypeSOCKS} {
+		t.Run(memberType, func(t *testing.T) {
+			link, requests := testURL(t, 0)
+			deadSite := M.ParseSocksaddr("1.2.3.4:443")
+			release := make(chan struct{})
+			member := newTestMember(memberType, "member", func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+				if destination == deadSite {
+					<-release // fails once the other dial has succeeded
+					return nil, syscall.ECONNREFUSED
+				}
+				return dialWorking(ctx, network, destination)
+			})
+			urlTest, group := newTestURLTest(t, link, member, newTestMember(C.TypeVLESS, "spare", dialWorking))
+
+			failed := make(chan error, 1)
+			go func() {
+				_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, deadSite)
+				failed <- err
+			}()
+			require.Eventually(t, func() bool { return member.dials.Load() == 1 }, 2*time.Second, time.Millisecond, "the failing dial has not begun")
+			conn, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr(link[len("http://"):]))
+			require.NoError(t, err)
+			conn.Close()
+			close(release)
+			require.Error(t, <-failed)
+			time.Sleep(50 * time.Millisecond)
+			require.Equal(t, "member", group.selectedOutboundTCP.Load().Tag())
+			require.NotNil(t, group.history.LoadURLTestHistory("member"))
