+	conn, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr(link[len("http://"):]))
+	require.NoError(t, err)
+	conn.Close()
+	dead.Store(true)
+	_, err = urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("1.2.3.4:443"))
