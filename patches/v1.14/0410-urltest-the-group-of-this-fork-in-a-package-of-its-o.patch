+		require.NoError(t, err)
+		conn.Close()
+		return group.balance.Load().devices[source].member.Tag()
+	}
+	onB := deviceOn(t, memberOf, "10.3.0.", "b")
+	setResult(group, "b", 0)
+	require.Equal(t, "a", memberOf(onB))
+	for i := 1; i < 40; i++ {
+		require.Equal(t, "a", memberOf(fmt.Sprint("10.4.0.", i)), "a new device")
+	}
+}
