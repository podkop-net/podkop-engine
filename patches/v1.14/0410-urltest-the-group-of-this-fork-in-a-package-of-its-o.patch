+package urltestgroup
+
+import (
+	"context"
+	"errors"
+	"net"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+
+	"github.com/stretchr/testify/require"
+)
+
+// A URL test without outbounds takes its fallbacks: what is left of a rule whose provider
+// took every server away. With neither it is refused.
+func TestURLTestOfFallbacksOnly(t *testing.T) {
+	t.Parallel()
+	ctx := service.ContextWithPtr(context.Background(), urltest.NewHistoryStorage())
+	_, err := NewURLTest(ctx, nil, log.NewNOPFactory().NewLogger("urltest"), "t", option.URLTestOutboundOptions{Fallbacks: []string{"f1"}})
+	require.NoError(t, err)
+	_, err = NewURLTest(ctx, nil, log.NewNOPFactory().NewLogger("urltest"), "t", option.URLTestOutboundOptions{})
+	require.ErrorContains(t, err, "missing tags")
+	both, err := NewURLTest(ctx, nil, log.NewNOPFactory().NewLogger("urltest"), "t", option.URLTestOutboundOptions{Outbounds: []string{"a"}, Fallbacks: []string{"f1"}})
+	require.NoError(t, err)
+	require.Equal(t, []string{"a", "f1"}, both.(*URLTest).All())
+	require.Equal(t, []string{"f1"}, both.(*URLTest).Fallbacks())
+
+	f1, f2 := newTestMember(C.TypeSOCKS, "f1", dialRefused), newTestMember(C.TypeSOCKS, "f2", dialRefused)
+	_, group := newTestFallbackGroup(t, "", "", nil, members(f1, f2), map[string]uint16{"f2": 100})
+	tcp, udp := selectedTags(group)
+	require.Equal(t, "f2", tcp)
+	require.Equal(t, "f2", udp)
+	setResult(group, "f2", 0)
+	group.performUpdateCheck()
+	tcp, _ = selectedTags(group)
+	require.Equal(t, "f2", tcp, "none answers: the one in use stays")
+}
+
+// A block fallback answers by refusing: chosen when nothing before it answers, never judged
+// failed for its refusals, given up as soon as a server answers again.
+func TestBlockFallbackAnswers(t *testing.T) {
+	t.Parallel()
+	server, dead := newTestMember(C.TypeSOCKS, "a", dialRefused), newTestMember(C.TypeSOCKS, "dead", dialRefused)
+	block := newTestMember(C.TypeBlock, "block", dialRefused)
+	_, group := newTestFallbackGroup(t, "", "", members(server), members(dead, block), map[string]uint16{"a": 100})
+	tcp, _ := selectedTags(group)
+	require.Equal(t, "a", tcp)
+	setResult(group, "a", 0)
+	group.performUpdateCheck()
+	tcp, udp := selectedTags(group)
+	require.Equal(t, "block", tcp)
+	require.Equal(t, "block", udp)
+	group.memberFailed(context.Background(), block, N.NetworkTCP, errors.New("refused"), time.Now())
+	tcp, _ = selectedTags(group)
+	require.Equal(t, "block", tcp, "a refusal of block is no failure")
+	setResult(group, "a", 120)
+	group.performUpdateCheck()
+	tcp, _ = selectedTags(group)
+	require.Equal(t, "a", tcp)
+}
+
+// No more URL tests than probeSlots run at once in the process. Not parallel: the slots are
+// those of the whole process.
+func TestProbeLimit(t *testing.T) {
+	var now, most, dials atomic.Int32
+	release := make(chan struct{})
+	slow := func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		dials.Add(1)
+		running := now.Add(1)
+		defer now.Add(-1)
+		for {
+			seen := most.Load()
+			if running <= seen || most.CompareAndSwap(seen, running) {
+				break
+			}
+		}
+		select {
+		case <-release:
+		case <-ctx.Done():
+		}
+		return nil, errors.New("down")
+	}
+	var done sync.WaitGroup
+	// members of their own: tests of one member with one URL are one (probes)
+	for i := range 3 * cap(probeSlots) {
+		member := newTestMember(C.TypeSOCKS, "slow"+strconv.Itoa(i), slow)
+		done.Add(1)
+		go func() {
+			defer done.Done()
+			_, _ = testOutbound(context.Background(), nil, "http://www.example.com/generate_204", member)
+		}()
+	}
+	require.Eventually(t, func() bool { return now.Load() == int32(cap(probeSlots)) }, 5*time.Second, 10*time.Millisecond)
+	time.Sleep(100 * time.Millisecond)
+	require.Equal(t, int32(cap(probeSlots)), most.Load())
+	close(release)
+	done.Wait()
+	require.Equal(t, int32(cap(probeSlots)), most.Load())
+	require.Equal(t, int32(3*cap(probeSlots)), dials.Load())
+}
+
+// Before a round has tested the members a fallback is not taken for want of their results: at
+// a start or after a swap a block fallback would refuse every connection.
+func TestNoFallbackBeforeARound(t *testing.T) {
+	t.Parallel()
+	history := urltest.NewHistoryStorage()
+	ctx := service.ContextWithPtr(context.Background(), history)
+	server, block := newTestMember(C.TypeSOCKS, "a", dialRefused), newTestMember(C.TypeBlock, "block", dialRefused)
+	manager := &testOutboundManager{members: map[string]adapter.Outbound{"a": server, "block": block}}
+	group, err := NewURLTestGroup(ctx, manager, log.NewNOPFactory().Logger(), members(server), members(block), "", "", time.Minute, 50, 0, false)
+	require.NoError(t, err)
+	selected, found := group.Select(N.NetworkTCP)
+	require.Equal(t, "a", selected.Tag())
+	require.False(t, found)
+	group.roundDone.Store(true)
+	selected, found = group.Select(N.NetworkTCP)
+	require.Equal(t, "block", selected.Tag(), "tested and not answering: the fallback")
+	require.True(t, found)
+}
+
+// Before a round a group of fallbacks alone takes its first fallback, not a block further
+// down: a rule whose servers are gone and whose fallbacks are direct, then block.
+func TestFallbacksOnlyBeforeARound(t *testing.T) {
+	t.Parallel()
+	history := urltest.NewHistoryStorage()
+	ctx := service.ContextWithPtr(context.Background(), history)
+	direct, block := newTestMember(C.TypeDirect, "direct", dialRefused), newTestMember(C.TypeBlock, "block", dialRefused)
+	manager := &testOutboundManager{members: map[string]adapter.Outbound{"direct": direct, "block": block}}
+	group, err := NewURLTestGroup(ctx, manager, log.NewNOPFactory().Logger(), nil, members(direct, block), "", "", time.Minute, 50, 0, false)
+	require.NoError(t, err)
+	for _, network := range []string{N.NetworkTCP, N.NetworkUDP} {
+		selected, found := group.Select(network)
+		require.Equal(t, "direct", selected.Tag(), network)
+		require.False(t, found)
+	}
+	group.roundDone.Store(true)
+	selected, found := group.Select(N.NetworkTCP)
+	require.Equal(t, "block", selected.Tag(), "tested, direct did not answer: block")
+	require.True(t, found)
+}
+
+// The first round of a group that took over, when every member has a result already, tests
+// nothing and still counts as a round: a member that fails after it gives way to a fallback.
+func TestTakeOverWithResultsIsARound(t *testing.T) {
+	t.Parallel()
+	a, f := newTestMember(C.TypeSOCKS, "a", dialRefused), newTestMember(C.TypeSOCKS, "f", dialRefused)
+	_, group := newTestFallbackGroup(t, "", "", members(a), members(f), map[string]uint16{"a": 100, "f": 200})
+	group.roundDone.Store(false)
+	group.checkUntested()
+	require.True(t, group.roundDone.Load())
+	require.Zero(t, a.dials.Load()+f.dials.Load(), "nothing to test")
+	setResult(group, "a", 0)
+	group.performUpdateCheck()
+	tcp, _ := selectedTags(group)
+	require.Equal(t, "f", tcp)
+}
+
+// A block fallback is taken without a download test: it downloads nothing.
+func TestBlockFallbackWithoutDownloadTest(t *testing.T) {
+	t.Parallel()
+	a, block := newTestMember(C.TypeSOCKS, "a", dialRefused), newTestMember(C.TypeBlock, "block", dialRefused)
+	_, group := newTestFallbackGroup(t, "", "http://www.example.com/64k", members(a), members(block), nil)
+	tcp, _ := selectedTags(group)
+	require.Equal(t, "block", tcp)
+	require.Zero(t, block.dials.Load())
+}
+
+// While a block fallback is the choice, rounds come sooner than the interval, so the servers
+// come back soon after the network that failed them. Not parallel: blockRetryFirst is the
+// package's.
+func TestBlockFallbackRetried(t *testing.T) {
+	first := blockRetryFirst
+	blockRetryFirst = 50 * time.Millisecond
+	t.Cleanup(func() { blockRetryFirst = first })
+	link, _ := testURL(t, 0)
+	var up atomic.Bool
+	a := newTestMember(C.TypeSOCKS, "a", func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		if !up.Load() {
+			return nil, errors.New("down")
+		}
+		return dialWorking(ctx, network, destination)
+	})
+	block := newTestMember(C.TypeBlock, "block", dialRefused)
+	ctx := service.ContextWithPtr(context.Background(), urltest.NewHistoryStorage())
+	manager := &testOutboundManager{members: map[string]adapter.Outbound{"a": a, "block": block}}
+	group, err := NewURLTestGroup(ctx, manager, log.NewNOPFactory().Logger(), members(a), members(block), link, "", 10*time.Minute, 50, 0, false)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = group.Close() })
+	group.lastActive.Store(time.Now())
+	group.CheckOutbounds(ctx, true)
+	tcp, _ := selectedTags(group)
+	require.Equal(t, "block", tcp)
+	require.Eventually(t, func() bool { return a.dials.Load() >= 3 }, 5*time.Second, 10*time.Millisecond, "rounds while block is chosen")
+	up.Store(true)
+	require.Eventually(t, func() bool {
+		tcp, _ := selectedTags(group)
+		return tcp == "a"
+	}, 5*time.Second, 10*time.Millisecond)
+	group.updateAccess.Lock()
+	armed := group.blockRetryTimer != nil
+	group.updateAccess.Unlock()
+	require.False(t, armed, "no more rounds once a server answers")
+}
+
+// A confirming test of a failing member does not wait for probeSlots: behind the rounds it
+// would keep the group on a dead member. Not parallel: the slots are those of the process.
+func TestConfirmPastProbeSlots(t *testing.T) {
+	for range cap(probeSlots) {
+		probeSlots <- struct{}{}
+	}
+	t.Cleanup(func() {
+		for range cap(probeSlots) {
+			<-probeSlots
+		}
+	})
+	a, f := newTestMember(C.TypeSOCKS, "a", dialRefused), newTestMember(C.TypeSOCKS, "f", dialRefused)
+	_, group := newTestFallbackGroup(t, "http://www.example.com/generate_204", "", members(a), members(f), map[string]uint16{"a": 100, "f": 200})
+	require.True(t, group.confirmFailure("a", a))
+	require.Eventually(t, func() bool { return a.dials.Load() > 0 }, 5*time.Second, 10*time.Millisecond)
+}
diff --git a/protocol/group/urltestgroup/urltest_response.go b/protocol/group/urltestgroup/urltest_response.go
new file mode 100644
index 000000000..5382362df
--- /dev/null
+++ b/protocol/group/urltestgroup/urltest_response.go
@@ -0,0 +1,443 @@
+package urltestgroup
+
+import (
+	"errors"
+	"github.com/sagernet/sing-box/protocol/group"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/bufio"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// Members that accept connections but never answer them (podkop-engine).
+//
+// A Hysteria2 or TUIC server that went silent still opens streams (locally, 0-RTT
+// included), and a VLESS or Trojan server whose own outbound is dead still accepts and
+// handshakes: the dial succeeds, the first write too, the answer never comes. The group
+// therefore watches the first answer of every TCP connection through a member.
+//
+// A connection is overdue when no byte of the answer has come one retransmission timeout
+// after the client's last write, the timeout computed as RFC 6298 does for TCP, from the
+// first-byte latencies of the member's own connections:
+//
+//	RTO = SRTT + 4 * RTTVAR + 1 s, at most C.TCPTimeout
+//
+// with SRTT and RTTVAR seeded from the member's last URL test delay (an upper bound: the
+// test takes two or three round trips), the second added for one retransmitted SYN on the
+// server's side (the initial RTO of RFC 6298 and Linux), the bound being the timeout
+// sing-box gives a handshake and the URL test. The clock runs from the last write: a
+// first flight may go out in pieces (tls_fragment waits between them), and the server
+// answers the whole. As in Karn's algorithm a late answer is no sample; it doubles the
+// timeout until an answer comes in time (RFC 6298, 5.5). A connection that fails before
+// the first byte (reset, aborted, or timed out on the way, not by a deadline of the caller)
+// counts at once; an EOF, or an error the server sent back (a destination it could not
+// reach), does not.
+//
+// An overdue connection says the member may be dead, or the destination slow. It is
+// refuted, as a failed dial is in S1, when a connection whose last write came later got an
+// answer, or a test of the member that began later passed. Otherwise one URL test of the
+// member decides, with the pauses after false alarms of confirmFailure kept apart from
+// those of S1, and a destination that was overdue while the member passed counts no more
+// for an interval. When the group has switched away from a member that lost its test
+// result, it closes the member's connections that never got an answer, preconnects
+// included: they would hang until their own timeouts, and the applications retry through
+// the new member at once. UDP is not watched. All times are offsets from the epoch of the
+// group, on the monotonic clock: the router's clock steps at the first NTP sync.
+
+const (
+	responseWaiting uint32 = iota
+	responseAnswered
+	responseClosed
+)
+
+type memberResponses struct {
+	access        sync.Mutex
+	smoothed      time.Duration
+	variation     time.Duration
+	seeded        bool
+	backoff       uint
+	answeredWrite time.Duration // the latest last write among the connections that got an answer
+	testPassed    time.Duration // the latest start of a passed test of the member
+	pending       map[*responseConn]struct{}
+	evidence      map[*responseConn]struct{}
+	passedHosts   map[string]time.Duration // destination → until when its silence counts no more
+}
+
+type responseConn struct {
+	net.Conn
+	group     *URLTestGroup
+	member    adapter.Outbound
+	tag       string
+	responses *memberResponses
+	host      string
+	dialedAt  time.Duration
+	state     atomic.Uint32
+	lastWrite atomic.Int64 // the last write before the answer, as an offset from the epoch; 0 before any
+	timer     *time.Timer  // under responses.access
+}
+
+// watchResponses says whether the first answers through member are watched: proxies with
+// a test result. A direct member is our own connection, a group watches its own members.
+func watchResponses(member adapter.Outbound) bool {
+	if _, isGroup := member.(adapter.OutboundGroup); isGroup {
+		return false
+	}
+	switch member.Type() {
+	case C.TypeDirect, C.TypeBlock, C.TypeDNS:
+		return false
+	}
+	return true
+}
+
+func (g *URLTestGroup) now() time.Duration {
+	return time.Since(g.epoch)
+}
+
+func (g *URLTestGroup) memberResponses(tag string) *memberResponses {
+	value, loaded := g.responses.Load(tag)
+	if !loaded {
+		value, _ = g.responses.LoadOrStore(tag, &memberResponses{
+			pending:     make(map[*responseConn]struct{}),
+			evidence:    make(map[*responseConn]struct{}),
+			passedHosts: make(map[string]time.Duration),
+		})
+	}
+	return value.(*memberResponses)
+}
+
+// watchResponse wraps a TCP connection dialed through member.
+func (g *URLTestGroup) watchResponse(conn net.Conn, member adapter.Outbound, destination M.Socksaddr) net.Conn {
+	if !watchResponses(member) {
+		return conn
+	}
+	tag := group.RealTag(member, N.NetworkTCP)
+	if g.history.LoadURLTestHistory(tag) == nil {
+		return conn
+	}
+	responses := g.memberResponses(tag)
+	watched := &responseConn{
+		Conn:      conn,
+		group:     g,
+		member:    member,
+		tag:       tag,
+		responses: responses,
+		host:      destination.AddrString(),
+		dialedAt:  g.now(),
+	}
+	responses.access.Lock()
+	responses.pending[watched] = struct{}{}
+	responses.access.Unlock()
+	return watched
+}
+
+// retransmissionTimeout is under responses.access.
+func (g *URLTestGroup) retransmissionTimeout(responses *memberResponses, tag string) time.Duration {
+	if !responses.seeded {
+		if history := g.history.LoadURLTestHistory(tag); history != nil {
+			sample := time.Duration(history.Delay) * time.Millisecond
+			responses.smoothed, responses.variation, responses.seeded = sample, sample/2, true
+		}
+	}
+	timeout := responses.smoothed + 4*responses.variation + time.Second
+	for i := uint(0); i < responses.backoff && timeout < C.TCPTimeout; i++ {
+		timeout *= 2
+	}
+	return min(timeout, C.TCPTimeout)
+}
+
+// sample adds a first-byte latency (RFC 6298, 2.2 and 2.3), under responses.access.
+func (responses *memberResponses) sample(latency time.Duration) {
+	if !responses.seeded {
+		responses.smoothed, responses.variation, responses.seeded = latency, latency/2, true
+		return
+	}
+	difference := responses.smoothed - latency
+	if difference < 0 {
+		difference = -difference
+	}
+	responses.variation = (3*responses.variation + difference) / 4
+	responses.smoothed = (7*responses.smoothed + latency) / 8
+}
+
+// wrote records a write of the client before the answer; the first one starts the clock.
+func (c *responseConn) wrote() {
+	if c.state.Load() != responseWaiting {
+		return
+	}
+	if c.lastWrite.Swap(int64(max(c.group.now(), 1))) != 0 {
+		return
+	}
+	c.responses.access.Lock()
+	if c.state.Load() == responseWaiting && c.timer == nil {
+		c.timer = time.AfterFunc(c.group.retransmissionTimeout(c.responses, c.tag), c.expired)
+	}
+	c.responses.access.Unlock()
+}
+
+func (c *responseConn) expired() {
+	if c.group.responsesClosed.Load() {
+		return
+	}
+	responses := c.responses
+	responses.access.Lock()
+	if c.state.Load() != responseWaiting {
+		responses.access.Unlock()
+		return
+	}
+	lastWrite := time.Duration(c.lastWrite.Load())
+	if remaining := lastWrite + c.group.retransmissionTimeout(responses, c.tag) - c.group.now(); remaining > 0 {
+		c.timer.Reset(remaining) // the client wrote again meanwhile
+		responses.access.Unlock()
+		return
+	}
+	confirm := c.group.addEvidence(c, lastWrite)
+	responses.access.Unlock()
+	if confirm && c.group.confirmUnanswered(c.tag, c.member) {
+		c.group.logger.Info("outbound ", c.tag, ": no answer from ", c.host, " after ", (c.group.now() - lastWrite).Round(time.Millisecond), ", testing the outbound")
+	}
+}
+
+// addEvidence records that c went unanswered since lastWrite, under responses.access, and
+// reports whether the member is to be tested.
+func (g *URLTestGroup) addEvidence(c *responseConn, lastWrite time.Duration) bool {
+	responses := c.responses
+	if responses.answeredWrite > lastWrite || responses.testPassed > lastWrite {
+		return false
+	}
+	history := g.history.LoadURLTestHistory(c.tag)
+	if history == nil {
+		return false // already unavailable
+	}
+	if testStart := history.Time.Add(-time.Duration(history.Delay) * time.Millisecond).Sub(g.epoch); testStart > lastWrite {
+		return false
+	}
+	if until, passed := responses.passedHosts[c.host]; passed && g.now() < until {
+		return false
+	}
+	responses.evidence[c] = struct{}{}
+	return true
+}
+
+// memberTestPassed refutes the evidence older than a passed test of the member that began
+// at start, and lets the destinations it was about count no more for an interval.
+func (g *URLTestGroup) memberTestPassed(tag string, start time.Time) {
+	value, loaded := g.responses.Load(tag)
+	if !loaded {
+		return
+	}
+	responses := value.(*memberResponses)
+	began := start.Sub(g.epoch)
+	now := g.now()
+	responses.access.Lock()
+	defer responses.access.Unlock()
+	responses.testPassed = max(responses.testPassed, began)
+	for host, until := range responses.passedHosts {
+		if now >= until {
+			delete(responses.passedHosts, host)
+		}
+	}
+	for c := range responses.evidence {
+		if time.Duration(c.lastWrite.Load()) < began {
+			responses.passedHosts[c.host] = now + g.interval
+			delete(responses.evidence, c)
+		}
+	}
+}
+
+func (c *responseConn) answered() {
+	if !c.state.CompareAndSwap(responseWaiting, responseAnswered) {
+		return
+	}
+	now := c.group.now()
+	responses := c.responses
+	responses.access.Lock()
+	defer responses.access.Unlock()
+	delete(responses.pending, c)
+	if c.timer != nil {
+		c.timer.Stop()
+	}
+	start := c.dialedAt
+	if written := time.Duration(c.lastWrite.Load()); written != 0 {
+		start = written
+		if _, wasOverdue := responses.evidence[c]; wasOverdue {
+			delete(responses.evidence, c)
+			responses.backoff++ // Karn: no sample from a late answer
+		} else if latency := now - start; latency > 0 {
+			responses.sample(latency)
+			responses.backoff = 0
+		}
+	}
+	responses.answeredWrite = max(responses.answeredWrite, start)
+	for evidence := range responses.evidence {
+		if time.Duration(evidence.lastWrite.Load()) < start {
+			delete(responses.evidence, evidence)
+		}
+	}
+}
+
+// failedOnTheWay tells a failure of the way to the server (a reset, an abort, a timeout
+// that no deadline of the caller set) from an error the server sent back or an EOF.
+func failedOnTheWay(err error) bool {
+	if errors.Is(err, os.ErrDeadlineExceeded) {
+		return false
+	}
+	if errors.Is(err, syscall.ECONNRESET) || errors.Is(err, syscall.ECONNABORTED) || errors.Is(err, syscall.EPIPE) || errors.Is(err, syscall.ETIMEDOUT) {
+		return true
+	}
+	var netErr net.Error
+	return errors.As(err, &netErr) && netErr.Timeout()
+}
+
+// failedBeforeAnswer handles a read error before the first byte.
+func (c *responseConn) failedBeforeAnswer(err error) {
+	if c.group.responsesClosed.Load() || c.state.Load() != responseWaiting || errors.Is(err, io.EOF) || !failedOnTheWay(err) {
+		return
+	}
+	responses := c.responses
+	responses.access.Lock()
+	lastWrite := time.Duration(c.lastWrite.Load())
+	if lastWrite == 0 {
+		lastWrite = c.dialedAt
+	}
+	confirm := c.group.addEvidence(c, lastWrite)
+	responses.access.Unlock()
+	if confirm && c.group.confirmUnanswered(c.tag, c.member) {
+		c.group.logger.Info("outbound ", c.tag, ": ", c.host, " failed before any answer: ", err, ", testing the outbound")
+	}
+}
+
+// observeRead notes what a read before the answer brought.
+func (c *responseConn) observeRead(n int, err error) {
+	if c.state.Load() != responseWaiting {
+		return
+	}
+	if n > 0 {
+		c.answered()
+	} else if err != nil {
+		c.failedBeforeAnswer(err)
+	}
+}
+
+func (c *responseConn) Read(b []byte) (int, error) {
+	n, err := c.Conn.Read(b)
+	c.observeRead(n, err)
+	return n, err
+}
+
+func (c *responseConn) Write(b []byte) (int, error) {
+	if len(b) > 0 {
+		c.wrote()
+	}
+	n, err := c.Conn.Write(b)
+	if n > 0 {
+		c.wrote()
+	}
+	return n, err
+}
+
+// The copy loop writes below this connection, so it reports its writes through a counter.
+// It reads through this connection until the answer begins, then below it; until then a
+// read waiter of the connection below, when there is one, still waits without a buffer.
+
+func (c *responseConn) UnwrapWriter() (io.Writer, []N.CountFunc) {
+	return c.Conn, []N.CountFunc{func(n int64) {
+		if n > 0 {
+			c.wrote()
+		}
+	}}
+}
+
+func (c *responseConn) CreateReadWaiter() (N.ReadWaiter, bool) {
+	readWaiter, created := bufio.CreateReadWaiter(c.Conn)
+	if !created || c.state.Load() != responseWaiting {
+		return readWaiter, created
+	}
+	return &responseReadWaiter{ReadWaiter: readWaiter, conn: c}, true
+}
+
+type responseReadWaiter struct {
+	N.ReadWaiter
+	conn *responseConn
+}
+
+func (w *responseReadWaiter) WaitReadBuffer() (*buf.Buffer, error) {
+	buffer, err := w.ReadWaiter.WaitReadBuffer()
+	n := 0
+	if buffer != nil {
+		n = buffer.Len()
+	}
+	w.conn.observeRead(n, err)
+	return buffer, err
+}
+
+func (c *responseConn) NeedHandshakeForRead() bool {
+	return c.state.Load() == responseWaiting
+}
+
+func (c *responseConn) ReaderReplaceable() bool {
+	return c.state.Load() != responseWaiting
+}
+
+func (c *responseConn) WriterReplaceable() bool {
+	return true
+}
+
+func (c *responseConn) Upstream() any {
+	return c.Conn
+}
+
+func (c *responseConn) Close() error {
+	if c.state.Swap(responseClosed) != responseClosed {
+		responses := c.responses
+		responses.access.Lock()
+		delete(responses.pending, c)
+		delete(responses.evidence, c)
+		if c.timer != nil {
+			c.timer.Stop()
+		}
+		responses.access.Unlock()
+	}
+	return c.Conn.Close()
+}
+
+// closeUnanswered closes the connections that never got an answer through the members the
+// group has switched away from after they lost their test result: their answers will not
+// come. When every member is down the selection stays, and so do its connections.
+func (g *URLTestGroup) closeUnanswered() {
+	selected := g.selectedOutboundTCP.Load()
+	var unanswered []*responseConn
+	g.responses.Range(func(key, value any) bool {
+		tag := key.(string)
+		if g.history.LoadURLTestHistory(tag) != nil || (selected != nil && group.RealTag(selected, N.NetworkTCP) == tag) {
+			return true
+		}
+		responses := value.(*memberResponses)
+		responses.access.Lock()
+		for c := range responses.pending {
+			unanswered = append(unanswered, c)
+		}
+		responses.access.Unlock()
+		return true
+	})
+	if len(unanswered) == 0 {
+		return
+	}
+	g.logger.Debug("closing ", len(unanswered), " connections that got no answer through outbounds switched away from")
+	go func() {
+		// a close may wait (a TLS close_notify, a FIN of a multiplexed stream): not under
+		// the lock of the selection
+		for _, c := range unanswered {
+			c.Close()
+		}
+	}()
+}
diff --git a/protocol/group/urltestgroup/urltest_response_test.go b/protocol/group/urltestgroup/urltest_response_test.go
new file mode 100644
index 000000000..e845235aa
--- /dev/null
+++ b/protocol/group/urltestgroup/urltest_response_test.go
@@ -0,0 +1,522 @@
+package urltestgroup
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/url"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/bufio"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+// fakeServer stands for a proxy server: each connection is a pipe; the server reads the
+// first write and answers it with answers[host], or never ("" or missing). Connections to
+// the URL test go to the test server, unless the test is to fail.
+type fakeServer struct {
+	testHost  string
+	failTest  atomic.Bool
+	access    sync.Mutex
+	answers   map[string]string
+	firstByte map[string]string // written before the client writes (a server that speaks first)
+	readErr   map[string]error  // returned to the client's reads instead of an answer
+}
+
+func newFakeServer(link string) *fakeServer {
+	parsed, _ := url.Parse(link)
+	return &fakeServer{
+		testHost:  parsed.Host,
+		answers:   make(map[string]string),
+		firstByte: make(map[string]string),
+		readErr:   make(map[string]error),
+	}
+}
+
+type failingConn struct {
+	net.Conn
+	err error
+}
+
+func (c *failingConn) Read([]byte) (int, error) {
+	return 0, c.err
+}
+
+func (s *fakeServer) dial(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	if destination.String() == s.testHost {
+		if s.failTest.Load() {
+			return nil, errors.New("the URL test failed")
+		}
+		return dialWorking(ctx, network, destination)
+	}
+	s.access.Lock()
+	answer, first, readErr := s.answers[destination.AddrString()], s.firstByte[destination.AddrString()], s.readErr[destination.AddrString()]
+	s.access.Unlock()
+	client, server := net.Pipe()
+	go func() {
+		defer server.Close()
+		if first != "" {
+			if _, err := server.Write([]byte(first)); err != nil {
+				return
+			}
+		}
+		buffer := make([]byte, 1024)
+		if _, err := server.Read(buffer); err != nil {
+			return
+		}
+		if answer != "" {
+			if _, err := server.Write([]byte(answer)); err != nil {
+				return
+			}
+		}
+		io.Copy(io.Discard, server)
+	}()
+	if readErr != nil {
+		return &failingConn{Conn: client, err: readErr}, nil
+	}
+	return client, nil
+}
+
+// readAll keeps reading conn, as the copy loop would, and reports the first data and the
+// end.
+func readAll(conn net.Conn) (data chan string, done chan error) {
+	data, done = make(chan string, 1), make(chan error, 1)
+	go func() {
+		buffer := make([]byte, 1024)
+		for {
+			n, err := conn.Read(buffer)
+			if n > 0 {
+				select {
+				case data <- string(buffer[:n]):
+				default:
+				}
+			}
+			if err != nil {
+				done <- err
+				return
+			}
+		}
+	}()
+	return
+}
+
+func dialAndWrite(t *testing.T, urlTest *URLTest, destination string) net.Conn {
+	conn, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr(destination))
+	require.NoError(t, err)
+	t.Cleanup(func() { conn.Close() })
+	_, err = conn.Write([]byte("request"))
+	require.NoError(t, err)
+	return conn
+}
+
+func waitSelectedWithin(t *testing.T, group *URLTestGroup, tag string, within time.Duration) {
+	t.Helper()
+	require.Eventually(t, func() bool {
+		return group.selectedOutboundTCP.Load().Tag() == tag
+	}, within, 10*time.Millisecond, "selected outbound is not %s", tag)
+}
+
+// A member that accepts connections and never answers: one retransmission timeout after the
+// client wrote, the member is tested out of turn, the test fails, the group switches and
+// closes the connection that waits for the answer.
+func TestURLTestUnansweredSwitches(t *testing.T) {
+	t.Parallel()
+	link, _ := testURL(t, 0)
+	server := newFakeServer(link)
+	server.failTest.Store(true)
+	silent := newTestMember(C.TypeHysteria2, "silent", server.dial)
+	spare := newTestMember(C.TypeHysteria2, "spare", dialWorking)
+	urlTest, group := newTestURLTest(t, link, silent, spare)
+
+	start := time.Now()
+	conn := dialAndWrite(t, urlTest, "example.com:443")
+	_, done := readAll(conn)
+	waitSelectedWithin(t, group, "spare", 3*time.Second)
+	require.Greater(t, time.Since(start), time.Second, "the member was tested before its timeout")
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("the unanswered connection was not closed")
+	}
+}
+
+// The member answers another connection that began later: the silence of the first is
+// its destination's, nothing is tested.
+func TestURLTestUnansweredRefutedByLaterAnswer(t *testing.T) {
+	t.Parallel()
+	link, requests := testURL(t, 0)
+	server := newFakeServer(link)
+	server.answers["fast.example"] = "answer"
+	member := newTestMember(C.TypeVLESS, "member", server.dial)
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, group := newTestURLTest(t, link, member, spare)
+
+	slow := dialAndWrite(t, urlTest, "slow.example:443")
+	readAll(slow)
+	time.Sleep(100 * time.Millisecond)
+	fast := dialAndWrite(t, urlTest, "fast.example:443")
+	data, _ := readAll(fast)
+	require.Equal(t, "answer", <-data)
+
+	time.Sleep(1500 * time.Millisecond)
+	require.Equal(t, int32(0), requests.Load(), "the member was tested")
+	require.Equal(t, "member", group.selectedOutboundTCP.Load().Tag())
+}
+
+// A destination that stays silent while the member passes its test counts no more for an
+// interval: the member is tested once, not for every connection to it.
+func TestURLTestUnansweredDestinationPassed(t *testing.T) {
+	t.Parallel()
+	link, requests := testURL(t, 0)
+	server := newFakeServer(link)
+	member := newTestMember(C.TypeVLESS, "member", server.dial)
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, group := newTestURLTest(t, link, member, spare)
+
+	readAll(dialAndWrite(t, urlTest, "dead.example:443"))
+	require.Eventually(t, func() bool { return requests.Load() == 1 }, 3*time.Second, 10*time.Millisecond)
+	readAll(dialAndWrite(t, urlTest, "dead.example:443"))
+	time.Sleep(1500 * time.Millisecond)
+	require.Equal(t, int32(1), requests.Load(), "the member was tested again for the same destination")
+	require.Equal(t, "member", group.selectedOutboundTCP.Load().Tag())
+}
+
+// A reset before any answer is evidence at once; an EOF is not.
+func TestURLTestResetBeforeAnswer(t *testing.T) {
+	t.Parallel()
+	link, requests := testURL(t, 0)
+	server := newFakeServer(link)
+	server.readErr["reset.example"] = syscall.ECONNRESET
+	server.readErr["eof.example"] = io.EOF
+	member := newTestMember(C.TypeVLESS, "member", server.dial)
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, _ := newTestURLTest(t, link, member, spare)
+
+	_, done := readAll(dialAndWrite(t, urlTest, "eof.example:443"))
+	require.ErrorIs(t, <-done, io.EOF)
+	time.Sleep(200 * time.Millisecond)
+	require.Equal(t, int32(0), requests.Load(), "an EOF made the member tested")
+
+	_, done = readAll(dialAndWrite(t, urlTest, "reset.example:443"))
+	<-done
+	require.Eventually(t, func() bool { return requests.Load() == 1 }, 500*time.Millisecond, 10*time.Millisecond,
+		"a reset before the answer did not make the member tested at once")
+}
+
+// A server that speaks first has answered before the client wrote anything: its later
+// silence says nothing.
+func TestURLTestServerFirstNotWatched(t *testing.T) {
+	t.Parallel()
+	link, requests := testURL(t, 0)
+	server := newFakeServer(link)
+	server.firstByte["smtp.example"] = "220 ready"
+	member := newTestMember(C.TypeVLESS, "member", server.dial)
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, _ := newTestURLTest(t, link, member, spare)
+
+	conn, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("smtp.example:25"))
+	require.NoError(t, err)
+	defer conn.Close()
+	data, _ := readAll(conn)
+	require.Equal(t, "220 ready", <-data)
+	_, err = conn.Write([]byte("EHLO"))
+	require.NoError(t, err)
+	time.Sleep(1500 * time.Millisecond)
+	require.Equal(t, int32(0), requests.Load())
+}
+
+// The clock runs from the last write before the answer: a first flight in pieces is not
+// overdue while its pieces keep coming.
+func TestURLTestUnansweredClockFromLastWrite(t *testing.T) {
+	t.Parallel()
+	link, requests := testURL(t, 0)
+	server := newFakeServer(link)
+	member := newTestMember(C.TypeVLESS, "member", server.dial)
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, _ := newTestURLTest(t, link, member, spare)
+
+	conn, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("pieces.example:443"))
+	require.NoError(t, err)
+	defer conn.Close()
+	readAll(conn)
+	for i := 0; i < 3; i++ {
+		_, err = conn.Write([]byte("piece"))
+		require.NoError(t, err)
+		time.Sleep(700 * time.Millisecond)
+	}
+	require.Equal(t, int32(0), requests.Load(), "overdue while the client was still writing")
+	require.Eventually(t, func() bool { return requests.Load() == 1 }, 2*time.Second, 10*time.Millisecond)
+}
+
+// RFC 6298: the first sample sets SRTT and RTTVAR, later ones are smoothed; a late answer
+// gives no sample and doubles the timeout until an answer comes in time.
+func TestURLTestRetransmissionTimeout(t *testing.T) {
+	link, _ := testURL(t, 0)
+	member := newTestMember(C.TypeVLESS, "member", dialWorking)
+	_, group := newTestURLTest(t, link, member)
+	responses := group.memberResponses("member")
+
+	responses.access.Lock()
+	defer responses.access.Unlock()
+	require.Equal(t, 10*time.Millisecond+20*time.Millisecond+time.Second, group.retransmissionTimeout(responses, "member"))
+	responses.sample(100 * time.Millisecond)
+	require.Equal(t, (7*10*time.Millisecond+100*time.Millisecond)/8, responses.smoothed)
+	require.Equal(t, (3*5*time.Millisecond+90*time.Millisecond)/4, responses.variation)
+	base := group.retransmissionTimeout(responses, "member")
+	responses.backoff = 2
+	require.Equal(t, 4*base, group.retransmissionTimeout(responses, "member"))
+	responses.backoff = 10
+	require.Equal(t, C.TCPTimeout, group.retransmissionTimeout(responses, "member"))
+}
+
+// waitCountingConn has a read waiter and counts its use: the copy loop reaches it once the
+// answer began.
+type waitCountingConn struct {
+	net.Conn
+	options N.ReadWaitOptions
+	waits   atomic.Int32
+}
+
+func (c *waitCountingConn) InitializeReadWaiter(options N.ReadWaitOptions) (needCopy bool) {
+	c.options = options
+	return false
+}
+
+func (c *waitCountingConn) WaitReadBuffer() (*buf.Buffer, error) {
+	c.waits.Add(1)
+	buffer := c.options.NewBuffer()
+	n, err := c.Conn.Read(buffer.FreeBytes())
+	if n > 0 {
+		buffer.Truncate(n)
+		return buffer, nil
+	}
+	buffer.Release()
+	return nil, err
+}
+
+// The copy loop reads through the connection until the answer begins, then below it.
+func TestURLTestUnansweredUnwrappedAfterAnswer(t *testing.T) {
+	t.Parallel()
+	link, _ := testURL(t, 0)
+	var inner *waitCountingConn
+	remote := make(chan net.Conn, 1)
+	member := newTestMember(C.TypeVLESS, "member", func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		client, server := net.Pipe()
+		inner = &waitCountingConn{Conn: client}
+		remote <- server
+		return inner, nil
+	})
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, _ := newTestURLTest(t, link, member, spare)
+
+	conn, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("example.com:443"))
+	require.NoError(t, err)
+	server := <-remote
+	go func() {
+		buffer := make([]byte, 64)
+		server.Read(buffer)
+		server.Write([]byte("first"))
+		server.Write([]byte(" second"))
+		server.Close()
+	}()
+	_, err = conn.Write([]byte("request"))
+	require.NoError(t, err)
+	var output bytesBuffer
+	_, err = bufio.Copy(&output, conn)
+	require.NoError(t, err)
+	require.Equal(t, "first second", output.String())
+	require.Positive(t, inner.waits.Load(), "the copy loop kept reading through the watching connection")
+}
+
+type bytesBuffer struct {
+	access sync.Mutex
+	data   []byte
+}
+
+func (b *bytesBuffer) Write(p []byte) (int, error) {
+	b.access.Lock()
+	defer b.access.Unlock()
+	b.data = append(b.data, p...)
+	return len(p), nil
+}
+
+func (b *bytesBuffer) String() string {
+	b.access.Lock()
+	defer b.access.Unlock()
+	return string(b.data)
+}
+
+// A member declared down by a failed dial (S1) gets its connections without an answer
+// closed, preconnects included.
+func TestURLTestVerdictClosesUnanswered(t *testing.T) {
+	t.Parallel()
+	link, _ := testURL(t, 0)
+	server := newFakeServer(link)
+	var refuse atomic.Bool
+	member := newTestMember(C.TypeVLESS, "member", func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		if refuse.Load() {
+			return nil, syscall.ECONNREFUSED
+		}
+		return server.dial(ctx, network, destination)
+	})
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, group := newTestURLTest(t, link, member, spare)
+
+	preconnect, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("preconnect.example:443"))
+	require.NoError(t, err)
+	defer preconnect.Close()
+	_, done := readAll(preconnect)
+
+	refuse.Store(true)
+	_, err = urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("example.com:443"))
+	require.Error(t, err)
+	waitSelectedWithin(t, group, "spare", 2*time.Second)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("the preconnect of the member declared down was not closed")
+	}
+}
+
+// Timers of a closed group do nothing.
+func TestURLTestUnansweredAfterClose(t *testing.T) {
+	t.Parallel()
+	link, requests := testURL(t, 0)
+	server := newFakeServer(link)
+	member := newTestMember(C.TypeVLESS, "member", server.dial)
+	spare := newTestMember(C.TypeVLESS, "spare", dialWorking)
+	urlTest, group := newTestURLTest(t, link, member, spare)
+
+	readAll(dialAndWrite(t, urlTest, "example.com:443"))
+	require.NoError(t, group.Close())
+	time.Sleep(1500 * time.Millisecond)
+	require.Equal(t, int32(0), requests.Load())
+}
+
+// A false alarm of a connection without an answer does not delay the test of a failed dial:
+// the two keep their pauses apart.
+func TestURLTestUnansweredPauseApart(t *testing.T) {
+	t.Parallel()
+	link, requests := testURL(t, 0)
+	server := newFakeServer(link)
+	var refuse atomic.Bool
+	member := newTestMember(C.TypeSOCKS, "member", func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		if refuse.Load() && destination.String() != server.testHost {
+			return nil, syscall.ECONNREFUSED
+		}
+		return server.dial(ctx, network, destination)
+	})
+	spare := newTestMember(C.TypeSOCKS, "spare", dialWorking)
+	urlTest, _ := newTestURLTest(t, link, member, spare)
+
+	readAll(dialAndWrite(t, urlTest, "dead.example:443"))
+	require.Eventually(t, func() bool { return requests.Load() == 1 }, 3*time.Second, 10*time.Millisecond)
+	time.Sleep(100 * time.Millisecond) // the test has passed: the pause of the unanswered alarms runs
+
+	refuse.Store(true)
+	_, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("other.example:443"))
+	require.Error(t, err)
+	require.Eventually(t, func() bool { return requests.Load() == 2 }, 500*time.Millisecond, 10*time.Millisecond,
+		"the failed dial waited for the pause of an unanswered connection")
+}
+
+// An error the server sent back (a destination it could not reach) is no evidence: the
+// server answered.
+func TestURLTestServerErrorNoEvidence(t *testing.T) {
+	t.Parallel()
+	link, requests := testURL(t, 0)
+	server := newFakeServer(link)
+	server.readErr["refused.example"] = errors.New("remote error: connection refused")
+	member := newTestMember(C.TypeHysteria2, "member", server.dial)
+	spare := newTestMember(C.TypeHysteria2, "spare", dialWorking)
+	urlTest, _ := newTestURLTest(t, link, member, spare)
+
+	_, done := readAll(dialAndWrite(t, urlTest, "refused.example:443"))
+	<-done
+	time.Sleep(200 * time.Millisecond)
+	require.Equal(t, int32(0), requests.Load())
+}
+
+// With every member down the selection stays, and so do the connections waiting through it.
+func TestURLTestUnansweredKeptWhenAllDown(t *testing.T) {
+	t.Parallel()
+	link, _ := testURL(t, 0)
+	server := newFakeServer(link)
+	member := newTestMember(C.TypeVLESS, "member", server.dial)
+	spare := newTestMember(C.TypeVLESS, "spare", server.dial)
+	urlTest, group := newTestURLTest(t, link, member, spare)
+
+	_, done := readAll(dialAndWrite(t, urlTest, "example.com:443"))
+	group.history.DeleteURLTestHistory("member")
+	group.history.DeleteURLTestHistory("spare")
+	group.performUpdateCheck()
+	require.Equal(t, "member", group.selectedOutboundTCP.Load().Tag())
+	select {
+	case err := <-done:
+		t.Fatal("the connection was closed although the group did not switch: ", err)
+	case <-time.After(300 * time.Millisecond):
+	}
+}
+
+// Before the answer the copy loop still waits with the read waiter of the connection below
+// (no buffer held while the server is silent), and the first data counts as the answer.
+func TestURLTestUnansweredKeepsReadWaiter(t *testing.T) {
+	t.Parallel()
+	link, _ := testURL(t, 0)
+	parsed, _ := url.Parse(link)
+	var inner *waitCountingConn
+	remote := make(chan net.Conn, 1)
+	member := newTestMember(C.TypeTrojan, "member", func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		if destination.String() == parsed.Host {
+			return dialWorking(ctx, network, destination)
+		}
+		client, server := net.Pipe()
+		inner = &waitCountingConn{Conn: client}
+		remote <- server
+		return inner, nil
+	})
+	spare := newTestMember(C.TypeTrojan, "spare", dialWorking)
+	urlTest, group := newTestURLTest(t, link, member, spare)
+
+	conn, err := urlTest.DialContext(context.Background(), N.NetworkTCP, M.ParseSocksaddr("example.com:443"))
+	require.NoError(t, err)
+	server := <-remote
+	request := make(chan struct{})
+	answer := make(chan struct{})
+	go func() {
+		buffer := make([]byte, 64)
+		server.Read(buffer)
+		close(request)
+		<-answer
+		server.Write([]byte("answer"))
+		server.Close()
+	}()
+	done := make(chan error, 1)
+	var output bytesBuffer
+	go func() {
+		_, err := bufio.Copy(&output, conn)
+		done <- err
+	}()
+	_, err = conn.Write([]byte("request"))
+	require.NoError(t, err)
+	<-request
+	require.Eventually(t, func() bool { return inner.waits.Load() > 0 }, time.Second, 5*time.Millisecond,
+		"the copy loop waited through the watching connection with its own buffer")
+	close(answer)
+	require.NoError(t, <-done)
+	require.Equal(t, "answer", output.String())
+	responses := group.memberResponses("member")
+	responses.access.Lock()
+	defer responses.access.Unlock()
+	require.Empty(t, responses.pending, "the answer that came through the read waiter was not seen")
+}
