From fdcd7592c58fcc73fded9ddd79da5b8ff94c5b3d Mon Sep 17 00:00:00 2001
From: FiyeroT <me@fiyero.xyz>
Date: Thu, 12 Nov 2026 21:41:20 +0300
Subject: [PATCH 17/63] dns, hooks in upstream files: the transports group and
 provider

The lines of upstream files that "dns: the transports group and provider" needs; the feature itself
is its patch of layer 03, in files of its own.

Pdk-Feature: dns-group
Pdk-Zone: core
Pdk-Layer: 02
---
 constant/dns.go     | 10 ++++++++++
 dns/router.go       |  4 +++-
 include/registry.go |  4 +++-
 3 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/constant/dns.go b/constant/dns.go
index d02688064..ebe36fb0f 100644
--- a/constant/dns.go
+++ b/constant/dns.go
@@ -30,6 +30,16 @@ const (
 	DNSTypeTailscale   = "tailscale"
 	DNSTypeOpenConnect = "openconnect"
 	DNSTypeOpenVPN     = "openvpn"
+	// a list of DNS servers asked in order or by speed, and the internet provider's DNS
+	// servers that netifd knows (podkop-engine, dns/transport_group.go, dns/transport_provider.go)
+	DNSTypeGroup    = "group"
+	DNSTypeProvider = "provider"
+)
+
+// The strategies of a DNS server group (podkop-engine).
+const (
+	DNSGroupStrategyOrder   = "order"
+	DNSGroupStrategyFastest = "fastest"
 )
 
 const (
diff --git a/dns/router.go b/dns/router.go
index aa673b7ef..f5e5aa56f 100644
--- a/dns/router.go
+++ b/dns/router.go
@@ -128,7 +128,9 @@ func (r *Router) Initialize(rules []option.DNSRule) error {
 		return err
 	}
 	closeRules(newRules)
-	return nil
+	// every DNS server exists now: the groups find their members, so that a wrong one fails
+	// the configuration check (podkop-engine, transport_group.go)
+	return initializeGroups(r.transport)
 }
 
 func (r *Router) Start(stage adapter.StartStage, scope *adapter.Scope) error {
diff --git a/include/registry.go b/include/registry.go
index 12cad23ee..201eb4c2e 100644
--- a/include/registry.go
+++ b/include/registry.go
@@ -95,7 +95,9 @@ func DNSTransportRegistry() *dns.TransportRegistry {
 	local.RegisterTransport(registry)
 	mdns.RegisterTransport(registry)
 	fakeip.RegisterTransport(registry)
-	resolved.RegisterTransport(registry)
+	// podkop-engine: a list of servers, and the provider's servers that netifd knows
+	dns.RegisterGroupTransport(registry)
+	dns.RegisterProviderTransport(registry)
 
 	registerNonPodkopDNSTransports(registry)
 	registerDHCPTransport(registry)
-- 
2.53.0

