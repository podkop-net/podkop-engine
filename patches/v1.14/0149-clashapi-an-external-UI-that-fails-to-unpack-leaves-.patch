 		}
-		err = filemanager.MkdirAll(s.ctx, saveDirectory, 0o755)
+		savePath := filepath.Join(output, name)
+		err := filemanager.MkdirAll(ctx, filepath.Dir(savePath), 0o755)
 		if err != nil {
