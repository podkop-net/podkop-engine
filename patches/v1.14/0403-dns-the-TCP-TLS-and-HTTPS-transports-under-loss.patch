diff --git a/dns/transport/https_test.go b/dns/transport/https_test.go
new file mode 100644
index 000000000..849768ae6
--- /dev/null
+++ b/dns/transport/https_test.go
@@ -0,0 +1,218 @@
+package transport
+
+import (
+	"context"
+	stdtls "crypto/tls"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/common/tls"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	mDNS "github.com/miekg/dns"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/net/http2"
+)
+
+// What a test DoH server does with the n-th request of a connection.
+type dohAction int
+
+const (
+	dohAnswer dohAction = iota
+	dohClose            // end the TCP connection under the request (a FIN): no answer, no GOAWAY
+	dohFail             // answer HTTP 500
+)
+
+type dohConnKey struct{}
+
+type dohServerConn struct {
+	index    int32
+	raw      net.Conn
+	requests atomic.Int32
+}
+
+// dohServer is a DoH server over HTTP/2 that closes its connections without a GOAWAY when
+// action says so, as Quad9 does.
+type dohServer struct {
+	*httptest.Server
+	connections atomic.Int32
+	requests    atomic.Int32
+	closed      atomic.Int32
+}
+
+func newDoHServer(t *testing.T, action func(conn *dohServerConn, request int32) dohAction) *dohServer {
+	s := &dohServer{}
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		s.requests.Add(1)
+		conn := r.Context().Value(dohConnKey{}).(*dohServerConn)
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			return
+		}
+		switch action(conn, conn.requests.Add(1)) {
+		case dohClose:
+			s.closed.Add(1)
+			// The side that writes only: a FIN, as the servers seen in the field send.
+			// Closing the socket while frames of the client wait in it unread would send
+			// a reset, another failure than the one under test.
+			if tcpConn, isTCP := conn.raw.(*net.TCPConn); isTCP {
+				tcpConn.CloseWrite()
+			} else {
+				conn.raw.Close()
+			}
+			return
+		case dohFail:
+			w.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		var query mDNS.Msg
+		if query.Unpack(body) != nil || len(query.Question) != 1 {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		var reply mDNS.Msg
+		reply.SetReply(&query)
+		reply.Answer = append(reply.Answer, &mDNS.A{
+			Hdr: mDNS.RR_Header{Name: query.Question[0].Name, Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 60},
+			A:   net.IPv4(192, 0, 2, 1),
+		})
+		packed, err := reply.Pack()
+		if err != nil {
+			w.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		w.Header().Set("Content-Type", MimeType)
+		w.Write(packed)
+	}))
+	server.EnableHTTP2 = true
+	server.Config.ConnContext = func(ctx context.Context, conn net.Conn) context.Context {
+		// the TCP connection itself: closing it sends a FIN without a TLS close_notify
+		raw := conn
+		if tlsConn, isTLS := conn.(*stdtls.Conn); isTLS {
+			raw = tlsConn.NetConn()
+		}
+		return context.WithValue(ctx, dohConnKey{}, &dohServerConn{index: s.connections.Add(1), raw: raw})
+	}
+	server.StartTLS()
+	t.Cleanup(server.Close)
+	s.Server = server
+	return s
+}
+
+func newTestHTTPS(t *testing.T, server *dohServer) *HTTPSTransport {
+	address := M.ParseSocksaddr(server.Listener.Addr().String())
+	tlsConfig, err := tls.NewClient(context.Background(), log.NewNOPFactory().Logger(), address.AddrString(),
+		option.OutboundTLSOptions{Enabled: true, Insecure: true})
+	require.NoError(t, err)
+	tlsConfig.SetNextProtos([]string{http2.NextProtoTLS, "http/1.1"})
+	destination := &url.URL{Scheme: "https", Host: address.String(), Path: "/dns-query"}
+	transport := NewHTTPSRaw(dns.NewTransportAdapter(C.DNSTypeHTTPS, "test", nil), log.NewNOPFactory().Logger(),
+		N.SystemDialer, destination, http.Header{}, address, tlsConfig)
+	t.Cleanup(transport.Reset)
+	return transport
+}
+
+func testDoHQuery(t *testing.T, transport *HTTPSTransport, name string) (*mDNS.Msg, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	message := new(mDNS.Msg)
+	message.SetQuestion(mDNS.Fqdn(name), mDNS.TypeA)
+	return transport.Exchange(ctx, message)
+}
+
+// A query on a connection that the server closes without a GOAWAY is asked again on a new
+// connection.
+func TestHTTPSAsksAgainAfterCloseWithoutGoAway(t *testing.T) {
+	t.Parallel()
+	server := newDoHServer(t, func(_ *dohServerConn, request int32) dohAction {
+		if request == 2 {
+			return dohClose
+		}
+		return dohAnswer
+	})
+	transport := newTestHTTPS(t, server)
+	for i := 0; i < 6; i++ {
+		response, err := testDoHQuery(t, transport, "q.example.com")
+		require.NoError(t, err, "query %d", i+1)
+		require.Len(t, response.Answer, 1)
+	}
+	// the second request of every connection is closed under it and asked again on the next
+	require.EqualValues(t, 5, server.closed.Load())
+	require.EqualValues(t, 6, server.connections.Load())
+	require.EqualValues(t, 11, server.requests.Load())
+}
+
+// Every query in flight on the closed connection is asked again: a server closes a busy
+// connection with several queries on it.
+func TestHTTPSAsksAgainEveryQueryInFlight(t *testing.T) {
+	t.Parallel()
+	const inFlight = 3
+	closedCh := make(chan struct{})
+	server := newDoHServer(t, func(conn *dohServerConn, request int32) dohAction {
+		if conn.index != 1 {
+			return dohAnswer
+		}
+		// the first connection: its third query closes it, the two before wait for that
+		if request == inFlight {
+			defer close(closedCh)
+			return dohClose
+		}
+		select {
+		case <-closedCh:
+		case <-time.After(4 * time.Second):
+		}
+		return dohClose
+	})
+	transport := newTestHTTPS(t, server)
+	errs := make(chan error, inFlight)
+	for i := 0; i < inFlight; i++ {
+		go func() {
+			response, err := testDoHQuery(t, transport, "q.example.com")
+			if err == nil && len(response.Answer) != 1 {
+				err = io.ErrShortBuffer
+			}
+			errs <- err
+		}()
+	}
+	for i := 0; i < inFlight; i++ {
+		require.NoError(t, <-errs)
+	}
+	require.GreaterOrEqual(t, server.connections.Load(), int32(2))
+}
+
+// Asked again once only: a server that closes the new connection too fails the query.
+func TestHTTPSAsksAgainOnce(t *testing.T) {
+	t.Parallel()
+	server := newDoHServer(t, func(_ *dohServerConn, _ int32) dohAction {
+		return dohClose
+	})
+	transport := newTestHTTPS(t, server)
+	_, err := testDoHQuery(t, transport, "q.example.com")
+	require.ErrorIs(t, err, io.ErrUnexpectedEOF)
+	require.EqualValues(t, 2, server.requests.Load())
+	require.EqualValues(t, 2, server.connections.Load())
+}
+
+// Other failures are not asked again.
+func TestHTTPSDoesNotAskAgainOtherFailures(t *testing.T) {
+	t.Parallel()
+	server := newDoHServer(t, func(_ *dohServerConn, _ int32) dohAction {
+		return dohFail
+	})
+	transport := newTestHTTPS(t, server)
+	_, err := testDoHQuery(t, transport, "q.example.com")
+	require.Error(t, err)
+	require.NotErrorIs(t, err, io.ErrUnexpectedEOF)
+	require.EqualValues(t, 1, server.requests.Load())
+}
