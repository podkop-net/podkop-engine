new file mode 100644
index 000000000..e8c385728
--- /dev/null
+++ b/common/domainset/addresses_test.go
@@ -0,0 +1,79 @@
+package domainset
+
+import (
+	"math/rand"
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-box/common/cidrset"
+
+	"github.com/stretchr/testify/require"
+)
+
+func prefixesOf(set *cidrset.Set) []netip.Prefix {
+	if set == nil {
+		return nil
+	}
+	return set.Prefixes()
+}
+
+// ReadSourceAddresses reads what ReadSource reads but the trie: the same rules with the
+// same sets of addresses and fields, and the first three names of each domain list.
+func TestReadSourceAddressesSameAsReadSource(t *testing.T) {
+	random := rand.New(rand.NewSource(7))
+	for index := range 20000 {
+		g := sourceText{random: random, names: 4}
+		if index%100 == 0 {
+			g.names = 200
+		}
+		text := []byte(g.set())
+		full, fullErr := ReadSource(text)
+		fast, fastErr := ReadSourceAddresses(text)
+		if fullErr != nil {
+			require.Error(t, fastErr, "%s", text)
+			continue
+		}
+		require.NoError(t, fastErr, "%s", text)
+		require.Equal(t, len(full.Options.Rules), len(fast.Options.Rules), "%s", text)
+		for rule := range full.Options.Rules {
+			mine, theirs := fast.Options.Rules[rule].DefaultOptions, full.Options.Rules[rule].DefaultOptions
+			require.Nil(t, mine.DomainSet)
+			if set := theirs.DomainSet; set != nil {
+				require.True(t, len(mine.Domain)+len(mine.DomainSuffix) > 0, "%s", text)
+				require.LessOrEqual(t, len(mine.Domain), 3)
+				require.LessOrEqual(t, len(mine.DomainSuffix), 3)
+			} else {
+				require.Equal(t, theirs.Domain, mine.Domain, "%s", text)
+				require.Equal(t, theirs.DomainSuffix, mine.DomainSuffix, "%s", text)
+			}
+			mine.Domain, mine.DomainSuffix, mine.DomainSet = nil, nil, nil
+			theirs.Domain, theirs.DomainSuffix, theirs.DomainSet = nil, nil, nil
+			require.Equal(t, prefixesOf(theirs.IPRanges), prefixesOf(mine.IPRanges), "%s", text)
+			require.Equal(t, prefixesOf(theirs.SourceIPRanges), prefixesOf(mine.SourceIPRanges), "%s", text)
+			mine.IPRanges, mine.SourceIPRanges, theirs.IPRanges, theirs.SourceIPRanges = nil, nil, nil, nil
+			require.Equal(t, theirs, mine, "%s", text)
+			require.Equal(t, full.Options.Rules[rule].Type, fast.Options.Rules[rule].Type)
+		}
+	}
+}
+
+// What reading a list of names costs when only its addresses are wanted.
+func BenchmarkReadSourceAddresses(b *testing.B) {
+	text := sourceList(300000)
+	b.Run("ReadSource", func(b *testing.B) {
+		b.ReportAllocs()
+		for range b.N {
+			if _, err := ReadSource(text); err != nil {
+				b.Fatal(err)
+			}
+		}
+	})
+	b.Run("ReadSourceAddresses", func(b *testing.B) {
+		b.ReportAllocs()
+		for range b.N {
+			if _, err := ReadSourceAddresses(text); err != nil {
+				b.Fatal(err)
+			}
+		}
+	})
+}
diff --git a/common/domainset/collector.go b/common/domainset/collector.go
new file mode 100644
index 000000000..e9ee48fa8
--- /dev/null
+++ b/common/domainset/collector.go
@@ -0,0 +1,161 @@
+package domainset
+
+import (
+	"context"
+	"math"
+	"slices"
+	"unicode/utf8"
+
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// The kinds of keys, as domain.NewMatcher of sing makes them of a name.
+const (
+	// a name matched as it is: the key is the name reversed
+	kindDomain = iota
+	// a suffix that matches the name and its subdomains: the name reversed, then rootLabel
+	kindRoot
+	// a suffix that begins with ".", its subdomains only: the name reversed, then
+	// prefixLabel
+	kindPrefix
+)
+
+// How a ref packs the length of a name, its kind and the buffer it is in.
+const (
+	lengthBits = 29
+	lengthMask = 1<<lengthBits - 1
+	kindShift  = lengthBits
+	ownShift   = 31
+)
+
+var (
+	// ErrEmptySuffix is an empty name in a list of suffixes: sing has no key for it (its
+	// domain.NewMatcher stops the process with an index out of range).
+	ErrEmptySuffix = E.New("an empty domain suffix")
+	errTooLong     = E.New("a list of domains too long to build")
+	errNotUTF8     = E.New("a domain that is not valid UTF-8")
+)
+
+// ref is a key of the trie: a name of length bytes at offset in one of the buffers of the
+// collector, read from its end, and the label its kind adds after it.
+type ref struct {
+	offset uint32
+	// the length of the name (low 29 bits), its kind (2 bits), the buffer (the top bit)
+	info uint32
+}
+
+func (r ref) length() int {
+	return int(r.info & lengthMask)
+}
+
+func (r ref) kind() uint32 {
+	return r.info >> kindShift & 3
+}
+
+// Collector gathers the names of a domain matcher and builds it. A name is not copied: a
+// key is where its name is, in the text the collector was made with (Add), read from its
+// end. A name that is not there, or is not ASCII, is copied once into a buffer of the
+// collector (AddString), with the bytes of each rune put in reverse order, so that it too
+// is read from its end into its runes reversed, as reverseDomain of sing reverses a name.
+type Collector struct {
+	buffers [2][]byte
+	refs    []ref
+	// the bytes of all keys, labels included: the most labels the trie can have
+	keyBytes int
+	// ctx stops the build of the trie once it is done (NewCollectorContext)
+	ctx context.Context
+}
+
+// NewCollector makes a collector of names found in text.
+func NewCollector(text []byte) *Collector {
+	return &Collector{buffers: [2][]byte{text, nil}}
+}
+
+// NewCollectorContext is NewCollector whose Set and Encode stop with the error of ctx once
+// it is done: the trie of a big list is the most a rule set costs to read, and the rule
+// set may be closed meanwhile.
+func NewCollectorContext(ctx context.Context, text []byte) *Collector {
+	return &Collector{buffers: [2][]byte{text, nil}, ctx: ctx}
+}
+
+// Len is the number of names gathered, repeated ones included.
+func (c *Collector) Len() int {
+	return len(c.refs)
+}
+
+// Grow makes room for count more names, so that a big list is gathered without the copies
+// a growing slice makes.
+func (c *Collector) Grow(count int) {
+	c.refs = slices.Grow(c.refs, count)
+}
+
+// Add takes text[start:end] as a name, a domain or a suffix. The name must be ASCII: the
+// caller checks it.
+func (c *Collector) Add(start int, end int, suffix bool) error {
+	return c.add(0, start, end, suffix)
+}
+
+// AddString takes a name that is not in the text, a domain or a suffix. It must be valid
+// UTF-8: sing reverses a name that is not into bytes that depend on what is around them.
+func (c *Collector) AddString(name string, suffix bool) error {
+	if !utf8.ValidString(name) {
+		return errNotUTF8
+	}
+	start := len(c.buffers[1])
+	c.buffers[1] = appendRunes(c.buffers[1], name)
+	return c.add(1, start, len(c.buffers[1]), suffix)
+}
+
+// AddBytes is AddString of a name in bytes, which are copied.
+func (c *Collector) AddBytes(name []byte, suffix bool) error {
+	if !utf8.Valid(name) {
+		return errNotUTF8
+	}
+	start := len(c.buffers[1])
+	c.buffers[1] = appendRunes(c.buffers[1], name)
+	return c.add(1, start, len(c.buffers[1]), suffix)
+}
+
+// appendRunes appends a name of valid UTF-8 with the bytes of each of its runes in reverse
+// order: read from its end, it is the name with its runes reversed.
+func appendRunes[T string | []byte](own []byte, name T) []byte {
+	for index := 0; index < len(name); {
+		size := 1
+		switch first := name[index]; {
+		case first < utf8.RuneSelf:
+		case first < 0xe0:
+			size = 2
+		case first < 0xf0:
+			size = 3
+		default:
+			size = 4
+		}
+		for back := size - 1; back >= 0; back-- {
+			own = append(own, name[index+back])
+		}
+		index += size
+	}
+	return own
+}
+
+func (c *Collector) add(buffer int, start int, end int, suffix bool) error {
+	length := end - start
+	if length > lengthMask || uint64(start) > math.MaxUint32 || len(c.refs) >= math.MaxInt32 {
+		return errTooLong
+	}
+	kind := uint32(kindDomain)
+	if suffix {
+		if length == 0 {
+			return ErrEmptySuffix
+		}
+		if c.buffers[buffer][start] == '.' {
+			kind = kindPrefix
+		} else {
+			kind = kindRoot
+		}
+		c.keyBytes++
+	}
+	c.keyBytes += length
+	c.refs = append(c.refs, ref{uint32(start), uint32(length) | kind<<kindShift | uint32(buffer)<<ownShift})
+	return nil
+}
diff --git a/common/domainset/domainset.go b/common/domainset/domainset.go
new file mode 100644
index 000000000..a7ef77f7a
--- /dev/null
+++ b/common/domainset/domainset.go
@@ -0,0 +1,139 @@
+// Package domainset reads lists of domains and builds of them the domain matcher of sing
+// (common/domain), the same matcher byte for byte as domain.NewMatcher builds, with a
+// fraction of its memory and time. It reads the rule sets of the source format, JSON, in
+// one pass (ReadSource), and takes lists of strings (NewSet, Encode).
+//
+// The rules it keeps:
+//
+//   - What it builds is what sing-box builds of the same input: the same matcher, byte for
+//     byte, and the same rules around it. Input it cannot read so is left to the code of
+//     sing-box (ReadSource), or refused with the reason (NewMatcher): it never guesses.
+//     Where sing stops the process (an empty suffix) it gives an error instead.
+//   - A name is not copied: a key of the trie is where the name is in the text it was
+//     read from, read from its end. Only a name written with escapes, or not ASCII, is
+//     copied, once.
+//   - The keys are not sorted by comparing them: the trie is built a level at a time, the
+//     keys of a node parted by their next byte (a radix sort in the order of the trie),
+//     so that a key is looked at once a byte. Repeated names, and a name that is a suffix
+//     too, are dealt with as the trie is built, with no map.
+//   - The trie is a type of its own (succinct.Set), sing's succinct set with sing's code
+//     to match it, filled in place: domain.ReadMatcher would copy it, and the copy and
+//     the trie it is made of were the peak of a big list.
+//
+// domain.NewMatcher keeps the queue of its breadth-first walk of the trie whole until the
+// trie is built, an entry of 24 bytes for every node, and its map of names: a list of
+// 100000 varied names, about two million nodes, takes it to a peak of a hundred
+// megabytes and more, which a router with 128 MB does not have.
+package domainset
+
+import (
+	"slices"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/sagernet/sing/common/domain"
+)
+
+// Matcher is what a rule asks of a domain trie: domain.Matcher of sing, or a succinct.Set.
+type Matcher interface {
+	Match(domain string) bool
+}
+
+// NewSet is domain.NewMatcher of the names matched as they are (domains) and with their
+// subdomains (domainSuffix; one that begins with "." matches its subdomains only): a
+// succinct.Set with what Describe tells of the lists. Names that are not valid UTF-8 are
+// built by sing itself, which reverses such a name into bytes that depend on what is
+// around them.
+func NewSet(domains []string, domainSuffix []string) (Matcher, error) {
+	if !validNames(domains, domainSuffix) {
+		// an empty suffix stops sing's build
+		if slices.Contains(domainSuffix, "") {
+			return nil, ErrEmptySuffix
+		}
+		return domain.NewMatcher(domains, domainSuffix, false), nil
+	}
+	collector, err := collect(domains, domainSuffix)
+	if err != nil {
+		return nil, err
+	}
+	return collector.Set(Describe(domains[:min(3, len(domains))], len(domains), domainSuffix[:min(3, len(domainSuffix))], len(domainSuffix)))
+}
+
+// Describe is what route/rule tells of a domain item of the lists: the first three names
+// of each (domains, domainSuffix), and whether there are more of them than that.
+func Describe(domains []string, domainCount int, domainSuffix []string, domainSuffixCount int) string {
+	var description string
+	if domainCount > 0 {
+		if domainCount == 1 {
+			description = "domain=" + domains[0]
+		} else if domainCount > 3 {
+			description = "domain=[" + strings.Join(domains[:3], " ") + "...]"
+		} else {
+			description = "domain=[" + strings.Join(domains, " ") + "]"
+		}
+	}
+	if domainSuffixCount > 0 {
+		if len(description) > 0 {
+			description += " "
+		}
+		if domainSuffixCount == 1 {
+			description += "domain_suffix=" + domainSuffix[0]
+		} else if domainSuffixCount > 3 {
+			description += "domain_suffix=[" + strings.Join(domainSuffix[:3], " ") + "...]"
+		} else {
+			description += "domain_suffix=[" + strings.Join(domainSuffix, " ") + "]"
+		}
+	}
+	return description
+}
+
+// Encode is domain.NewMatcher(domains, domainSuffix, generateLegacy) as domain.Matcher.Write
+// writes it, the form a rule set in the binary format carries.
+func Encode(domains []string, domainSuffix []string, generateLegacy bool) ([]byte, error) {
+	if generateLegacy || !validNames(domains, domainSuffix) {
+		return encodeSorted(domains, domainSuffix, generateLegacy)
+	}
+	collector, err := collect(domains, domainSuffix)
+	if err != nil {
+		return nil, err
+	}
+	return collector.Encode()
+}
+
+func collect(domains []string, domainSuffix []string) (*Collector, error) {
+	size := 0
+	for _, list := range [][]string{domains, domainSuffix} {
+		for _, name := range list {
+			size += len(name)
+		}
+	}
+	collector := NewCollector(nil)
+	collector.buffers[1] = make([]byte, 0, size)
+	collector.refs = make([]ref, 0, len(domains)+len(domainSuffix))
+	for _, name := range domainSuffix {
+		err := collector.AddString(name, true)
+		if err != nil {
+			return nil, err
+		}
+	}
+	for _, name := range domains {
+		err := collector.AddString(name, false)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return collector, nil
+}
+
+// validNames tells that every name is valid UTF-8. sing reverses a name that is not into
+// bytes that depend on what is around them; such a list is built the way sing builds it.
+func validNames(lists ...[]string) bool {
+	for _, list := range lists {
+		for _, name := range list {
+			if !utf8.ValidString(name) {
+				return false
+			}
+		}
+	}
+	return true
+}
diff --git a/common/domainset/domainset_test.go b/common/domainset/domainset_test.go
new file mode 100644
index 000000000..117f941bb
--- /dev/null
+++ b/common/domainset/domainset_test.go
@@ -0,0 +1,244 @@
+package domainset
+
+import (
+	"bytes"
+	"math/rand"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/common/domainset/succinct"
+	"github.com/sagernet/sing/common/domain"
+
+	"github.com/stretchr/testify/require"
+)
+
+// names makes count names of no pattern, some with a dot in front, some repeated, some
+// not of ASCII.
+func names(random *rand.Rand, count int) []string {
+	letters := "abcdefghijklmnopqrstuvwxyz0123456789-"
+	tlds := []string{"com", "net", "org", "ru", "io", "co.uk", "рф", "xn--p1ai"}
+	result := make([]string, 0, count)
+	for len(result) < count {
+		var name strings.Builder
+		if random.Intn(10) == 0 {
+			name.WriteByte('.')
+		}
+		for range 1 + random.Intn(3) {
+			for range 1 + random.Intn(10) {
+				name.WriteByte(letters[random.Intn(26)])
+			}
+			if random.Intn(5) == 0 {
+				name.WriteString("-" + string(letters[random.Intn(len(letters))]))
+			}
+			name.WriteByte('.')
+		}
+		name.WriteString(tlds[random.Intn(len(tlds))])
+		result = append(result, name.String())
+		if random.Intn(20) == 0 && len(result) < count {
+			// the same name again
+			result = append(result, result[random.Intn(len(result))])
+		}
+	}
+	return result
+}
+
+func singBytes(t *testing.T, domains []string, domainSuffix []string, generateLegacy bool) []byte {
+	var content bytes.Buffer
+	require.NoError(t, domain.NewMatcher(domains, domainSuffix, generateLegacy).Write(&content))
+	return content.Bytes()
+}
+
+// The matcher is the one of sing, byte for byte as it is written into a rule set: names and
+// suffixes of no pattern, repeated, in both lists, with a dot in front, not of ASCII, in
+// the legacy way and not, from a few to many.
+func TestSameAsSing(t *testing.T) {
+	random := rand.New(rand.NewSource(1))
+	for _, count := range []int{1, 2, 3, 10, 100, 1000, 20000} {
+		for _, legacy := range []bool{false, true} {
+			domains, suffixes := names(random, count), names(random, count)
+			// a name in both lists, and a suffix of a name
+			domains = append(domains, suffixes[0])
+			suffixes = append(suffixes, "."+strings.TrimPrefix(domains[0], "."))
+			for _, lists := range [][2][]string{{domains, suffixes}, {domains, nil}, {nil, suffixes}} {
+				want := singBytes(t, lists[0], lists[1], legacy)
+				encoded, err := Encode(lists[0], lists[1], legacy)
+				require.NoError(t, err)
+				require.Equal(t, want, encoded, "%d names, legacy %v", count, legacy)
+				if legacy {
+					continue
+				}
+				matcher, err := NewSet(lists[0], lists[1])
+				require.NoError(t, err)
+				var written bytes.Buffer
+				require.NoError(t, matcher.(*succinct.Set).Write(&written))
+				require.Equal(t, want, written.Bytes())
+			}
+		}
+	}
+	// one name and one suffix, and a name that is a suffix of another
+	for _, lists := range [][2][]string{
+		{{"example.com"}, nil}, {nil, {"example.com"}}, {nil, {".example.com"}},
+		{{"a.b.c", "b.c"}, {"c", ".b.c"}}, {{"x"}, {"x"}},
+	} {
+		encoded, err := Encode(lists[0], lists[1], false)
+		require.NoError(t, err)
+		require.Equal(t, singBytes(t, lists[0], lists[1], false), encoded, "%v", lists)
+	}
+}
+
+// Names sing takes that a list of a rule set hardly has: empty, in capitals, with the
+// labels of the trie inside them, of one byte, a name that is a suffix of another in
+// every way; and names that are not valid UTF-8, which go the way sing builds them. The
+// random lists go every way: with a name that is not valid UTF-8 or not, legacy or not.
+func TestSameAsSingOddNames(t *testing.T) {
+	for _, lists := range [][2][]string{
+		{{""}, nil},
+		{{"", "a"}, {"a"}},
+		{{"Example.COM", "example.com"}, {"EXAMPLE.com"}},
+		{{"a\nb", "a\rb", "\nx"}, {"b\ra", ".\n"}},
+		{{"a", "b", "c"}, {"a", ".a", "b"}},
+		{{".a", "a."}, {".a", "a."}},
+		{{"x.y.z", "y.z", "z"}, {"y.z", ".z", "x.y.z"}},
+		{{"ab\xffcd"}, {"ef\xfegh"}},
+		{{"пример.рф", "例子.测试"}, {".рф", "测试"}},
+	} {
+		encoded, err := Encode(lists[0], lists[1], false)
+		require.NoError(t, err)
+		require.Equal(t, singBytes(t, lists[0], lists[1], false), encoded, "%q", lists)
+	}
+	random := rand.New(rand.NewSource(3))
+	alphabet := []string{"a", "b", ".", "\n", "\r", "я", "-"}
+	for range 2000 {
+		var lists [2][]string
+		for side := range lists {
+			for range random.Intn(8) {
+				var name strings.Builder
+				for range random.Intn(6) {
+					name.WriteString(alphabet[random.Intn(len(alphabet))])
+				}
+				lists[side] = append(lists[side], name.String())
+			}
+		}
+		if len(lists[0])+len(lists[1]) == 0 {
+			continue
+		}
+		// a name that is not valid UTF-8 takes the list to the build of sorted keys, as
+		// the legacy way does (two bytes before the bad one: sing's reverse of a name puts
+		// U+FFFD, three bytes, where that byte goes and needs room for it)
+		odd := append(append([]string(nil), lists[0]...), "ab\xffcd")
+		for _, domains := range [][]string{lists[0], odd} {
+			for _, legacy := range []bool{false, true} {
+				var want []byte
+				func() {
+					defer func() {
+						if recover() != nil {
+							want = nil
+						}
+					}()
+					want = singBytes(t, domains, lists[1], legacy)
+				}()
+				encoded, err := Encode(domains, lists[1], legacy)
+				if want == nil {
+					// sing stops the process: an empty suffix
+					require.Error(t, err, "%q %q legacy %v", domains, lists[1], legacy)
+				} else {
+					require.NoError(t, err, "%q %q legacy %v", domains, lists[1], legacy)
+					require.Equal(t, want, encoded, "%q %q legacy %v", domains, lists[1], legacy)
+				}
+				if !legacy {
+					_, err = NewSet(domains, lists[1])
+					require.Equal(t, want == nil, err != nil, "%q %q", domains, lists[1])
+				}
+			}
+		}
+	}
+}
+
+// What sing cannot build is an error here, where sing stops the process.
+func TestRefused(t *testing.T) {
+	_, err := NewSet(nil, []string{"a", ""})
+	require.ErrorIs(t, err, ErrEmptySuffix)
+	_, err = NewSet([]string{"ab\xffcd"}, []string{"a", ""})
+	require.ErrorIs(t, err, ErrEmptySuffix)
+	_, err = Encode(nil, []string{"a", ""}, true)
+	require.ErrorIs(t, err, ErrEmptySuffix)
+}
+
+// A name and a suffix that make the same key are one key, as in sing since v0.9.7: in the
+// trie of Collector, and in the build of sorted keys (the legacy way, a name that is not
+// valid UTF-8).
+func TestSameKey(t *testing.T) {
+	for _, item := range []struct {
+		domains, domainSuffix []string
+		legacy                bool
+	}{
+		{[]string{"\na"}, []string{"a"}, false},
+		{[]string{"\r.a"}, []string{"a"}, true},
+		{[]string{"\na", "ab\xffcd"}, []string{"a"}, false},
+	} {
+		encoded, err := Encode(item.domains, item.domainSuffix, item.legacy)
+		require.NoError(t, err, "%q", item)
+		require.Equal(t, singBytes(t, item.domains, item.domainSuffix, item.legacy), encoded, "%q", item)
+	}
+}
+
+// What a list of 100000 names of no pattern costs to build: here and in sing.
+func BenchmarkBuild(b *testing.B) {
+	list := names(rand.New(rand.NewSource(2)), 100000)
+	b.Run("domainset", func(b *testing.B) {
+		b.ReportAllocs()
+		for range b.N {
+			if _, err := NewSet(nil, list); err != nil {
+				b.Fatal(err)
+			}
+		}
+	})
+	b.Run("sing", func(b *testing.B) {
+		b.ReportAllocs()
+		for range b.N {
+			domain.NewMatcher(nil, list, false)
+		}
+	})
+}
+
+// The set matches what the matcher of sing matches: the names of the lists, their
+// subdomains, the names a suffix is cut from, names in capitals, not of ASCII, empty,
+// words; and it tells of itself what route/rule told of a domain item.
+func TestSetMatchesAsSing(t *testing.T) {
+	random := rand.New(rand.NewSource(7))
+	for _, count := range []int{1, 2, 5, 50, 3000} {
+		for round := range 20 {
+			domains, suffixes := names(random, count), names(random, count)
+			if round%3 == 1 {
+				domains = nil
+			} else if round%3 == 2 {
+				suffixes = nil
+			}
+			matcher, err := NewSet(domains, suffixes)
+			require.NoError(t, err)
+			want := domain.NewMatcher(domains, suffixes, false)
+			var queries []string
+			for _, name := range append(append([]string(nil), domains...), suffixes...) {
+				bare := strings.TrimPrefix(name, ".")
+				queries = append(queries, name, bare, "a."+bare, "x.y."+bare, strings.ToUpper(bare), bare[1:], bare+".", "."+bare)
+				if dot := strings.IndexByte(bare, '.'); dot >= 0 {
+					queries = append(queries, bare[dot+1:], bare[dot:])
+				}
+			}
+			queries = append(queries, "", ".", "com", "рф", "localhost", "\n", "\r", "a\nb")
+			for _, query := range queries {
+				require.Equal(t, want.Match(query), matcher.Match(query), "%q in %d names", query, count)
+			}
+			require.Equal(t, Describe(domains[:min(3, len(domains))], len(domains), suffixes[:min(3, len(suffixes))], len(suffixes)),
+				matcher.(*succinct.Set).String())
+		}
+	}
+}
+
+// A trie that is not one is refused, as domain.ReadMatcher refuses it.
+func TestSetRefusesMalformed(t *testing.T) {
+	_, err := succinct.New(nil, []uint64{0b10}, []byte("ab"), "")
+	require.Error(t, err)
+	_, err = succinct.New(nil, nil, nil, "")
+	require.Error(t, err)
+}
diff --git a/common/domainset/legacy.go b/common/domainset/legacy.go
new file mode 100644
index 000000000..1d06b73e3
--- /dev/null
+++ b/common/domainset/legacy.go
@@ -0,0 +1,151 @@
+package domainset
+
+import (
+	"bytes"
+	"encoding/binary"
+	"slices"
+	"unicode/utf8"
+
+	"github.com/sagernet/sing/common/varbin"
+)
+
+// the labels of sing (common/domain/matcher.go): a key that ends a suffix, and one that
+// ends a name and its subdomains
+const (
+	prefixLabel = '\r'
+	rootLabel   = '\n'
+)
+
+// encodeSorted builds the matcher the way sing does, its keys made into strings, kept in a
+// map and sorted: for the legacy way of rule sets of version 1 (a suffix is two keys,
+// one of them for a name that is not in the list) and for names that are not valid UTF-8.
+// Only the walk of the trie is the lean one of Collector.build, one level at a time.
+func encodeSorted(domains []string, domainSuffix []string, generateLegacy bool) ([]byte, error) {
+	list, err := keys(domains, domainSuffix, generateLegacy)
+	if err != nil {
+		return nil, err
+	}
+	return buildSorted(list), nil
+}
+
+// keys are the keys of the trie, as domain.NewMatcher makes them: a name reversed, with a
+// label for how it matches, each once, in order. A name of domains that is a suffix too is
+// the suffix only, as there, and a name and a suffix that make the same key are one key.
+// An empty suffix, which stops the process there, is an error.
+func keys(domains []string, domainSuffix []string, generateLegacy bool) ([]string, error) {
+	seen := make(map[string]bool, len(domainSuffix)+len(domains))
+	list := make([]string, 0, len(domains)+len(domainSuffix))
+	for _, name := range domainSuffix {
+		if name == "" {
+			return nil, ErrEmptySuffix
+		}
+		if seen[name] {
+			continue
+		}
+		seen[name] = true
+		switch {
+		case name[0] == '.':
+			list = append(list, reverse(string(prefixLabel)+name))
+		case generateLegacy:
+			list = append(list, reverse(name))
+			suffix := "." + name
+			if !seen[suffix] {
+				seen[suffix] = true
+				list = append(list, reverse(string(prefixLabel)+suffix))
+			}
+		default:
+			list = append(list, reverse(string(rootLabel)+name))
+		}
+	}
+	for _, name := range domains {
+		if seen[name] {
+			continue
+		}
+		seen[name] = true
+		list = append(list, reverse(name))
+	}
+	// the map is no longer needed: a big list should not keep it while the trie is built
+	seen = nil
+	slices.Sort(list)
+	// a name that begins with "\n" or "\r" can make the key of a suffix: sing keeps it once
+	// (slices.Compact since v0.9.7), and buildSorted cannot hold it twice
+	return slices.Compact(list), nil
+}
+
+// reverse is reverseDomain of sing: the runes in the other order.
+func reverse(name string) string {
+	length := len(name)
+	reversed := make([]byte, length)
+	for index := 0; index < length; {
+		character, size := utf8.DecodeRuneInString(name[index:])
+		index += size
+		utf8.EncodeRune(reversed[length-index:], character)
+	}
+	return string(reversed)
+}
+
+// sortedSpan is a node of the trie as buildSorted sees it: the keys from start to end
+// that share their first column bytes.
+type sortedSpan struct {
+	start, end, column int32
+}
+
+// buildSorted makes the succinct set of sorted keys, the trie of newSuccinctSet of sing,
+// written as succinctSet.Write writes it.
+func buildSorted(keys []string) []byte {
+	var (
+		leaves, labelBitmap []uint64
+		labels              []byte
+	)
+	bit := 0
+	node := 0
+	level := []sortedSpan{{0, int32(len(keys)), 0}}
+	var next []sortedSpan
+	for len(level) > 0 {
+		next = next[:0]
+		for _, item := range level {
+			start := int(item.start)
+			column := int(item.column)
+			if column == len(keys[start]) {
+				// a key ends here: a leaf
+				start++
+				setBit(&leaves, node)
+			}
+			for index := start; index < int(item.end); {
+				first := index
+				for index < int(item.end) && keys[index][column] == keys[first][column] {
+					index++
+				}
+				next = append(next, sortedSpan{int32(first), int32(index), int32(column + 1)})
+				labels = append(labels, keys[first][column])
+				// a zero bit for each label
+				bit++
+			}
+			setBit(&labelBitmap, bit)
+			bit++
+			node++
+		}
+		level, next = next, level
+	}
+	var content bytes.Buffer
+	content.Grow(16 + 8*(len(leaves)+len(labelBitmap)) + len(labels))
+	content.WriteByte(0)
+	writeWords(&content, leaves)
+	writeWords(&content, labelBitmap)
+	writeLength(&content, len(labels))
+	content.Write(labels)
+	return content.Bytes()
+}
+
+func writeLength(content *bytes.Buffer, length int) {
+	_, _ = varbin.WriteUvarint(content, uint64(length))
+}
+
+func writeWords(content *bytes.Buffer, words []uint64) {
+	writeLength(content, len(words))
+	var word [8]byte
+	for _, value := range words {
+		binary.BigEndian.PutUint64(word[:], value)
+		content.Write(word[:])
+	}
+}
diff --git a/common/domainset/source.go b/common/domainset/source.go
new file mode 100644
index 000000000..b271d779b
--- /dev/null
+++ b/common/domainset/source.go
@@ -0,0 +1,709 @@
+package domainset
+
+import (
+	"bytes"
+	"context"
+	"net/netip"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/sagernet/sing-box/common/cidrset"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json"
+	"github.com/sagernet/sing/common/json/badjson"
+	"github.com/sagernet/sing/common/json/badoption"
+)
+
+// ReadSource reads a rule set of the source format, JSON, into what
+// json.UnmarshalExtended[option.PlainRuleSetCompat] reads of it, in one pass and without
+// a copy of the names where it can. The rules differ in one way: the names of a rule of
+// the default type (domain, domain_suffix) come as their trie (DomainSet), and its CIDR
+// lists (source_ip_cidr, ip_cidr) as their sets (SourceIPRanges, IPRanges), not as lists
+// of strings; the trie and the sets, and what they tell of themselves, are what
+// route/rule builds of those lists.
+//
+// What it reads so is JSON of a strict shape: the object of the rule set with "version"
+// (a digit) and "rules", nothing around it but white space. In a rule it reads the lists of
+// strings itself (domain, domain_suffix, domain_keyword, domain_regex, source_ip_cidr,
+// ip_cidr, each a string, an array of strings or null), and hands the other fields to
+// sing-box as a small object. Anything else (comments, a logical rule, a field written in
+// other letters, a key twice, a value of another shape) goes to sing-box: a rule alone,
+// when the shape of the set is as above, or the whole text. So does any error: the error
+// is then sing-box's own.
+func ReadSource(content []byte) (option.PlainRuleSetCompat, error) {
+	return ReadSourceContext(context.Background(), content)
+}
+
+// ReadSourceContext is ReadSource that stops with the error of ctx once it is done: a rule
+// set closed while it reads a big list does not read it to the end. The decoding of
+// sing-box, for a text of another shape, is not stopped.
+func ReadSourceContext(ctx context.Context, content []byte) (option.PlainRuleSetCompat, error) {
+	compat, ok, err := readSource(ctx, content)
+	if err != nil {
+		return compat, err
+	}
+	if ok {
+		return compat, nil
+	}
+	return json.UnmarshalExtended[option.PlainRuleSetCompat](content)
+}
+
+// the lists of strings of a default rule read here, in the order of their bit in a mask
+const (
+	fieldDomain = iota
+	fieldDomainSuffix
+	fieldDomainKeyword
+	fieldDomainRegex
+	fieldSourceIPCIDR
+	fieldIPCIDR
+	fieldCount
+)
+
+var (
+	fieldNames = [fieldCount]string{"domain", "domain_suffix", "domain_keyword", "domain_regex", "source_ip_cidr", "ip_cidr"}
+	// the keys whose other spellings are sing-box's to read
+	foldNames = append(fieldNames[:], "type")
+)
+
+// ReadSourceAddresses is ReadSource for those who want the addresses of a rule set and the
+// shape of its rules, not its matcher: the names of domain and domain_suffix are counted,
+// not gathered, and a rule keeps the first three of each as its lists (Domain,
+// DomainSuffix) in place of the trie. Everything else is read as ReadSource reads it.
+func ReadSourceAddresses(content []byte) (option.PlainRuleSetCompat, error) {
+	compat, ok := readSourceText(&reader{text: content, ctx: context.Background(), addresses: true})
+	if ok {
+		return compat, nil
+	}
+	return json.UnmarshalExtended[option.PlainRuleSetCompat](content)
+}
+
+// reader is the text of a rule set and where it is read. It stops once ctx is done, and
+// err tells why. addresses: the names of domains are not gathered (ReadSourceAddresses).
+type reader struct {
+	text      []byte
+	at        int
+	ctx       context.Context
+	items     int
+	err       error
+	addresses bool
+}
+
+// stopped tells, every stopEvery items, whether the reading is to stop.
+func (r *reader) stopped() bool {
+	r.items++
+	if r.items&stopEvery == 0 && r.ctx.Err() != nil {
+		r.err = r.ctx.Err()
+	}
+	return r.err != nil
+}
+
+func readSource(ctx context.Context, text []byte) (option.PlainRuleSetCompat, bool, error) {
+	compat, ok := readSourceText(&reader{text: text, ctx: ctx})
+	return compat, ok, ctx.Err()
+}
+
+func readSourceText(r *reader) (option.PlainRuleSetCompat, bool) {
+	var compat option.PlainRuleSetCompat
+	text := r.text
+	r.space()
+	begin := r.at
+	if !r.take('{') {
+		return compat, false
+	}
+	var (
+		haveVersion, haveRules bool
+		rules                  []option.HeadlessRule
+		empty                  = true
+	)
+	r.space()
+	if !r.take('}') {
+		for {
+			key, plain, ok := r.key()
+			if !ok || !plain {
+				return compat, false
+			}
+			switch key {
+			case "version":
+				if haveVersion {
+					return compat, false
+				}
+				haveVersion = true
+				compat.Version, ok = r.version()
+			case "rules":
+				if haveRules {
+					return compat, false
+				}
+				haveRules = true
+				rules, empty, ok = r.rules()
+			default:
+				// any other key, of other letters too, is sing-box's to tell
+				return compat, false
+			}
+			if !ok {
+				return compat, false
+			}
+			r.space()
+			if r.take(',') {
+				r.space()
+				continue
+			}
+			if r.take('}') {
+				break
+			}
+			return compat, false
+		}
+	}
+	end := r.at
+	r.space()
+	if r.at != len(text) || !haveVersion {
+		return compat, false
+	}
+	// rules that are all empty (no rule, or rules whose values are all empty arrays and
+	// objects) are dropped by badjson before sing-box reads them: there are none
+	if !empty {
+		compat.Options.Rules = rules
+	}
+	compat.RawMessage = text[begin:end]
+	return compat, true
+}
+
+// version reads the version of the rule set: one digit of a version sing-box knows.
+func (r *reader) version() (uint8, bool) {
+	if r.at+1 >= len(r.text) {
+		return 0, false
+	}
+	digit := r.text[r.at]
+	if digit < '1' || digit > '0'+C.RuleSetVersionCurrent {
+		return 0, false
+	}
+	switch r.text[r.at+1] {
+	case ' ', '\t', '\n', '\r', ',', '}':
+	default:
+		return 0, false
+	}
+	r.at++
+	return digit - '0', true
+}
+
+// rules reads the array of rules, and whether every rule is empty as badjson sees it.
+func (r *reader) rules() ([]option.HeadlessRule, bool, bool) {
+	if !r.take('[') {
+		return nil, false, false
+	}
+	var rules []option.HeadlessRule
+	empty := true
+	r.space()
+	if r.take(']') {
+		return nil, true, true
+	}
+	for {
+		rule, ruleEmpty, ok := r.rule()
+		if !ok {
+			return nil, false, false
+		}
+		rules = append(rules, rule)
+		empty = empty && ruleEmpty
+		r.space()
+		if r.take(',') {
+			r.space()
+			continue
+		}
+		if r.take(']') {
+			return rules, empty, true
+		}
+		return nil, false, false
+	}
+}
+
+// rule reads a rule: the lists of strings of a default rule here, the rest by sing-box.
+// It also tells whether badjson takes the rule for empty.
+func (r *reader) rule() (option.HeadlessRule, bool, bool) {
+	var rule option.HeadlessRule
+	begin := r.at
+	if !r.take('{') {
+		return rule, false, false
+	}
+	var (
+		// the rule goes to sing-box whole
+		whole bool
+		// the fields read here, and the ones of them that are not empty arrays
+		seen, full uint
+		lists      [fieldCount][]string
+		names      *Collector
+		// the first names of domain and domain_suffix, and how many there are
+		first  [2][]string
+		counts [2]int
+		// the ranges of source_ip_cidr and ip_cidr, their first items, how many there are
+		cidrs      [2]cidrset.Builder
+		cidrFirst  [2][]string
+		cidrCounts [2]int
+		// the other members, as their text
+		rest [][]byte
+	)
+	r.space()
+	if !r.take('}') {
+		for {
+			memberStart := r.at
+			key, plain, ok := r.key()
+			if !ok {
+				return rule, false, false
+			}
+			valueStart := r.at
+			field := fieldIndex(key)
+			switch {
+			case whole:
+			case !plain:
+				whole = true
+			case field >= 0:
+				if seen&(1<<field) != 0 {
+					// a key twice: badjson keeps the last value
+					whole = true
+					break
+				}
+				seen |= 1 << field
+				var count int
+				if field == fieldDomain || field == fieldDomainSuffix {
+					side := field - fieldDomain
+					if r.addresses {
+						count, ok = r.firstNames(&first[side])
+					} else {
+						if names == nil {
+							names = NewCollectorContext(r.ctx, r.text)
+						}
+						count, ok = r.names(names, field == fieldDomainSuffix, &first[side])
+					}
+					counts[side] = count
+				} else if field == fieldSourceIPCIDR || field == fieldIPCIDR {
+					side := field - fieldSourceIPCIDR
+					count, ok = r.cidrs(&cidrs[side], &cidrFirst[side])
+					cidrCounts[side] = count
+				} else {
+					lists[field], ok = r.strings()
+					count = len(lists[field])
+				}
+				if !ok {
+					// a value of another shape
+					whole = true
+					r.at = valueStart
+					break
+				}
+				if count > 0 || r.text[valueStart] != '[' {
+					full |= 1 << field
+				}
+			case foldsTo(key):
+				// "Domain", "TYPE": decoding matches fields in any letters
+				whole = true
+			case key == "type":
+				if !r.defaultType() {
+					whole = true
+				}
+				r.at = valueStart
+			}
+			if whole || field < 0 {
+				if !r.skipValue() || r.at == valueStart {
+					return rule, false, false
+				}
+				if !whole {
+					rest = append(rest, r.text[memberStart:r.at])
+				}
+			}
+			r.space()
+			if r.take(',') {
+				r.space()
+				continue
+			}
+			if r.take('}') {
+				break
+			}
+			return rule, false, false
+		}
+	}
+	if whole {
+		rule, empty, err := sourceRule(r.text[begin:r.at])
+		return rule, empty, err == nil
+	}
+	restEmpty := true
+	if len(rest) == 0 {
+		rule.Type = C.RuleTypeDefault
+	} else {
+		var err error
+		rule, restEmpty, err = sourceRule(append(append([]byte{'{'}, bytes.Join(rest, []byte{','})...), '}'))
+		if err != nil || rule.Type != C.RuleTypeDefault {
+			return rule, false, false
+		}
+	}
+	fields := &rule.DefaultOptions
+	fields.DomainKeyword = badoption.Listable[string](lists[fieldDomainKeyword])
+	fields.DomainRegex = badoption.Listable[string](lists[fieldDomainRegex])
+	if cidrCounts[0] > 0 {
+		fields.SourceIPRanges = cidrs[0].Set(cidrset.Describe(true, cidrFirst[0], cidrCounts[0]))
+	}
+	if cidrCounts[1] > 0 {
+		fields.IPRanges = cidrs[1].Set(cidrset.Describe(false, cidrFirst[1], cidrCounts[1]))
+	}
+	if names != nil && names.Len() > 0 {
+		set, err := names.Set(Describe(first[0], counts[0], first[1], counts[1]))
+		if err != nil {
+			return rule, false, false
+		}
+		fields.DomainSet = set
+	}
+	if r.addresses {
+		if counts[0] > 0 {
+			fields.Domain = first[0]
+		}
+		if counts[1] > 0 {
+			fields.DomainSuffix = first[1]
+		}
+	}
+	return rule, full == 0 && restEmpty, true
+}
+
+// sourceRule reads a rule as sing-box reads one of the rules of a set: badjson takes the
+// rule apart, writes it again without its empty values, and the rule reads that. It also
+// tells whether badjson takes the rule for empty.
+func sourceRule(text []byte) (option.HeadlessRule, bool, error) {
+	var rule option.HeadlessRule
+	var object badjson.JSONObject
+	err := object.UnmarshalJSONContext(context.Background(), text)
+	if err != nil {
+		return rule, false, err
+	}
+	written, err := object.MarshalJSONContext(context.Background())
+	if err != nil {
+		return rule, false, err
+	}
+	err = rule.UnmarshalJSON(written)
+	return rule, object.IsEmpty(), err
+}
+
+func fieldIndex(key string) int {
+	for index, name := range fieldNames {
+		if key == name {
+			return index
+		}
+	}
+	return -1
+}
+
+// foldsTo tells a key that is not one of the fields read here, nor "type", but which the
+// decoding of sing-box matches with one of them, as it matches keys in any letters.
+func foldsTo(key string) bool {
+	for _, name := range foldNames {
+		if key != name && strings.EqualFold(key, name) {
+			return true
+		}
+	}
+	return false
+}
+
+// defaultType tells that the value of "type" is "default" or "": a default rule, whose
+// type sing-box reads with the rest.
+func (r *reader) defaultType() bool {
+	start, end, plain, ok := r.str()
+	if !ok || !plain {
+		return false
+	}
+	value := string(r.text[start:end])
+	return value == "" || value == C.RuleTypeDefault
+}
+
+// names reads a value of domain or domain_suffix into the collector: a string, an array
+// of strings or null. It tells how many names it read, and keeps the first three of them
+// for the description of the rule. An empty name is route/rule's to refuse: the rule goes
+// to sing-box.
+func (r *reader) names(names *Collector, suffix bool, first *[]string) (int, bool) {
+	names.Grow(r.countStrings())
+	count := 0
+	ok := r.each(func(start int, end int, plain bool) bool {
+		if start == end {
+			return false
+		}
+		count++
+		var err error
+		var name string
+		if plain {
+			err = names.Add(start, end, suffix)
+		} else if text, unescaped := r.unescaped(start, end); unescaped {
+			err = names.AddBytes(text, suffix)
+		} else {
+			var ok bool
+			name, ok = r.unquote(start, end)
+			if !ok || name == "" {
+				return false
+			}
+			err = names.AddString(name, suffix)
+		}
+		if len(*first) < 3 {
+			if name == "" {
+				name = string(r.text[start:end])
+			}
+			*first = append(*first, name)
+		}
+		return err == nil
+	})
+	return count, ok
+}
+
+// firstNames reads a value of domain or domain_suffix without gathering it: how many names
+// there are, and the first three of them. An empty name is route/rule's to refuse, as in
+// names.
+func (r *reader) firstNames(first *[]string) (int, bool) {
+	count := 0
+	ok := r.each(func(start int, end int, plain bool) bool {
+		if start == end {
+			return false
+		}
+		count++
+		if len(*first) >= 3 {
+			return true
+		}
+		name := string(r.text[start:end])
+		if !plain {
+			var ok bool
+			name, ok = r.unquote(start, end)
+			if !ok || name == "" {
+				return false
+			}
+		}
+		*first = append(*first, name)
+		return true
+	})
+	return count, ok
+}
+
+// cidrs reads a value of source_ip_cidr or ip_cidr into the builder: a string, an array of
+// strings or null. A canonical IPv4 prefix is read from its text, any other by netip as
+// NewIPCIDRItem reads it; one netip refuses is NewIPCIDRItem's to tell: the rule goes to
+// sing-box. It tells how many items it read, and keeps the first three of them for the
+// description of the rule.
+func (r *reader) cidrs(builder *cidrset.Builder, first *[]string) (int, bool) {
+	builder.Grow(r.countStrings())
+	count := 0
+	ok := r.each(func(start int, end int, plain bool) bool {
+		count++
+		var text string
+		if plain {
+			if from, to, ok := cidrset.Parse4(r.text[start:end]); ok {
+				builder.Add4(from, to)
+				if len(*first) < 3 {
+					*first = append(*first, string(r.text[start:end]))
+				}
+				return true
+			}
+			text = string(r.text[start:end])
+		} else {
+			var ok bool
+			text, ok = r.unquote(start, end)
+			if !ok {
+				return false
+			}
+		}
+		if len(*first) < 3 {
+			*first = append(*first, text)
+		}
+		if prefix, err := netip.ParsePrefix(text); err == nil {
+			return builder.AddPrefix(prefix)
+		}
+		if address, err := netip.ParseAddr(text); err == nil {
+			return builder.AddAddr(address)
+		}
+		return false
+	})
+	return count, ok
+}
+
+// strings reads a value of one of the other lists: a string, an array of strings or null.
+func (r *reader) strings() ([]string, bool) {
+	var list []string
+	ok := r.each(func(start int, end int, plain bool) bool {
+		if plain {
+			list = append(list, string(r.text[start:end]))
+			return true
+		}
+		if text, ok := r.unescaped(start, end); ok {
+			list = append(list, string(text))
+			return true
+		}
+		value, ok := r.unquote(start, end)
+		list = append(list, value)
+		return ok
+	})
+	return list, ok
+}
+
+// each reads a string, an array of strings or null, and hands each string to take: where
+// its text is, and whether that text is the string as it is (ASCII, no escape).
+func (r *reader) each(take func(start int, end int, plain bool) bool) bool {
+	if r.at >= len(r.text) {
+		return false
+	}
+	switch r.text[r.at] {
+	case '"':
+		start, end, plain, ok := r.str()
+		return ok && take(start, end, plain)
+	case 'n':
+		if bytes.HasPrefix(r.text[r.at:], []byte("null")) {
+			r.at += 4
+			return true
+		}
+		return false
+	case '[':
+		r.at++
+		r.space()
+		if r.take(']') {
+			return true
+		}
+		for {
+			start, end, plain, ok := r.str()
+			if !ok || r.stopped() || !take(start, end, plain) {
+				return false
+			}
+			r.space()
+			if r.take(',') {
+				r.space()
+				continue
+			}
+			return r.take(']')
+		}
+	}
+	return false
+}
+
+// countStrings counts the strings of the array the reader is at, without reading it: a
+// list is gathered into room made once. Anything else counts none.
+func (r *reader) countStrings() int {
+	if r.at >= len(r.text) || r.text[r.at] != '[' {
+		return 0
+	}
+	count := 0
+	for index := r.at + 1; index < len(r.text); index++ {
+		switch r.text[index] {
+		case '"':
+			count++
+			for index++; index < len(r.text) && r.text[index] != '"'; index++ {
+				if r.text[index] == '\\' {
+					index++
+				}
+			}
+		case ']':
+			return count
+		case '[', '{':
+			return 0
+		}
+	}
+	return 0
+}
+
+// unescaped is the text of a string that has no escape and is valid UTF-8: the string
+// sing-box reads of it, as it is.
+func (r *reader) unescaped(start int, end int) ([]byte, bool) {
+	text := r.text[start:end]
+	return text, bytes.IndexByte(text, '\\') < 0 && utf8.Valid(text)
+}
+
+// unquote is the string sing-box reads of the text of a string between its quotes:
+// escapes undone, bytes that are not UTF-8 replaced by U+FFFD.
+func (r *reader) unquote(start int, end int) (string, bool) {
+	var value string
+	err := json.Unmarshal(r.text[start-1:end+1], &value)
+	return value, err == nil
+}
+
+// key reads a key and the colon after it. It tells whether the key is as it is written
+// (ASCII, no escape); one that is not is read only to be skipped.
+func (r *reader) key() (string, bool, bool) {
+	start, end, plain, ok := r.str()
+	if !ok {
+		return "", false, false
+	}
+	r.space()
+	if !r.take(':') {
+		return "", false, false
+	}
+	r.space()
+	return string(r.text[start:end]), plain, true
+}
+
+// str reads a string: where its text is between the quotes, and whether that text is the
+// string as it is (ASCII, no escape). A string with a control character is no JSON.
+func (r *reader) str() (int, int, bool, bool) {
+	if r.at >= len(r.text) || r.text[r.at] != '"' {
+		return 0, 0, false, false
+	}
+	start := r.at + 1
+	plain := true
+	for index := start; index < len(r.text); index++ {
+		character := r.text[index]
+		switch {
+		case character == '"':
+			r.at = index + 1
+			return start, index, plain, true
+		case character == '\\':
+			plain = false
+			index++
+		case character < 0x20:
+			return 0, 0, false, false
+		case character >= 0x80:
+			plain = false
+		}
+	}
+	return 0, 0, false, false
+}
+
+// skipValue goes past a value, for sing-box to read: it only finds its end. A comment
+// stops it: sing-box's decoding takes comments out first.
+func (r *reader) skipValue() bool {
+	depth := 0
+	for r.at < len(r.text) {
+		switch r.text[r.at] {
+		case '"':
+			if _, _, _, ok := r.str(); !ok {
+				return false
+			}
+			if depth == 0 {
+				return true
+			}
+			continue
+		case '[', '{':
+			depth++
+		case ']', '}':
+			if depth == 0 {
+				return true
+			}
+			depth--
+			if depth == 0 {
+				r.at++
+				return true
+			}
+		case ',', ' ', '\t', '\n', '\r':
+			if depth == 0 {
+				return true
+			}
+		case '/', '#':
+			return false
+		}
+		r.at++
+	}
+	return depth == 0
+}
+
+func (r *reader) space() {
+	for r.at < len(r.text) {
+		switch r.text[r.at] {
+		case ' ', '\t', '\n', '\r':
+			r.at++
+		default:
+			return
+		}
+	}
+}
+
+func (r *reader) take(character byte) bool {
+	if r.at < len(r.text) && r.text[r.at] == character {
+		r.at++
+		return true
+	}
+	return false
+}
