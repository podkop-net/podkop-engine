+package domainset
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"math/rand"
+	"net/netip"
+	"reflect"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/common/cidrset"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/domain"
+	"github.com/sagernet/sing/common/json"
+	"github.com/sagernet/sing/common/json/badoption"
+	"github.com/sagernet/sing/common/varbin"
+
+	"github.com/stretchr/testify/require"
+	"go4.org/netipx"
+)
+
+// sourceText makes the text of rule sets of the source format of every shape sing-box
+// reads, and of shapes it does not: white space of all kinds, a string or an array or
+// null or an empty array, escapes, names not of ASCII and bytes not of UTF-8, the other
+// fields of a rule, logical rules, keys in other letters or twice, unknown keys,
+// comments, trailing commas, versions it does not know.
+type sourceText struct {
+	random *rand.Rand
+	// names: how many names a list has at most
+	names int
+}
+
+func (g sourceText) one(choices ...string) string {
+	return choices[g.random.Intn(len(choices))]
+}
+
+func (g sourceText) space() string {
+	if g.random.Intn(3) > 0 {
+		return g.one("", " ")
+	}
+	return g.one("\n", "\t", "\r\n  ", "  ")
+}
+
+func (g sourceText) name() string {
+	switch g.random.Intn(30) {
+	case 0:
+		return ""
+	case 1:
+		return "Пример.РФ"
+	case 2:
+		return "Example.COM"
+	case 3:
+		return ".example.com"
+	case 4:
+		return "a\nb"
+	}
+	letters := "abcdefghijklmnopqrstuvwxyz0123456789-"
+	var name strings.Builder
+	if g.random.Intn(8) == 0 {
+		name.WriteByte('.')
+	}
+	for range 1 + g.random.Intn(2) {
+		for range 1 + g.random.Intn(6) {
+			name.WriteByte(letters[g.random.Intn(len(letters))])
+		}
+		name.WriteByte('.')
+	}
+	name.WriteString(g.one("com", "net", "ru", "io", "co.uk", "рф"))
+	return name.String()
+}
+
+// quote writes a string as JSON, now and then with escapes or bytes JSON does not have.
+func (g sourceText) quote(value string) string {
+	switch g.random.Intn(40) {
+	case 0:
+		return `"` + strings.ReplaceAll(value, "a", `a`) + `"`
+	case 1:
+		return `"` + strings.ReplaceAll(value, ".", `\/.`) + `"`
+	case 2:
+		return "\"" + value + "\xff\""
+	case 3:
+		return "\"" + value + "\x01\""
+	}
+	quoted, _ := json.Marshal(value)
+	return string(quoted)
+}
+
+func (g sourceText) list(name func() string) string {
+	switch g.random.Intn(12) {
+	case 0:
+		return "null"
+	case 1:
+		return "[]"
+	case 2:
+		return g.quote(name())
+	case 3:
+		return "[" + g.quote(name()) + ", null]"
+	case 4:
+		return "[[]]"
+	case 5:
+		return "42"
+	}
+	count := 1 + g.random.Intn(g.names)
+	items := make([]string, count)
+	for index := range items {
+		items[index] = g.quote(name())
+	}
+	separator := ","
+	if g.random.Intn(2) == 0 {
+		separator = "," + g.space()
+	}
+	return "[" + g.space() + strings.Join(items, separator) + g.space() + "]"
+}
+
+func (g sourceText) member(key string, value string) string {
+	return g.quote(key) + g.space() + ":" + g.space() + value
+}
+
+func (g sourceText) rule(depth int) string {
+	var members []string
+	add := func(key string, value string) {
+		members = append(members, g.member(key, value))
+	}
+	cidr := func() string {
+		if g.random.Intn(3) == 0 {
+			return fmt.Sprintf("10.%d.%d.%d/%d", g.random.Intn(4), g.random.Intn(256), g.random.Intn(256), 16+g.random.Intn(17))
+		}
+		return g.one("10.0.0.0/8", "192.0.2.1", "192.0.2.0/24", "2001:db8::/32", "::ffff:192.0.2.1", "::ffff:192.0.2.0/120",
+			"0.0.0.0/0", "255.255.255.255", "fe80::1%eth0", "01.2.3.4", "1.2.3.4/033", "bad")
+	}
+	word := func() string { return g.one("ex", "ample", "^a.*$", "q") }
+	for range 1 + g.random.Intn(4) {
+		switch g.random.Intn(22) {
+		case 0, 1, 2:
+			add("domain_suffix", g.list(g.name))
+		case 3, 4:
+			add("domain", g.list(g.name))
+		case 5:
+			add("domain_keyword", g.list(word))
+		case 6:
+			add("domain_regex", g.list(word))
+		case 7:
+			add("ip_cidr", g.list(cidr))
+		case 8:
+			add("source_ip_cidr", g.list(cidr))
+		case 9:
+			add("port", g.one("80", "[80, 443]", "[]", `"x"`))
+		case 10:
+			add("network", g.one(`"tcp"`, `["udp"]`, `"bad"`))
+		case 11:
+			add("invert", g.one("true", "false"))
+		case 12:
+			add("query_type", g.one(`["A", "AAAA"]`, `"HTTPS"`))
+		case 13:
+			add("type", g.one(`"default"`, `""`, `"bad"`, `"logical"`))
+		case 14:
+			add(g.one("Domain_Suffix", "DOMAIN", "Type", "domain_ſuffix"), g.list(g.name))
+		case 15:
+			add(g.one("foo", "domain suffix"), `"x"`)
+		case 16:
+			add("network_interface_address", g.one("{}", `{"wifi": []}`, `{"wifi": ["10.0.0.0/8"]}`))
+		case 17:
+			add("port_range", g.one(`["1000:2000"]`, "[]", "null"))
+		case 18:
+			if depth < 2 {
+				return "{" + g.space() + strings.Join([]string{
+					g.member("type", `"logical"`), g.member("mode", g.one(`"and"`, `"or"`)),
+					g.member("rules", "["+g.rule(depth+1)+","+g.space()+g.rule(depth+1)+"]"),
+				}, ",") + "}"
+			}
+		case 19:
+			if len(members) > 0 {
+				// a key twice
+				members = append(members, members[0])
+			}
+		case 20:
+			add("domain_suffix", g.list(g.name))
+			members = append(members, g.one("/* a */ ", "// a\n", "# a\n")+members[len(members)-1])
+		case 21:
+			add("domain_suffix", `"domain.ru"`)
+		}
+	}
+	g.random.Shuffle(len(members), func(i, j int) { members[i], members[j] = members[j], members[i] })
+	text := "{" + g.space() + strings.Join(members, ","+g.space()) + g.space()
+	if g.random.Intn(30) == 0 {
+		text += ","
+	}
+	return text + "}"
+}
+
+func (g sourceText) set() string {
+	var members []string
+	switch g.random.Intn(20) {
+	case 0:
+	case 1:
+		members = append(members, g.member("version", g.one("0", "9", "3.0", `"3"`, "1e0", "-1", "33")))
+	case 2:
+		members = append(members, g.member("Version", "3"))
+	default:
+		members = append(members, g.member("version", fmt.Sprint(1+g.random.Intn(C.RuleSetVersionCurrent))))
+	}
+	switch g.random.Intn(15) {
+	case 0:
+	case 1:
+		members = append(members, g.member("rules", g.one("[]", "null", "{}", "[{}]", `[{"domain": []}, {}]`)))
+	default:
+		count := g.random.Intn(4)
+		rules := make([]string, count)
+		for index := range rules {
+			rules[index] = g.rule(0)
+		}
+		members = append(members, g.member("rules", "["+g.space()+strings.Join(rules, ","+g.space())+g.space()+"]"))
+	}
+	if g.random.Intn(30) == 0 {
+		members = append(members, g.member("extra", "1"))
+	}
+	g.random.Shuffle(len(members), func(i, j int) { members[i], members[j] = members[j], members[i] })
+	text := g.space() + "{" + g.space() + strings.Join(members, ","+g.space()) + g.space() + "}" + g.space()
+	if g.random.Intn(40) == 0 {
+		text = "// a rule set\n" + text
+	}
+	return text
+}
+
+// written is a trie as a rule set carries it.
+func written(t testing.TB, matcher interface{ Write(varbin.Writer) error }) []byte {
+	var content bytes.Buffer
+	require.NoError(t, matcher.Write(&content))
+	return content.Bytes()
+}
+
+// sameAsStock checks one text: what readSource reads of it is what sing-box reads, its
+// matchers the ones route/rule builds; text sing-box refuses is not read here. It tells
+// whether readSource read the text.
+func sameAsStock(t testing.TB, text []byte) bool {
+	stock, stockErr := json.UnmarshalExtended[option.PlainRuleSetCompat](text)
+	fast, ok, _ := readSource(context.Background(), text)
+	if stockErr != nil {
+		require.False(t, ok, "sing-box refuses it (%v), readSource read it:\n%s", stockErr, text)
+		return false
+	}
+	if !ok {
+		return false
+	}
+	require.Equal(t, len(stock.Options.Rules), len(fast.Options.Rules), "%s", text)
+	for index := range stock.Options.Rules {
+		mine, theirs := &fast.Options.Rules[index].DefaultOptions, &stock.Options.Rules[index].DefaultOptions
+		if slices.Contains(theirs.Domain, "") || slices.Contains(theirs.DomainSuffix, "") {
+			// route/rule refuses an empty name: the rule must reach it as lists
+			require.Nil(t, mine.DomainSet, "an empty name built here:\n%s", text)
+		}
+		sameCIDR(t, text, true, &mine.SourceIPRanges, &theirs.SourceIPCIDR)
+		sameCIDR(t, text, false, &mine.IPRanges, &theirs.IPCIDR)
+		if mine.DomainSet != nil {
+			require.True(t, len(theirs.Domain)+len(theirs.DomainSuffix) > 0, "%s", text)
+			var want *domain.Matcher
+			func() {
+				defer func() {
+					if recover() != nil {
+						want = nil
+					}
+				}()
+				want = domain.NewMatcher(theirs.Domain, theirs.DomainSuffix, false)
+			}()
+			require.NotNil(t, want, "sing stops on these names, readSource built them:\n%s", text)
+			require.Equal(t, written(t, want), written(t, mine.DomainSet), "%s", text)
+			require.Equal(t, Describe(theirs.Domain[:min(3, len(theirs.Domain))], len(theirs.Domain),
+				theirs.DomainSuffix[:min(3, len(theirs.DomainSuffix))], len(theirs.DomainSuffix)), mine.DomainSet.String(), "%s", text)
+			mine.DomainSet = nil
+			theirs.Domain, theirs.DomainSuffix = nil, nil
+		}
+	}
+	require.True(t, reflect.DeepEqual(stock, fast), "%s\nsing-box: %#v\nhere: %#v", text, stock, fast)
+	return true
+}
+
+// sameCIDR checks the set of a CIDR list read here against the list sing-box read: the
+// ranges and the description NewIPCIDRItem makes of it. A list with an item netip refuses
+// must reach route/rule as it is. Both are then put aside.
+func sameCIDR(t testing.TB, text []byte, source bool, mine **cidrset.Set, theirs *badoption.Listable[string]) {
+	var reference netipx.IPSetBuilder
+	takes := true
+	for _, item := range *theirs {
+		if prefix, err := netip.ParsePrefix(item); err == nil {
+			reference.AddPrefix(prefix)
+		} else if address, err := netip.ParseAddr(item); err == nil {
+			reference.Add(address)
+		} else {
+			takes = false
+		}
+	}
+	if !takes {
+		require.Nil(t, *mine, "a list cidrset does not take, built here:\n%s", text)
+	}
+	if *mine == nil {
+		return
+	}
+	require.NotEmpty(t, *theirs, "%s", text)
+	want, err := reference.IPSet()
+	require.NoError(t, err)
+	require.Equal(t, want.Ranges(), (*mine).Ranges(), "%s", text)
+	require.Equal(t, cidrset.Describe(source, (*theirs)[:min(3, len(*theirs))], len(*theirs)), (*mine).String(), "%s", text)
+	*mine, *theirs = nil, nil
+}
+
+// What the source format reads here is what sing-box reads, for a hundred thousand rule
+// sets of every shape; and ReadSource gives what sing-box gives for each of them, an error
+// included.
+func TestReadSourceSameAsStock(t *testing.T) {
+	random := rand.New(rand.NewSource(4))
+	read := 0
+	const sets = 100000
+	for index := range sets {
+		g := sourceText{random: random, names: 4}
+		if index%100 == 0 {
+			g.names = 200
+		}
+		text := []byte(g.set())
+		if sameAsStock(t, text) {
+			read++
+		}
+		if index%10 == 0 {
+			stock, stockErr := json.UnmarshalExtended[option.PlainRuleSetCompat](text)
+			mine, err := ReadSource(text)
+			if stockErr != nil {
+				require.EqualError(t, err, stockErr.Error())
+			} else {
+				require.NoError(t, err)
+				require.Equal(t, len(stock.Options.Rules), len(mine.Options.Rules))
+			}
+		}
+	}
+	t.Logf("read here: %d of %d", read, sets)
+	// the shapes a list of podkop and of the lists published as rule sets have are read
+	// here, not left to sing-box
+	require.Greater(t, read, sets/4)
+}
+
+// Rule sets as they are written in the wild are read here.
+func TestReadSourceShapes(t *testing.T) {
+	for _, text := range []string{
+		`{"version": 3, "rules": [{"domain_suffix": ["example.com", "example.org"]}]}`,
+		"{\n  \"version\": 2,\n  \"rules\": [\n    {\n      \"domain_suffix\": [\n        \"a.ru\",\n        \"b.ru\"\n      ]\n    }\n  ]\n}\n",
+		`{"version":1,"rules":[{"domain":["a.com"],"domain_suffix":[".b.com"],"domain_keyword":["k"],"domain_regex":["^r$"]},{"ip_cidr":["10.0.0.0/8"]}]}`,
+		`{"version": 3, "rules": [{"domain_suffix": "one.example", "port": [80, 443], "invert": true}]}`,
+		`{"rules": [{"type": "default", "domain": "x.example"}], "version": 3}`,
+		`{"version": 3}`,
+		`{"version": 3, "rules": []}`,
+		`{"version": 3, "rules": [{"domain": "x"}, {"type": "logical", "mode": "and", "rules": [{"domain": "y"}, {"port": 80}]}]}`,
+	} {
+		require.True(t, sameAsStock(t, []byte(text)), "not read here:\n%s", text)
+	}
+	for _, text := range []string{
+		// comments, a version that is not a digit, a key in other letters: sing-box's
+		`// a set` + "\n" + `{"version": 3, "rules": []}`,
+		`{"version": "3", "rules": []}`,
+		`{"version": 3, "Rules": []}`,
+		`{"version": 3, "rules": [{"domain": "x"},]}`,
+	} {
+		require.False(t, sameAsStock(t, []byte(text)), "read here:\n%s", text)
+	}
+}
+
+func FuzzReadSource(f *testing.F) {
+	random := rand.New(rand.NewSource(5))
+	for range 200 {
+		f.Add([]byte(sourceText{random: random, names: 3}.set()))
+	}
+	f.Fuzz(func(t *testing.T, text []byte) {
+		sameAsStock(t, text)
+	})
+}
+
+// sourceList is a rule set of count varied names as one list of domain_suffix, the way
+// podkop writes its lists.
+func sourceList(count int) []byte {
+	list := names(rand.New(rand.NewSource(6)), count)
+	var text bytes.Buffer
+	text.WriteString(`{"version": 3, "rules": [{"domain_suffix": [`)
+	for index, name := range list {
+		if index > 0 {
+			text.WriteByte(',')
+		}
+		quoted, _ := json.Marshal(name)
+		text.Write(quoted)
+	}
+	text.WriteString("]}]}")
+	return text.Bytes()
+}
+
+// What reading a rule set of 100000 names and building its matcher costs: sing-box with
+// the matcher of sing, sing-box with the builder of this package, and ReadSource.
+func BenchmarkReadSource(b *testing.B) {
+	for _, count := range []int{100000, 300000} {
+		text := sourceList(count)
+		b.Run(fmt.Sprint(count, "/sing"), func(b *testing.B) {
+			b.ReportAllocs()
+			for range b.N {
+				compat, err := json.UnmarshalExtended[option.PlainRuleSetCompat](text)
+				if err != nil {
+					b.Fatal(err)
+				}
+				rule := compat.Options.Rules[0].DefaultOptions
+				domain.NewMatcher(rule.Domain, rule.DomainSuffix, false)
+			}
+		})
+		b.Run(fmt.Sprint(count, "/stock-json"), func(b *testing.B) {
+			b.ReportAllocs()
+			for range b.N {
+				compat, err := json.UnmarshalExtended[option.PlainRuleSetCompat](text)
+				if err != nil {
+					b.Fatal(err)
+				}
+				rule := compat.Options.Rules[0].DefaultOptions
+				_, err = NewSet(rule.Domain, rule.DomainSuffix)
+				if err != nil {
+					b.Fatal(err)
+				}
+			}
+		})
+		b.Run(fmt.Sprint(count, "/ReadSource"), func(b *testing.B) {
+			b.ReportAllocs()
+			for range b.N {
+				compat, err := ReadSource(text)
+				if err != nil || compat.Options.Rules[0].DefaultOptions.DomainSet == nil {
+					b.Fatal(err)
+				}
+			}
+		})
+	}
+}
diff --git a/common/domainset/succinct/set.go b/common/domainset/succinct/set.go
new file mode 100644
index 000000000..db6d7439b
--- /dev/null
+++ b/common/domainset/succinct/set.go
@@ -0,0 +1,301 @@
+// Package succinct is the domain trie of sing (common/domain) as a type of its own: the
+// succinct set domain.Matcher keeps, which common/domainset builds in place where
+// domain.ReadMatcher would copy it. The matching, the indexes and the bit tricks are the
+// code of sing (common/domain/matcher.go and set.go, after github.com/openacid/succinct),
+// copied without a change of what they do; the tests of the package hold them to sing's.
+package succinct
+
+import (
+	"encoding/binary"
+	"math/bits"
+	"unicode/utf8"
+
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/varbin"
+)
+
+// the labels of sing: a key that ends a suffix, and one that ends a name and its
+// subdomains
+const (
+	prefixLabel = '\r'
+	rootLabel   = '\n'
+)
+
+// Set is a domain trie: what domain.Matcher matches, of the same parts.
+type Set struct {
+	leaves, labelBitmap []uint64
+	labels              []byte
+	ranks, selects      []int32
+	description         string
+}
+
+// New makes a set of the parts of a trie as succinctSet.Write of sing writes them. The
+// slices are kept, not copied. A trie that is not one is refused, as domain.ReadMatcher
+// refuses it. The description is what String tells of the set.
+func New(leaves []uint64, labelBitmap []uint64, labels []byte, description string) (*Set, error) {
+	onesCount := 0
+	lastOneIndex := -1
+	for wordIndex, word := range labelBitmap {
+		onesCount += bits.OnesCount64(word)
+		if word != 0 {
+			lastOneIndex = wordIndex<<6 | (63 - bits.LeadingZeros64(word))
+		}
+	}
+	zerosCount := lastOneIndex + 1 - onesCount
+	if onesCount != zerosCount+1 || len(labels) != zerosCount {
+		return nil, E.New("domain: malformed succinct set")
+	}
+	leavesWordCount := (onesCount + 63) >> 6
+	if len(leaves) < leavesWordCount {
+		leaves = append(leaves, make([]uint64, leavesWordCount-len(leaves))...)
+	}
+	set := &Set{leaves: leaves, labelBitmap: labelBitmap, labels: labels, description: description}
+	set.selects, set.ranks = indexSelect32R64(labelBitmap)
+	return set, nil
+}
+
+// Match tells whether the set has the domain, as domain.Matcher.Match does.
+func (s *Set) Match(domain string) bool {
+	return s.has(reverseDomain(domain))
+}
+
+// String is the description the set was made with.
+func (s *Set) String() string {
+	return s.description
+}
+
+// Write writes the set as domain.Matcher.Write does.
+func (s *Set) Write(writer varbin.Writer) error {
+	err := writer.WriteByte(0)
+	if err != nil {
+		return err
+	}
+	err = writeUint64Slice(writer, s.leaves)
+	if err != nil {
+		return err
+	}
+	err = writeUint64Slice(writer, s.labelBitmap)
+	if err != nil {
+		return err
+	}
+	return writeByteSlice(writer, s.labels)
+}
+
+func (s *Set) has(key string) bool {
+	var nodeId, bmIdx int
+	for i := 0; i < len(key); i++ {
+		currentChar := key[i]
+		for ; ; bmIdx++ {
+			if getBit(s.labelBitmap, bmIdx) != 0 {
+				return false
+			}
+			nextLabel := s.labels[bmIdx-nodeId]
+			if nextLabel == prefixLabel {
+				return true
+			}
+			if nextLabel == rootLabel {
+				nextNodeId := countZeros(s.labelBitmap, s.ranks, bmIdx+1)
+				hasNext := getBit(s.leaves, nextNodeId) != 0
+				if currentChar == '.' && hasNext {
+					return true
+				}
+			}
+			if nextLabel == currentChar {
+				break
+			}
+		}
+		nodeId = countZeros(s.labelBitmap, s.ranks, bmIdx+1)
+		bmIdx = selectIthOne(s.labelBitmap, s.ranks, s.selects, nodeId-1) + 1
+	}
+	if getBit(s.leaves, nodeId) != 0 {
+		return true
+	}
+	for ; ; bmIdx++ {
+		if getBit(s.labelBitmap, bmIdx) != 0 {
+			return false
+		}
+		nextLabel := s.labels[bmIdx-nodeId]
+		if nextLabel == prefixLabel || nextLabel == rootLabel {
+			return true
+		}
+	}
+}
+
+func reverseDomain(domain string) string {
+	l := len(domain)
+	b := make([]byte, l)
+	for i := 0; i < l; {
+		r, n := utf8.DecodeRuneInString(domain[i:])
+		i += n
+		utf8.EncodeRune(b[l-i:], r)
+	}
+	return string(b)
+}
+
+func writeUint64Slice(writer varbin.Writer, value []uint64) error {
+	_, err := varbin.WriteUvarint(writer, uint64(len(value)))
+	if err != nil {
+		return err
+	}
+	if len(value) == 0 {
+		return nil
+	}
+	return binary.Write(writer, binary.BigEndian, value)
+}
+
+func writeByteSlice(writer varbin.Writer, value []byte) error {
+	_, err := varbin.WriteUvarint(writer, uint64(len(value)))
+	if err != nil {
+		return err
+	}
+	if len(value) == 0 {
+		return nil
+	}
+	_, err = writer.Write(value)
+	return err
+}
+
+func getBit(bm []uint64, i int) uint64 {
+	return bm[i>>6] & (1 << uint(i&63))
+}
+
+func countZeros(bm []uint64, ranks []int32, i int) int {
+	a, _ := rank64(bm, ranks, int32(i))
+	return i - int(a)
+}
+
+func selectIthOne(bm []uint64, ranks, selects []int32, i int) int {
+	a, _ := select32R64(bm, selects, ranks, int32(i))
+	return int(a)
+}
+
+func rank64(words []uint64, rindex []int32, i int32) (int32, int32) {
+	wordI := i >> 6
+	j := uint32(i & 63)
+	n := rindex[wordI]
+	w := words[wordI]
+	c1 := n + int32(bits.OnesCount64(w&mask[j]))
+	return c1, int32(w>>uint(j)) & 1
+}
+
+func indexRank64(words []uint64, opts ...bool) []int32 {
+	trailing := false
+	if len(opts) > 0 {
+		trailing = opts[0]
+	}
+	l := len(words)
+	if trailing {
+		l++
+	}
+	idx := make([]int32, l)
+	n := int32(0)
+	for i := range len(words) {
+		idx[i] = n
+		n += int32(bits.OnesCount64(words[i]))
+	}
+	if trailing {
+		idx[len(words)] = n
+	}
+	return idx
+}
+
+func select32R64(words []uint64, selectIndex, rankIndex []int32, i int32) (int32, int32) {
+	a := int32(0)
+	l := int32(len(words))
+	wordI := selectIndex[i>>5] >> 6
+	for ; rankIndex[wordI+1] <= i; wordI++ {
+	}
+	w := words[wordI]
+	ww := w
+	base := wordI << 6
+	findIth := int(i - rankIndex[wordI])
+	offset := int32(0)
+	ones := bits.OnesCount32(uint32(ww))
+	if ones <= findIth {
+		findIth -= ones
+		offset |= 32
+		ww >>= 32
+	}
+	ones = bits.OnesCount16(uint16(ww))
+	if ones <= findIth {
+		findIth -= ones
+		offset |= 16
+		ww >>= 16
+	}
+	ones = bits.OnesCount8(uint8(ww))
+	if ones <= findIth {
+		a = int32(select8Lookup[(ww>>5)&0x7f8|uint64(findIth-ones)]) + offset + 8
+	} else {
+		a = int32(select8Lookup[(ww&0xff)<<3|uint64(findIth)]) + offset
+	}
+	a += base
+	w &= rMaskUpto[a&63]
+	if w != 0 {
+		return a, base + int32(bits.TrailingZeros64(w))
+	}
+	wordI++
+	for ; wordI < l; wordI++ {
+		w = words[wordI]
+		if w != 0 {
+			return a, wordI<<6 + int32(bits.TrailingZeros64(w))
+		}
+	}
+	return a, l << 6
+}
+
+func indexSelect32R64(words []uint64) ([]int32, []int32) {
+	l := len(words) << 6
+	sidx := make([]int32, 0, len(words))
+
+	ith := -1
+	for i := range l {
+		if words[i>>6]&(1<<uint(i&63)) != 0 {
+			ith++
+			if ith&31 == 0 {
+				sidx = append(sidx, int32(i))
+			}
+		}
+	}
+
+	// clone to reduce cap to len
+	sidx = append(sidx[:0:0], sidx...)
+	return sidx, indexRank64(words, true)
+}
+
+func init() {
+	initMasks()
+	initSelectLookup()
+}
+
+var (
+	mask      [65]uint64
+	rMaskUpto [64]uint64
+)
+
+func initMasks() {
+	for i := range 65 {
+		mask[i] = (1 << uint(i)) - 1
+	}
+
+	var maskUpto [64]uint64
+	for i := range 64 {
+		maskUpto[i] = (1 << uint(i+1)) - 1
+		rMaskUpto[i] = ^maskUpto[i]
+	}
+}
+
+var select8Lookup [256 * 8]uint8
+
+func initSelectLookup() {
+	for i := range 256 {
+		w := uint8(i)
+		for j := range 8 {
+			// x-th 1 in w
+			// if x-th 1 is not found, it is 8
+			x := bits.TrailingZeros8(w)
+			w &= w - 1
+
+			select8Lookup[i*8+j] = uint8(x)
+		}
+	}
+}
diff --git a/common/domainset/trie.go b/common/domainset/trie.go
new file mode 100644
index 000000000..370caeb03
--- /dev/null
+++ b/common/domainset/trie.go
@@ -0,0 +1,241 @@
+package domainset
+
+import (
+	"encoding/binary"
+	"runtime"
+	"slices"
+
+	"github.com/sagernet/sing-box/common/domainset/succinct"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// trie is the succinct set of sing (common/domain/set.go) as its Write writes it, without
+// the indexes succinct.New makes.
+type trie struct {
+	leaves, labelBitmap []uint64
+	labels              []byte
+}
+
+// stopEvery is how many nodes, or items read, go between two looks at the context of a
+// build: a mask, a power of two less one.
+const stopEvery = 1<<12 - 1
+
+// smallSpan is the most keys a node parts by sorting them in place; a node of more keys
+// counts them by their next byte.
+const smallSpan = 24
+
+// Set builds the trie of the names gathered: the one domain.NewMatcher of sing builds of
+// the same names, byte for byte, as a set of its own, so that it is not copied. The
+// collector is spent: its keys are let go first. The description is what the set tells
+// of itself (Describe).
+func (c *Collector) Set(description string) (*succinct.Set, error) {
+	built, err := c.build()
+	c.release()
+	if err != nil {
+		return nil, err
+	}
+	// the buffers were made for the most the trie could take; a trie of names that share
+	// much takes far less, and the set is kept as long as its rule set. A big trie is
+	// made smaller by a copy, with the garbage of the build collected first, so that the
+	// copy does not come on top of it: a million names (x86) peak at +40-46 MB and keep
+	// 43 MB of heap so, at +41-44 MB and 52 MB with no copy, at +58-64 MB and 43 MB with
+	// a copy on top of the garbage.
+	if len(built.labels) > 1<<20 && cap(built.labels)-len(built.labels) > len(built.labels)/8 {
+		runtime.GC()
+	}
+	return succinct.New(fit(built.leaves), fit(built.labelBitmap), fit(built.labels), description)
+}
+
+// fit is a slice without the room it was made with beyond an eighth of what it holds.
+func fit[T any](items []T) []T {
+	if cap(items)-len(items) > len(items)/8 {
+		return slices.Clone(items)
+	}
+	return items
+}
+
+// Encode is the matcher of the names gathered as domain.Matcher.Write writes it, the form
+// a rule set in the binary format carries. The collector is spent.
+func (c *Collector) Encode() ([]byte, error) {
+	built, err := c.build()
+	c.release()
+	if err != nil {
+		return nil, err
+	}
+	head, labels := built.parts()
+	return append(head, labels...), nil
+}
+
+func (c *Collector) release() {
+	c.refs = nil
+	c.buffers = [2][]byte{}
+}
+
+// build makes the trie newSuccinctSet of sing makes of the sorted keys. The keys are not
+// sorted first: the trie is built a level at a time, in the order of sing's walk, and
+// the keys of each node are parted by their byte at the depth of the level into the
+// nodes of the next one (a radix sort, done in the order of the trie). The keys of a
+// level are kept one after another, the keys that ended left out, and a bit marks where
+// each node of the level begins: a level costs a bit a key besides the keys. The keys of
+// a node that end at it are its leaf: one key, however many times it was gathered; a name
+// that is also a suffix is the suffix only, as the map of domain.NewMatcher has it.
+func (c *Collector) build() (trie, error) {
+	count := len(c.refs)
+	if count == 0 {
+		return trie{}, E.New("no domain to build")
+	}
+	buffers := &c.buffers
+	// the labels of the trie are no more than the bytes of its keys: the buffers are made
+	// once, of that size
+	most := c.keyBytes
+	built := trie{
+		labels:      make([]byte, 0, most),
+		leaves:      make([]uint64, 0, most/64+1),
+		labelBitmap: make([]uint64, 0, (2*most+1)/64+1),
+	}
+	from, to := c.refs, make([]ref, count)
+	starts, nextStarts := make([]uint64, count/64+1), make([]uint64, count/64+1)
+	// the root: one node of all keys
+	starts[0] = 1
+	active := count
+	var scratch []uint16
+	node, bit := 0, 0
+	for column := 0; active > 0; column++ {
+		clear(nextStarts[:active/64+1])
+		out := 0
+		// a group of keys that share their byte at column: a node of the next level
+		group := func(first int, bucket int) {
+			nextStarts[first>>6] |= 1 << uint(first&63)
+			built.labels = append(built.labels, byte(bucket-1))
+			bit++
+		}
+		for start := 0; start < active; {
+			end := start + 1
+			for end < active && starts[end>>6]&(1<<uint(end&63)) == 0 {
+				end++
+			}
+			var enderDomain, enderSuffix, sameName bool
+			// where a key goes at column: 0 when it ends there, 1 + its byte otherwise
+			look := func(key ref) int {
+				length := key.length()
+				kind := key.kind()
+				if column < length {
+					return 1 + int(buffers[key.info>>ownShift][int(key.offset)+length-1-column])
+				}
+				if column == length && kind != kindDomain {
+					// a suffix as long as the node is deep: its name is the one of the node
+					sameName = true
+					if kind == kindPrefix {
+						return 1 + '\r'
+					}
+					return 1 + '\n'
+				}
+				if kind == kindDomain {
+					enderDomain = true
+				} else {
+					enderSuffix = true
+				}
+				return 0
+			}
+			switch size := end - start; {
+			case size == 1:
+				key := from[start]
+				if bucket := look(key); bucket != 0 {
+					group(out, bucket)
+					to[out] = key
+					out++
+				}
+			case size <= smallSpan:
+				var (
+					keys    [smallSpan]ref
+					buckets [smallSpan]uint16
+				)
+				for index := 0; index < size; index++ {
+					key := from[start+index]
+					bucket := uint16(look(key))
+					place := index
+					for place > 0 && buckets[place-1] > bucket {
+						buckets[place] = buckets[place-1]
+						keys[place] = keys[place-1]
+						place--
+					}
+					buckets[place] = bucket
+					keys[place] = key
+				}
+				for place := 0; place < size; place++ {
+					bucket := buckets[place]
+					if bucket == 0 {
+						continue
+					}
+					if place == 0 || buckets[place-1] != bucket {
+						group(out, int(bucket))
+					}
+					to[out] = keys[place]
+					out++
+				}
+			default:
+				if scratch == nil {
+					scratch = make([]uint16, count)
+				}
+				var counts, places [257]int32
+				for index := start; index < end; index++ {
+					bucket := look(from[index])
+					scratch[index] = uint16(bucket)
+					counts[bucket]++
+				}
+				place := int32(out)
+				for bucket := 1; bucket < len(counts); bucket++ {
+					places[bucket] = place
+					if counts[bucket] > 0 {
+						group(int(place), bucket)
+					}
+					place += counts[bucket]
+				}
+				for index := start; index < end; index++ {
+					if bucket := scratch[index]; bucket != 0 {
+						to[places[bucket]] = from[index]
+						places[bucket]++
+					}
+				}
+				out = int(place)
+			}
+			// a name and a suffix that make the same key (a name that begins with "\n" or
+			// "\r") are one key, as sing makes them (slices.Compact since v0.9.7)
+			if enderSuffix || enderDomain && !sameName {
+				setBit(&built.leaves, node)
+			}
+			setBit(&built.labelBitmap, bit)
+			bit++
+			node++
+			start = end
+			if node&stopEvery == 0 && c.ctx != nil && c.ctx.Err() != nil {
+				return trie{}, c.ctx.Err()
+			}
+		}
+		from, to = to, from
+		starts, nextStarts = nextStarts, starts
+		active = out
+	}
+	return built, nil
+}
+
+func setBit(words *[]uint64, index int) {
+	for index>>6 >= len(*words) {
+		*words = append(*words, 0)
+	}
+	(*words)[index>>6] |= 1 << uint(index&63)
+}
+
+// parts are the trie as succinctSet.Write writes it: all but the labels, then the labels.
+func (t trie) parts() ([]byte, []byte) {
+	head := make([]byte, 0, 1+3*binary.MaxVarintLen64+8*(len(t.leaves)+len(t.labelBitmap)))
+	head = append(head, 0)
+	for _, words := range [][]uint64{t.leaves, t.labelBitmap} {
+		head = binary.AppendUvarint(head, uint64(len(words)))
+		for _, word := range words {
+			head = binary.BigEndian.AppendUint64(head, word)
+		}
+	}
+	head = binary.AppendUvarint(head, uint64(len(t.labels)))
+	return head, t.labels
+}
