+}
+
+func (m quicTestMember) QUICStats() (adapter.QUICStats, bool) {
+	return adapter.QUICStats{}, false
+}
+
+// A member is weighed at the price of its transport: one over QUIC that loses 1 % 100 ms away
+// stays before a clean one 30 % slower; one over TCP with the same loss and delay does not.
+func TestLossModeQUICPrice(t *testing.T) {
+	for _, overQUIC := range []bool{true, false} {
+		a, b := newTestMember(C.TypeHysteria2, "a", dialWorking), newTestMember(C.TypeSOCKS, "b", dialWorking)
+		first := adapter.Outbound(a)
+		if overQUIC {
+			first = quicTestMember{a}
+		}
+		_, group := newModeGroup(t, modeLoss, []adapter.Outbound{first, b}, map[string]uint16{"a": 200, "b": 260}, func(group *URLTestGroup) {
+			storeLoss(group, "a", 1000, 10, 100*time.Millisecond)
+			storeLoss(group, "b", 1000, 0, 130*time.Millisecond)
+		})
+		tcp, _ := selectedTags(group)
+		if overQUIC {
+			require.Equal(t, "a", tcp)
+		} else {
+			require.Equal(t, "b", tcp)
+		}
+	}
 }
 
