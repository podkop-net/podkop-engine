diff --git a/protocol/group/urltestgroup/urltest_loss_quic.go b/protocol/group/urltestgroup/urltest_loss_quic.go
new file mode 100644
index 000000000..dbcc0e18e
--- /dev/null
+++ b/protocol/group/urltestgroup/urltest_loss_quic.go
@@ -0,0 +1,15 @@
+package urltestgroup
+
+// quicLossPrice is the price of the loss of a member over QUIC (podkop-engine), measured on the
+// stand of report 02 (grid g16 of lab/hy2, 2026-11-15): hysteria2 of sing-box 1.14.4, its pages at
+// RTTs of 20 to 150 ms and losses of 0.5 to 10 % on both ways, the server sending with BBR, as it
+// does when the client declares no rate. It is fitted, by least squares over the 24 cells with
+// loss, to the slowdown itself (a page at the loss p over a page without loss at the same RTT), so
+// perRTT is 1. A lost packet costs its stream a round of recovery and no new connection a
+// handshake timer: 1 % of loss costs ×1.06 at 20 ms, ×1.19 at 50 ms, ×1.24 at 100 ms and ×1.25 at
+// 150 ms, and nothing below 16 ms (weighDelay never weighs a delay down), where over TCP the cost
+// falls with the RTT (tcpLossPrice: ×2.85 at 20 ms, ×1.57 at 100 ms). Report 02's fit of the page
+// time fits this grid worse (residuals of 71 ms rms, a flat ×1.14 at any RTT). With Brutal (a rate
+// declared) a loss costs less (×1.03 to ×1.14 at 1 %), so this price weighs such a member a little
+// more than its loss costs. TUIC was not measured and is priced as hysteria2.
+var quicLossPrice = lossPrice{perRTT: 1, perLoss: -4.43, perLossRTT: 0.282}
