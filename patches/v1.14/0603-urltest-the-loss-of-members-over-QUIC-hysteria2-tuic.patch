diff --git a/adapter/quic_stats.go b/adapter/quic_stats.go
new file mode 100644
index 000000000..0de94c244
--- /dev/null
+++ b/adapter/quic_stats.go
@@ -0,0 +1,27 @@
+package adapter
+
+import "time"
+
+// QUICStatsOutbound is an outbound whose connections are streams of one QUIC connection of its
+// own (Hysteria2, TUIC) (podkop-engine): no connection made through it is a connection of its
+// own to the server, so what a connection sees of the path, the outbound tells of its QUIC
+// connection instead.
+type QUICStatsOutbound interface {
+	Outbound
+	// QUICStats returns the counts of the current QUIC connection; false when there is none.
+	QUICStats() (QUICStats, bool)
+}
+
+// QUICStats are the counts of a QUIC connection.
+type QUICStats struct {
+	// Connection tells one connection from the ones before and after it: counts of two
+	// connections cannot be compared.
+	Connection uint64
+	// PeerPacketsReceived and PeerPacketsMissing are the server's 1-RTT packets that came, each
+	// once, and the packet numbers between the smallest and the largest that came that did not
+	// (lost on the way, still to come out of order, or skipped by the server).
+	PeerPacketsReceived uint64
+	PeerPacketsMissing  uint64
+	SmoothedRTT         time.Duration
+	MinRTT              time.Duration
+}
diff --git a/common/urltest/loss.go b/common/urltest/loss.go
index 373a8391c..089fe9a56 100644
--- a/common/urltest/loss.go
+++ b/common/urltest/loss.go
@@ -44,6 +44,11 @@ var ErrLossNotCounted = E.New("loss not counted")
 // own (a multiplexed transport, QUIC): probing the member again would not count either.
 var ErrLossNotOwnConnection = E.New("the probe had no connection of its own")
 
+// ErrLossNoWindows wraps ErrLossNotCounted when a probe over QUIC cannot ask for its download a
+// window at a time (LossProbeQUIC): the loss URL serves no ranges and has no "bytes" parameter.
+// Probing the member again with the same URL would not count either.
+var ErrLossNoWindows = E.New("the loss URL serves no ranges and has no bytes parameter")
+
 // lossStall is how long a body may bring nothing before the probe calls it stopped: a slow
 // path that keeps bringing data is counted as far as it came, not failed. A variable for the
 // tests, as lossClientTimeout.
diff --git a/common/urltest/loss_quic.go b/common/urltest/loss_quic.go
new file mode 100644
index 000000000..e11c2faa9
--- /dev/null
+++ b/common/urltest/loss_quic.go
@@ -0,0 +1,260 @@
+package urltest
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"strconv"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/probesock"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/ntp"
+)
+
+// The loss probe of a member over QUIC (podkop-engine).
+//
+// The connections of a Hysteria2 or TUIC member are streams of one QUIC connection: the TCP
+// probe has no connection of its own to count (ErrLossNotOwnConnection). QUIC numbers every
+// packet, so the member tells how many of the server's packets came and how many numbers did not
+// (adapter.QUICStatsOutbound). LossProbeQUIC downloads what LossProbe does, a window at a time:
+// probesock.Window bytes, the next window asked for when it has come in full, so the server sends
+// no more in a round trip than the TCP probe's window lets it, whatever its
+// congestion control (Brutal sends at a set rate and does not slow down on loss, and the stream
+// windows of Hysteria2 are megabytes: one request for the whole body would be sent at once). The
+// sample is the difference of the counts across the download. What else the connection carried
+// meanwhile (the member in use) is in it too: the sample then weighs as many packets as the probe
+// brought itself, at the share the connection lost, as the sample of LossProbe is the segments of
+// its own connection. A window is a range of the link; a link with a "bytes" parameter (the
+// default loss URL, speed.cloudflare.com/__down, serves no ranges: it answers a range with the
+// whole body) is asked for a body of that many bytes instead.
+
+// QUICCounter tells the counts of a QUIC connection (adapter.QUICStatsOutbound).
+type QUICCounter interface {
+	QUICStats() (adapter.QUICStats, bool)
+}
+
+// errStillComing tells a window cut while its body still came (the time limit, the end of the
+// group): the probe is counted as far as it came, as LossProbe does.
+var errStillComing = E.New("cut while the body came")
+
+// quicReorderWait is how long after the last window the counts are read: QUIC takes a packet for
+// lost when it is 9/8 of the smoothed RTT late (RFC 9002, kTimeThreshold), so a packet that comes
+// out of order comes within that and takes its gap back.
+func quicReorderWait(stats adapter.QUICStats) time.Duration {
+	return min(stats.SmoothedRTT*9/8, time.Second)
+}
+
+// quicPacketBytes is fewer bytes of a body than a packet of a Hysteria2 or TUIC server carries (up
+// to its datagrams of 1200 to 1452 bytes): body/quicPacketBytes is more packets than a body takes.
+const quicPacketBytes = 1000
+
+// quicProbePackets is how many packets a probe that brought received bytes in windows windows
+// takes at most: the body, and for each window a response header and an acknowledgment or two.
+func quicProbePackets(received int64, windows int) uint64 {
+	return uint64(received/quicPacketBytes) + 4*uint64(windows) + 16
+}
+
+// quicWait waits d, unless ctx is canceled (the group was closed): a probe cut by its own time
+// limit still waits, for the packets that come late.
+func quicWait(ctx context.Context, d time.Duration) error {
+	timer := time.NewTimer(d)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+		return nil
+	case <-ctx.Done():
+		if errors.Is(ctx.Err(), context.DeadlineExceeded) {
+			<-timer.C
+			return nil
+		}
+		return ctx.Err()
+	}
+}
+
+// LossProbeQUIC downloads size bytes of link through detour, a window at a time, and returns what
+// the QUIC connection of counter counted meanwhile. Its errors are LossProbe's, and one wrapping
+// ErrLossNotCounted when the member had no QUIC connection, the connection was closed or replaced
+// during the probe, or the UDP receive buffers of the system dropped datagrams meanwhile (the count
+// would put them on the path).
+func LossProbeQUIC(ctx context.Context, link string, size int64, detour N.Dialer, counter QUICCounter) (LossSample, error) {
+	var sample LossSample
+	linkURL, err := url.Parse(link)
+	if err != nil {
+		return sample, err
+	}
+	port := linkURL.Port()
+	if port == "" {
+		switch linkURL.Scheme {
+		case "http":
+			port = "80"
+		case "https":
+			port = "443"
+		}
+	}
+	destination := M.ParseSocksaddrHostPortStr(linkURL.Hostname(), port)
+	byParameter := linkURL.Query().Has("bytes")
+	start := time.Now()
+	// a stream held open across the probe, dialed before the first count: a member whose connection
+	// was idle dials it now, and the connection stays while the HTTP connections of the probe close
+	// and come again. A member no group uses closes its connection with its last stream: a window
+	// cut by the time limit, or an HTTP connection not kept between windows, closed it before it
+	// was counted. Closed at the end, after the client's, it leaves the member to close the
+	// connection as it would have.
+	anchor, err := detour.DialContext(ctx, "tcp", destination)
+	if err != nil {
+		return sample, err
+	}
+	defer anchor.Close()
+	before, active := counter.QUICStats()
+	if !active {
+		return sample, E.Cause(ErrLossNotCounted, "no QUIC connection")
+	}
+	dropsBefore, dropsKnown := udpReceiveDrops()
+	client := quicProbeClient(ctx, detour, destination)
+	defer client.CloseIdleConnections()
+	var received int64
+	var probeErr error
+	windows := 0
+	for received < size {
+		end := min(received+probesock.Window, size) - 1
+		got, err := quicProbeWindow(ctx, client, linkURL, byParameter, received, end)
+		received += got
+		windows++
+		if err != nil {
+			probeErr = err
+			break
+		}
+	}
+	sample.Elapsed = time.Since(start)
+	sample.Received = received
+	switch {
+	case probeErr == nil, errors.Is(probeErr, io.EOF):
+		// io.EOF: the whole body, shorter than asked, counted as it is
+	case received == 0:
+		return sample, E.Cause(probeErr, "no body")
+	case errors.Is(probeErr, errStillComing):
+		// cut while it came: counted as far as it came
+	default:
+		return sample, probeErr
+	}
+	// the wait for what comes out of order, by the RTT the connection has now (a connection of
+	// 0-RTT may have had none before)
+	now, active := counter.QUICStats()
+	if !active || now.Connection != before.Connection {
+		return sample, E.Cause(ErrLossNotCounted, "the QUIC connection was closed or replaced during the probe")
+	}
+	if err := quicWait(ctx, quicReorderWait(now)); err != nil {
+		return sample, err
+	}
+	after, active := counter.QUICStats()
+	if !active || after.Connection != before.Connection {
+		return sample, E.Cause(ErrLossNotCounted, "the QUIC connection was closed or replaced during the probe")
+	}
+	if dropsKnown {
+		if dropsAfter, known := udpReceiveDrops(); known && dropsAfter > dropsBefore {
+			return sample, E.Cause(ErrLossNotCounted, "the UDP receive buffers of the system dropped ", dropsAfter-dropsBefore, " datagrams")
+		}
+	}
+	came := after.PeerPacketsReceived - before.PeerPacketsReceived
+	var lost uint64
+	if after.PeerPacketsMissing > before.PeerPacketsMissing {
+		lost = after.PeerPacketsMissing - before.PeerPacketsMissing
+	}
+	// the connection carried more than the probe (the member in use): as many packets as the probe
+	// took, at the share the connection lost, or one busy probe would outweigh the rest of a window
+	// of hours (lossMinSegments of the group)
+	if own := quicProbePackets(received, windows); came+lost > own {
+		share := (lost*own + (came+lost)/2) / (came + lost)
+		came, lost = own-share, share
+	}
+	sample.At = time.Now()
+	sample.Segments = int(came + lost)
+	sample.Lost = int(lost)
+	sample.RTT = after.MinRTT
+	return sample, nil
+}
+
+// quicProbeWindow downloads the window from start to end of link (a range, or with byParameter a
+// body of that many bytes) and returns how many bytes came: io.EOF tells a body shorter than asked
+// (the whole of what there is), errStillComing a body cut while it came, ErrDownloadStopped one
+// that brought nothing for lossStall before it ended, ErrLossNoWindows a link that serves no
+// ranges.
+func quicProbeWindow(ctx context.Context, client *http.Client, link *url.URL, byParameter bool, start, end int64) (int64, error) {
+	target := *link
+	if byParameter {
+		query := target.Query()
+		query.Set("bytes", strconv.FormatInt(end-start+1, 10))
+		target.RawQuery = query.Encode()
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, target.String(), nil)
+	if err != nil {
+		return 0, err
+	}
+	if !byParameter {
+		req.Header.Set("Range", "bytes="+strconv.FormatInt(start, 10)+"-"+strconv.FormatInt(end, 10))
+	}
+	asked := time.Now()
+	resp, err := client.Do(req)
+	if err != nil {
+		if ctx.Err() != nil && time.Since(asked) < lossStall {
+			return 0, errors.Join(errStillComing, err)
+		}
+		return 0, err
+	}
+	defer resp.Body.Close()
+	switch {
+	case resp.StatusCode == http.StatusPartialContent && !byParameter, resp.StatusCode == http.StatusOK && byParameter:
+	case resp.StatusCode == http.StatusRequestedRangeNotSatisfiable && !byParameter && start > 0:
+		// the file ended where the window before did: the whole of it came
+		return 0, io.EOF
+	case resp.StatusCode == http.StatusOK:
+		// no ranges: the whole body comes at once, past the window
+		return 0, errors.Join(ErrLossNotCounted, ErrLossNoWindows)
+	default:
+		return 0, E.New("HTTP ", resp.StatusCode)
+	}
+	want := end - start + 1
+	body := &progressReader{Reader: resp.Body, last: time.Now()}
+	got, err := io.CopyN(io.Discard, body, want)
+	switch {
+	case err == nil:
+		return got, nil
+	case errors.Is(err, io.EOF):
+		return got, io.EOF
+	case time.Since(body.last) < lossStall:
+		return got, errors.Join(errStillComing, err)
+	default:
+		return got, E.Cause(errors.Join(ErrDownloadStopped, err), "after ", got, " bytes")
+	}
+}
+
+// quicProbeClient makes the HTTP client of a QUIC probe: its connections are streams dialed through
+// detour (over the same QUIC connection). One connection at a time, no redirects, no compression
+// asked for, as probeClient.
+func quicProbeClient(ctx context.Context, detour N.Dialer, destination M.Socksaddr) *http.Client {
+	return &http.Client{
+		Transport: &http.Transport{
+			DialContext: func(dialCtx context.Context, network, addr string) (net.Conn, error) {
+				return detour.DialContext(dialCtx, "tcp", destination)
+			},
+			TLSClientConfig: &tls.Config{
+				Time:    ntp.TimeFuncFromContext(ctx),
+				RootCAs: adapter.RootPoolFromContext(ctx),
+			},
+			DisableCompression: true,
+			MaxConnsPerHost:    1,
+		},
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+		Timeout: lossClientTimeout,
+	}
+}
diff --git a/common/urltest/loss_quic_test.go b/common/urltest/loss_quic_test.go
new file mode 100644
index 000000000..1362119c9
--- /dev/null
+++ b/common/urltest/loss_quic_test.go
@@ -0,0 +1,294 @@
+package urltest
+
+import (
+	"bytes"
+	"context"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/probesock"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+)
+
+// quicCounterStub counts as a QUIC connection would: every window the server sends brings
+// packets, some of them missing.
+type quicCounterStub struct {
+	received, missing atomic.Uint64
+	connection        atomic.Uint64
+	none              bool
+}
+
+func (s *quicCounterStub) QUICStats() (adapter.QUICStats, bool) {
+	if s.none {
+		return adapter.QUICStats{}, false
+	}
+	return adapter.QUICStats{Connection: s.connection.Load(), PeerPacketsReceived: s.received.Load(),
+		PeerPacketsMissing: s.missing.Load(), MinRTT: 7 * time.Millisecond}, true
+}
+
+func plainDialer() DialerFunc {
+	return func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, network, destination.String())
+	}
+}
+
+// rangeServer serves a body of total bytes by ranges; each window adds 15 packets that came and
+// 1 that did not to the counter. ranges returns the sizes of the ranges asked for.
+func rangeServer(t *testing.T, total int, counter *quicCounterStub) (server *httptest.Server, ranges func() []int64) {
+	body := make([]byte, total)
+	var access sync.Mutex
+	var asked []int64
+	server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		spec := strings.TrimPrefix(r.Header.Get("Range"), "bytes=")
+		if from, to, found := strings.Cut(spec, "-"); found {
+			a, _ := strconv.ParseInt(from, 10, 64)
+			b, _ := strconv.ParseInt(to, 10, 64)
+			access.Lock()
+			asked = append(asked, b-a+1)
+			access.Unlock()
+		}
+		counter.received.Add(15)
+		counter.missing.Add(1)
+		http.ServeContent(w, r, "", time.Time{}, bytes.NewReader(body))
+	}))
+	t.Cleanup(server.Close)
+	return server, func() []int64 {
+		access.Lock()
+		defer access.Unlock()
+		return append([]int64(nil), asked...)
+	}
+}
+
+// The probe asks for one window at a time and counts what the connection counted across it.
+func TestLossProbeQUICWindows(t *testing.T) {
+	counter := &quicCounterStub{}
+	server, ranges := rangeServer(t, LossProbeSmall, counter)
+	sample, err := LossProbeQUIC(context.Background(), server.URL, LossProbeSmall, plainDialer(), counter)
+	require.NoError(t, err)
+	windows := (LossProbeSmall + probesock.Window - 1) / probesock.Window
+	require.Len(t, ranges(), windows)
+	for _, size := range ranges() {
+		require.LessOrEqual(t, size, int64(probesock.Window))
+	}
+	require.Equal(t, int64(LossProbeSmall), sample.Received)
+	require.Equal(t, 16*windows, sample.Segments)
+	require.Equal(t, windows, sample.Lost)
+	require.Equal(t, 7*time.Millisecond, sample.RTT)
+}
+
+// A body shorter than asked is counted as it is.
+func TestLossProbeQUICShortBody(t *testing.T) {
+	counter := &quicCounterStub{}
+	server, _ := rangeServer(t, 50<<10, counter)
+	sample, err := LossProbeQUIC(context.Background(), server.URL, LossProbeSmall, plainDialer(), counter)
+	require.NoError(t, err)
+	require.Equal(t, int64(50<<10), sample.Received)
+	require.Positive(t, sample.Segments)
+}
+
+// No connection, or one replaced during the probe: nothing is counted.
+func TestLossProbeQUICNotCounted(t *testing.T) {
+	none := &quicCounterStub{none: true}
+	server, _ := rangeServer(t, LossProbeSmall, none)
+	_, err := LossProbeQUIC(context.Background(), server.URL, LossProbeSmall, plainDialer(), none)
+	require.ErrorIs(t, err, ErrLossNotCounted)
+	replaced := &replacedAfterFirst{&quicCounterStub{}}
+	server, _ = rangeServer(t, LossProbeSmall, replaced.quicCounterStub)
+	_, err = LossProbeQUIC(context.Background(), server.URL, LossProbeSmall, plainDialer(), replaced)
+	require.ErrorIs(t, err, ErrLossNotCounted)
+}
+
+// replacedAfterFirst is a counter whose connection changes after its first count.
+type replacedAfterFirst struct {
+	*quicCounterStub
+}
+
+func (r *replacedAfterFirst) QUICStats() (adapter.QUICStats, bool) {
+	stats, active := r.quicCounterStub.QUICStats()
+	r.connection.Add(1)
+	return stats, active
+}
+
+// A URL that serves no ranges and has no "bytes" parameter would send the whole body at once:
+// not a probe, and never one with that URL.
+func TestLossProbeQUICNoRanges(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write(make([]byte, LossProbeSmall))
+	}))
+	t.Cleanup(server.Close)
+	_, err := LossProbeQUIC(context.Background(), server.URL, LossProbeSmall, plainDialer(), &quicCounterStub{})
+	require.ErrorIs(t, err, ErrLossNotCounted)
+	require.ErrorIs(t, err, ErrLossNoWindows)
+}
+
+// A URL with a "bytes" parameter, as speed.cloudflare.com/__down, which answers a range with the
+// whole body: each window is a body of that many bytes.
+func TestLossProbeQUICByParameter(t *testing.T) {
+	counter := &quicCounterStub{}
+	var access sync.Mutex
+	var asked []string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		size, _ := strconv.Atoi(r.URL.Query().Get("bytes"))
+		access.Lock()
+		asked = append(asked, r.URL.Query().Get("bytes")+" "+r.Header.Get("Range"))
+		access.Unlock()
+		counter.received.Add(15)
+		w.Write(make([]byte, size))
+	}))
+	t.Cleanup(server.Close)
+	sample, err := LossProbeQUIC(context.Background(), server.URL+"/__down?bytes=1048576", LossProbeSmall, plainDialer(), counter)
+	require.NoError(t, err)
+	require.Equal(t, int64(LossProbeSmall), sample.Received)
+	access.Lock()
+	defer access.Unlock()
+	windows := (LossProbeSmall + probesock.Window - 1) / probesock.Window
+	require.Len(t, asked, windows)
+	require.Equal(t, strconv.Itoa(probesock.Window)+" ", asked[0])
+	require.Equal(t, strconv.Itoa(LossProbeSmall-(windows-1)*probesock.Window)+" ", asked[windows-1])
+	require.Equal(t, 15*windows, sample.Segments)
+	require.Zero(t, sample.Lost)
+}
+
+// A connection that carried more than the probe (the member in use, busy) weighs as many packets
+// as the probe took, at the share the connection lost.
+func TestLossProbeQUICBusyConnection(t *testing.T) {
+	counter := &quicCounterStub{}
+	body := make([]byte, LossProbeSmall)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// the window, and the traffic of the users of the member meanwhile: 1000 packets, 2 % lost
+		counter.received.Add(980)
+		counter.missing.Add(20)
+		http.ServeContent(w, r, "", time.Time{}, bytes.NewReader(body))
+	}))
+	t.Cleanup(server.Close)
+	sample, err := LossProbeQUIC(context.Background(), server.URL, LossProbeSmall, plainDialer(), counter)
+	require.NoError(t, err)
+	windows := (LossProbeSmall + probesock.Window - 1) / probesock.Window
+	require.Equal(t, int(quicProbePackets(LossProbeSmall, windows)), sample.Segments)
+	require.InDelta(t, 2.0, 100*float64(sample.Lost)/float64(sample.Segments), 0.6)
+}
+
+// A file whose end is the end of a window answers the window after it with 416: the whole of it
+// came, and is counted.
+func TestLossProbeQUICRangeEnd(t *testing.T) {
+	counter := &quicCounterStub{}
+	server, _ := rangeServer(t, 2*probesock.Window, counter)
+	sample, err := LossProbeQUIC(context.Background(), server.URL, LossProbeSmall, plainDialer(), counter)
+	require.NoError(t, err)
+	require.Equal(t, int64(2*probesock.Window), sample.Received)
+	require.Positive(t, sample.Segments)
+}
+
+// idleClosingMember is a member no group uses (sing-quic with closeIdle): its QUIC connection
+// closes with its last stream, and the next stream opens another.
+type idleClosingMember struct {
+	counter quicCounterStub
+	access  sync.Mutex
+	streams int
+	open    bool
+}
+
+func (m *idleClosingMember) QUICStats() (adapter.QUICStats, bool) {
+	m.access.Lock()
+	defer m.access.Unlock()
+	if !m.open {
+		return adapter.QUICStats{}, false
+	}
+	return m.counter.QUICStats()
+}
+
+func (m *idleClosingMember) dial(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	conn, err := plainDialer()(ctx, network, destination)
+	if err != nil {
+		return nil, err
+	}
+	m.access.Lock()
+	if !m.open {
+		m.open = true
+		m.counter.connection.Add(1)
+	}
+	m.streams++
+	m.access.Unlock()
+	return &idleClosingStream{Conn: conn, member: m}, nil
+}
+
+type idleClosingStream struct {
+	net.Conn
+	member *idleClosingMember
+	once   sync.Once
+}
+
+func (c *idleClosingStream) Close() error {
+	c.once.Do(func() {
+		c.member.access.Lock()
+		c.member.streams--
+		if c.member.streams == 0 {
+			c.member.open = false
+		}
+		c.member.access.Unlock()
+	})
+	return c.Conn.Close()
+}
+
+// A window cut by the time limit closes the HTTP connection of the probe: the connection of a member
+// no group uses stays until it was counted (the stream the probe holds), and the probe counts as
+// far as it came.
+func TestLossProbeQUICCutCounts(t *testing.T) {
+	member := &idleClosingMember{}
+	var requests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		member.counter.received.Add(15)
+		member.counter.missing.Add(1)
+		w.Header().Set("Content-Range", "bytes 0-"+strconv.Itoa(probesock.Window-1)+"/"+strconv.Itoa(LossProbeSmall))
+		w.Header().Set("Content-Length", strconv.Itoa(probesock.Window))
+		w.WriteHeader(http.StatusPartialContent)
+		if requests.Add(1) < 3 {
+			w.Write(make([]byte, probesock.Window))
+			return
+		}
+		// the third window comes in part, and the rest too late
+		w.Write(make([]byte, probesock.Window/2))
+		w.(http.Flusher).Flush()
+		select {
+		case <-r.Context().Done():
+		case <-time.After(5 * time.Second):
+		}
+	}))
+	t.Cleanup(server.Close)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	sample, err := LossProbeQUIC(ctx, server.URL, LossProbeSmall, DialerFunc(member.dial), member)
+	require.NoError(t, err)
+	require.Equal(t, int64(2*probesock.Window+probesock.Window/2), sample.Received)
+	require.Equal(t, 3*16, sample.Segments)
+	require.Equal(t, 3, sample.Lost)
+	// the HTTP connection the cut closed goes in the background of net/http
+	require.Eventually(t, func() bool {
+		member.access.Lock()
+		defer member.access.Unlock()
+		return member.streams == 0 && !member.open
+	}, 2*time.Second, 10*time.Millisecond, "the connection of a member no group uses is closed after the probe, as before it")
+}
+
+func TestParseUDPReceiveDrops(t *testing.T) {
+	snmp := "Ip: Forwarding DefaultTTL\nIp: 1 64\n" +
+		"Udp: InDatagrams NoPorts InErrors OutDatagrams RcvbufErrors SndbufErrors InCsumErrors IgnoredMulti MemErrors\n" +
+		"Udp: 154054 7 3 80910 2 0 0 17450 0\n" +
+		"UdpLite: InDatagrams NoPorts InErrors OutDatagrams RcvbufErrors SndbufErrors InCsumErrors IgnoredMulti MemErrors\n" +
+		"UdpLite: 0 0 0 0 9 0 0 0 0\n"
+	drops, known := parseUDPReceiveDrops(snmp)
+	require.True(t, known)
+	require.Equal(t, uint64(2), drops)
+	_, known = parseUDPReceiveDrops("Ip: Forwarding\nIp: 1\n")
+	require.False(t, known)
+}
