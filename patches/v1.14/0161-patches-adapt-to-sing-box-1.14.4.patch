 common/trafficcontrol/manager_race_test.go |  2 +-
 protocol/group/urltest.go                  |  2 +-
 protocol/group/urltest_download.go         |  6 ++--
 protocol/group/urltest_failure.go          |  4 +--
 protocol/group/urltest_fallback_test.go    | 15 ++++----
 protocol/group/urltest_response.go         |  4 +--
 route/route.go                             | 15 ++------
 route/route_loop_test.go                   | 40 ++++++++++++++--------
 route/rule/rule_set_remote.go              |  2 +-
 10 files changed, 48 insertions(+), 44 deletions(-)

