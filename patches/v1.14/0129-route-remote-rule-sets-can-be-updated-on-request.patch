 route/router.go                     |  9 ++++
 route/rule/rule_set_updater.go      | 48 +++++++++++++++++++-
 route/rule/rule_set_updater_test.go | 69 +++++++++++++++++++++++++++++
 3 files changed, 125 insertions(+), 1 deletion(-)
 create mode 100644 route/rule/rule_set_updater_test.go

