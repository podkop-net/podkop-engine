diff --git a/adapter/lifecycle_podkop.go b/adapter/lifecycle_podkop.go
new file mode 100644
index 000000000..aa174de2c
--- /dev/null
+++ b/adapter/lifecycle_podkop.go
@@ -0,0 +1,40 @@
+package adapter
+
+import (
+	"maps"
+	"slices"
+
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// CloseComponent closes the scopes a component was started in, found among the children of
+// this scope and theirs, and lets go of them: the scopes hold the component no more. The
+// cleanups that close them with their parents stay and do nothing then. It tells whether the
+// component was found (podkop-engine: an outbound that was replaced while the box runs is
+// closed alone).
+//
+// A component may have more than one: the outbound manager starts an outbound in its scope,
+// but the start stage of one that is a Lifecycle in the scope of the endpoint manager (it is
+// an adapter.Endpoint by its methods).
+func (s *Scope) CloseComponent(component Lifecycle) (bool, error) {
+	taken := s.takeChildren(component, nil)
+	var errors []error
+	for _, child := range taken {
+		errors = append(errors, child.Close())
+	}
+	return len(taken) > 0, E.Errors(errors...)
+}
+
+func (s *Scope) takeChildren(component Lifecycle, taken []*Scope) []*Scope {
+	s.access.Lock()
+	if child, loaded := s.children[component]; loaded {
+		delete(s.children, component)
+		taken = append(taken, child)
+	}
+	children := slices.Collect(maps.Values(s.children))
+	s.access.Unlock()
+	for _, child := range children {
+		taken = child.takeChildren(component, taken)
+	}
+	return taken
+}
diff --git a/adapter/lifecycle_podkop_test.go b/adapter/lifecycle_podkop_test.go
new file mode 100644
index 000000000..e6decb20a
--- /dev/null
+++ b/adapter/lifecycle_podkop_test.go
@@ -0,0 +1,65 @@
+package adapter_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+
+	"github.com/stretchr/testify/require"
+)
+
+type closeCounter struct {
+	closed int
+	child  adapter.Lifecycle
+}
+
+func (c *closeCounter) Start(stage adapter.StartStage, scope *adapter.Scope) error {
+	if stage != adapter.StartStateInitialize {
+		return nil
+	}
+	scope.Add(func() error {
+		c.closed++
+		return nil
+	})
+	if c.child != nil {
+		return scope.Start("child", c.child, stage)
+	}
+	return nil
+}
+
+// A component found anywhere below a scope is closed alone, once: the close of the scope
+// it was in does not close it again.
+func TestCloseComponent(t *testing.T) {
+	scope := adapter.NewScope(context.Background(), log.NewNOPFactory().Logger())
+	deep := &closeCounter{}
+	parent := &closeCounter{child: deep}
+	other := &closeCounter{}
+	require.NoError(t, scope.Start("parent", parent, adapter.StartStateInitialize))
+	require.NoError(t, scope.Start("other", other, adapter.StartStateInitialize))
+
+	found, err := scope.CloseComponent(deep)
+	require.True(t, found)
+	require.NoError(t, err)
+	require.Equal(t, 1, deep.closed)
+	require.Zero(t, parent.closed)
+	found, _ = scope.CloseComponent(deep)
+	require.False(t, found, "let go of")
+
+	// started in two scopes, as an outbound that is a Lifecycle is: closed in both
+	twice := &closeCounter{}
+	require.NoError(t, scope.Start("left", &closeCounter{child: twice}, adapter.StartStateInitialize))
+	require.NoError(t, scope.Start("right", &closeCounter{child: twice}, adapter.StartStateInitialize))
+	found, err = scope.CloseComponent(twice)
+	require.True(t, found)
+	require.NoError(t, err)
+	require.Equal(t, 2, twice.closed, "both scopes it was started in")
+
+	require.NoError(t, scope.Close())
+	require.Equal(t, 1, deep.closed)
+	require.Equal(t, 1, parent.closed)
+	require.Equal(t, 1, other.closed)
+	found, _ = scope.CloseComponent(other)
+	require.False(t, found, "a closed scope has no children")
+}
diff --git a/adapter/outbound/manager_podkop.go b/adapter/outbound/manager_podkop.go
new file mode 100644
index 000000000..4d588ad4f
--- /dev/null
+++ b/adapter/outbound/manager_podkop.go
@@ -0,0 +1,90 @@
+package outbound
+
+import (
+	"context"
+	"os"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// What podkop-engine adds to the manager: an outbound built and started outside it takes the
+// place of the one of its tag while the box runs (box.UpdateOutbounds). Nothing here starts,
+// stops or closes an outbound.
+
+// NewOutbound builds an outbound as Create does, without putting it in the manager.
+func (m *Manager) NewOutbound(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, outboundType string, options any) (adapter.Outbound, error) {
+	if tag == "" {
+		return nil, os.ErrInvalid
+	}
+	return m.registry.CreateOutbound(ctx, router, logger, tag, outboundType, options)
+}
+
+// SwapOutbounds puts each outbound of put in the place of the one of its tag, or after the
+// others when its tag is new, and takes out those of the tags in remove. It returns the
+// outbounds it replaced or took out. The list and the map are copied, not changed: who read
+// them before goes on with what was there. Nothing is changed when a tag is given twice, is
+// that of an endpoint, is to be removed and is not there, or is the default outbound's to be
+// removed. The default outbound that is replaced is the new one.
+func (m *Manager) SwapOutbounds(put []adapter.Outbound, remove []string) ([]adapter.Outbound, error) {
+	m.access.Lock()
+	defer m.access.Unlock()
+	replacing := make(map[string]adapter.Outbound, len(put))
+	for _, outbound := range put {
+		tag := outbound.Tag()
+		if tag == "" {
+			return nil, os.ErrInvalid
+		}
+		if _, given := replacing[tag]; given {
+			return nil, E.New("duplicate outbound tag: ", tag)
+		}
+		if _, isEndpoint := m.endpoint.Get(tag); isEndpoint {
+			return nil, E.New("outbound tag is that of an endpoint: ", tag)
+		}
+		replacing[tag] = outbound
+	}
+	removing := make(map[string]bool, len(remove))
+	for _, tag := range remove {
+		if _, given := replacing[tag]; given || removing[tag] {
+			return nil, E.New("duplicate outbound tag: ", tag)
+		}
+		if _, loaded := m.outboundByTag[tag]; !loaded {
+			return nil, E.New("outbound not found: ", tag)
+		}
+		if m.defaultOutbound != nil && m.defaultOutbound.Tag() == tag {
+			return nil, E.New("the default outbound cannot be removed: ", tag)
+		}
+		removing[tag] = true
+	}
+	outbounds := make([]adapter.Outbound, 0, len(m.outbounds)+len(put))
+	outboundByTag := make(map[string]adapter.Outbound, len(m.outboundByTag)+len(put))
+	var previous []adapter.Outbound
+	for _, outbound := range m.outbounds {
+		tag := outbound.Tag()
+		if removing[tag] {
+			previous = append(previous, outbound)
+			continue
+		}
+		if next, replaced := replacing[tag]; replaced {
+			previous = append(previous, outbound)
+			outbound = next
+		}
+		outbounds = append(outbounds, outbound)
+		outboundByTag[tag] = outbound
+	}
+	for _, outbound := range put {
+		if _, placed := outboundByTag[outbound.Tag()]; !placed {
+			outbounds = append(outbounds, outbound)
+			outboundByTag[outbound.Tag()] = outbound
+		}
+	}
+	if m.defaultOutbound != nil {
+		if next, replaced := replacing[m.defaultOutbound.Tag()]; replaced {
+			m.defaultOutbound = next
+		}
+	}
+	m.outbounds = outbounds
+	m.outboundByTag = outboundByTag
+	return previous, nil
+}
diff --git a/adapter/outbound/manager_podkop_test.go b/adapter/outbound/manager_podkop_test.go
new file mode 100644
index 000000000..4964ff1d3
--- /dev/null
+++ b/adapter/outbound/manager_podkop_test.go
@@ -0,0 +1,112 @@
+package outbound_test
+
+import (
+	"context"
+	"net"
+	"os"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/endpoint"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/log"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+type swapOutbound struct {
+	outbound.Adapter
+}
+
+func newSwapOutbound(tag string) *swapOutbound {
+	return &swapOutbound{Adapter: outbound.NewAdapter("test", tag, []string{N.NetworkTCP}, nil)}
+}
+
+func (o *swapOutbound) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return nil, os.ErrInvalid
+}
+
+func (o *swapOutbound) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, os.ErrInvalid
+}
+
+func tagsOf(outbounds []adapter.Outbound) []string {
+	tags := make([]string, len(outbounds))
+	for i, outbound := range outbounds {
+		tags[i] = outbound.Tag()
+	}
+	return tags
+}
+
+// newSwapManager is a manager of the outbounds of the tags, the first the default.
+func newSwapManager(t *testing.T, tags ...string) *outbound.Manager {
+	registry := outbound.NewRegistry()
+	outbound.Register[struct{}](registry, "test", func(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options struct{}) (adapter.Outbound, error) {
+		return newSwapOutbound(tag), nil
+	})
+	manager := outbound.NewManager(registry, endpoint.NewManager(nil), "")
+	for _, tag := range tags {
+		require.NoError(t, manager.Create(context.Background(), nil, nil, tag, "test", &struct{}{}))
+	}
+	return manager
+}
+
+// An outbound takes the place of the one of its tag, a new tag goes after the others, and
+// a removed one is gone; who read the list before keeps it as it was.
+func TestSwapOutbounds(t *testing.T) {
+	manager := newSwapManager(t, "a", "b", "c")
+	before := manager.Outbounds()
+	oldB, _ := manager.Outbound("b")
+	oldC, _ := manager.Outbound("c")
+	newB, d := newSwapOutbound("b"), newSwapOutbound("d")
+
+	previous, err := manager.SwapOutbounds([]adapter.Outbound{d, newB}, []string{"c"})
+	require.NoError(t, err)
+	require.ElementsMatch(t, []adapter.Outbound{oldB, oldC}, previous)
+	require.Equal(t, []string{"a", "b", "d"}, tagsOf(manager.Outbounds()))
+	found, loaded := manager.Outbound("b")
+	require.True(t, loaded)
+	require.Same(t, adapter.Outbound(newB), found)
+	_, loaded = manager.Outbound("c")
+	require.False(t, loaded)
+	require.Equal(t, []string{"a", "b", "c"}, tagsOf(before))
+	require.Same(t, oldB, before[1])
+
+	// the default outbound is replaced, never removed
+	newA := newSwapOutbound("a")
+	_, err = manager.SwapOutbounds([]adapter.Outbound{newA}, nil)
+	require.NoError(t, err)
+	require.Same(t, adapter.Outbound(newA), manager.Default())
+	_, err = manager.SwapOutbounds(nil, []string{"a"})
+	require.ErrorContains(t, err, "default outbound")
+
+	// what cannot be done changes nothing
+	for _, testCase := range []struct {
+		put    []adapter.Outbound
+		remove []string
+	}{
+		{[]adapter.Outbound{newSwapOutbound("e"), newSwapOutbound("e")}, nil},
+		{[]adapter.Outbound{newSwapOutbound("b")}, []string{"b"}},
+		{nil, []string{"missing"}},
+		{nil, []string{"d", "d"}},
+	} {
+		listed := manager.Outbounds()
+		_, err = manager.SwapOutbounds(testCase.put, testCase.remove)
+		require.Error(t, err)
+		require.Equal(t, listed, manager.Outbounds())
+	}
+}
+
+// NewOutbound builds what Create would, and puts nothing in the manager.
+func TestNewOutbound(t *testing.T) {
+	manager := newSwapManager(t, "a")
+	created, err := manager.NewOutbound(context.Background(), nil, nil, "a", "test", &struct{}{})
+	require.NoError(t, err)
+	require.Equal(t, "a", created.Tag())
+	found, _ := manager.Outbound("a")
+	require.NotSame(t, created, found)
+	_, err = manager.NewOutbound(context.Background(), nil, nil, "", "test", &struct{}{})
+	require.Error(t, err)
+}
