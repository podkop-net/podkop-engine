 common/domainset/domainset.go      | 10 +++--
 common/domainset/domainset_test.go | 69 ++++++++++++++++++++++--------
 common/domainset/legacy.go         | 20 ++++++---
 common/domainset/trie.go           |  5 +--
 5 files changed, 77 insertions(+), 35 deletions(-)

