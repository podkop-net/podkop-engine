 protocol/group/urltest.go          |  69 ++++++++++++++++++--
 protocol/group/urltest_download.go |   4 ++
 protocol/group/urltest_failure.go  |  13 +++-
 protocol/group/urltest_r20_test.go | 101 +++++++++++++++++++++++++++++
 5 files changed, 181 insertions(+), 9 deletions(-)

